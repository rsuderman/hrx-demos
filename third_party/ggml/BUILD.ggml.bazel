load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

package(default_visibility = ["//visibility:public"])

# The maintained ggml-base source set. No CPU/GPU backend implementation,
# backend registry, model loader, tokenizer, or llama inference is linked.
iree_cc_library(
    name = "metadata",
    srcs = [
        "ggml/src/ggml.c",
        "ggml/src/ggml-alloc.c",
        "ggml/src/ggml-backend.cpp",
        "ggml/src/ggml-backend-meta.cpp",
        "ggml/src/ggml-opt.cpp",
        "ggml/src/ggml-threading.cpp",
        "ggml/src/ggml-quants.c",
        "ggml/src/gguf.cpp",
    ],
    hdrs = glob(["ggml/include/*.h", "ggml/src/*.h", "ggml/src/ggml-cpu/*.h"]),
    includes = ["ggml/include", "ggml/src"],
    defines = ["GGML_STATIC"],
    local_defines = ['GGML_VERSION=\\"0.18.0\\"', 'GGML_COMMIT=\\"dace2471abb49c118f95e6be09b4b8de2c1118b2\\"'],
    copts = select({"@hrx_system//build_tools/bazel:cc_compiler_clang_cl": [], "@hrx_system//build_tools/bazel:cc_compiler_msvc": [], "//conditions:default": ["-pthread"]}),
    linkopts = select({"@hrx_system//build_tools/bazel:cc_compiler_clang_cl": [], "@hrx_system//build_tools/bazel:cc_compiler_msvc": [], "//conditions:default": ["-pthread", "-lm"]}),
)

exports_files(["LICENSE"])

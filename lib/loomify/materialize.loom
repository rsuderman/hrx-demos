// Pre-target specialization preserves explicit kernel dispatches; optional
// callable expansion belongs to the target compilation pipeline.
pass.pipeline<module> @materialize pipeline {
  for func { canonicalize }
  inline-callables(budget = 0, hot-budget = 0)
  for func {
    canonicalize
    unroll-scf-for
    canonicalize
  }
  repeat until_converged(max_iterations = 32) {
    select-templates(mode = "early", rewrite = "inline")
    inline-callables(budget = 0, hot-budget = 0)
    for func {
      canonicalize
      unroll-scf-for
      canonicalize
    }
  }
  select-templates(mode = "final", rewrite = "inline")
  for func { canonicalize }
  symbol-dce
}

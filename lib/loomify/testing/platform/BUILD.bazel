load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
package(default_visibility = ["//visibility:private"])
[loom_merge(name = member + "_" + format, srcs = [member + ".loom"], output_format = format, testonly = True) for member in ["root", "targets"] for format in ["text", "bc"]]
cc_test(
    name = "provider_test",
    size = "small",
    srcs = ["provider_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = [":root_text", ":root_bc", ":targets_text", ":targets_bc"],
    deps = ["//lib/loomify:native_linking", "@hrx_system//loom/binding/c:loomc", "@hrx_system//loom/binding/c/target/amdgpu", "@hrx_system//loom/binding/c/target/cmd", "@googletest//:gtest", "@googletest//:gtest_main"],
)

[loom_merge(
    name = "reset_provider_" + format,
    testonly = True,
    srcs = [
        "reset_bytes.loom",
        "testing/reset_programs.loom",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "reset_" + format + "_test",
    srcs = [
        "testing/reset_checks.loom",
        ":reset_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]


command.decl @benchmark_reset.odd() launch(%seed: buffer, %live: buffer)

command.decl @benchmark_reset.single() launch(%seed: buffer, %live: buffer)

command.decl @benchmark_reset.tail() launch(%seed: buffer, %live: buffer)

command.decl @benchmark_reset.repeated() launch(%seed: buffer, %live: buffer)

// Independent host byte oracle, including untouched guards around the slice.
func.def @benchmark_reset.expected(%n0: index, %source_origin: offset, %target_origin: offset, %seed: buffer, %live: buffer) {
  %n = index.assume %n0 [range(%n0, 1, 513)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %source = buffer.view %seed[%source_origin] : buffer -> view<[%n]xi8>
  %target = buffer.view %live[%target_origin] : buffer -> view<[%n]xi8>
  scf.for %i = [%zero to %n step %one] {
    %byte = view.load %source[%i] : view<[%n]xi8> -> i8
    view.store %byte, %target[%i] : i8, view<[%n]xi8>
  }
  func.return
}

func.def @benchmark_reset.expected_odd(%seed: buffer, %live: buffer) {
  %n = index.constant 257 : index
  %source = index.constant 3 : offset
  %target = index.constant 5 : offset
  func.call @benchmark_reset.expected(%n, %source, %target, %seed, %live) : (index, offset, offset, buffer, buffer)
  func.return
}

func.def @benchmark_reset.expected_single(%seed: buffer, %live: buffer) {
  %n = index.constant 1 : index
  %source = index.constant 511 : offset
  %target = index.constant 7 : offset
  func.call @benchmark_reset.expected(%n, %source, %target, %seed, %live) : (index, offset, offset, buffer, buffer)
  func.return
}

func.def @benchmark_reset.expected_tail(%seed: buffer, %live: buffer) {
  %n = index.constant 513 : index
  %source = index.constant 3 : offset
  %target = index.constant 7 : offset
  func.call @benchmark_reset.expected(%n, %source, %target, %seed, %live) : (index, offset, offset, buffer, buffer)
  func.return
}

check.scenario @benchmark_reset.odd_bytes {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.generate.iota offset(-128) step(1) period(256) : tensor<528xi8>
    %live = check.generate.fill value(67) : tensor<528xi8>
    check.compare<@benchmark_reset.odd, @benchmark_reset.expected_odd>(%seed, %live) : (tensor<528xi8>, tensor<528xi8>) -> () {
      check.expect.bitwise actual(%live) expected(%live) : tensor<528xi8>
      check.expect.bitwise actual(%seed) expected(%seed) : tensor<528xi8>
    }
  }
  check.return
}

check.scenario @benchmark_reset.single_byte {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.generate.iota offset(-128) step(1) period(256) : tensor<528xi8>
    %live = check.generate.fill value(67) : tensor<528xi8>
    check.compare<@benchmark_reset.single, @benchmark_reset.expected_single>(%seed, %live) : (tensor<528xi8>, tensor<528xi8>) -> () {
      check.expect.bitwise actual(%live) expected(%live) : tensor<528xi8>
      check.expect.bitwise actual(%seed) expected(%seed) : tensor<528xi8>
    }
  }
  check.return
}

check.scenario @benchmark_reset.multi_group_tail {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.generate.iota offset(-128) step(1) period(256) : tensor<528xi8>
    %live = check.generate.fill value(67) : tensor<528xi8>
    check.compare<@benchmark_reset.tail, @benchmark_reset.expected_tail>(%seed, %live) : (tensor<528xi8>, tensor<528xi8>) -> () {
      check.expect.bitwise actual(%live) expected(%live) : tensor<528xi8>
      check.expect.bitwise actual(%seed) expected(%seed) : tensor<528xi8>
    }
  }
  check.return

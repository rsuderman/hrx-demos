kernel.decl @loomify.benchmark.reset_bytes(%bytes$0: index) launch(%bytes$1: index, %seed_origin: offset, %live_origin: offset, %seed: buffer, %live: buffer)

command.def @benchmark_reset.odd() launch(%seed: buffer, %live: buffer) {
  %bytes = index.constant 257 : index
  %source = index.constant 3 : offset
  %target = index.constant 5 : offset
  kernel.launch @loomify.benchmark.reset_bytes[%bytes](%bytes, %source, %target, %seed, %live) : [index](index, offset, offset, buffer, buffer)
  command.return
}

command.def @benchmark_reset.single() launch(%seed: buffer, %live: buffer) {
  %bytes = index.constant 1 : index
  %source = index.constant 511 : offset
  %target = index.constant 7 : offset
  kernel.launch @loomify.benchmark.reset_bytes[%bytes](%bytes, %source, %target, %seed, %live) : [index](index, offset, offset, buffer, buffer)
  command.return
}

command.def @benchmark_reset.tail() launch(%seed: buffer, %live: buffer) {
  %bytes = index.constant 513 : index
  %source = index.constant 3 : offset
  %target = index.constant 7 : offset
  kernel.launch @loomify.benchmark.reset_bytes[%bytes](%bytes, %source, %target, %seed, %live) : [index](index, offset, offset, buffer, buffer)
  command.return
}

// Test-only disturbance between restores makes native ordering observable.
kernel.def @benchmark_reset.disturb() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%live: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %live[%origin] : buffer -> view<528xi8>
  %zero = scalar.constant 0 : i8
  view.store %zero, %view[5] : i8, view<528xi8>
  kernel.return
}

command.def @benchmark_reset.repeated() launch(%seed: buffer, %live: buffer) {
  command.launch @benchmark_reset.odd(%seed, %live) : (buffer, buffer)
  kernel.launch @benchmark_reset.disturb(%live) : (buffer)
  command.launch @benchmark_reset.odd(%seed, %live) : (buffer, buffer)
  command.return
}

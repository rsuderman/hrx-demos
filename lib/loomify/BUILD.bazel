    name = "native_linking",
    srcs = ["linking.cc"], hdrs = ["linking.h", "architectures.h", "platforms.h"],
    cxxopts = _CXXOPTS,
    visibility = [
        "//lib/loomify:__pkg__",
        "//lib/loomify/testing/platform:__pkg__",
        "//lib/loomify/testing:__pkg__",
        "//lib/architectures:__subpackages__",
        "//lib/programs/ffn/testing:__pkg__",
        "//lib/programs/projection/testing:__pkg__",
        "//lib/serving/testing:__pkg__",
    ],
    deps = [":materialize_source", "@hrx_system//loom/binding/c:loomc"],
)


iree_cc_library(
    name = "gguf_model_builder",
    visibility = ["//visibility:public"],
    srcs = ["package.cc", "gguf_model_builder.cc", "gguf_model_builder_internal.h", "architectures.cc", "platforms.cc"],
    hdrs = ["gguf_model_builder.h"],

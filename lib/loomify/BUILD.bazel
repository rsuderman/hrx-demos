    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "configuration",
    visibility = [
        "//lib/loomify/testing:__pkg__",
        "//lib/architectures/llama:__pkg__",
        "//lib/architectures/qwen3:__pkg__",
        "//lib/architectures/qwen35:__pkg__",

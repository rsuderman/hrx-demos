    srcs = ["configuration.cc", "configuration_internal.h", "architectures/llama.cc", "architectures/qwen35.cc", "architectures/gemma3.cc", "architectures/qwen3.cc"],
    hdrs = ["configuration.h"],
    cxxopts = _CXXOPTS,
    deps = ["//tools/model:gguf_catalog", "//tools/model:model_descriptor"],
)

iree_cc_library(
    name = "configuration_fixture",
    visibility = [
        "//lib/loomify/testing:__pkg__",
        "//lib/architectures/llama:__pkg__",
        "//lib/architectures/qwen35:__pkg__",
        "//lib/architectures/qwen35/testing:__pkg__",

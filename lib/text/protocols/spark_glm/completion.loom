global.rodata.decl @chatml.assistant_open

func.decl @chatml.check(%condition: i1)

global.rodata.decl @chatml.end

func.decl @chatml.generation_thought(%thinking: i1) -> (buffer)

global.rodata.decl @spark.empty

func.decl @spark.reason_prefix(%reason: buffer) -> (buffer)

func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)

func.decl @text.range(%json: buffer, %begin: i64, %length: i64) -> (buffer)

// Copyright 2026 AMD ROCm Software
// SPDX-License-Identifier: MIT
// Canonical history follows original assistant rendering, including empty reason.
// Replay is conservative: a generated open think prefix may disappear canonically.
func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %zero = index.constant 0 : offset
  %zero64 = scalar.constant 0 : i64
  %two64 = scalar.constant 2 : i64
  %mask = scalar.constant 7 : i64
  %prefix_mask = scalar.constant 16 : i64
  %flags = scalar.andi %initial_state, %prefix_mask : i64
  %no_prefix = scalar.cmpi ne, %flags, %zero64 : i64
  %mode = scalar.andi %initial_state, %mask : i64
  %thinking = scalar.cmpi eq, %mode, %two64 : i64
  %thought = func.call @chatml.generation_thought(%thinking) : (i1) -> (buffer)
  %header = global.load @chatml.assistant_open : buffer
  %header_size = buffer.length %header
  %thought_size = buffer.length %thought
  %prefix_size = index.add %header_size, %thought_size : offset
  %strip = scf.select %no_prefix, %zero, %prefix_size : offset
  %prompt_size = buffer.length %prompt
  %fits = index.cmp uge, %prompt_size, %strip : offset
  func.call @chatml.check(%fits) : (i1)
  %kept = index.sub %prompt_size, %strip : offset
  %kept64 = index.cast %kept : offset to i64
  %history = func.call @text.range(%prompt, %zero64, %kept64) : (buffer, i64, i64) -> (buffer)
  %reason_prefix = func.call @spark.reason_prefix(%reasoning) : (buffer) -> (buffer)
  %end = global.load @chatml.end : buffer
  %empty = global.load @spark.empty : buffer
  %v = func.call @text.join8(%history, %header, %reason_prefix, %content, %tools, %end, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %reuse = scalar.constant 0 : i32
  func.return %v, %reuse : buffer, i32
}

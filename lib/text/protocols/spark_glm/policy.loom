func.decl @chatml.check(%condition: i1)

global.rodata.decl @chatml.content

global.rodata.decl @chatml.messages

global.rodata.decl @chatml.role

global.rodata.decl @chatml.text

global.rodata.decl @chatml.tool

global.rodata.decl @chatml.type

global.rodata.decl @loomify.text.default_effort_instruction

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

global.rodata.decl @spark.system_lead

global.rodata.decl @spark.tool_header

func.decl @text.equal(%a: buffer, %b: buffer) -> (i1)

func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)

func.decl @text.lookup(%json: buffer, %key: buffer) -> (buffer, i64, i1)

func.decl @text.range(%json: buffer, %begin: i64, %length: i64) -> (buffer)

func.decl @text.string(%json: buffer, %key: buffer) -> (buffer, i1)

global.rodata.decl @chatml.end


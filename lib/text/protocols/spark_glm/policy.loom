// Exact 93d6aa90 Spark GLM policy, independent of numerical architecture.
global.rodata.def public @spark.empty = bytes("")

global.rodata.def public @spark.think_open = bytes("3c7468696e6b3e")

global.rodata.def public @spark.think_close = bytes("3c2f7468696e6b3e")

global.rodata.def @spark.function = bytes("66756e6374696f6e")

global.rodata.def @spark.reasoning_content = bytes("726561736f6e696e675f636f6e74656e74")

global.rodata.def @spark.tool_open = bytes("3c746f6f6c5f726573706f6e73653e")

global.rodata.def @spark.tool_close = bytes("3c2f746f6f6c5f726573706f6e73653e")

func.def inline @chatml.generation_thought(%thinking: i1) -> (buffer) {
  %open = global.load @spark.think_open : buffer
  %close = global.load @spark.think_close : buffer
  %v = scf.select %thinking, %open, %close : buffer
  func.return %v : buffer
}

func.def inline @chatml.history_prefix(%header: buffer, %reason: buffer, %retain: i1) -> (buffer) {
  %empty = global.load @spark.empty : buffer
  %v = func.call @text.join8(%header, %reason, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.return %v : buffer
}

func.def @spark.reason_prefix(%reason: buffer) -> (buffer) {
  %zero = index.constant 0 : offset
  %size = buffer.length %reason
  %has = index.cmp ne, %size, %zero : offset
  %empty = global.load @spark.empty : buffer
  %open = global.load @spark.think_open : buffer
  %close = global.load @spark.think_close : buffer
  %start = scf.select %has, %open, %empty : buffer
  %v = func.call @text.join8(%start, %reason, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.return %v : buffer
}

func.def @chatml.assistant_parts(%raw: buffer, %text: buffer, %reason: buffer, %fields: i64, %retain: i1) -> (buffer, buffer) {
  %key = global.load @spark.reasoning_content : buffer
  %value, %found = func.call @text.string(%raw, %key) : (buffer, buffer) -> (buffer, i1)
  %empty = global.load @spark.empty : buffer
  %kept = scf.select %found, %value, %empty : buffer
  %prefix = func.call @spark.reason_prefix(%kept) : (buffer) -> (buffer)
  func.return %text, %prefix : buffer, buffer
}

func.def @chatml.default_system() -> (buffer, i1) {
  %lead = global.load @spark.system_lead : buffer
  %effort = global.load @loomify.text.default_effort_instruction : buffer
  %empty = global.load @spark.empty : buffer
  %v = func.call @text.join8(%lead, %effort, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %yes = scalar.constant true : i1
  func.return %v, %yes : buffer, i1
}

func.def @chatml.schema_value(%tool: buffer) -> (buffer) {
  %key = global.load @spark.function : buffer
  %v, %kind, %found = func.call @text.lookup(%tool, %key) : (buffer, buffer) -> (buffer, i64, i1)
  func.call @chatml.check(%found) : (i1)
  func.return %v : buffer
}

func.def @chatml.render_tool_response(%raw: buffer, %text: buffer, %prior: i1, %first: i1) -> (buffer) {
  %empty = global.load @spark.empty : buffer
  %header = global.load @spark.tool_header : buffer
  %start = scf.select %prior, %empty, %header : buffer
  %open = global.load @spark.tool_open : buffer
  %close = global.load @spark.tool_close : buffer
  %v = func.call @text.join8(%start, %open, %text, %close, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.return %v : buffer
}

// Validate original shapes before Serve's decoded text loses type information.
func.def @chatml.admit_request(%request: buffer) {
  %messages_key = global.load @chatml.messages : buffer
  %messages, %kind, %found = func.call @text.lookup(%request, %messages_key) : (buffer, buffer) -> (buffer, i64, i1)
  scf.if %found {
    %records, %type, %count = func.call @members(%messages) : (buffer) -> (buffer, i32, i64)
    %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %origin = index.constant 0 : offset
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
    %role_key = global.load @chatml.role : buffer
    %tool_role = global.load @chatml.tool : buffer
    %content_key = global.load @chatml.content : buffer
    %text_key = global.load @chatml.text : buffer
    %type_key = global.load @chatml.type : buffer
    %zero64 = scalar.constant 0 : i64
    %array_kind = scalar.constant 3 : i64
    scf.for %i = [%zero to %extent step %one] {
      %begin = view.load %fields[%i, 2] : view<[%extent]x5xi64> -> i64
      %length = view.load %fields[%i, 3] : view<[%extent]x5xi64> -> i64
      %raw = func.call @text.range(%messages, %begin, %length) : (buffer, i64, i64) -> (buffer)
      %role, %has_role = func.call @text.string(%raw, %role_key) : (buffer, buffer) -> (buffer, i1)
      %tool = func.call @text.equal(%role, %tool_role) : (buffer, buffer) -> (i1)
      %content, %content_kind, %has_content = func.call @text.lookup(%raw, %content_key) : (buffer, buffer) -> (buffer, i64, i1)
      scf.if %tool {
        %string = scalar.cmpi eq, %content_kind, %zero64 : i64
        %valid = scalar.andi %string, %has_content : i1
        func.call @chatml.check(%valid) : (i1)
      } else {
        %array = scalar.cmpi eq, %content_kind, %array_kind : i64
        scf.if %array {
          %parts, %pk, %pc = func.call @members(%content) : (buffer) -> (buffer, i32, i64)
          %pb = scalar.assume %pc [range(%pc, 0, 2147483647)] : i64
          %pe = index.cast %pb : i64 to index
          %pv = buffer.view %parts[%origin] : buffer -> view<[%pe]x5xi64>
          scf.for %j = [%zero to %pe step %one] {
            %b = view.load %pv[%j, 2] : view<[%pe]x5xi64> -> i64
            %n = view.load %pv[%j, 3] : view<[%pe]x5xi64> -> i64
            %part = func.call @text.range(%content, %b, %n) : (buffer, i64, i64) -> (buffer)
            %t, %has_type = func.call @text.string(%part, %type_key) : (buffer, buffer) -> (buffer, i1)
            %is_text = func.call @text.equal(%t, %text_key) : (buffer, buffer) -> (i1)
            %valid = scalar.andi %has_type, %is_text : i1
            func.call @chatml.check(%valid) : (i1)
          }
        }
      }
    }
  }
  func.return
}

// Spark always keeps its default lead, then tools, then initial custom system.
func.def @chatml.render_system(%source_system: buffer, %source_has_system: i1, %instruction: buffer, %tools: buffer) -> (buffer) {
  %lead = global.load @spark.system_lead : buffer
  %open = global.load @chatml.system_open : buffer
  %close = global.load @chatml.end : buffer
  %empty = global.load @spark.empty : buffer
  %gap = global.load @chatml.separator : buffer
  %zero = index.constant 0 : offset
  %size = buffer.length %source_system
  %has_text = index.cmp ne, %size, %zero : offset
  %sep = scf.select %has_text, %gap, %empty : buffer
  %records, %kind, %count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %zero64 = scalar.constant 0 : i64
  %has_tools = scalar.cmpi ne, %count, %zero64 : i64
  %tool_text = scf.if %has_tools -> (buffer) {
    %prefix = global.load @loomify.text.tools_prefix : buffer
    %suffix = global.load @loomify.text.tools_suffix : buffer
    %compact = scalar.constant true : i1
    %schemas = func.call @chatml.render_schemas(%tools, %compact) : (buffer, i1) -> (buffer)
    %v = func.call @text.join8(%prefix, %schemas, %suffix, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %v : buffer
  } else {
    scf.yield %empty : buffer
  }
  %v = func.call @text.join8(%open, %lead, %instruction, %tool_text, %sep, %source_system, %close, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.return %v : buffer
}

global.rodata.def @spark.high = bytes("68696768")

func.def @chatml.effort_instruction(%effort: buffer, %enabled: i1) -> (buffer) {
  %empty = global.load @spark.empty : buffer
  %value = scf.if %enabled -> (buffer) {
    %low_key = global.load @chatml.low : buffer
    %high_key = global.load @spark.high : buffer
    %low = func.call @text.equal(%effort, %low_key) : (buffer, buffer) -> (i1)
    %high = func.call @text.equal(%effort, %high_key) : (buffer, buffer) -> (i1)
    %valid = scalar.ori %low, %high : i1
    func.call @chatml.check(%valid) : (i1)
    %low_text = global.load @loomify.text.effort_low : buffer
    %high_text = global.load @loomify.text.effort_xhigh : buffer
    %v = scf.select %low, %low_text, %high_text : buffer
    scf.yield %v : buffer
  } else {
    scf.yield %empty : buffer
  }
  func.return %value : buffer
}

func.def public @chat_reasoning() -> (i32, i32, i32) {
  %enabled = scalar.constant 1 : i32
  %mask = scalar.constant 20 : i32
  %low = scalar.constant 2 : i32
  %high = scalar.constant 4 : i32
  %value = global.load @loomify.text.default_effort : buffer
  %key = global.load @chatml.low : buffer
  %is_low = func.call @text.equal(%value, %key) : (buffer, buffer) -> (i1)
  %level = scf.select %is_low, %low, %high : i32
  func.return %enabled, %mask, %level : i32, i32, i32
}

// Canonical history follows original assistant rendering, including empty reason.
// Replay is conservative: a generated open think prefix may disappear canonically.
func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %zero = index.constant 0 : offset
  %zero64 = scalar.constant 0 : i64
  %two64 = scalar.constant 2 : i64
  %mask = scalar.constant 7 : i64
  %prefix_mask = scalar.constant 16 : i64
  %flags = scalar.andi %initial_state, %prefix_mask : i64
  %no_prefix = scalar.cmpi ne, %flags, %zero64 : i64
  %mode = scalar.andi %initial_state, %mask : i64
  %thinking = scalar.cmpi eq, %mode, %two64 : i64
  %thought = func.call @chatml.generation_thought(%thinking) : (i1) -> (buffer)
  %header = global.load @chatml.assistant_open : buffer
  %header_size = buffer.length %header
  %thought_size = buffer.length %thought
  %prefix_size = index.add %header_size, %thought_size : offset
  %strip = scf.select %no_prefix, %zero, %prefix_size : offset
  %prompt_size = buffer.length %prompt
  %fits = index.cmp uge, %prompt_size, %strip : offset
  func.call @chatml.check(%fits) : (i1)
  %kept = index.sub %prompt_size, %strip : offset
  %kept64 = index.cast %kept : offset to i64
  %history = func.call @text.range(%prompt, %zero64, %kept64) : (buffer, i64, i64) -> (buffer)
  %reason_prefix = func.call @spark.reason_prefix(%reasoning) : (buffer) -> (buffer)
  %end = global.load @chatml.end : buffer
  %empty = global.load @spark.empty : buffer
  %v = func.call @text.join8(%history, %header, %reason_prefix, %content, %tools, %end, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %reuse = scalar.constant 0 : i32
  func.return %v, %reuse : buffer, i32
}

  %call_open = global.load @spark_parse.call_open : buffer
  %call_close = global.load @spark_parse.call_close : buffer
  %key_open = global.load @spark_parse.key_open : buffer
  %key_close = global.load @spark_parse.key_close : buffer
  %value_open = global.load @spark_parse.value_open : buffer
  %value_close = global.load @spark_parse.value_close : buffer
  %xml_open = global.load @spark_parse.xml_open : buffer
  %xml_close = global.load @spark_parse.xml_close : buffer
  %xml_key = global.load @spark_parse.xml_key : buffer
  %xml_value_close = global.load @spark_parse.xml_value_close : buffer
  %xml_delimiter = global.load @spark_parse.xml_delimiter : buffer
  %tag = global.load @spark_parse.tag : buffer

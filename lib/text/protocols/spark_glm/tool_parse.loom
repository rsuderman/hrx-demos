  %end, %written = scf.while(%at = %zero : offset, %out = %zero : offset) -> (offset, offset) {
    %more = index.cmp ult, %at, %size : offset
    scf.condition %more, %at, %out : i1, offset, offset
  } do(%at: offset, %out: offset) {
    %name_begin = func.call @spark_parse.require_at(%response, %at, %call_open) : (buffer, offset, buffer) -> (offset)
    %key_at, %has_key = func.call @text.find(%response, %name_begin, %key_open) : (buffer, offset, buffer) -> (offset, i1)
    %call_end, %has_end = func.call @text.find(%response, %name_begin, %call_close) : (buffer, offset, buffer) -> (offset, i1)
    func.call @chatml.check(%has_end) : (i1)
    %key_before_end = index.cmp ult, %key_at, %call_end : offset
    %has_args = scalar.andi %has_key, %key_before_end : i1
    %name_end = scf.select %has_args, %key_at, %call_end : offset
    %name = func.call @text.slice(%response, %name_begin, %name_end) : (buffer, offset, offset) -> (buffer)
    func.call @spark_parse.identifier(%name) : (buffer)
    %o0 = func.call @text.append(%output, %out, %xml_open) : (buffer, offset, buffer) -> (offset)
    %o1 = func.call @text.append(%output, %o0, %name) : (buffer, offset, buffer) -> (offset)
    %o2 = func.call @text.append(%output, %o1, %tag) : (buffer, offset, buffer) -> (offset)
    %argument_end, %o3 = scf.while(%p = %name_end : offset, %o = %o2 : offset) -> (offset, offset) {
      %more = index.cmp ult, %p, %call_end : offset
      scf.condition %more, %p, %o : i1, offset, offset
    } do(%p: offset, %o: offset) {
      %kb = func.call @spark_parse.require_at(%response, %p, %key_open) : (buffer, offset, buffer) -> (offset)
      %ke, %has_ke = func.call @text.find(%response, %kb, %key_close) : (buffer, offset, buffer) -> (offset, i1)
      %ke_before = index.cmp ult, %ke, %call_end : offset
      %ke_valid = scalar.andi %has_ke, %ke_before : i1
      func.call @chatml.check(%ke_valid) : (i1)
      %key = func.call @text.slice(%response, %kb, %ke) : (buffer, offset, offset) -> (buffer)
      func.call @spark_parse.identifier(%key) : (buffer)
      %after_key = func.call @spark_parse.require_at(%response, %ke, %key_close) : (buffer, offset, buffer) -> (offset)
      %vb = func.call @spark_parse.require_at(%response, %after_key, %value_open) : (buffer, offset, buffer) -> (offset)
      %ve, %has_ve = func.call @text.find(%response, %vb, %value_close) : (buffer, offset, buffer) -> (offset, i1)
      %ve_before = index.cmp ult, %ve, %call_end : offset
      %ve_valid = scalar.andi %has_ve, %ve_before : i1
      func.call @chatml.check(%ve_valid) : (i1)

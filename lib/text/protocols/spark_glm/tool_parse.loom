func.def @spark_parse.require_known(%schemas: buffer, %name: buffer) {
  %records, %kind, %count = func.call @members(%schemas) : (buffer) -> (buffer, i32, i64)
  %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
  %function_key = global.load @spark_parse.function : buffer
  %name_key = global.load @spark_parse.name : buffer
  %false = scalar.constant false : i1
  %known = scf.for %i = [%zero to %extent step %one](%prior = %false : i1) -> (i1) {
    %begin = view.load %fields[%i, 2] : view<[%extent]x5xi64> -> i64
    %length = view.load %fields[%i, 3] : view<[%extent]x5xi64> -> i64
    %tool = func.call @text.range(%schemas, %begin, %length) : (buffer, i64, i64) -> (buffer)
    %function, %fk, %ff = func.call @text.lookup(%tool, %function_key) : (buffer, buffer) -> (buffer, i64, i1)
    %candidate, %present = func.call @text.string(%function, %name_key) : (buffer, buffer) -> (buffer, i1)
    %same = func.call @text.equal(%candidate, %name) : (buffer, buffer) -> (i1)
    %valid = scalar.andi %present, %same : i1
    %next = scalar.ori %prior, %valid : i1
    scf.yield %next : i1
  }
  func.call @chatml.check(%known) : (i1)
  func.return
}

func.def @spark_parse.check_calls(%schemas: buffer, %calls: buffer) {
  %records, %kind, %count = func.call @members(%calls) : (buffer) -> (buffer, i32, i64)
  %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
  %function_key = global.load @spark_parse.function : buffer
  %arguments_key = global.load @spark_parse.arguments : buffer
  %name_key = global.load @spark_parse.name : buffer
  scf.for %i = [%zero to %extent step %one] {
    %begin = view.load %fields[%i, 2] : view<[%extent]x5xi64> -> i64
    %length = view.load %fields[%i, 3] : view<[%extent]x5xi64> -> i64
    %call = func.call @text.range(%calls, %begin, %length) : (buffer, i64, i64) -> (buffer)
    %function, %fk, %ff = func.call @text.lookup(%call, %function_key) : (buffer, buffer) -> (buffer, i64, i1)
    %name, %nf = func.call @text.string(%function, %name_key) : (buffer, buffer) -> (buffer, i1)
    func.call @chatml.check(%nf) : (i1)
    func.call @spark_parse.require_known(%schemas, %name) : (buffer, buffer)
    %args, %af = func.call @text.string(%function, %arguments_key) : (buffer, buffer) -> (buffer, i1)
    func.call @chatml.check(%af) : (i1)
    func.call @chatml.admit_mapping(%args) : (buffer)
  }
  func.return
}

func.def public @parse_tools(%schemas: buffer, %response: buffer, %truncated: i64) -> (buffer) {
  %zero = index.constant 0 : offset
  %size = buffer.length %response
  %has_text = index.cmp ne, %size, %zero : offset
  %v = scf.if %has_text -> (buffer) {
    %xml = func.call @spark_parse.convert(%response) : (buffer) -> (buffer)
    %normalized = func.call @chatml.normalize_tool_output(%schemas, %xml) : (buffer, buffer) -> (buffer)
    %strict = scalar.constant 0 : i64
    %calls = func.call @parse_xml(%schemas, %normalized, %strict) : (buffer, buffer, i64) -> (buffer)
    func.call @spark_parse.check_calls(%schemas, %calls) : (buffer, buffer)
    scf.yield %calls : buffer
  } else {
    %empty = global.load @spark_parse.empty_array : buffer
    scf.yield %empty : buffer
  }
  func.return %v : buffer

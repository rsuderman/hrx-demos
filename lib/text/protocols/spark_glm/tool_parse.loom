// Scan a complete bounded delimiter; partial tails are malformed complete calls.
func.def @spark_parse.require_at(%text: buffer, %at: offset, %marker: buffer) -> (offset) {
  %valid = func.call @text.at(%text, %at, %marker) : (buffer, offset, buffer) -> (i1)
  func.call @chatml.check(%valid) : (i1)
  %size = buffer.length %marker
  %next = index.add %at, %size : offset
  func.return %next : offset
}

func.def @spark_parse.identifier(%text: buffer) {
  %zero64 = scalar.constant 0 : i64
  %length = buffer.length %text
  %n = index.cast %length : offset to i64
  func.call @tool_identifier(%text, %zero64, %n) : (buffer, i64, i64)
  func.return
}

func.def @spark_parse.convert(%response: buffer) -> (buffer) {

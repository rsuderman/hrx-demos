func.decl @chatml.admit_mapping(%json: buffer)

func.decl @chatml.default_system() -> (buffer, i1)

func.decl @chatml.emit_empty_system() -> (i1)

global.rodata.decl @chatml.end

global.rodata.decl @chatml.newline

func.decl @chatml.render_schemas(%tools: buffer, %compact: i1) -> (buffer)

global.rodata.decl @chatml.separator

func.decl @chatml.system_before_tools() -> (i1)

global.rodata.decl @chatml.system_open

func.decl @chatml.system_tools_separator(%has: i1, %has_text: i1) -> (buffer)

global.rodata.decl @chatml_input.empty

global.rodata.decl @loomify.text.tools_prefix

global.rodata.decl @loomify.text.tools_suffix

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)

// Copyright 2026 AMD ROCm Software
// SPDX-License-Identifier: MIT
func.def @chatml.render_system(%source_system: buffer, %source_has_system: i1, %instruction: buffer, %tools: buffer) -> (buffer) {
  %default_system, %has_default = func.call @chatml.default_system() : () -> (buffer, i1)
  %false = scalar.constant false : i1
  %missing_system = scalar.cmpi eq, %source_has_system, %false : i1
  %use_default = scalar.andi %missing_system, %has_default : i1
  %system = scf.select %use_default, %default_system, %source_system : buffer
  %has_system = scalar.ori %source_has_system, %use_default : i1
  %empty = global.load @chatml_input.empty : buffer
  %zero = index.constant 0 : offset
  %instruction_size = buffer.length %instruction
  %system_size = buffer.length %system
  %has_instruction = index.cmp ne, %instruction_size, %zero : offset
  %has_text = index.cmp ne, %system_size, %zero : offset
  %separator = global.load @chatml.separator : buffer
  %separate_instruction = scalar.andi %has_instruction, %has_text : i1
  %between = scf.select %separate_instruction, %separator, %empty : buffer
  %system_body = func.call @text.join8(%instruction, %between, %system, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.call @chatml.admit_mapping(%tools) : (buffer)
  %records, %kind, %count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %zero64 = scalar.constant 0 : i64
  %has_tools = scalar.cmpi ne, %count, %zero64 : i64
  %open = global.load @chatml.system_open : buffer
  %close = global.load @chatml.end : buffer
  %result = scf.if %has_tools -> (buffer) {
    %bounded = scalar.assume %count [range(%count, 1, 2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %first = index.constant 0 : index
    %one = index.constant 1 : index
    %fields = buffer.view %records[%zero] : buffer -> view<[%extent]x5xi64>
    %tool_prefix = global.load @loomify.text.tools_prefix : buffer
    %tool_suffix = global.load @loomify.text.tools_suffix : buffer
    %instruction_separator = scf.select %has_instruction, %separator, %empty : buffer
    %system_first = func.call @chatml.system_before_tools() : () -> (i1)
    %start = scf.if %system_first -> (buffer) {
      %sep = func.call @chatml.system_tools_separator(%has_system, %has_text) : (i1, i1) -> (buffer)
      %value = func.call @text.join8(%open, %system, %sep, %tool_prefix, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    } else {
      %value = func.call @text.join8(%open, %instruction, %instruction_separator, %tool_prefix, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    }
    %newline = global.load @chatml.newline : buffer
    %schemas = func.call @chatml.render_schemas(%tools, %false) : (buffer, i1) -> (buffer)
    %body = func.call @text.join8(%start, %schemas, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    %system_separator = scf.select %has_text, %separator, %empty : buffer
    %tail_system = scf.select %system_first, %empty, %system : buffer
    %tail_separator = scf.select %system_first, %empty, %system_separator : buffer
    %rendered = func.call @text.join8(%body, %tool_suffix, %tail_separator, %tail_system, %close, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %rendered : buffer
  } else {
    %emit_empty = func.call @chatml.emit_empty_system() : () -> (i1)
    %keep_empty = scalar.andi %has_system, %emit_empty : i1
    %with_text = scalar.ori %has_text, %has_instruction : i1
    %emit = scalar.ori %with_text, %keep_empty : i1
    %rendered = scf.if %emit -> (buffer) {
      %frame = func.call @text.join8(%open, %system_body, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %frame : buffer
    } else {
      scf.yield %empty : buffer
    }
    scf.yield %rendered : buffer
  }
  func.return %result : buffer
}

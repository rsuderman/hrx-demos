// Plain output preserves every byte, including literal thinking/tool markup.
func.decl @chatml.check(%condition: i1)
func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)
func.decl @loomify.tokens.terminal_marker() -> (buffer)
global.rodata.def @chatml_plain_output.empty = bytes("")
global.rodata.def @chatml_plain_output.assistant = bytes("3c7c696d5f73746172747c3e617373697374616e740a")
global.rodata.def @chatml_plain_output.newline = bytes("0a")
func.def @chatml.output_initial(%thinking: i1, %generation: i1) -> (i64) {
  %content = scalar.constant 1 : i64
  %no_header = scalar.constant 17 : i64
  %state = scf.select %generation, %content, %no_header : i64
  func.return %state : i64
}
func.def public @output_next(%response: buffer, %previous: i64, %state: i64, %phase: i32) -> (i64, i64, i64, i64) {
  %length = buffer.length %response
  %end = index.cast %length : offset to i64
  %valid = scalar.cmpi ule, %previous, %end : i64
  func.call @chatml.check(%valid) : (i1) -> ()
  %content = scalar.constant 1 : i64
  func.return %content, %previous, %end, %state : i64, i64, i64, i64
}
func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %zero = index.constant 0 : offset
  %reason_length = buffer.length %reasoning
  %tools_length = buffer.length %tools
  %no_reason = index.cmp eq, %reason_length, %zero : offset
  %no_tools = index.cmp eq, %tools_length, %zero : offset
  %valid = scalar.andi %no_reason, %no_tools : i1
  func.call @chatml.check(%valid) : (i1) -> ()
  %flag = scalar.constant 16 : i64
  %zero64 = scalar.constant 0 : i64
  %bits = scalar.andi %initial_state, %flag : i64
  %missing_header = scalar.cmpi ne, %bits, %zero64 : i64
  %empty = global.load @chatml_plain_output.empty : buffer
  %assistant = global.load @chatml_plain_output.assistant : buffer
  %header = scf.select %missing_header, %assistant, %empty : buffer
  %terminal = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
  %newline = global.load @chatml_plain_output.newline : buffer
  %result = func.call @text.join8(%prompt, %header, %content, %terminal, %newline, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %reusable = scalar.constant 0 : i32
  func.return %result, %reusable : buffer, i32
}

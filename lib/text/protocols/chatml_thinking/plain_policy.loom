// Selected plain ChatML framing: no synthetic system, reasoning or tools.
global.rodata.def @chatml_plain.empty = bytes("")
global.rodata.def @chatml_plain.array = bytes("5b5d")
global.rodata.def @chatml_plain.tools = bytes("746f6f6c73")
global.rodata.def @chatml_plain.calls = bytes("746f6f6c5f63616c6c73")
global.rodata.def @chatml_plain.reasoning = bytes("726561736f6e696e675f636f6e74656e74")
global.rodata.def @chatml_plain.reasoning_alias = bytes("726561736f6e696e67")
global.rodata.def @chatml_plain.effort = bytes("726561736f6e696e675f6566666f7274")
func.decl @chatml.check(%condition: i1)
// Each input is parsed independently before native merge. Definitions are
// supplied by the shared ChatML input member in this selected product.
global.rodata.decl @chatml.enable_thinking
global.rodata.decl @chatml.messages
global.rodata.decl @chatml.role
global.rodata.decl @chatml.content
global.rodata.decl @chatml.system
global.rodata.decl @chatml.user
global.rodata.decl @chatml.assistant
func.decl @chatml.boolean(%json: buffer, %key: buffer, %default: i1) -> (i1)
func.decl @text.lookup(%json: buffer, %key: buffer) -> (buffer, i64, i1)
func.decl @text.string(%json: buffer, %key: buffer) -> (buffer, i1)
func.decl @text.equal(%a: buffer, %b: buffer) -> (i1)
func.decl @text.range(%text: buffer, %begin: i64, %length: i64) -> (buffer)
func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

// Permit absent/null and empty native fields, but never discard actual data.
func.def @chatml_plain.empty_field(%json: buffer, %key: buffer) {
  %value, %kind, %found = func.call @text.lookup(%json, %key) : (buffer, buffer) -> (buffer, i64, i1)
  %false = scalar.constant false : i1
  %missing = scalar.cmpi eq, %found, %false : i1
  %null_kind = scalar.constant 6 : i64
  %null = scalar.cmpi eq, %kind, %null_kind : i64
  %absent = scalar.ori %missing, %null : i1
  scf.if %absent { } else {
    %string_kind = scalar.constant 0 : i64
    %array_kind = scalar.constant 3 : i64
    %string = scalar.cmpi eq, %kind, %string_kind : i64
    %array = scalar.cmpi eq, %kind, %array_kind : i64
    %accepted = scalar.ori %string, %array : i1
    func.call @chatml.check(%accepted) : (i1) -> ()
    %empty = scf.if %string -> (i1) {
      %text, %present = func.call @text.string(%json, %key) : (buffer, buffer) -> (buffer, i1)
      %length = buffer.length %text
      %zero = index.constant 0 : offset
      %result = index.cmp eq, %length, %zero : offset
      scf.yield %result : i1
    } else {
      %records, %type, %count = func.call @members(%value) : (buffer) -> (buffer, i32, i64)
      %zero = scalar.constant 0 : i64
      %result = scalar.cmpi eq, %count, %zero : i64
      scf.yield %result : i1
    }
    func.call @chatml.check(%empty) : (i1) -> ()
  }
  func.return
}
func.def @chatml.admit_request(%request: buffer) {
  %tools = global.load @chatml_plain.tools : buffer
  func.call @chatml_plain.empty_field(%request, %tools) : (buffer, buffer) -> ()
  %effort = global.load @chatml_plain.effort : buffer
  %effort_value, %effort_kind, %has_effort = func.call @text.lookup(%request, %effort) : (buffer, buffer) -> (buffer, i64, i1)
  %false = scalar.constant false : i1
  %no_effort = scalar.cmpi eq, %has_effort, %false : i1
  func.call @chatml.check(%no_effort) : (i1) -> ()
  %thinking_key = global.load @chatml.enable_thinking : buffer
  %thinking = func.call @chatml.boolean(%request, %thinking_key, %false) : (buffer, buffer, i1) -> (i1)
  %no_thinking = scalar.cmpi eq, %thinking, %false : i1
  func.call @chatml.check(%no_thinking) : (i1) -> ()
  %messages_key = global.load @chatml.messages : buffer
  %messages, %kind, %found = func.call @text.lookup(%request, %messages_key) : (buffer, buffer) -> (buffer, i64, i1)
  scf.if %found {
    %array_kind = scalar.constant 3 : i64
    %array = scalar.cmpi eq, %kind, %array_kind : i64
    func.call @chatml.check(%array) : (i1) -> ()
    %records, %type, %count = func.call @members(%messages) : (buffer) -> (buffer, i32, i64)
    %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %origin = index.constant 0 : offset
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
    %role_key = global.load @chatml.role : buffer
    %content_key = global.load @chatml.content : buffer
    %system = global.load @chatml.system : buffer
    %user = global.load @chatml.user : buffer
    %assistant = global.load @chatml.assistant : buffer
    %calls = global.load @chatml_plain.calls : buffer
    %reason = global.load @chatml_plain.reasoning : buffer
    %reason_alias = global.load @chatml_plain.reasoning_alias : buffer
    scf.for %i = [%zero to %extent step %one] {
      %begin = view.load %fields[%i, 2] : view<[%extent]x5xi64> -> i64
      %length = view.load %fields[%i, 3] : view<[%extent]x5xi64> -> i64
      %message = func.call @text.range(%messages, %begin, %length) : (buffer, i64, i64) -> (buffer)
      %role, %has_role = func.call @text.string(%message, %role_key) : (buffer, buffer) -> (buffer, i1)
      %content, %has_content = func.call @text.string(%message, %content_key) : (buffer, buffer) -> (buffer, i1)
      %is_system = func.call @text.equal(%role, %system) : (buffer, buffer) -> (i1)
      %is_user = func.call @text.equal(%role, %user) : (buffer, buffer) -> (i1)
      %is_assistant = func.call @text.equal(%role, %assistant) : (buffer, buffer) -> (i1)
      %ordinary = scalar.ori %is_system, %is_user : i1
      %known = scalar.ori %ordinary, %is_assistant : i1
      %typed = scalar.andi %has_role, %has_content : i1
      %valid = scalar.andi %known, %typed : i1
      func.call @chatml.check(%valid) : (i1) -> ()
      func.call @chatml_plain.empty_field(%message, %calls) : (buffer, buffer) -> ()
      func.call @chatml_plain.empty_field(%message, %reason) : (buffer, buffer) -> ()
      func.call @chatml_plain.empty_field(%message, %reason_alias) : (buffer, buffer) -> ()
      scf.yield
    }
  }
  func.return
}
func.def pure inline @chatml.default_thinking() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.supports_thinking() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.keep_reasoning_default() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.inline_reasoning() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.emit_empty_system() -> (i1) { %v = scalar.constant true : i1 func.return %v : i1 }
func.def pure inline @chatml.has_effort() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.allow_later_system() -> (i1) { %v = scalar.constant true : i1 func.return %v : i1 }
func.def pure inline @chatml.system_before_tools() -> (i1) { %v = scalar.constant true : i1 func.return %v : i1 }
func.def pure inline @chatml.require_user() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.first_tool_header() -> (i1) { %v = scalar.constant true : i1 func.return %v : i1 }
func.def inline @chatml.normalize_content(%text: buffer) -> (buffer) { func.return %text : buffer }
func.def inline @chatml.normalize_reason(%text: buffer) -> (buffer) { func.return %text : buffer }
func.def inline @chatml.retained_body(%text: buffer) -> (buffer) { func.return %text : buffer }
func.def inline @chatml.history_calls(%raw: buffer, %rendered: buffer) -> (buffer) { %v = global.load @chatml_plain.empty : buffer func.return %v : buffer }
func.def inline @chatml.call_separator() -> (buffer) { %v = global.load @chatml_plain.empty : buffer func.return %v : buffer }
func.def inline @chatml.generation_thought(%thinking: i1) -> (buffer) { %v = global.load @chatml_plain.empty : buffer func.return %v : buffer }
func.def pure inline @chatml.history_state(%last_user: i64, %count: i64) -> (i64) { %v = scalar.constant 0 : i64 func.return %v : i64 }
func.def pure inline @chatml.history_thought(%state: i64, %ordinal: i64, %reason: buffer) -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def inline @chatml.default_system() -> (buffer, i1) { %v = global.load @chatml_plain.empty : buffer %p = scalar.constant false : i1 func.return %v, %p : buffer, i1 }
func.def inline @chatml.system_tools_separator(%has_system: i1) -> (buffer) { %v = global.load @chatml_plain.empty : buffer func.return %v : buffer }
func.def public @render_tool(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %false = scalar.constant false : i1
  func.call @chatml.check(%false) : (i1) -> ()
  %empty = global.load @chatml_plain.empty : buffer
  %zero = scalar.constant 0 : i64
  func.return %empty, %zero : buffer, i64
}
func.def public @parse_tools(%schemas: buffer, %response: buffer, %truncated: i64) -> (buffer) {
  %records, %kind, %count = func.call @members(%schemas) : (buffer) -> (buffer, i32, i64)
  %zero = scalar.constant 0 : i64
  %empty = scalar.cmpi eq, %count, %zero : i64
  func.call @chatml.check(%empty) : (i1) -> ()
  %result = global.load @chatml_plain.array : buffer
  func.return %result : buffer
}

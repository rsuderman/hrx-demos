// Shared source-order schema traversal. Selected protocols own wrapper policy.
func.decl @chatml.admit_mapping(%json: buffer)

func.decl @chatml.schema_value(%tool: buffer) -> (buffer)

func.decl @text.range(%json: buffer, %begin: i64, %length: i64) -> (buffer)

func.decl @text.json_dump(%json: buffer) -> (buffer)

func.decl @text.json_dump_compact(%json: buffer) -> (buffer)

func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

global.rodata.def @chatml_schemas.empty = bytes("")

global.rodata.def @chatml_schemas.newline = bytes("0a")

func.def @chatml.render_schemas(%tools: buffer, %compact: i1) -> (buffer) {
  func.call @chatml.admit_mapping(%tools) : (buffer)
  %records, %kind, %count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
  %empty = global.load @chatml_schemas.empty : buffer
  %newline = global.load @chatml_schemas.newline : buffer
  %body = scf.for %i = [%zero to %extent step %one](%prior = %empty : buffer) -> (buffer) {
    %begin = view.load %fields[%i, 2] : view<[%extent]x5xi64> -> i64
    %length = view.load %fields[%i, 3] : view<[%extent]x5xi64> -> i64
    %value = func.call @text.range(%tools, %begin, %length) : (buffer, i64, i64) -> (buffer)
    %schema = func.call @chatml.schema_value(%value) : (buffer) -> (buffer)
    %formatted = scf.if %compact -> (buffer) {
      %v = func.call @text.json_dump_compact(%schema) : (buffer) -> (buffer)
      scf.yield %v : buffer
    } else {
      %v = func.call @text.json_dump(%schema) : (buffer) -> (buffer)
      scf.yield %v : buffer
    }
    %next = func.call @text.join8(%prior, %newline, %formatted, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %next : buffer
  }
  func.return %body : buffer
}

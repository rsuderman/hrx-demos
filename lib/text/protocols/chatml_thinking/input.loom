// Host chat messages support null/string/text-parts content. This same bounded
// operation is used during the last-real-user scan, so history never disagrees
// with the text supplied to chat_message by Serve.
func.def @chatml.content_text(%message: buffer) -> (buffer) {
  %key = global.load @chatml.content : buffer
  %raw, %kind, %found = func.call @text.lookup(%message, %key) : (buffer, buffer) -> (buffer, i64, i1)
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 3 : i64
  %five64 = scalar.constant 6 : i64
  %empty = global.load @chatml_input.empty : buffer
  %string = scalar.cmpi eq, %kind, %zero64 : i64
  %array = scalar.cmpi eq, %kind, %one64 : i64
  %null = scalar.cmpi eq, %kind, %five64 : i64
  %false = scalar.constant false : i1
  %missing = scalar.cmpi eq, %found, %false : i1
  %a = scalar.ori %string, %array : i1
  %b = scalar.ori %null, %missing : i1
  %valid = scalar.ori %a, %b : i1
  func.call @chatml.check(%valid) : (i1) -> ()
  %text = scf.if %string -> (buffer) {
    %bytes = buffer.length %raw
    %length = index.cast %bytes : offset to i64
    %decoded = func.call @text.decode(%raw, %zero64, %length) : (buffer, i64, i64) -> (buffer)
    scf.yield %decoded : buffer
  } else {
    %text = scf.if %array -> (buffer) {
      %records, %type, %count = func.call @members(%raw) : (buffer) -> (buffer, i32, i64)
      %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
      %extent = index.cast %bounded : i64 to index
      %origin = index.constant 0 : offset
      %zero = index.constant 0 : index
      %one = index.constant 1 : index
      %parts = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
      %joined = scf.for %i = [%zero to %extent step %one](%prior = %empty : buffer) -> (buffer) {
        %begin = view.load %parts[%i,2] : view<[%extent]x5xi64> -> i64
        %length = view.load %parts[%i,3] : view<[%extent]x5xi64> -> i64
        %part = func.call @text.range(%raw, %begin, %length) : (buffer, i64, i64) -> (buffer)
        %text_key = global.load @chatml.text : buffer
        %body, %present = func.call @text.string(%part, %text_key) : (buffer, buffer) -> (buffer, i1)
        func.call @chatml.check(%present) : (i1) -> ()
        %type_key = global.load @chatml.type : buffer
        %part_type, %typed = func.call @text.string(%part, %type_key) : (buffer, buffer) -> (buffer, i1)
        %is_text = func.call @text.equal(%part_type, %text_key) : (buffer, buffer) -> (i1)
        %not_typed = scalar.cmpi eq, %typed, %false : i1
        %valid_part = scalar.ori %is_text, %not_typed : i1
        func.call @chatml.check(%valid_part) : (i1) -> ()
        %next = func.call @text.join8(%prior,%body,%empty,%empty,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
        scf.yield %next : buffer
      }
      scf.yield %joined : buffer
    } else { scf.yield %empty : buffer }
    scf.yield %text : buffer
  }
  %trimmed = func.call @text.trim(%text) : (buffer) -> (buffer)
  func.return %trimmed : buffer
}

// Typed booleans preserve absent defaults and reject null/numeric aliases.
func.def @chatml.boolean(%json: buffer, %key: buffer, %default: i1) -> (i1) {
  %value, %kind, %found = func.call @text.lookup(%json, %key) : (buffer, buffer) -> (buffer,i64,i1)
  %three = scalar.constant 5 : i64
  %four = scalar.constant 4 : i64
  %yes = scalar.cmpi eq, %kind, %four : i64
  %no = scalar.cmpi eq, %kind, %three : i64
  %boolean = scalar.ori %yes, %no : i1
  %false = scalar.constant false : i1
  %absent = scalar.cmpi eq, %found, %false : i1
  %valid = scalar.ori %absent, %boolean : i1
  func.call @chatml.check(%valid) : (i1) -> ()
  %result = scf.select %found, %yes, %default : i1
  func.return %result : i1
}

// Source-private rendering state: low2 previous role, bit4 thinking,
// bit5 preserve_thinking, bit6 generation prompt; last real user at bit8+.
func.def @chatml.options(%request: buffer) -> (i1, i1, i1, buffer) {
  %zero64 = scalar.constant 0 : i64
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %empty = global.load @chatml_input.empty : buffer
  %thinking_key = global.load @chatml.enable_thinking : buffer
  %default_thinking = func.call @chatml.default_thinking() : () -> (i1)
  %thinking = func.call @chatml.boolean(%request, %thinking_key, %default_thinking) : (buffer,buffer,i1) -> (i1)
  %options_key = global.load @chatml.model_options : buffer
  %options, %options_kind, %has_options = func.call @text.lookup(%request, %options_key) : (buffer,buffer) -> (buffer,i64,i1)
  %default_preserve = func.call @chatml.keep_reasoning_default() : () -> (i1)
  %preserve, %generation, %effort = scf.if %has_options -> (i1,i1,buffer) {
    %two64 = scalar.constant 2 : i64
    %object = scalar.cmpi eq, %options_kind, %two64 : i64
    func.call @chatml.check(%object) : (i1) -> ()
    %records, %kind, %count = func.call @members(%options) : (buffer) -> (buffer,i32,i64)
    %bounded = scalar.assume %count [range(%count,0,2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
    %preserve_key = global.load @chatml.preserve_thinking : buffer
    %generation_key = global.load @chatml.add_generation_prompt : buffer
    %effort_key = global.load @chatml.reasoning_effort : buffer
    %supports_effort = func.call @chatml.has_effort() : () -> (i1)
    scf.for %i = [%zero to %extent step %one] {
      %begin = view.load %fields[%i,0] : view<[%extent]x5xi64> -> i64
      %length = view.load %fields[%i,1] : view<[%extent]x5xi64> -> i64
      %key = func.call @text.decode(%options,%begin,%length) : (buffer,i64,i64) -> (buffer)
      %is_preserve = func.call @text.equal(%key,%preserve_key) : (buffer,buffer) -> (i1)
      %is_generation = func.call @text.equal(%key,%generation_key) : (buffer,buffer) -> (i1)
      %is_effort = func.call @text.equal(%key,%effort_key) : (buffer,buffer) -> (i1)
      %specific = scalar.ori %is_preserve,%is_effort : i1
      %accepted_specific = scalar.andi %specific,%supports_effort : i1
      %accepted = scalar.ori %accepted_specific,%is_generation : i1
      func.call @chatml.check(%accepted) : (i1) -> ()
      scf.yield
    }
    %keep = func.call @chatml.boolean(%options,%preserve_key,%default_preserve) : (buffer,buffer,i1) -> (i1)
    %generate = func.call @chatml.boolean(%options,%generation_key,%true) : (buffer,buffer,i1) -> (i1)
    %requested, %effort_string = func.call @text.string(%options,%effort_key) : (buffer,buffer) -> (buffer,i1)
    %effort_raw, %effort_kind, %effort_present = func.call @text.lookup(%options,%effort_key) : (buffer,buffer) -> (buffer,i64,i1)
    %absent = scalar.cmpi eq,%effort_present,%false : i1
    %valid_type = scalar.ori %absent,%effort_string : i1
    func.call @chatml.check(%valid_type) : (i1) -> ()
    %xhigh = global.load @loomify.text.default_effort : buffer
    %resolved = scf.select %effort_present,%requested,%xhigh : buffer
    scf.yield %keep,%generate,%resolved : i1,i1,buffer
  } else {
    %xhigh = global.load @loomify.text.default_effort : buffer
    scf.yield %default_preserve,%true,%xhigh : i1,i1,buffer
  }
  %has_effort = func.call @chatml.has_effort() : () -> (i1)
  %uses_effort = scalar.andi %thinking,%has_effort : i1
  %instruction = scf.if %uses_effort -> (buffer) {
    %low_key = global.load @chatml.low : buffer
    %medium_key = global.load @chatml.medium : buffer
    %xhigh_key = global.load @chatml.xhigh : buffer
    %low = func.call @text.equal(%effort,%low_key) : (buffer,buffer) -> (i1)
    %medium = func.call @text.equal(%effort,%medium_key) : (buffer,buffer) -> (i1)
    %xhigh = func.call @text.equal(%effort,%xhigh_key) : (buffer,buffer) -> (i1)
    %a = scalar.ori %low,%medium : i1
    %valid = scalar.ori %a,%xhigh : i1
    func.call @chatml.check(%valid) : (i1) -> ()
    %low_text = global.load @loomify.text.effort_low : buffer
    %high_text = global.load @loomify.text.effort_xhigh : buffer
    %high_or_empty = scf.select %xhigh,%high_text,%empty : buffer
    %text = scf.select %low,%low_text,%high_or_empty : buffer
    scf.yield %text : buffer
  } else { scf.yield %empty : buffer }
  func.return %thinking,%preserve,%generation,%instruction : i1,i1,i1,buffer
}

func.def @chatml.wrapped_response(%text: buffer) -> (i1) {
  %zero = index.constant 0 : offset
  %start = global.load @chatml.response_start : buffer
  %end = global.load @chatml.response_end : buffer
  %prefix = func.call @text.at(%text,%zero,%start) : (buffer,offset,buffer) -> (i1)
  %size = buffer.length %text
  %suffix_size = buffer.length %end
  %fits = index.cmp uge,%size,%suffix_size : offset
  %suffix = scf.if %fits -> (i1) {
    %position = index.sub %size,%suffix_size : offset
    %matches = func.call @text.at(%text,%position,%end) : (buffer,offset,buffer) -> (i1)
    scf.yield %matches : i1
  } else { %false = scalar.constant false : i1 scf.yield %false : i1 }
  %result = scalar.andi %prefix,%suffix : i1
  func.return %result : i1
}

// Scan full history once to retain/drop assistant reasoning against the same
// last-real-user boundary as the selected template. A wrapped tool response
// in a user message is deliberately not a new user query.
func.def @chatml.scan(%request: buffer) -> (i64, buffer, i1) {
  %messages_key = global.load @chatml.messages : buffer
  %messages,%kind,%found = func.call @text.lookup(%request,%messages_key) : (buffer,buffer) -> (buffer,i64,i1)
  %three64 = scalar.constant 3 : i64
  %array = scalar.cmpi eq,%kind,%three64 : i64
  %valid = scalar.andi %found,%array : i1
  func.call @chatml.check(%valid) : (i1) -> ()
  %records,%type,%count = func.call @members(%messages) : (buffer) -> (buffer,i32,i64)
  %zero64 = scalar.constant 0 : i64
  %nonempty = scalar.cmpi sgt,%count,%zero64 : i64
  func.call @chatml.check(%nonempty) : (i1) -> ()
  %bounded = scalar.assume %count [range(%count,1,2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %empty = global.load @chatml_input.empty : buffer
  %role_key = global.load @chatml.role : buffer
  %user_role = global.load @chatml.user : buffer
  %system_role = global.load @chatml.system : buffer
  %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
  %last,%seen,%system,%has_system = scf.for %i = [%zero to %extent step %one](%prior = %zero64 : i64,%seen_user = %false : i1,%prior_system = %empty : buffer,%prior_has_system = %false : i1) -> (i64,i1,buffer,i1) {
    %begin = view.load %fields[%i,2] : view<[%extent]x5xi64> -> i64
    %length = view.load %fields[%i,3] : view<[%extent]x5xi64> -> i64
    %message = func.call @text.range(%messages,%begin,%length) : (buffer,i64,i64) -> (buffer)
    %role,%has_role = func.call @text.string(%message,%role_key) : (buffer,buffer) -> (buffer,i1)
    func.call @chatml.check(%has_role) : (i1) -> ()
    %user = func.call @text.equal(%role,%user_role) : (buffer,buffer) -> (i1)
    %is_system = func.call @text.equal(%role,%system_role) : (buffer,buffer) -> (i1)
    %text = func.call @chatml.content_text(%message) : (buffer) -> (buffer)
    %wrapped = func.call @chatml.wrapped_response(%text) : (buffer) -> (i1)
    %ordinary = scalar.cmpi eq,%wrapped,%false : i1
    %real_user = scalar.andi %user,%ordinary : i1
    %ordinal = index.cast %i : index to i64
    %new_last = scf.select %real_user,%ordinal,%prior : i64
    %new_seen = scalar.ori %seen_user,%real_user : i1
    %first = index.cmp eq,%i,%zero : index
    %first_system = scalar.andi %first,%is_system : i1
    %not_system = scalar.cmpi eq,%is_system,%false : i1
    %system_order = scalar.ori %first,%not_system : i1
    func.call @chatml.check(%system_order) : (i1) -> ()
    %new_system = scf.select %first_system,%text,%prior_system : buffer
    %new_has_system = scalar.ori %prior_has_system,%first_system : i1
    scf.yield %new_last,%new_seen,%new_system,%new_has_system : i64,i1,buffer,i1
  }
  func.call @chatml.check(%seen) : (i1) -> ()
  func.return %last,%system,%has_system : i64,buffer,i1
}

global.rodata.decl @loomify.text.tools_prefix

global.rodata.decl @loomify.text.tools_suffix

func.decl @text.json_dump(%json: buffer) -> (buffer)
func.decl @chatml.admit_mapping(%json: buffer)

func.def public @chat_begin(%request: buffer,%tools: buffer) -> (buffer,i64) {
  %thinking,%preserve,%generation,%instruction = func.call @chatml.options(%request) : (buffer) -> (i1,i1,i1,buffer)
  %last,%system,%has_system = func.call @chatml.scan(%request) : (buffer) -> (i64,buffer,i1)
  %empty = global.load @chatml_input.empty : buffer
  %zero = index.constant 0 : offset
  %instruction_size = buffer.length %instruction
  %system_size = buffer.length %system
  %has_instruction = index.cmp ne,%instruction_size,%zero : offset
  %has_text = index.cmp ne,%system_size,%zero : offset
  %separator = global.load @chatml.separator : buffer
  %separate_instruction = scalar.andi %has_instruction,%has_text : i1
  %between = scf.select %separate_instruction,%separator,%empty : buffer
  %system_body = func.call @text.join8(%instruction,%between,%system,%empty,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
  func.call @chatml.admit_mapping(%tools) : (buffer) -> ()
  %records,%kind,%count = func.call @members(%tools) : (buffer) -> (buffer,i32,i64)
  %zero64 = scalar.constant 0 : i64
  %has_tools = scalar.cmpi ne,%count,%zero64 : i64
  %open = global.load @chatml.system_open : buffer
  %close = global.load @chatml.end : buffer
  %result = scf.if %has_tools -> (buffer) {
    %bounded = scalar.assume %count [range(%count,1,2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %first = index.constant 0 : index
    %one = index.constant 1 : index
    %fields = buffer.view %records[%zero] : buffer -> view<[%extent]x5xi64>
    %tool_prefix = global.load @loomify.text.tools_prefix : buffer
    %tool_suffix = global.load @loomify.text.tools_suffix : buffer
    %instruction_separator = scf.select %has_instruction,%separator,%empty : buffer
    %start = func.call @text.join8(%open,%instruction,%instruction_separator,%tool_prefix,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
    %newline = global.load @chatml.newline : buffer
    %body = scf.for %i = [%first to %extent step %one](%prior = %start : buffer) -> (buffer) {
      %begin = view.load %fields[%i,2] : view<[%extent]x5xi64> -> i64
      %length = view.load %fields[%i,3] : view<[%extent]x5xi64> -> i64
      %value = func.call @text.range(%tools,%begin,%length) : (buffer,i64,i64) -> (buffer)
      %formatted = func.call @text.json_dump(%value) : (buffer) -> (buffer)
      %next = func.call @text.join8(%prior,%newline,%formatted,%empty,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
      scf.yield %next : buffer
    }
    %system_separator = scf.select %has_text,%separator,%empty : buffer
    %rendered = func.call @text.join8(%body,%tool_suffix,%system_separator,%system,%close,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
    scf.yield %rendered : buffer
  } else {
    %emit_empty = func.call @chatml.emit_empty_system() : () -> (i1)
    %keep_empty = scalar.andi %has_system,%emit_empty : i1
    %with_text = scalar.ori %has_text,%has_instruction : i1
    %emit = scalar.ori %with_text,%keep_empty : i1
    %rendered = scf.if %emit -> (buffer) {
      %frame = func.call @text.join8(%open,%system_body,%close,%empty,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
      scf.yield %frame : buffer
    } else { scf.yield %empty : buffer }
    scf.yield %rendered : buffer
  }
  %sixteen = scalar.constant 16 : i64
  %thirty_two = scalar.constant 32 : i64
  %sixty_four = scalar.constant 64 : i64
  %eight = scalar.constant 8 : i64
  %thinking_bit = scf.select %thinking,%sixteen,%zero64 : i64
  %preserve_bit = scf.select %preserve,%thirty_two,%zero64 : i64
  %generation_bit = scf.select %generation,%sixty_four,%zero64 : i64
  %last_bits = scalar.shli %last,%eight : i64
  %a = scalar.ori %thinking_bit,%preserve_bit : i64
  %b = scalar.ori %a,%generation_bit : i64
  %state = scalar.ori %b,%last_bits : i64
  func.return %result,%state : buffer,i64
}

func.def public @chat_end(%state: i64) -> (buffer,i64) {
  %zero64 = scalar.constant 0 : i64
  %three = scalar.constant 3 : i64
  %sixteen = scalar.constant 16 : i64
  %sixty_four = scalar.constant 64 : i64
  %prior_role = scalar.andi %state,%three : i64
  %tool = scalar.cmpi eq,%prior_role,%three : i64
  %thinking_bit = scalar.andi %state,%sixteen : i64
  %generation_bit = scalar.andi %state,%sixty_four : i64
  %thinking = scalar.cmpi ne,%thinking_bit,%zero64 : i64
  %generation = scalar.cmpi ne,%generation_bit,%zero64 : i64
  %empty = global.load @chatml_input.empty : buffer
  %close = global.load @chatml.end : buffer
  %before = scf.select %tool,%close,%empty : buffer
  %suffix = scf.if %generation -> (buffer) {
    %header = global.load @chatml.assistant_open : buffer
    %open = global.load @chatml.think_open : buffer
    %completed = global.load @chatml.empty_think : buffer
    %thought = scf.select %thinking,%open,%completed : buffer

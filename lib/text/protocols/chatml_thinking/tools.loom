global.rodata.def @tool_open = bytes("3c746f6f6c5f63616c6c3e0a3c66756e6374696f6e3d")
global.rodata.def @tag_end = bytes("3e0a")
global.rodata.def @parameter_open = bytes("3c706172616d657465723d")
global.rodata.def @parameter_end = bytes("0a3c2f706172616d657465723e0a")
global.rodata.def @tool_close = bytes("3c2f66756e6374696f6e3e0a3c2f746f6f6c5f63616c6c3e")
global.rodata.def @tool_identifier_error = bytes("746f6f6c206e616d6573206d757374206265206c69746572616c204153434949206964656e74696669657273206f66203120746f20313238206279746573")
global.rodata.def @tool_object_error = bytes("746f6f6c20617267756d656e7473206d757374206265206f6e65204a534f4e206f626a656374")
global.rodata.def @tool_size_error = bytes("746f6f6c20617267756d656e74732065786365656420666f726d617474696e67206361706163697479")
global.rodata.def @chatml.python_true = bytes("54727565")
global.rodata.def @chatml.python_false = bytes("46616c7365")
global.rodata.def @chatml.python_none = bytes("4e6f6e65")
global.rodata.def @chatml_tools.empty = bytes("")
global.rodata.def @chatml_tools.newline = bytes("0a")
func.decl import("json") @members(%json: buffer) -> (buffer,i32,i64)
func.decl import("input") @require(%condition: i32,%diagnostic: buffer)
func.decl @text.equal(%a: buffer,%b: buffer) -> (i1)
func.decl @text.decode(%json: buffer,%begin: i64,%length: i64) -> (buffer)
func.decl @text.range(%text: buffer,%begin: i64,%length: i64) -> (buffer)
func.decl @text.join8(%a: buffer,%b: buffer,%c: buffer,%d: buffer,%e: buffer,%f: buffer,%g: buffer,%h: buffer) -> (buffer)
global.rodata.def @chatml.mapping_error = bytes("746f6f6c206d617070696e6773207265717569726520737472696374204a534f4e207769746820756e69717565206f626a656374206b657973")
func.def @chatml.mapping_check(%condition: i1) {
  %diagnostic = global.load @chatml.mapping_error : buffer
  %flag = scalar.extui %condition : i1 to i32
  func.call @require(%flag,%diagnostic) : (i32,buffer) -> ()
  func.return
}
func.decl @chatml.inline_reasoning() -> (i1)
func.decl @text.json_dump(%json: buffer) -> (buffer)
func.def @tool_identifier(%text: buffer, %begin: i64, %length: i64) {
  %zero64 = scalar.constant 0 : i64
  %limit = scalar.constant 128 : i64
  %nonempty = scalar.cmpi ugt, %length, %zero64 : i64
  %bounded = scalar.cmpi ule, %length, %limit : i64
  %valid_length = scalar.andi %nonempty, %bounded : i1
  %valid_length32 = scalar.extui %valid_length : i1 to i32
  %diagnostic = global.load @tool_identifier_error : buffer
  func.call @require(%valid_length32, %diagnostic) : (i32, buffer) -> ()
  %count_value = scalar.assume %length [range(%length, 1, 128)] : i64
  %count = index.cast %count_value : i64 to index
  // begin is zero or an offset produced by json.members for this buffer.
  %begin_value = scalar.assume %begin [range(%begin, 0, 9223372036854775807)] : i64
  %start = index.cast %begin_value : i64 to offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %true = scalar.constant 1 : i1
  %case_bit = scalar.constant 32 : i32
  %a = scalar.constant 97 : i32
  %z = scalar.constant 122 : i32
  %digit_zero = scalar.constant 48 : i32
  %digit_nine = scalar.constant 57 : i32
  %underscore = scalar.constant 95 : i32
  %dash = scalar.constant 45 : i32
  %dot = scalar.constant 46 : i32
  %valid = scf.for %i = [%zero to %count step %one](%prior = %true : i1) -> (i1) {
    %relative = index.cast %i : index to offset
    %offset = index.add %start, %relative : offset
    %byte = buffer.load.i8.u %text[%offset]
    %lower = scalar.ori %byte, %case_bit : i32
    %after_a = scalar.cmpi uge, %lower, %a : i32
    %before_z = scalar.cmpi ule, %lower, %z : i32
    %letter = scalar.andi %after_a, %before_z : i1
    %after_zero = scalar.cmpi uge, %byte, %digit_zero : i32
    %before_nine = scalar.cmpi ule, %byte, %digit_nine : i32
    %digit = scalar.andi %after_zero, %before_nine : i1
    %under = scalar.cmpi eq, %byte, %underscore : i32
    %hyphen = scalar.cmpi eq, %byte, %dash : i32
    %period = scalar.cmpi eq, %byte, %dot : i32
    %punctuation_a = scalar.ori %under, %hyphen : i1
    %punctuation = scalar.ori %punctuation_a, %period : i1
    %alphanumeric = scalar.ori %letter, %digit : i1
    %allowed = scalar.ori %alphanumeric, %punctuation : i1
    %next = scalar.andi %prior, %allowed : i1
    scf.yield %next : i1
  }
  %valid32 = scalar.extui %valid : i1 to i32
  func.call @require(%valid32, %diagnostic) : (i32, buffer) -> ()
  func.return
}

// Object/array traversal uses the native parser. This is admission for the
// mapping domain presented to a template, not a replacement JSON parser.
func.def @chatml.admit_mapping(%json: buffer) {
  func.call @chatml.strict_json(%json) : (buffer) -> ()
  %fields,%kind,%count = func.call @members(%json) : (buffer) -> (buffer,i32,i64)
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %object = scalar.cmpi eq,%kind,%two : i32
  %array = scalar.cmpi eq,%kind,%three : i32
  %container = scalar.ori %object,%array : i1
  scf.if %container {
    %origin = index.constant 0 : offset
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %bounded = scalar.assume %count [range(%count,0,2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
    scf.for %i = [%zero to %extent step %one] {
      scf.if %object {
        %kb = view.load %records[%i,0] : view<[%extent]x5xi64> -> i64
        %kl = view.load %records[%i,1] : view<[%extent]x5xi64> -> i64
        %key = func.call @text.decode(%json,%kb,%kl) : (buffer,i64,i64) -> (buffer)
        scf.for %j = [%zero to %extent step %one] {
          %earlier = index.cmp ult,%j,%i : index
          scf.if %earlier {
            %pb = view.load %records[%j,0] : view<[%extent]x5xi64> -> i64
            %pl = view.load %records[%j,1] : view<[%extent]x5xi64> -> i64
            %prior = func.call @text.decode(%json,%pb,%pl) : (buffer,i64,i64) -> (buffer)
            %same = func.call @text.equal(%key,%prior) : (buffer,buffer) -> (i1)
            %false = scalar.constant false : i1
            %unique = scalar.cmpi eq,%same,%false : i1
            func.call @chatml.mapping_check(%unique) : (i1) -> ()
            scf.yield
          }
          scf.yield
        }
        scf.yield
      }
      %vb = view.load %records[%i,2] : view<[%extent]x5xi64> -> i64
      %vl = view.load %records[%i,3] : view<[%extent]x5xi64> -> i64
      %vk = view.load %records[%i,4] : view<[%extent]x5xi64> -> i64
      %two64 = scalar.constant 2 : i64
      %three64 = scalar.constant 3 : i64
      %is_object = scalar.cmpi eq,%vk,%two64 : i64
      %is_array = scalar.cmpi eq,%vk,%three64 : i64
      %nested = scalar.ori %is_object,%is_array : i1
      scf.if %nested {
        %value = func.call @text.range(%json,%vb,%vl) : (buffer,i64,i64) -> (buffer)
        func.call @chatml.admit_mapping(%value) : (buffer) -> ()
        scf.yield
      }
      scf.yield
    }
    scf.yield
  }
  func.return
}

func.def public @render_tool(%name: buffer,%arguments: buffer,%ordinal: i64) -> (buffer,i64) {
  %zero64 = scalar.constant 0 : i64
  %name_size = buffer.length %name
  %name_length = index.cast %name_size : offset to i64
  func.call @tool_identifier(%name,%zero64,%name_length) : (buffer,i64,i64) -> ()
  func.call @chatml.admit_mapping(%arguments) : (buffer) -> ()
  %records,%type,%count = func.call @members(%arguments) : (buffer) -> (buffer,i32,i64)
  %two32 = scalar.constant 2 : i32
  %object = scalar.cmpi eq,%type,%two32 : i32
  func.call @chatml.mapping_check(%object) : (i1) -> ()
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %bounded = scalar.assume %count [range(%count,0,2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
  %empty = global.load @chatml_tools.empty : buffer
  %newline = global.load @chatml_tools.newline : buffer
  %prior = scalar.cmpi ne,%ordinal,%zero64 : i64
  %before = scf.select %prior,%newline,%empty : buffer
  %prefix = global.load @tool_open : buffer
  %tag = global.load @tag_end : buffer
  %start = func.call @text.join8(%before,%prefix,%name,%tag,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
  %body = scf.for %i = [%zero to %extent step %one](%prior_body = %start : buffer) -> (buffer) {
    %kb = view.load %fields[%i,0] : view<[%extent]x5xi64> -> i64
    %kl = view.load %fields[%i,1] : view<[%extent]x5xi64> -> i64
    %key = func.call @text.decode(%arguments,%kb,%kl) : (buffer,i64,i64) -> (buffer)
    %ks = buffer.length %key
    %key_length = index.cast %ks : offset to i64
    func.call @tool_identifier(%key,%zero64,%key_length) : (buffer,i64,i64) -> ()
    %vb = view.load %fields[%i,2] : view<[%extent]x5xi64> -> i64
    %vl = view.load %fields[%i,3] : view<[%extent]x5xi64> -> i64
    %vk = view.load %fields[%i,4] : view<[%extent]x5xi64> -> i64
    %string = scalar.cmpi eq,%vk,%zero64 : i64
    %value = scf.if %string -> (buffer) {
      %decoded = func.call @text.decode(%arguments,%vb,%vl) : (buffer,i64,i64) -> (buffer)
      scf.yield %decoded : buffer
    } else {
      %raw = func.call @text.range(%arguments,%vb,%vl) : (buffer,i64,i64) -> (buffer)
      %old_revision = func.call @chatml.inline_reasoning() : () -> (i1)
      %four64 = scalar.constant 4 : i64
      %five64 = scalar.constant 5 : i64
      %six64 = scalar.constant 6 : i64
      %is_true = scalar.cmpi eq,%vk,%four64 : i64
      %is_false = scalar.cmpi eq,%vk,%five64 : i64
      %is_null = scalar.cmpi eq,%vk,%six64 : i64
      %bool_kind = scalar.ori %is_true,%is_false : i1
      %python_kind = scalar.ori %bool_kind,%is_null : i1
      %python = scalar.andi %old_revision,%python_kind : i1
      %formatted = scf.if %python -> (buffer) {
        %yes = global.load @chatml.python_true : buffer
        %no = global.load @chatml.python_false : buffer
        %none = global.load @chatml.python_none : buffer
        %boolean = scf.select %is_true,%yes,%no : buffer
        %result = scf.select %is_null,%none,%boolean : buffer
        scf.yield %result : buffer
      } else {
        %json = func.call @text.json_dump(%raw) : (buffer) -> (buffer)
        scf.yield %json : buffer
      }
      scf.yield %formatted : buffer
    }
    %open = global.load @parameter_open : buffer
    %end = global.load @parameter_end : buffer
    %next = func.call @text.join8(%prior_body,%open,%key,%tag,%value,%end,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
    scf.yield %next : buffer
  }
  %close = global.load @tool_close : buffer
  %result = func.call @text.join8(%body,%close,%empty,%empty,%empty,%empty,%empty,%empty) : (buffer,buffer,buffer,buffer,buffer,buffer,buffer,buffer) -> (buffer)
  %size = buffer.length %result
  %length = index.cast %size : offset to i64
  func.return %result,%length : buffer,i64
}

func.decl import("tools") @parse_xml(%schemas: buffer,%response: buffer) -> (buffer)
func.decl @chatml.normalize_tool_output(%schemas: buffer,%response: buffer) -> (buffer)
func.def public @parse_tools(%schemas: buffer,%response: buffer) -> (buffer) {
  %legacy = func.call @chatml.inline_reasoning() : () -> (i1)
  %normalized = scf.if %legacy -> (buffer) {
    %text = func.call @chatml.normalize_tool_output(%schemas,%response) : (buffer,buffer) -> (buffer)
    scf.yield %text : buffer
  } else { scf.yield %response : buffer }
  %calls = func.call @parse_xml(%schemas,%normalized) : (buffer,buffer) -> (buffer)
  func.return %calls : buffer
}

// Native members accepts JSONC. The supported template mapping domain is
// strict JSON: reject comment delimiters and trailing commas outside strings.
// Structural validity and escape validity remain the native parser's job.
func.def @chatml.strict_json(%json: buffer) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %size = buffer.length %json
  %false = scalar.constant false : i1
  %zero32 = scalar.constant 0 : i32
  %quote = scalar.constant 34 : i32
  %slash = scalar.constant 47 : i32
  %backslash = scalar.constant 92 : i32
  %comma = scalar.constant 44 : i32
  %brace = scalar.constant 125 : i32
  %bracket = scalar.constant 93 : i32
  %space = scalar.constant 32 : i32
  %tab = scalar.constant 9 : i32
  %lf = scalar.constant 10 : i32
  %cr = scalar.constant 13 : i32
  %in_string,%escaped,%previous = scf.for %i = [%zero to %size step %one](%quoted = %false : i1,%escape = %false : i1,%prior = %zero32 : i32) -> (i1,i1,i32) {
    %byte = buffer.load.i8.u %json[%i]
    %is_quote = scalar.cmpi eq,%byte,%quote : i32
    %is_escape = scalar.cmpi eq,%byte,%backslash : i32
    %not_escaped = scalar.cmpi eq,%escape,%false : i1
    %closing_quote = scalar.andi %is_quote,%not_escaped : i1
    %next_quoted,%next_escape,%next_prior = scf.if %quoted -> (i1,i1,i32) {
      %still_quoted = scalar.cmpi eq,%closing_quote,%false : i1
      %escaped_next = scalar.andi %is_escape,%not_escaped : i1
      %prior_byte = scf.select %closing_quote,%quote,%prior : i32
      scf.yield %still_quoted,%escaped_next,%prior_byte : i1,i1,i32
    } else {
      %is_slash = scalar.cmpi eq,%byte,%slash : i32
      %allowed = scalar.cmpi eq,%is_slash,%false : i1
      func.call @chatml.mapping_check(%allowed) : (i1) -> ()
      %is_brace = scalar.cmpi eq,%byte,%brace : i32
      %is_bracket = scalar.cmpi eq,%byte,%bracket : i32
      %closing = scalar.ori %is_brace,%is_bracket : i1
      %prior_comma = scalar.cmpi eq,%prior,%comma : i32
      %trailing = scalar.andi %closing,%prior_comma : i1
      %valid_comma = scalar.cmpi eq,%trailing,%false : i1
      func.call @chatml.mapping_check(%valid_comma) : (i1) -> ()
      %s = scalar.cmpi eq,%byte,%space : i32
      %t = scalar.cmpi eq,%byte,%tab : i32
      %l = scalar.cmpi eq,%byte,%lf : i32
      %r = scalar.cmpi eq,%byte,%cr : i32
      %a = scalar.ori %s,%t : i1
      %b = scalar.ori %l,%r : i1
      %whitespace = scalar.ori %a,%b : i1
      %prior_byte = scf.select %whitespace,%prior,%byte : i32
      scf.yield %is_quote,%false,%prior_byte : i1,i1,i32
    }
    scf.yield %next_quoted,%next_escape,%next_prior : i1,i1,i32
  }
  func.return
}

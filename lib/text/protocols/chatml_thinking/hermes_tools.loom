func.decl import("json") @compact(%text: buffer) -> (buffer)
global.rodata.def @hermes.empty = bytes("")
global.rodata.def @hermes.newline = bytes("0a")
global.rodata.def @hermes.open = bytes("3c746f6f6c5f63616c6c3e")
global.rodata.def @hermes.close = bytes("3c2f746f6f6c5f63616c6c3e")
global.rodata.def @hermes.render_open = bytes("3c746f6f6c5f63616c6c3e0a7b226e616d65223a2022")
global.rodata.def @hermes.render_middle = bytes("222c2022617267756d656e7473223a20")
global.rodata.def @hermes.render_close = bytes("7d0a3c2f746f6f6c5f63616c6c3e")

func.decl @chatml.inline_reasoning() -> (i1)

func.decl import("tools") @parse_xml(%schemas: buffer, %response: buffer, %native_truncated: i64) -> (buffer)

func.decl @chatml.normalize_tool_output(%schemas: buffer, %response: buffer) -> (buffer)

// Retain strict complete-call parsing while accepting the current host ABI.
func.def public @parse_tools(%schemas: buffer, %response: buffer, %truncated: i64) -> (buffer) {
  %legacy = func.call @chatml.inline_reasoning() : () -> (i1)
  %normalized = scf.if %legacy -> (buffer) {
    %text = func.call @chatml.normalize_tool_output(%schemas, %response) : (buffer, buffer) -> (buffer)
    scf.yield %text : buffer
  } else {
    scf.yield %response : buffer
  }
  %strict_complete = scalar.constant 0 : i64
  %calls = func.call @parse_xml(%schemas, %normalized, %strict_complete) : (buffer, buffer, i64) -> (buffer)
  func.return %calls : buffer
}

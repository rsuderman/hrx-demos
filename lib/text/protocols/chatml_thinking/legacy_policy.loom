func.decl @text.trim(%text: buffer) -> (buffer)

func.def inline @chatml.normalize_content(%text: buffer) -> (buffer) {
  %result = func.call @text.trim(%text) : (buffer) -> (buffer)
  func.return %result : buffer
}
func.def inline @chatml.normalize_reason(%text: buffer) -> (buffer) {
  %result = func.call @text.trim(%text) : (buffer) -> (buffer)
  func.return %result : buffer
}
func.def inline @chatml.retained_body(%text: buffer) -> (buffer) { func.return %text : buffer }
func.def pure inline @chatml.allow_later_system() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.system_before_tools() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
func.def pure inline @chatml.model_emits_think_open() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }
global.rodata.def @chatml_policy.think_open = bytes("3c7468696e6b3e0a")
global.rodata.def @chatml_policy.empty_think = bytes("3c7468696e6b3e0a0a3c2f7468696e6b3e0a0a")
func.def inline @chatml.generation_thought(%thinking: i1) -> (buffer) {
  %open = global.load @chatml_policy.think_open : buffer
  %closed = global.load @chatml_policy.empty_think : buffer
  %result = scf.select %thinking, %open, %closed : buffer
  func.return %result : buffer
}
func.def pure inline @chatml.history_state(%last_user: i64, %count: i64) -> (i64) {
  %eight = scalar.constant 8 : i64
  %bits = scalar.shli %last_user, %eight : i64
  func.return %bits : i64
}
func.def inline @chatml.history_thought(%state: i64, %ordinal: i64, %reason: buffer) -> (i1) {
  %eight = scalar.constant 8 : i64
  %preserve_mask = scalar.constant 32 : i64
  %zero = scalar.constant 0 : i64
  %last_user = scalar.shrui %state, %eight : i64
  %after = scalar.cmpi sgt, %ordinal, %last_user : i64
  %bit = scalar.andi %state, %preserve_mask : i64
  %preserve = scalar.cmpi ne, %bit, %zero : i64
  %retain = scalar.ori %preserve, %after : i1
  func.return %retain : i1
}

global.rodata.def @chatml_policy.separator = bytes("0a0a")
func.def inline @chatml.call_separator() -> (buffer) {
  %value = global.load @chatml_policy.separator : buffer
  func.return %value : buffer
}

func.def pure inline @chatml.require_user() -> (i1) { %v = scalar.constant true : i1 func.return %v : i1 }
func.def pure inline @chatml.first_tool_header() -> (i1) { %v = scalar.constant false : i1 func.return %v : i1 }

func.def inline @chatml.history_calls(%raw: buffer,%rendered: buffer) -> (buffer) {
  func.return %rendered : buffer
}

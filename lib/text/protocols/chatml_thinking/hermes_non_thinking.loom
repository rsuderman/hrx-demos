func.def inline @chatml.normalize_reason(%text: buffer) -> (buffer) { func.return %text : buffer }
func.def inline @chatml.retained_body(%text: buffer) -> (buffer) { func.return %text : buffer }
func.def inline @chatml.generation_thought(%thinking: i1) -> (buffer) {
  %empty = global.load @chatml_non_thinking.empty : buffer
  func.return %empty : buffer
}
func.def pure inline @chatml.history_state(%last_user: i64, %count: i64) -> (i64) {
  %zero = scalar.constant 0 : i64
  func.return %zero : i64
}
func.def pure inline @chatml.history_thought(%state: i64, %ordinal: i64, %reason: buffer) -> (i1) {
  %no = scalar.constant false : i1
  func.return %no : i1
}
func.def inline @chatml.default_system() -> (buffer, i1) {
  %value = global.load @loomify.text.default_system : buffer
  %present = scalar.constant true : i1
  func.return %value, %present : buffer, i1
}
func.def inline @chatml.system_tools_separator(%has_system: i1,%has_text: i1) -> (buffer) {

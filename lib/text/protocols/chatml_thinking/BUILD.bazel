load("//build_tools:loom_merge.bzl", "loom_merge")
package(default_visibility = ["//visibility:public"])
exports_files(glob(["*.loom"]))
filegroup(name = "core_sources", srcs = ["admission.loom", "input.loom", "output.loom", "mapping.loom"])
filegroup(name = "shared_sources", srcs = [":core_sources", "tools.loom", "tool_output.loom", "legacy_policy.loom"])
loom_merge(name = "inline_history", srcs = [":shared_sources", "inline_history.loom"])
loom_merge(name = "explicit_reasoning", srcs = [":shared_sources", "explicit_reasoning.loom"])
loom_merge(name = "hermes", srcs = [":core_sources", "hermes_common.loom", "hermes_policy.loom", "hermes_tools.loom"])
loom_merge(name = "hermes_non_thinking", srcs = [":core_sources", "hermes_common.loom", "hermes_non_thinking.loom", "hermes_tools.loom"])

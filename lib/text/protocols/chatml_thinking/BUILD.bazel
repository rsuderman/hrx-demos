load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

# Shared Hermes test properties used directly by Qwen2 and Qwen3 local suites.
filegroup(
    name = "hermes_test_sources",
    testonly = True,
    srcs = [
        "testing/hermes_policy.h",
        "testing/hermes_policy.cc",
    ],
    visibility = ["//internal_consumer:__pkg__"],
)

exports_files(glob(["*.loom"]))

filegroup(
    name = "core_sources",
    srcs = [
        "admission.loom",
        "input.loom",
        "output.loom",
        "mapping.loom",
        "schemas.loom",
    ],
)

filegroup(
    name = "default_sources",
    srcs = [
        "effort.loom",
        "system.loom",
        "completion.loom",
    ],
)

loom_merge(
    name = "plain",
    srcs = [
        "standard_framing.loom",
        "admission.loom",
        "input.loom",
        "mapping.loom",
        "plain_policy.loom",
        "plain_output.loom",
        "effort.loom",
        "system.loom",
        "schemas.loom",
    ],
)

filegroup(
    name = "shared_sources",
    srcs = [
        "standard_framing.loom",
        ":core_sources",
        ":default_sources",
        "tools.loom",
        "tool_output.loom",
        "xml_parse.loom",
        "legacy_policy.loom",
    ],
)

loom_merge(
    name = "inline_history",
    srcs = [
        ":shared_sources",
    ],
)

loom_merge(
    name = "explicit_reasoning",
    srcs = [
        ":shared_sources",
    ],
)

loom_merge(
    name = "hermes",
    srcs = [
        "standard_framing.loom",
        ":core_sources",
        ":default_sources",
        "hermes_policy.loom",
        "hermes_tools.loom",
    ],
)

loom_merge(
    name = "hermes_non_thinking",
    srcs = [
        "standard_framing.loom",
        ":core_sources",
        ":default_sources",
        "hermes_non_thinking.loom",
        "hermes_tools.loom",
    ],
)

loom_merge(
    name = "compact_reasoning",
    srcs = [
        ":core_sources",
        ":default_sources",
        "compact_reasoning.loom",
        "tools.loom",
        "tool_output.loom",
        "xml_parse.loom",
    ],
)

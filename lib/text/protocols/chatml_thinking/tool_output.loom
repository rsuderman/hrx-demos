func.def @chatml_tool.call(%schemas: buffer, %text: buffer, %output: buffer, %position: offset) -> (offset, i1) {
  %open = global.load @chatml_tool.open : buffer
  %function = global.load @chatml_tool.function : buffer
  %end_function = global.load @chatml_tool.end_function : buffer
  %close = global.load @chatml_tool.close : buffer
  %false = scalar.constant false : i1
  %at = func.call @text.at(%text, %position, %open) : (buffer, offset, buffer) -> (i1)
  %next, %valid = scf.if %at -> (offset, i1) {
    %size = buffer.length %open
    %after = index.add %position, %size : offset
    %function_at = func.call @chatml_tool.skip(%text, %after) : (buffer, offset) -> (offset)
    %name, %body, %has_name = func.call @chatml_tool.name(%text, %function_at, %function) : (buffer, offset, buffer) -> (buffer, offset, i1)
    %next, %valid = scf.if %has_name -> (offset, i1) {
      %properties = func.call @chatml_tool.properties(%schemas, %name) : (buffer, buffer) -> (buffer)
      %start = func.call @chatml_tool.skip(%text, %body) : (buffer, offset) -> (offset)
      %end, %parameters_valid = func.call @chatml_tool.parameters(%text, %output, %start, %properties) : (buffer, buffer, offset, buffer) -> (offset, i1)
      %function_closed = func.call @text.at(%text, %end, %end_function) : (buffer, offset, buffer) -> (i1)
      %closed_parameters = scalar.andi %parameters_valid, %function_closed : i1
      %next, %valid = scf.if %closed_parameters -> (offset, i1) {
        %size = buffer.length %end_function
        %after = index.add %end, %size : offset
        %close_at = func.call @chatml_tool.skip(%text, %after) : (buffer, offset) -> (offset)
        %closed = func.call @text.at(%text, %close_at, %close) : (buffer, offset, buffer) -> (i1)
        %next = scf.if %closed -> (offset) {
          %size = buffer.length %close
          %after = index.add %close_at, %size : offset
          %next = func.call @chatml_tool.skip(%text, %after) : (buffer, offset) -> (offset)
          scf.yield %next : offset
        } else {
          scf.yield %position : offset
        }
        scf.yield %next, %closed : offset, i1
      } else {
        scf.yield %position, %false : offset, i1
      }
      scf.yield %next, %valid : offset, i1
    } else {
      scf.yield %position, %false : offset, i1
    }
    scf.yield %next, %valid : offset, i1
  } else {
    scf.yield %position, %false : offset, i1
  }
  func.return %next, %valid : offset, i1
}

func.def @chatml.normalize_tool_output(%schemas: buffer, %response: buffer) -> (buffer) {
  %zero = index.constant 0 : offset
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %length = buffer.length %response
  %output = buffer.alloca<private> align(1) %length : buffer
  buffer.copy %response[%zero], %output[%zero], %length
  %schema_length = buffer.length %schemas
  %has_schemas = index.cmp ne, %schema_length, %zero : offset
  %admitted = scf.if %has_schemas -> (i1) {
    %begin = func.call @chatml_tool.skip(%schemas, %zero) : (buffer, offset) -> (offset)
    %has = index.cmp ult, %begin, %schema_length : offset
    %array = scf.if %has -> (i1) {
      %b = buffer.load.i8.u %schemas[%begin]
      %open_array = scalar.constant 91 : i32
      %is_array = scalar.cmpi eq, %b, %open_array : i32
      scf.yield %is_array : i1
    } else {
      scf.yield %false : i1
    }
    scf.yield %array : i1
  } else {
    scf.yield %false : i1
  }
  scf.if %admitted {
    %start = func.call @chatml_tool.skip(%response, %zero) : (buffer, offset) -> (offset)
    %position, %valid = scf.while(%p = %start : offset, %valid = %true : i1) -> (offset, i1) {
      %has = index.cmp ult, %p, %length : offset
      %more = scalar.andi %valid, %has : i1
      scf.condition %more, %p, %valid : i1, offset, i1
    } do(%p: offset, %prior_valid: i1) {
      %next, %valid = func.call @chatml_tool.call(%schemas, %response, %output, %p) : (buffer, buffer, buffer, offset) -> (offset, i1)
      scf.yield %next, %valid : offset, i1
    }
    %malformed = scalar.cmpi eq, %valid, %false : i1
    scf.if %malformed {
      // No repaired/truncated XML grammar is passed to the native parser.
      buffer.copy %response[%zero], %output[%zero], %length
    }
  }
  func.return %output : buffer
}

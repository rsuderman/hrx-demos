func.decl @text.string(%json: buffer, %key: buffer) -> (buffer, i1)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

global.rodata.def @chatml_tool.empty = bytes("")

global.rodata.def @chatml_tool.open = bytes("3c746f6f6c5f63616c6c3e")

global.rodata.def @chatml_tool.function = bytes("3c66756e6374696f6e3d")

global.rodata.def @chatml_tool.parameter = bytes("3c706172616d657465723d")


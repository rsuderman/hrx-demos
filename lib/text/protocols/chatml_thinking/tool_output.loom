global.rodata.def @chatml_tool.name_key = bytes("6e616d65")

global.rodata.def @chatml_tool.parameters_key = bytes("706172616d6574657273")

global.rodata.def @chatml_tool.properties_key = bytes("70726f70657274696573")

global.rodata.def @chatml_tool.type_key = bytes("74797065")

global.rodata.def @chatml_tool.boolean = bytes("626f6f6c65616e")

global.rodata.def @chatml_tool.true = bytes("54727565")

global.rodata.def @chatml_tool.false = bytes("46616c7365")

func.def @chatml_tool.space(%text: buffer, %p: offset) -> (i1) {
  %b = buffer.load.i8.u %text[%p]
  %nine = scalar.constant 9 : i32
  %thirteen = scalar.constant 13 : i32
  %space = scalar.constant 32 : i32
  %lo = scalar.cmpi uge, %b, %nine : i32
  %hi = scalar.cmpi ule, %b, %thirteen : i32
  %control = scalar.andi %lo, %hi : i1
  %ordinary = scalar.cmpi eq, %b, %space : i32
  %result = scalar.ori %control, %ordinary : i1
  func.return %result : i1
}

func.def @chatml_tool.skip(%text: buffer, %start: offset) -> (offset) {
  %length = buffer.length %text
  %one = index.constant 1 : offset
  %p = scf.while(%p = %start : offset) -> (offset) {
    %has = index.cmp ult, %p, %length : offset
    %space = scf.if %has -> (i1) {
      %s = func.call @chatml_tool.space(%text, %p) : (buffer, offset) -> (i1)
      scf.yield %s : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    scf.condition %space, %p : i1, offset
  } do(%p: offset) {
    %next = index.add %p, %one : offset
    scf.yield %next : offset
  }
  func.return %p : offset
}

// Native schema admission supplies function objects with object parameters.
// Still guard each lookup by type, so missing/unknown structure never proves
// that an arbitrary text parameter is Boolean.
func.def @chatml_tool.properties(%schemas: buffer, %name: buffer) -> (buffer) {
  %zero = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %one = index.constant 1 : index
  %object = scalar.constant 2 : i64
  %empty = global.load @chatml_tool.empty : buffer
  %function_key = global.load @chatml_tool.function_key : buffer
  %name_key = global.load @chatml_tool.name_key : buffer
  %parameters_key = global.load @chatml_tool.parameters_key : buffer
  %properties_key = global.load @chatml_tool.properties_key : buffer
  %records, %type, %count64 = func.call @members(%schemas) : (buffer) -> (buffer, i32, i64)
  %bounded = scalar.assume %count64 [range(%count64, 0, 2147483647)] : i64
  %count = index.cast %bounded : i64 to index
  %rows = buffer.view %records[%zero] : buffer -> view<[%count]x5xi64>
  %result = scf.for %i = [%zero_index to %count step %one](%prior = %empty : buffer) -> (buffer) {
    %kind = view.load %rows[%i, 4] : view<[%count]x5xi64> -> i64
    %is_object = scalar.cmpi eq, %kind, %object : i64
    %candidate = scf.if %is_object -> (buffer) {
      %begin = view.load %rows[%i, 2] : view<[%count]x5xi64> -> i64
      %size = view.load %rows[%i, 3] : view<[%count]x5xi64> -> i64
      %tool = func.call @text.range(%schemas, %begin, %size) : (buffer, i64, i64) -> (buffer)
      %function, %kind, %found = func.call @text.lookup(%tool, %function_key) : (buffer, buffer) -> (buffer, i64, i1)
      %obj = scalar.cmpi eq, %kind, %object : i64
      %valid = scalar.andi %found, %obj : i1
      %properties = scf.if %valid -> (buffer) {
        %declared_name, %has_name = func.call @text.string(%function, %name_key) : (buffer, buffer) -> (buffer, i1)
        %equal = func.call @text.equal(%name, %declared_name) : (buffer, buffer) -> (i1)
        %matches = scalar.andi %has_name, %equal : i1
        %params, %pk, %pf = func.call @text.lookup(%function, %parameters_key) : (buffer, buffer) -> (buffer, i64, i1)
        %po = scalar.cmpi eq, %pk, %object : i64
        %pvalid = scalar.andi %pf, %po : i1
        %selected = scalar.andi %matches, %pvalid : i1
        %props = scf.if %selected -> (buffer) {
          %value, %vk, %vf = func.call @text.lookup(%params, %properties_key) : (buffer, buffer) -> (buffer, i64, i1)
          %vo = scalar.cmpi eq, %vk, %object : i64
          %valid = scalar.andi %vf, %vo : i1
          %props = scf.select %valid, %value, %prior : buffer
          scf.yield %props : buffer
        } else {
          scf.yield %prior : buffer
        }
        scf.yield %props : buffer
      } else {
        scf.yield %prior : buffer
      }
      scf.yield %properties : buffer
    } else {
      scf.yield %prior : buffer
    }
    scf.yield %candidate : buffer
  }
  func.return %result : buffer
}

func.def @chatml_tool.is_boolean(%properties: buffer, %name: buffer) -> (i1) {
  %zero = index.constant 0 : offset
  %object = scalar.constant 2 : i64
  %length = buffer.length %properties
  %has = index.cmp ne, %length, %zero : offset
  %result = scf.if %has -> (i1) {
    %property, %kind, %found = func.call @text.lookup(%properties, %name) : (buffer, buffer) -> (buffer, i64, i1)
    %obj = scalar.cmpi eq, %kind, %object : i64
    %valid = scalar.andi %found, %obj : i1
    %boolean = scf.if %valid -> (i1) {
      %key = global.load @chatml_tool.type_key : buffer
      %expected = global.load @chatml_tool.boolean : buffer
      %type, %found = func.call @text.string(%property, %key) : (buffer, buffer) -> (buffer, i1)
      %equal = func.call @text.equal(%type, %expected) : (buffer, buffer) -> (i1)
      %boolean = scalar.andi %found, %equal : i1
      scf.yield %boolean : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    scf.yield %boolean : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %result : i1
}

// Recognize only the native codec's literal ASCII name domain. Invalid names
// trigger passthrough, leaving the original diagnostic to tools.parse_xml.
func.def @chatml_tool.identifier(%name: buffer) -> (i1) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %limit = index.constant 128 : offset
  %length = buffer.length %name
  %nonempty = index.cmp ne, %length, %zero : offset
  %bounded = index.cmp ule, %length, %limit : offset
  %valid = scalar.andi %nonempty, %bounded : i1
  %result = scf.for %i = [%zero to %length step %one](%valid = %valid : i1) -> (i1) {
    %b = buffer.load.i8.u %name[%i]
    %c48 = scalar.constant 48 : i32
    %c57 = scalar.constant 57 : i32
    %c65 = scalar.constant 65 : i32
    %c90 = scalar.constant 90 : i32
    %c97 = scalar.constant 97 : i32
    %c122 = scalar.constant 122 : i32
    %c95 = scalar.constant 95 : i32
    %c45 = scalar.constant 45 : i32
    %c46 = scalar.constant 46 : i32
    %dlo = scalar.cmpi uge, %b, %c48 : i32
    %dhi = scalar.cmpi ule, %b, %c57 : i32
    %digit = scalar.andi %dlo, %dhi : i1
    %ulo = scalar.cmpi uge, %b, %c65 : i32
    %uhi = scalar.cmpi ule, %b, %c90 : i32
    %upper = scalar.andi %ulo, %uhi : i1
    %llo = scalar.cmpi uge, %b, %c97 : i32
    %lhi = scalar.cmpi ule, %b, %c122 : i32
    %lower = scalar.andi %llo, %lhi : i1
    %underscore = scalar.cmpi eq, %b, %c95 : i32
    %dash = scalar.cmpi eq, %b, %c45 : i32
    %dot = scalar.cmpi eq, %b, %c46 : i32
    %letter = scalar.ori %upper, %lower : i1
    %word = scalar.ori %letter, %digit : i1
    %punct = scalar.ori %underscore, %dash : i1
    %special = scalar.ori %punct, %dot : i1
    %allowed = scalar.ori %word, %special : i1
    %next = scalar.andi %valid, %allowed : i1
    scf.yield %next : i1
  }
  func.return %result : i1
}

func.def @chatml_tool.name(%text: buffer, %position: offset, %prefix: buffer) -> (buffer, offset, i1) {
  %one = index.constant 1 : offset
  %at = func.call @text.at(%text, %position, %prefix) : (buffer, offset, buffer) -> (i1)
  %name, %next, %valid = scf.if %at -> (buffer, offset, i1) {
    %size = buffer.length %prefix
    %start = index.add %position, %size : offset
    %tag_end = global.load @chatml_tool.tag_end : buffer
    %end, %found = func.call @text.find(%text, %start, %tag_end) : (buffer, offset, buffer) -> (offset, i1)
    %name = func.call @text.slice(%text, %start, %end) : (buffer, offset, offset) -> (buffer)
    %next = scf.if %found -> (offset) {
      %after = index.add %end, %one : offset
      scf.yield %after : offset
    } else {
      scf.yield %position : offset
    }
    %identifier = func.call @chatml_tool.identifier(%name) : (buffer) -> (i1)
    %valid = scalar.andi %found, %identifier : i1
    scf.yield %name, %next, %valid : buffer, offset, i1
  } else {
    %empty = global.load @chatml_tool.empty : buffer
    scf.yield %empty, %position, %at : buffer, offset, i1
  }
  func.return %name, %next, %valid : buffer, offset, i1
}

func.def @chatml_tool.parameters(%text: buffer, %output: buffer, %start: offset, %properties: buffer) -> (offset, i1) {
  %prefix = global.load @chatml_tool.parameter : buffer
  %end_tag = global.load @chatml_tool.end_parameter : buffer
  %true_token = global.load @chatml_tool.true : buffer
  %false_token = global.load @chatml_tool.false : buffer
  %one = index.constant 1 : offset
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %lower_t = scalar.constant 116 : i32
  %lower_f = scalar.constant 102 : i32
  %position, %valid = scf.while(%p = %start : offset, %valid = %true : i1) -> (offset, i1) {
    %at = func.call @text.at(%text, %p, %prefix) : (buffer, offset, buffer) -> (i1)
    %more = scalar.andi %valid, %at : i1
    scf.condition %more, %p, %valid : i1, offset, i1
  } do(%p: offset, %prior_valid: i1) {
    %name, %body, %has_name = func.call @chatml_tool.name(%text, %p, %prefix) : (buffer, offset, buffer) -> (buffer, offset, i1)
    %end, %has_end = func.call @text.find(%text, %body, %end_tag) : (buffer, offset, buffer) -> (offset, i1)
    %valid = scalar.andi %has_name, %has_end : i1
    %next = scf.if %valid -> (offset) {
      %boolean = func.call @chatml_tool.is_boolean(%properties, %name) : (buffer, buffer) -> (i1)
      scf.if %boolean {
        %begin = func.call @chatml_tool.skip(%text, %body) : (buffer, offset) -> (offset)
        %trimmed_end = scf.while(%q = %end : offset) -> (offset) {
          %has = index.cmp ugt, %q, %begin : offset
          %space = scf.if %has -> (i1) {
            %last = index.sub %q, %one : offset
            %s = func.call @chatml_tool.space(%text, %last) : (buffer, offset) -> (i1)
            scf.yield %s : i1
          } else {
            scf.yield %false : i1
          }
          scf.condition %space, %q : i1, offset
        } do(%q: offset) {
          %next = index.sub %q, %one : offset
          scf.yield %next : offset
        }
        %body_text = func.call @text.slice(%text, %begin, %trimmed_end) : (buffer, offset, offset) -> (buffer)
        %is_true = func.call @text.equal(%body_text, %true_token) : (buffer, buffer) -> (i1)
        %is_false = func.call @text.equal(%body_text, %false_token) : (buffer, buffer) -> (i1)
        %replace = scalar.ori %is_true, %is_false : i1
        scf.if %replace {
          %letter = scf.select %is_true, %lower_t, %lower_f : i32
          buffer.store.i8 %letter, %output[%begin]
        }
      }
      %size = buffer.length %end_tag
      %after = index.add %end, %size : offset
      %next = func.call @chatml_tool.skip(%text, %after) : (buffer, offset) -> (offset)
      scf.yield %next : offset
    } else {
      scf.yield %p : offset
    }
    scf.yield %next, %valid : offset, i1
  }

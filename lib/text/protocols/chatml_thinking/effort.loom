func.decl @chatml.check(%condition: i1)

func.decl @chatml.has_effort() -> (i1)

global.rodata.decl @chatml.low

global.rodata.decl @chatml.medium

func.decl @chatml.supports_thinking() -> (i1)

global.rodata.decl @chatml.xhigh

global.rodata.decl @chatml_input.empty

global.rodata.decl @loomify.text.default_effort

global.rodata.decl @loomify.text.effort_low

global.rodata.decl @loomify.text.effort_xhigh

func.decl @text.equal(%a: buffer, %b: buffer) -> (i1)

// Copyright 2026 AMD ROCm Software
// SPDX-License-Identifier: MIT
func.def @chatml.effort_instruction(%effort: buffer, %enabled: i1) -> (buffer) {
  %empty = global.load @chatml_input.empty : buffer
  %instruction = scf.if %enabled -> (buffer) {
    %low_key = global.load @chatml.low : buffer
    %medium_key = global.load @chatml.medium : buffer
    %xhigh_key = global.load @chatml.xhigh : buffer
    %low = func.call @text.equal(%effort, %low_key) : (buffer, buffer) -> (i1)
    %medium = func.call @text.equal(%effort, %medium_key) : (buffer, buffer) -> (i1)
    %xhigh = func.call @text.equal(%effort, %xhigh_key) : (buffer, buffer) -> (i1)
    %a = scalar.ori %low, %medium : i1
    %valid = scalar.ori %a, %xhigh : i1
    func.call @chatml.check(%valid) : (i1)
    %low_text = global.load @loomify.text.effort_low : buffer
    %high_text = global.load @loomify.text.effort_xhigh : buffer
    %high_or_empty = scf.select %xhigh, %high_text, %empty : buffer
    %text = scf.select %low, %low_text, %high_or_empty : buffer
    scf.yield %text : buffer
  } else {
    scf.yield %empty : buffer
  }
  func.return %instruction : buffer
}

// Cold discovery follows this selected text policy, not the thinking default.
func.def public @chat_reasoning() -> (i32, i32, i32) {
  %supported = func.call @chatml.supports_thinking() : () -> (i1)
  %enabled = scalar.extui %supported : i1 to i32
  %zero = scalar.constant 0 : i32
  %has_effort = func.call @chatml.has_effort() : () -> (i1)
  %mask, %default = scf.if %has_effort -> (i32, i32) {
    %levels = scalar.constant 44 : i32
    %low_level = scalar.constant 2 : i32
    %medium_level = scalar.constant 3 : i32
    %xhigh_level = scalar.constant 5 : i32
    %value = global.load @loomify.text.default_effort : buffer
    %low_text = global.load @chatml.low : buffer
    %medium_text = global.load @chatml.medium : buffer
    %xhigh_text = global.load @chatml.xhigh : buffer
    %low = func.call @text.equal(%value, %low_text) : (buffer, buffer) -> (i1)
    %medium = func.call @text.equal(%value, %medium_text) : (buffer, buffer) -> (i1)
    %xhigh = func.call @text.equal(%value, %xhigh_text) : (buffer, buffer) -> (i1)
    %a = scalar.ori %low, %medium : i1
    %valid = scalar.ori %a, %xhigh : i1
    func.call @chatml.check(%valid) : (i1)
    %other = scf.select %medium, %medium_level, %xhigh_level : i32
    %selected = scf.select %low, %low_level, %other : i32
    scf.yield %levels, %selected : i32, i32
  } else {
    scf.yield %zero, %zero : i32, i32
  }
  func.return %enabled, %mask, %default : i32, i32, i32
}

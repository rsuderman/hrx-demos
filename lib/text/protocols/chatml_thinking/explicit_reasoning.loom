func.def pure inline @chatml.default_thinking() -> (i1) {
  %value = scalar.constant true : i1
  func.return %value : i1
}

func.def pure inline @chatml.keep_reasoning_default() -> (i1) {
  %value = scalar.constant true : i1
  func.return %value : i1
}

func.def pure inline @chatml.inline_reasoning() -> (i1) {
  %value = scalar.constant false : i1
  func.return %value : i1
}

func.def pure inline @chatml.emit_empty_system() -> (i1) {
  %value = scalar.constant false : i1
  func.return %value : i1
}

func.def pure inline @chatml.has_effort() -> (i1) {
  %value = scalar.constant true : i1
  func.return %value : i1
}

// Exact maintained Gemma turns semantics; JSON and UTF-8 mechanics are shared.
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)
func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)
func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)
func.decl @text.equal(%a: buffer, %b: buffer) -> (i1)
func.decl @text.lookup(%json: buffer, %key: buffer) -> (buffer, i64, i1)
func.decl @text.string(%json: buffer, %key: buffer) -> (buffer, i1)
func.decl @text.decode(%source: buffer, %begin: i64, %length: i64) -> (buffer)
func.decl @text.range(%source: buffer, %begin: i64, %length: i64) -> (buffer)
func.decl @text.trim(%text: buffer) -> (buffer)
func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)
func.decl @loomify.tokens.bos_marker() -> (buffer)
func.decl @loomify.tokens.vocabulary_size() -> (i64)
func.decl @loomify.tokens.terminal_marker() -> (buffer)
global.rodata.def @gemma.empty = bytes("")
global.rodata.def @gemma.array = bytes("5b5d")
global.rodata.def @gemma.newline = bytes("0a")
global.rodata.def @gemma.double_newline = bytes("0a0a")
global.rodata.def @gemma.user_header = bytes("3c73746172745f6f665f7475726e3e757365720a")
global.rodata.def @gemma.model_header = bytes("3c73746172745f6f665f7475726e3e6d6f64656c0a")
global.rodata.def @gemma.messages = bytes("6d65737361676573")
global.rodata.def @gemma.role = bytes("726f6c65")
global.rodata.def @gemma.content_key = bytes("636f6e74656e74")
global.rodata.def @gemma.type = bytes("74797065")
global.rodata.def @gemma.text = bytes("74657874")
global.rodata.def @gemma.user = bytes("75736572")
global.rodata.def @gemma.assistant = bytes("617373697374616e74")
global.rodata.def @gemma.system = bytes("73797374656d")
global.rodata.def @gemma.model_options = bytes("6d6f64656c5f6f7074696f6e73")
global.rodata.def @gemma.generation_key = bytes("6164645f67656e65726174696f6e5f70726f6d7074")
global.rodata.def @gemma.thinking = bytes("656e61626c655f7468696e6b696e67")
global.rodata.def @gemma.reasoning_effort = bytes("726561736f6e696e675f6566666f7274")
global.rodata.def @gemma.invalid = bytes("47656d6d61207475726e73207265717569726520616c7465726e6174696e6720757365722f617373697374616e7420746578742c206f7074696f6e616c206c656164696e672073797374656d2c20616e64206e6f206d656469612f746f6f6c732f726561736f6e696e67")

func.def @gemma.check(%condition: i1) {
  %flag = scalar.extui %condition : i1 to i32
  %error = global.load @gemma.invalid : buffer
  func.call @require(%flag, %error) : (i32, buffer)
  func.return
}
func.def @gemma.array_count(%array: buffer) -> (i64) {
  %records, %kind, %count = func.call @members(%array) : (buffer) -> (buffer, i32, i64)
  %array_type = scalar.constant 3 : i32
  %valid = scalar.cmpi eq, %kind, %array_type : i32
  func.call @gemma.check(%valid) : (i1)
  func.return %count : i64
}
func.def @gemma.item(%array: buffer, %ordinal: i64) -> (buffer) {
  %records, %kind, %count = func.call @members(%array) : (buffer) -> (buffer, i32, i64)
  %array_type = scalar.constant 3 : i32
  %array_ok = scalar.cmpi eq, %kind, %array_type : i32
  %in_range = scalar.cmpi ult, %ordinal, %count : i64
  %valid = scalar.andi %array_ok, %in_range : i1
  func.call @gemma.check(%valid) : (i1)
  %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %bounded_ordinal = scalar.assume %ordinal [range(%ordinal, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %index_value = index.cast %bounded_ordinal : i64 to index
  %index = index.assume %index_value [range(%index_value, 0, 2147483646), lt(%index_value, %extent)] : index
  %origin = index.constant 0 : offset
  %view = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
  %begin = view.load %view[%index, 2] : view<[%extent]x5xi64> -> i64
  %length = view.load %view[%index, 3] : view<[%extent]x5xi64> -> i64
  %value = func.call @text.range(%array, %begin, %length) : (buffer, i64, i64) -> (buffer)
  func.return %value : buffer
}
// Preserve system string whitespace. Ordinary lists trim each item separately;
// the first system list uses only its first text item, as the source template does.
func.def @gemma.content(%message: buffer, %system: i1) -> (buffer) {
  %content_key = global.load @gemma.content_key : buffer
  %value, %kind, %found = func.call @text.lookup(%message, %content_key) : (buffer, buffer) -> (buffer, i64, i1)
  func.call @gemma.check(%found) : (i1)
  %string_type = scalar.constant 0 : i64
  %is_string = scalar.cmpi eq, %kind, %string_type : i64
  %result = scf.if %is_string -> (buffer) {
    %decoded, %present = func.call @text.string(%message, %content_key) : (buffer, buffer) -> (buffer, i1)
    func.call @gemma.check(%present) : (i1)
    %trimmed = func.call @text.trim(%decoded) : (buffer) -> (buffer)
    %text = scf.select %system, %decoded, %trimmed : buffer
    scf.yield %text : buffer
  } else {
    %count = func.call @gemma.array_count(%value) : (buffer) -> (i64)
    %zero64 = scalar.constant 0 : i64
    %nonempty = scalar.cmpi ne, %count, %zero64 : i64
    %false = scalar.constant false : i1
    %ordinary = scalar.cmpi eq, %system, %false : i1
    %valid_count = scalar.ori %nonempty, %ordinary : i1
    func.call @gemma.check(%valid_count) : (i1)
    %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %empty = global.load @gemma.empty : buffer
    %type_key = global.load @gemma.type : buffer
    %text_key = global.load @gemma.text : buffer
    %all = scf.for %i = [%zero to %extent step %one](%prior = %empty : buffer) -> (buffer) {
      %ordinal = index.cast %i : index to i64
      %part = func.call @gemma.item(%value, %ordinal) : (buffer, i64) -> (buffer)
      %type, %has_type = func.call @text.string(%part, %type_key) : (buffer, buffer) -> (buffer, i1)
      %is_text = func.call @text.equal(%type, %text_key) : (buffer, buffer) -> (i1)
      %valid = scalar.andi %has_type, %is_text : i1
      func.call @gemma.check(%valid) : (i1)
      %text, %has_text = func.call @text.string(%part, %text_key) : (buffer, buffer) -> (buffer, i1)
      func.call @gemma.check(%has_text) : (i1)
      %trimmed = func.call @text.trim(%text) : (buffer) -> (buffer)
      %normalized = scf.select %system, %text, %trimmed : buffer
      %first = index.cmp eq, %i, %zero : index
      %include = scalar.ori %ordinary, %first : i1
      %next = scf.select %include, %normalized, %empty : buffer
      %joined = func.call @text.join8(%prior, %next, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %joined : buffer
    }
    scf.yield %all : buffer
  }
  func.return %result : buffer
}
func.def @gemma.no_tools(%tools: buffer) {
  %count = func.call @gemma.array_count(%tools) : (buffer) -> (i64)
  %zero = scalar.constant 0 : i64
  %empty = scalar.cmpi eq, %count, %zero : i64
  func.call @gemma.check(%empty) : (i1)
  func.return
}
func.def @gemma.generation(%request: buffer) -> (i1) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %effort_key = global.load @gemma.reasoning_effort : buffer
  %effort, %effort_kind, %effort_present = func.call @text.lookup(%request, %effort_key) : (buffer, buffer) -> (buffer, i64, i1)
  %no_effort = scalar.cmpi eq, %effort_present, %false : i1
  func.call @gemma.check(%no_effort) : (i1)
  %thinking = global.load @gemma.thinking : buffer
  %think, %think_kind, %think_present = func.call @text.lookup(%request, %thinking) : (buffer, buffer) -> (buffer, i64, i1)
  %false_kind = scalar.constant 5 : i64
  %no_thinking = scalar.cmpi eq, %think_kind, %false_kind : i64
  %absent_thinking = scalar.cmpi eq, %think_present, %false : i1
  %thinking_ok = scalar.ori %absent_thinking, %no_thinking : i1
  func.call @gemma.check(%thinking_ok) : (i1)
  %options_key = global.load @gemma.model_options : buffer
  %options, %kind, %found = func.call @text.lookup(%request, %options_key) : (buffer, buffer) -> (buffer, i64, i1)
  %generation = scf.if %found -> (i1) {
    %records, %object, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
    %object_type = scalar.constant 2 : i32
    %valid_object = scalar.cmpi eq, %object, %object_type : i32
    func.call @gemma.check(%valid_object) : (i1)
    %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %origin = index.constant 0 : offset
    %fields = buffer.view %records[%origin] : buffer -> view<[%extent]x5xi64>
    %generation_key = global.load @gemma.generation_key : buffer
    scf.for %i = [%zero to %extent step %one] {
      %begin = view.load %fields[%i, 0] : view<[%extent]x5xi64> -> i64
      %length = view.load %fields[%i, 1] : view<[%extent]x5xi64> -> i64
      %key = func.call @text.decode(%options, %begin, %length) : (buffer, i64, i64) -> (buffer)
      %valid = func.call @text.equal(%key, %generation_key) : (buffer, buffer) -> (i1)
      func.call @gemma.check(%valid) : (i1)
      scf.yield
    }
    %value, %value_kind, %present = func.call @text.lookup(%options, %generation_key) : (buffer, buffer) -> (buffer, i64, i1)
    %true_kind = scalar.constant 4 : i64
    %is_true = scalar.cmpi eq, %value_kind, %true_kind : i64
    %is_false = scalar.cmpi eq, %value_kind, %false_kind : i64
    %is_bool = scalar.ori %is_true, %is_false : i1
    %absent = scalar.cmpi eq, %present, %false : i1
    %valid = scalar.ori %absent, %is_bool : i1
    func.call @gemma.check(%valid) : (i1)
    %resolved = scalar.ori %absent, %is_true : i1
    scf.yield %resolved : i1
  } else { scf.yield %true : i1 }
  func.return %generation : i1
}

// Bits: leading system=1, system has following user=2, generation suffix=4,
// next expected non-system role assistant=8. No pointer/buffer is retained here.
func.def public @chat_begin(%request: buffer, %tools: buffer) -> (buffer, i64) {
  func.call @gemma.no_tools(%tools) : (buffer)
  %generation = func.call @gemma.generation(%request) : (buffer) -> (i1)
  %messages_key = global.load @gemma.messages : buffer
  %messages, %kind, %found = func.call @text.lookup(%request, %messages_key) : (buffer, buffer) -> (buffer, i64, i1)
  func.call @gemma.check(%found) : (i1)
  %count = func.call @gemma.array_count(%messages) : (buffer) -> (i64)
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %two = scalar.constant 2 : i64
  %four = scalar.constant 4 : i64
  %first = func.call @gemma.item(%messages, %zero) : (buffer, i64) -> (buffer)
  %role_key = global.load @gemma.role : buffer
  %role, %has_role = func.call @text.string(%first, %role_key) : (buffer, buffer) -> (buffer, i1)
  func.call @gemma.check(%has_role) : (i1)
  %system_key = global.load @gemma.system : buffer
  %system = func.call @text.equal(%role, %system_key) : (buffer, buffer) -> (i1)
  %following = scalar.cmpi ugt, %count, %one : i64
  %open = scalar.andi %system, %following : i1
  %system_bit = scf.select %system, %one, %zero : i64
  %following_bit = scf.select %open, %two, %zero : i64
  %generation_bit = scf.select %generation, %four, %zero : i64
  %a = scalar.ori %system_bit, %following_bit : i64
  %state = scalar.ori %a, %generation_bit : i64
  %bos = func.call @loomify.tokens.bos_marker() : () -> (buffer)
  func.return %bos, %state : buffer, i64
}
func.def public @chat_message(%raw: buffer, %role_payload: buffer, %content: buffer, %parts: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %two = scalar.constant 2 : i64
  %seven = scalar.constant 7 : i64
  %eight = scalar.constant 8 : i64
  %no_extra = scalar.cmpi eq, %fields, %zero : i64
  func.call @gemma.check(%no_extra) : (i1)
  %role_key = global.load @gemma.role : buffer
  %role, %present = func.call @text.string(%raw, %role_key) : (buffer, buffer) -> (buffer, i1)
  func.call @gemma.check(%present) : (i1)
  %sys_key = global.load @gemma.system : buffer
  %user_key = global.load @gemma.user : buffer
  %assistant_key = global.load @gemma.assistant : buffer
  %system = func.call @text.equal(%role, %sys_key) : (buffer, buffer) -> (i1)
  %user = func.call @text.equal(%role, %user_key) : (buffer, buffer) -> (i1)
  %assistant = func.call @text.equal(%role, %assistant_key) : (buffer, buffer) -> (i1)
  %empty = global.load @gemma.empty : buffer
  %text = func.call @gemma.content(%raw, %system) : (buffer, i1) -> (buffer)
  %fragment, %next = scf.if %system -> (buffer, i64) {
    %first = scalar.cmpi eq, %ordinal, %zero : i64
    %has_system = scalar.andi %state, %one : i64
    %declared_system = scalar.cmpi ne, %has_system, %zero : i64
    %valid = scalar.andi %first, %declared_system : i1
    func.call @gemma.check(%valid) : (i1)
    %following_bit = scalar.andi %state, %two : i64
    %following = scalar.cmpi ne, %following_bit, %zero : i64
    %header = global.load @gemma.user_header : buffer
    %separator = global.load @gemma.double_newline : buffer
    %with_system = func.call @text.join8(%header, %text, %separator, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    %value = scf.select %following, %with_system, %empty : buffer
    scf.yield %value, %state : buffer, i64
  } else {
    %known = scalar.ori %user, %assistant : i1
    %expected_bit = scalar.andi %state, %eight : i64
    %expected_assistant = scalar.cmpi ne, %expected_bit, %zero : i64
    %matches = scalar.cmpi eq, %assistant, %expected_assistant : i1
    %valid = scalar.andi %known, %matches : i1
    func.call @gemma.check(%valid) : (i1)
    %second = scalar.cmpi eq, %ordinal, %one : i64
    %sys_bit = scalar.andi %state, %one : i64
    %has_system = scalar.cmpi ne, %sys_bit, %zero : i64
    %prefixed = scalar.andi %second, %has_system : i1
    %user_header = global.load @gemma.user_header : buffer
    %model_header = global.load @gemma.model_header : buffer
    %normal_header = scf.select %user, %user_header, %model_header : buffer
    %header = scf.select %prefixed, %empty, %normal_header : buffer
    %eot = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
    %newline = global.load @gemma.newline : buffer
    %value = func.call @text.join8(%header, %text, %eot, %newline, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    %keep = scalar.andi %state, %seven : i64
    %expected = scf.select %user, %eight, %zero : i64
    %updated = scalar.ori %keep, %expected : i64
    scf.yield %value, %updated : buffer, i64
  }
  func.return %fragment, %next, %empty : buffer, i64, buffer
}
func.def public @chat_end(%state: i64) -> (buffer, i64) {
  %four = scalar.constant 4 : i64
  %zero = scalar.constant 0 : i64
  %generation = scalar.andi %state, %four : i64
  %enabled = scalar.cmpi ne, %generation, %zero : i64
  %header = global.load @gemma.model_header : buffer
  %empty = global.load @gemma.empty : buffer
  %suffix = scf.select %enabled, %header, %empty : buffer
  func.return %suffix, %generation : buffer, i64
}
func.def public @text.validate_request(%request: buffer) {
  %generation = func.call @gemma.generation(%request) : (buffer) -> (i1)
  func.return
}
func.def public @parse_tools(%schemas: buffer, %response: buffer) -> (buffer) {
  func.call @gemma.no_tools(%schemas) : (buffer)
  %empty = global.load @gemma.array : buffer
  func.return %empty : buffer
}
func.def public @render_tool(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %false = scalar.constant false : i1
  func.call @gemma.check(%false) : (i1)
  %empty = global.load @gemma.empty : buffer
  %zero = scalar.constant 0 : i64
  func.return %empty, %zero : buffer, i64
}
func.def public @prepare_input(%text: buffer, %media: buffer, %media_count: i64, %format: i32, %boundary: i32, %capacity: i64) -> (buffer, i64, buffer) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %no_media = scalar.cmpi eq, %media_count, %zero64 : i64
  %valid_format = scalar.cmpi ule, %format, %one : i32
  %valid_boundary = scalar.cmpi ule, %boundary, %two : i32
  %maximum = scalar.constant 2305843009213693950 : i64
  %valid_capacity = scalar.cmpi ule, %capacity, %maximum : i64
  %a = scalar.andi %no_media, %valid_format : i1
  %b = scalar.andi %valid_boundary, %valid_capacity : i1
  %valid = scalar.andi %a, %b : i1
  func.call @gemma.check(%valid) : (i1)
  %user = scalar.cmpi eq, %format, %one : i32
  %fresh = scalar.cmpi eq, %boundary, %zero : i32
  %open = scalar.cmpi eq, %boundary, %one : i32
  %terminated = scalar.cmpi eq, %boundary, %two : i32
  %empty = global.load @gemma.empty : buffer
  %newline = global.load @gemma.newline : buffer
  %eot = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
  %open_separator = func.call @text.join8(%eot, %newline, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %after = scf.select %terminated, %newline, %empty : buffer
  %separator = scf.select %open, %open_separator, %after : buffer
  %rendered = scf.if %user -> (buffer) {
    %bos = func.call @loomify.tokens.bos_marker() : () -> (buffer)
    %prefix = scf.select %fresh, %bos, %separator : buffer
    %trimmed = func.call @text.trim(%text) : (buffer) -> (buffer)
    %user_header = global.load @gemma.user_header : buffer
    %model_header = global.load @gemma.model_header : buffer
    %value = func.call @text.join8(%prefix, %user_header, %trimmed, %eot, %newline, %model_header, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    %value = func.call @text.join8(%separator, %text, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  }
  %probe = scalar.addi %capacity, %one64 : i64
  %tokens, %count = func.call @encode(%rendered, %zero, %probe) : (buffer, i32, i64) -> (buffer, i64)
  %fits = scalar.cmpi ule, %count, %capacity : i64
  func.call @gemma.check(%fits) : (i1)
  // External tokenizer JSON may contain added media IDs outside the numerical
  // vocabulary. Reject actual encoded out-of-domain IDs before host admission.
  %vocabulary = func.call @loomify.tokens.vocabulary_size() : () -> (i64)
  %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %start = index.constant 0 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %ids = buffer.view %tokens[%origin] : buffer -> view<[%extent]xi32>
  scf.for %i = [%start to %extent step %step] {
    %id32 = view.load %ids[%i] : view<[%extent]xi32> -> i32
    %id = scalar.extui %id32 : i32 to i64
    %inside = scalar.cmpi ult, %id, %vocabulary : i64
    func.call @gemma.check(%inside) : (i1)
    scf.yield
  }
  func.return %tokens, %count, %empty : buffer, i64, buffer
}

func.decl @loomify.tokens.terminal_marker() -> (buffer)
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)
func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)
func.decl import("json") @members(%text: buffer) -> (buffer, i32, i64)
func.decl import("json") @unescape(%source: buffer, %offset: i64, %length: i64, %target: buffer, %target_offset: i64) -> (i64)
func.decl @text.equal(%a: buffer, %b: buffer) -> (i1)
func.decl @text.join8(%a: buffer, %b: buffer, %c: buffer, %d: buffer, %e: buffer, %f: buffer, %g: buffer, %h: buffer) -> (buffer)
func.decl @text.range(%text: buffer, %begin: i64, %length: i64) -> (buffer)
func.decl @text.trim(%text: buffer) -> (buffer)
func.decl @loomify.request.check(%condition: i1)
global.rodata.def @llama_text.empty = bytes("")
global.rodata.def @llama_text.empty_array = bytes("5b5d")
global.rodata.def @llama_text.bos = bytes("3c7c626567696e5f6f665f746578747c3e")
global.rodata.def @llama_text.system_prefix = bytes("3c7c73746172745f6865616465725f69647c3e73797374656d3c7c656e645f6865616465725f69647c3e0a0a43757474696e67204b6e6f776c6564676520446174653a20446563656d62657220323032330a546f64617920446174653a20")
global.rodata.decl @loomify.text.fallback_date
global.rodata.def @llama_text.date_key = bytes("646174655f737472696e67")
global.rodata.def @llama_text.double_newline = bytes("0a0a")
global.rodata.def @llama_text.header_open = bytes("3c7c73746172745f6865616465725f69647c3e")
global.rodata.def @llama_text.header_close = bytes("3c7c656e645f6865616465725f69647c3e0a0a")
global.rodata.def @llama_text.assistant_header = bytes("3c7c73746172745f6865616465725f69647c3e617373697374616e743c7c656e645f6865616465725f69647c3e0a0a")
global.rodata.def @llama_text.user_header = bytes("3c7c73746172745f6865616465725f69647c3e757365723c7c656e645f6865616465725f69647c3e0a0a")
global.rodata.def @llama_text.system = bytes("73797374656d")
global.rodata.def @llama_text.user = bytes("75736572")
global.rodata.def @llama_text.assistant = bytes("617373697374616e74")
global.rodata.def @llama_text.capacity_error = bytes("436f6d706c65746520696e707574206578636565647320746f6b656e206361706163697479206f7220696e707574206d6f646520697320696e76616c6964")
global.rodata.def @llama_text.model_options = bytes("6d6f64656c5f6f7074696f6e73")
global.rodata.def @llama_text.thinking_key = bytes("656e61626c655f7468696e6b696e67")
global.rodata.def @llama_text.custom_tools_key = bytes("637573746f6d5f746f6f6c73")
global.rodata.def @llama_text.tools_in_user_key = bytes("746f6f6c735f696e5f757365725f6d657373616765")
global.rodata.def @llama_text.template_kwargs_key = bytes("636861745f74656d706c6174655f6b7761726773")


func.def @llama_text.date_value(%request: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero64 = scalar.constant 0 : i64
  %string_type = scalar.constant 0 : i64
  %object_type = scalar.constant 2 : i32
  %fields, %type, %count = func.call @members(%request) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %type, %object_type : i32
  func.call @loomify.request.check(%object) : (i1)
  %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %default = global.load @loomify.text.fallback_date : buffer
  %date_key = global.load @llama_text.date_key : buffer
  %model_key = global.load @llama_text.model_options : buffer
  %thinking_key = global.load @llama_text.thinking_key : buffer
  %custom_tools_key = global.load @llama_text.custom_tools_key : buffer
  %tools_in_user_key = global.load @llama_text.tools_in_user_key : buffer
  %template_kwargs_key = global.load @llama_text.template_kwargs_key : buffer
  %date = scf.for %i = [%zero to %extent step %one](%prior = %default : buffer) -> (buffer) {
    %key_begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_size = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %key_capacity = buffer.length %request
    %key_storage = buffer.alloca<private> align(1) %key_capacity : buffer
    %key_used = func.call @unescape(%request, %key_begin, %key_size, %key_storage, %zero64) : (buffer, i64, i64, buffer, i64) -> (i64)
    %key_bounded = scalar.assume %key_used [range(%key_used, 0, 9223372036854775807)] : i64
    %key_extent = index.cast %key_bounded : i64 to offset
    %key = buffer.alloca<private> align(1) %key_extent : buffer
    buffer.copy %key_storage[%origin], %key[%origin], %key_extent
    %is_date = func.call @text.equal(%key, %date_key) : (buffer, buffer) -> (i1)
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_size = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %next = scf.if %is_date -> (buffer) {
      %string = scalar.cmpi eq, %value_type, %string_type : i64
      func.call @loomify.request.check(%string) : (i1)
      %capacity = buffer.length %request
      %storage = buffer.alloca<private> align(1) %capacity : buffer
      %used = func.call @unescape(%request, %value_begin, %value_size, %storage, %zero64) : (buffer, i64, i64, buffer, i64) -> (i64)
      %used_bounded = scalar.assume %used [range(%used, 0, 9223372036854775807)] : i64
      %used_offset = index.cast %used_bounded : i64 to offset
      %value = buffer.alloca<private> align(1) %used_offset : buffer
      buffer.copy %storage[%origin], %value[%origin], %used_offset
      scf.yield %value : buffer
    } else { scf.yield %prior : buffer }
    %custom_tools = func.call @text.equal(%key, %custom_tools_key) : (buffer, buffer) -> (i1)
    %tools_in_user = func.call @text.equal(%key, %tools_in_user_key) : (buffer, buffer) -> (i1)
    %template_kwargs = func.call @text.equal(%key, %template_kwargs_key) : (buffer, buffer) -> (i1)
    %tool_options = scalar.ori %custom_tools, %tools_in_user : i1
    %template_options = scalar.ori %tool_options, %template_kwargs : i1
    %false = scalar.constant false : i1
    %plain_template = scalar.cmpi eq, %template_options, %false : i1
    func.call @loomify.request.check(%plain_template) : (i1)
    %is_model = func.call @text.equal(%key, %model_key) : (buffer, buffer) -> (i1)
    scf.if %is_model {
      %value = func.call @text.range(%request, %value_begin, %value_size) : (buffer, i64, i64) -> (buffer)
      %checked = func.call @request_defaults(%value) : (buffer) -> (buffer)
    }
    %is_thinking = func.call @text.equal(%key, %thinking_key) : (buffer, buffer) -> (i1)
    scf.if %is_thinking {
      %false_type = scalar.constant 5 : i64
      %disabled = scalar.cmpi eq, %value_type, %false_type : i64
      func.call @loomify.request.check(%disabled) : (i1)
    }
    scf.yield %next : buffer
  }
  func.return %date : buffer
}

func.def @llama_text.empty_tools(%tools: buffer) {
  %zero64 = scalar.constant 0 : i64
  %array_type = scalar.constant 3 : i32
  %fields, %type, %count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %array = scalar.cmpi eq, %type, %array_type : i32
  %none = scalar.cmpi eq, %count, %zero64 : i64
  %valid = scalar.andi %array, %none : i1
  func.call @loomify.request.check(%valid) : (i1)
  func.return
}

func.def public @chat_begin(%request: buffer, %tools: buffer) -> (buffer, i64) {
  func.call @llama_text.empty_tools(%tools) : (buffer) -> ()
  %date = func.call @llama_text.date_value(%request) : (buffer) -> (buffer)
  %bos = global.load @llama_text.bos : buffer
  %system = global.load @llama_text.system_prefix : buffer
  %newline = global.load @llama_text.double_newline : buffer
  %empty = global.load @llama_text.empty : buffer
  %result = func.call @text.join8(%bos, %system, %date, %newline, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  // System header remains open until the first custom/default system closes.
  %state = scalar.constant 0 : i64
  func.return %result, %state : buffer, i64
}

func.def public @chat_message(%raw: buffer, %role: buffer, %content: buffer, %parts: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %four64 = scalar.constant 4 : i64
  %eight64 = scalar.constant 8 : i64
  %origin = index.constant 0 : offset
  %system_role = global.load @llama_text.system : buffer
  %user_role = global.load @llama_text.user : buffer
  %assistant_role = global.load @llama_text.assistant : buffer
  %system = func.call @text.equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %user = func.call @text.equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %assistant = func.call @text.equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %pending = scalar.cmpi eq, %state, %zero64 : i64
  %first = scalar.cmpi eq, %ordinal, %zero64 : i64
  %custom = scalar.andi %system, %first : i1
  %custom_pending = scalar.andi %custom, %pending : i1
  %ordinary = scalar.ori %user, %assistant : i1
  %known = scalar.ori %custom_pending, %ordinary : i1
  %no_fields = scalar.cmpi eq, %fields, %zero64 : i64
  %valid = scalar.andi %known, %no_fields : i1
  func.call @loomify.request.check(%valid) : (i1)
  %text = func.call @text.trim(%content) : (buffer) -> (buffer)
  %empty = global.load @llama_text.empty : buffer
  %eot = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
  %rendered = scf.if %custom_pending -> (buffer) {
    %result = func.call @text.join8(%text, %eot, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  } else {
    %before = scf.select %pending, %eot, %empty : buffer
    %open = global.load @llama_text.header_open : buffer
    %close = global.load @llama_text.header_close : buffer
    %result = func.call @text.join8(%before, %open, %role, %close, %text, %eot, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  }
  %prior_user = scalar.andi %state, %eight64 : i64
  %user_bit = scf.select %user, %eight64, %zero64 : i64
  %user_seen = scalar.ori %prior_user, %user_bit : i64
  %role_bit0 = scf.select %assistant, %two64, %zero64 : i64
  %role_bit = scf.select %user, %one64, %role_bit0 : i64
  %closed_user = scalar.ori %four64, %user_seen : i64
  %next = scalar.ori %closed_user, %role_bit : i64
  func.return %rendered, %next, %empty : buffer, i64, buffer
}

func.def public @chat_end(%state: i64) -> (buffer, i64) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %three = scalar.constant 3 : i64
  %eight = scalar.constant 8 : i64
  %user_bit = scalar.andi %state, %eight : i64
  %has_user = scalar.cmpi ne, %user_bit, %zero : i64
  %role = scalar.andi %state, %three : i64
  %last_user = scalar.cmpi eq, %role, %one : i64
  %valid = scalar.andi %has_user, %last_user : i1
  func.call @loomify.request.check(%valid) : (i1)
  %header = global.load @llama_text.assistant_header : buffer
  func.return %header, %zero : buffer, i64
}

func.def public @parse_tools(%schemas: buffer, %response: buffer) -> (buffer) {
  func.call @llama_text.empty_tools(%schemas) : (buffer) -> ()
  %empty = global.load @llama_text.empty_array : buffer
  func.return %empty : buffer
}

func.def public @render_tool(%name: buffer, %arguments: buffer, %ordinal: i64) -> (buffer, i64) {
  %no = scalar.constant false : i1
  func.call @loomify.request.check(%no) : (i1)
  %empty = global.load @llama_text.empty : buffer
  %zero = scalar.constant 0 : i64
  func.return %empty, %zero : buffer, i64
}

func.def public @output_next(%response: buffer, %previous: i64, %state: i64, %phase: i32) -> (i64, i64, i64, i64) {
  %bytes = buffer.length %response
  %end = index.cast %bytes : offset to i64
  %valid = scalar.cmpi ule, %previous, %end : i64
  func.call @loomify.request.check(%valid) : (i1)
  %content = scalar.constant 1 : i64
  func.return %content, %previous, %end, %state : i64, i64, i64, i64
}

func.def public @complete_text(%prompt: buffer, %response: buffer, %content: buffer, %reasoning: buffer, %tools: buffer, %initial_state: i64, %final_state: i64) -> (buffer, i32) {
  %text = func.call @text.trim(%content) : (buffer) -> (buffer)
  %empty = global.load @llama_text.empty : buffer
  %eot = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
  %result = func.call @text.join8(%prompt, %text, %eot, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %reusable = scalar.constant 1 : i32
  func.return %result, %reusable : buffer, i32
}

func.def public @prepare_input(%text: buffer, %media: buffer, %media_count: i64, %format: i32, %boundary: i32, %capacity: i64) -> (buffer, i64, buffer) {
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %maximum = scalar.constant 2305843009213693950 : i64
  %text_only = scalar.cmpi eq, %media_count, %zero64 : i64
  %valid_format = scalar.cmpi ule, %format, %one32 : i32
  %valid_boundary = scalar.cmpi ule, %boundary, %two32 : i32
  %valid_capacity = scalar.cmpi ule, %capacity, %maximum : i64
  %modes = scalar.andi %valid_format, %valid_boundary : i1
  %bounds = scalar.andi %text_only, %valid_capacity : i1
  %valid = scalar.andi %modes, %bounds : i1
  func.call @loomify.request.check(%valid) : (i1)
  %user = scalar.cmpi eq, %format, %one32 : i32
  %fresh = scalar.cmpi eq, %boundary, %zero32 : i32
  %open = scalar.cmpi eq, %boundary, %one32 : i32
  %empty = global.load @llama_text.empty : buffer
  %eot = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
  %separator = scf.select %open, %eot, %empty : buffer
  %rendered = scf.if %user -> (buffer) {
    %prefix = scf.if %fresh -> (buffer) {
      %bos = global.load @llama_text.bos : buffer
      %system = global.load @llama_text.system_prefix : buffer
      %date = global.load @loomify.text.fallback_date : buffer
      %newline = global.load @llama_text.double_newline : buffer
      %prefix = func.call @text.join8(%bos, %system, %date, %newline, %eot, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %prefix : buffer
    } else { scf.yield %separator : buffer }
    %content = func.call @text.trim(%text) : (buffer) -> (buffer)
    %user_header = global.load @llama_text.user_header : buffer
    %assistant_header = global.load @llama_text.assistant_header : buffer
    %result = func.call @text.join8(%prefix, %user_header, %content, %eot, %assistant_header, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  } else {
    %result = func.call @text.join8(%separator, %text, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %result : buffer
  }
  %probe_capacity = scalar.addi %capacity, %one64 : i64
  %tokens, %count = func.call @encode(%rendered, %zero32, %probe_capacity) : (buffer, i32, i64) -> (buffer, i64)
  %fits = scalar.cmpi ule, %count, %capacity : i64
  %fits32 = scalar.extui %fits : i1 to i32
  %error = global.load @llama_text.capacity_error : buffer
  func.call @require(%fits32, %error) : (i32, buffer) -> ()
  func.return %tokens, %count, %empty : buffer, i64, buffer
}

func.def public @text.validate_request(%request: buffer) {
  %date = func.call @llama_text.date_value(%request) : (buffer) -> (buffer)
  func.return
}

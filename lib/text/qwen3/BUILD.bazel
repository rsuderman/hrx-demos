load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# Selected explicitly by the external SDK consumer; no private SDK deps here.
filegroup(
    name = "revision_test_sources",
    testonly = True,
    srcs = [
        "testing/revision_cases.h",
        "testing/revision_cases.cc",
    ],
    visibility = ["//internal_consumer:__pkg__"],
)

filegroup(
    name = "reference_inputs",
    testonly = True,
    srcs = [
        "testing/render_cases.json",
        "testing/reference_adapter.py",
    ],
    visibility = ["//visibility:public"],
)

exports_files([
    "templates/5da44855.jinja",
    "testing/render_cases.json",
])

cc_test(
    name = "composition_test",
    size = "small",
    srcs = ["testing/composition_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    deps = [
        "//lib/text/testing:selected_policy",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/vm",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],

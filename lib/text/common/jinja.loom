    %bounded = scalar.assume %span [range(%span, 0, 2147483647)] : i64
    %extent = index.cast %bounded : i64 to index
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %body = scf.for %offset = [%zero to %extent step %one](%prior = %open : buffer) -> (buffer) {
      %delta = index.cast %offset : index to i64
      %i = scalar.addi %begin, %delta : i64
      %item, %item_kind = func.call @jinja.member(%value, %members, %n, %i) : (buffer, buffer, i64, i64) -> (buffer, i64)
      %serialized = func.call @jinja.tojson(%item, %item_kind, %default_indent) : (buffer, i64, i64) -> (buffer)
      %first = scalar.cmpi eq, %i, %begin : i64
      %prefix = scf.if %first -> (buffer) {
        scf.yield %prior : buffer
      } else {
        %joined = func.call @jinja.join(%prior, %comma) : (buffer, buffer) -> (buffer)
        scf.yield %joined : buffer
      }
      %next = func.call @jinja.join(%prefix, %serialized) : (buffer, buffer) -> (buffer)
      scf.yield %next : buffer
    }
    %text = func.call @jinja.join(%body, %close) : (buffer, buffer) -> (buffer)
    scf.yield %text : buffer
  }
  func.return %output, %kind : buffer, i64
}

func.def public @jinja.truth(%value: buffer, %kind: i64) -> (i1) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %three64 = scalar.constant 3 : i64
  %four64 = scalar.constant 4 : i64
  %string = scalar.cmpi eq, %kind, %zero64 : i64
  %object = scalar.cmpi eq, %kind, %two64 : i64
  %array = scalar.cmpi eq, %kind, %three64 : i64
  %container = scalar.ori %object, %array : i1
  %sized = scalar.ori %string, %container : i1
  %truth = scf.if %sized -> (i1) {
    %count = func.call @jinja.length(%value, %kind) : (buffer, i64) -> (i64)
    %nonempty = scalar.cmpi ne, %count, %zero64 : i64
    scf.yield %nonempty : i1
  } else {
    %number = scalar.cmpi eq, %kind, %one64 : i64
    %result = scf.if %number -> (i1) {
      %bytes = buffer.length %value
      %length = index.cast %bytes : offset to i64
      %number = func.call @parse_f64(%value, %zero64, %length) : (buffer, i64, i64) -> (f64)
      %zero = scalar.constant 0.0 : f64
      %nonzero = scalar.cmpf une, %number, %zero : f64
      scf.yield %nonzero : i1
    } else {
      %yes = scalar.cmpi eq, %kind, %four64 : i64
      scf.yield %yes : i1
    }
    scf.yield %result : i1
  }
  func.return %truth : i1
}

func.def public @jinja.integer(%value: i64) -> (buffer) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %ten = scalar.constant 10 : i64
  %ascii_zero = scalar.constant 48 : i64
  %negative = scalar.cmpi slt, %value, %zero64 : i64
  // Unsigned magnitude keeps INT64_MIN representable without signed negation.
  %negated = scalar.subi %zero64, %value : i64
  %magnitude = scf.select %negative, %negated, %value : i64
  %capacity = index.constant 21 : offset
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %storage = buffer.alloca<private> align(1) %capacity : buffer
  %true = scalar.constant true : i1
  %number, %start, %again = scf.while(%number = %magnitude : i64, %position = %capacity : offset, %again = %true : i1) -> (i64, offset, i1) {
    scf.condition %again, %number, %position, %again : i1, i64, offset, i1
  } do(%number: i64, %position: offset, %again: i1) {
    %digit = scalar.remui %number, %ten : i64
    %quotient = scalar.divui %number, %ten : i64
    %ascii = scalar.addi %digit, %ascii_zero : i64
    %byte = scalar.trunci %ascii : i64 to i32
    %prior = index.sub %position, %one : offset
    buffer.store.i8 %byte, %storage[%prior]
    %more = scalar.cmpi ne, %quotient, %zero64 : i64
    scf.yield %quotient, %prior, %more : i64, offset, i1
  }
  %first = scf.if %negative -> (offset) {
    %minus = scalar.constant 45 : i32
    %first = index.sub %start, %one : offset
    buffer.store.i8 %minus, %storage[%first]
    scf.yield %first : offset
  } else {
    scf.yield %start : offset
  }
  %length = index.sub %capacity, %first : offset
  %first64 = index.cast %first : offset to i64
  %length64 = index.cast %length : offset to i64
  %output = func.call @text.range(%storage, %first64, %length64) : (buffer, i64, i64) -> (buffer)
  func.return %output : buffer
}

func.def public @jinja.tointeger(%value: buffer, %kind: i64) -> (i64) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %four = scalar.constant 4 : i64
  %five = scalar.constant 5 : i64
  %numeric = scalar.cmpi eq, %kind, %one : i64
  %number = scf.if %numeric -> (i64) {
    %bytes = buffer.length %value
    %length = index.cast %bytes : offset to i64
    %parsed = func.call @parse_i64(%value, %zero, %length) : (buffer, i64, i64) -> (i64)
    scf.yield %parsed : i64
  } else {
    %true = scalar.cmpi eq, %kind, %four : i64
    %false = scalar.cmpi eq, %kind, %five : i64
    %boolean = scalar.ori %true, %false : i1
    func.call @jinja.check(%boolean) : (i1)
    %integer = scf.select %true, %one, %zero : i64
    scf.yield %integer : i64
  }
  func.return %number : i64
}

func.def public @jinja.string(%value: buffer, %kind: i64) -> (buffer) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %four = scalar.constant 4 : i64
  %five = scalar.constant 5 : i64
  %six = scalar.constant 6 : i64
  %seven = scalar.constant 7 : i64
  %string = scalar.cmpi eq, %kind, %zero : i64
  %number = scalar.cmpi eq, %kind, %one : i64
  %result = scf.if %string -> (buffer) {
    scf.yield %value : buffer
  } else {
    %result = scf.if %number -> (buffer) {
      // Match Python's integer -0 -> 0; floating lexemes retain their deferred
      // spelling, independently of JSON's integer normalization.
      %canonical = func.call @text.json_dump(%value) : (buffer) -> (buffer)
      scf.yield %canonical : buffer
    } else {
      %is_true = scalar.cmpi eq, %kind, %four : i64
      %is_false = scalar.cmpi eq, %kind, %five : i64
      %is_none = scalar.cmpi eq, %kind, %six : i64
      %is_missing = scalar.cmpi eq, %kind, %seven : i64
      %boolean = scalar.ori %is_true, %is_false : i1
      %emptyish = scalar.ori %is_none, %is_missing : i1
      %supported = scalar.ori %boolean, %emptyish : i1
      func.call @jinja.check(%supported) : (i1)
      %yes = global.load @jinja.true : buffer
      %no = global.load @jinja.false : buffer
      %none = global.load @jinja.none : buffer
      %empty = global.load @jinja.empty : buffer
      %base = scf.select %is_none, %none, %empty : buffer
      %without_true = scf.select %is_false, %no, %base : buffer
      %text = scf.select %is_true, %yes, %without_true : buffer
      scf.yield %text : buffer
    }
    scf.yield %result : buffer
  }
  func.return %result : buffer
}

func.def public @jinja.trim(%value: buffer, %kind: i64) -> (buffer, i64) {
  %string = func.call @jinja.string(%value, %kind) : (buffer, i64) -> (buffer)
  %trimmed = func.call @text.trim(%string) : (buffer) -> (buffer)
  %string_kind = scalar.constant 0 : i64
  func.return %trimmed, %string_kind : buffer, i64
}

func.def public @jinja.add_integer(%a: i64, %b: i64) -> (i64) {
  %zero = scalar.constant 0 : i64
  %false = scalar.constant false : i1
  %result = scalar.addi %a, %b : i64
  %a_negative = scalar.cmpi slt, %a, %zero : i64
  %b_negative = scalar.cmpi slt, %b, %zero : i64
  %result_negative = scalar.cmpi slt, %result, %zero : i64
  %same_sign = scalar.cmpi eq, %a_negative, %b_negative : i1
  %changed_sign = scalar.cmpi ne, %a_negative, %result_negative : i1
  %overflow = scalar.andi %same_sign, %changed_sign : i1
  %valid = scalar.cmpi eq, %overflow, %false : i1
  func.call @jinja.check(%valid) : (i1)
  func.return %result : i64
}

func.def public @jinja.remainder(%a: i64, %b: i64) -> (i64) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %minus_one = scalar.constant -1 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %nonzero = scalar.cmpi ne, %b, %zero : i64
  func.call @jinja.check(%nonzero) : (i1)
  // Keep remsi itself defined even during constant specialization of a rejected
  // zero divisor or the valid INT64_MIN % -1 edge case.
  %a_minimum = scalar.cmpi eq, %a, %minimum : i64
  %b_minus_one = scalar.cmpi eq, %b, %minus_one : i64
  %overflow_pair = scalar.andi %a_minimum, %b_minus_one : i1
  %nonzero_divisor = scf.select %nonzero, %b, %one : i64
  %safe_divisor = scf.select %overflow_pair, %one, %nonzero_divisor : i64
  %remainder = scalar.remsi %a, %safe_divisor : i64
  %has_remainder = scalar.cmpi ne, %remainder, %zero : i64
  %remainder_negative = scalar.cmpi slt, %remainder, %zero : i64
  %divisor_negative = scalar.cmpi slt, %b, %zero : i64
  %different_sign = scalar.cmpi ne, %remainder_negative, %divisor_negative : i1
  %adjust = scalar.andi %has_remainder, %different_sign : i1
  %result = scf.if %adjust -> (i64) {
    %python_remainder = scalar.addi %remainder, %b : i64
    scf.yield %python_remainder : i64
  } else {
    scf.yield %remainder : i64
  }
  func.return %result : i64
}

func.def public @jinja.add(%a: buffer, %ak: i64, %b: buffer, %bk: i64) -> (buffer, i64) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %three = scalar.constant 3 : i64
  %four = scalar.constant 4 : i64
  %five = scalar.constant 5 : i64
  %a_string = scalar.cmpi eq, %ak, %zero : i64
  %b_string = scalar.cmpi eq, %bk, %zero : i64
  %strings = scalar.andi %a_string, %b_string : i1
  %result, %kind = scf.if %strings -> (buffer, i64) {
    %joined = func.call @jinja.join(%a, %b) : (buffer, buffer) -> (buffer)
    scf.yield %joined, %zero : buffer, i64
  } else {
    %a_array = scalar.cmpi eq, %ak, %three : i64
    %b_array = scalar.cmpi eq, %bk, %three : i64
    %arrays = scalar.andi %a_array, %b_array : i1
    %result, %result_kind = scf.if %arrays -> (buffer, i64) {
      %joined = func.call @jinja.concat_arrays(%a, %b) : (buffer, buffer) -> (buffer)
      scf.yield %joined, %three : buffer, i64
    } else {
      %a_number = scalar.cmpi eq, %ak, %one : i64
      %a_true = scalar.cmpi eq, %ak, %four : i64
      %a_false = scalar.cmpi eq, %ak, %five : i64
      %a_boolean = scalar.ori %a_true, %a_false : i1
      %a_numeric = scalar.ori %a_number, %a_boolean : i1
      %b_number = scalar.cmpi eq, %bk, %one : i64
      %b_true = scalar.cmpi eq, %bk, %four : i64
      %b_false = scalar.cmpi eq, %bk, %five : i64
      %b_boolean = scalar.ori %b_true, %b_false : i1
      %b_numeric = scalar.ori %b_number, %b_boolean : i1
      %numeric = scalar.andi %a_numeric, %b_numeric : i1
      func.call @jinja.check(%numeric) : (i1)
      %a_text = func.call @jinja.numeric_text(%a, %ak) : (buffer, i64) -> (buffer)
      %b_text = func.call @jinja.numeric_text(%b, %bk) : (buffer, i64) -> (buffer)
      %a_integer = func.call @jinja.is_integer(%a_text) : (buffer) -> (i1)
      %b_integer = func.call @jinja.is_integer(%b_text) : (buffer) -> (i1)
      %integers = scalar.andi %a_integer, %b_integer : i1
      func.call @jinja.check(%integers) : (i1)
      %a_value = func.call @jinja.tointeger(%a_text, %one) : (buffer, i64) -> (i64)
      %b_value = func.call @jinja.tointeger(%b_text, %one) : (buffer, i64) -> (i64)
      %sum = func.call @jinja.add_integer(%a_value, %b_value) : (i64, i64) -> (i64)
      %text = func.call @jinja.integer(%sum) : (i64) -> (buffer)
      scf.yield %text, %one : buffer, i64
    }
    scf.yield %result, %result_kind : buffer, i64
  }
  func.return %result, %kind : buffer, i64
}

func.def @jinja.numeric_text(%value: buffer, %kind: i64) -> (buffer) {
  %one = scalar.constant 1 : i64
  %four = scalar.constant 4 : i64
  %true = scalar.cmpi eq, %kind, %four : i64
  %number = scalar.cmpi eq, %kind, %one : i64
  %result = scf.if %number -> (buffer) {
    scf.yield %value : buffer
  } else {
    %zero = scalar.constant 0 : i64
    %boolean = scf.select %true, %one, %zero : i64
    %text = func.call @jinja.integer(%boolean) : (i64) -> (buffer)
    scf.yield %text : buffer
  }
  func.return %result : buffer
}

func.def @jinja.is_integer(%text: buffer) -> (i1) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %length = buffer.length %text
  %true = scalar.constant true : i1
  %dot = scalar.constant 46 : i32
  %upper = scalar.constant 69 : i32
  %lower = scalar.constant 101 : i32
  %integer = scf.for %p = [%zero to %length step %one](%prior = %true : i1) -> (i1) {
    %c = buffer.load.i8.u %text[%p]
    %is_dot = scalar.cmpi eq, %c, %dot : i32
    %is_upper = scalar.cmpi eq, %c, %upper : i32
    %is_lower = scalar.cmpi eq, %c, %lower : i32
    %exp = scalar.ori %is_upper, %is_lower : i1
    %floating = scalar.ori %is_dot, %exp : i1
    %not_float = scalar.cmpi eq, %floating, %true : i1
    %false = scalar.constant false : i1
    %next = scf.select %not_float, %false, %prior : i1
    scf.yield %next : i1
  }
  func.return %integer : i1
}

// Comparing a large integer through f64 could turn unequal values into equal
// values. B supports mixed numeric equality only in the exact integer range;
// reject the unsupported case instead of silently rounding either operand.
func.def @jinja.check_exact_float_integer(%text: buffer) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : offset
  %sixteen = index.constant 16 : offset
  %length = buffer.length %text
  %first = buffer.load.i8.u %text[%zero]
  %minus = scalar.constant 45 : i32
  %negative = scalar.cmpi eq, %first, %minus : i32
  %begin = scf.select %negative, %one, %zero : offset
  %digits = index.sub %length, %begin : offset
  %shorter = index.cmp ult, %digits, %sixteen : offset
  %same_length = index.cmp eq, %digits, %sixteen : offset
  %valid = scf.if %same_length -> (i1) {
    %limit = global.load @jinja.exact_integer_limit : buffer
    %compared = buffer.compare %text[%begin], %limit[%zero], %sixteen
    %zero32 = scalar.constant 0 : i32
    %fits = scalar.cmpi sle, %compared, %zero32 : i32
    scf.yield %fits : i1
  } else {
    scf.yield %shorter : i1
  }
  func.call @jinja.check(%valid) : (i1)
  func.return
}

func.def public @jinja.equal(%a: buffer, %ak: i64, %b: buffer, %bk: i64) -> (i1) {
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %two = scalar.constant 2 : i64
  %three = scalar.constant 3 : i64
  %four = scalar.constant 4 : i64
  %five = scalar.constant 5 : i64
  %a_number = scalar.cmpi eq, %ak, %one : i64
  %a_true = scalar.cmpi eq, %ak, %four : i64
  %a_false = scalar.cmpi eq, %ak, %five : i64
  %a_bool = scalar.ori %a_true, %a_false : i1
  %a_numeric = scalar.ori %a_number, %a_bool : i1
  %b_number = scalar.cmpi eq, %bk, %one : i64
  %b_true = scalar.cmpi eq, %bk, %four : i64
  %b_false = scalar.cmpi eq, %bk, %five : i64
  %b_bool = scalar.ori %b_true, %b_false : i1
  %b_numeric = scalar.ori %b_number, %b_bool : i1
  %both_numeric = scalar.andi %a_numeric, %b_numeric : i1
  %result = scf.if %both_numeric -> (i1) {
    %at = func.call @jinja.numeric_text(%a, %ak) : (buffer, i64) -> (buffer)
    %bt = func.call @jinja.numeric_text(%b, %bk) : (buffer, i64) -> (buffer)
    %ai = func.call @jinja.is_integer(%at) : (buffer) -> (i1)
    %bi = func.call @jinja.is_integer(%bt) : (buffer) -> (i1)
    %integers = scalar.andi %ai, %bi : i1
    %equal = scf.if %integers -> (i1) {
      // Keep large integer lexemes exact; dump also canonicalizes integer -0.
      %ac = func.call @text.json_dump(%at) : (buffer) -> (buffer)
      %bc = func.call @text.json_dump(%bt) : (buffer) -> (buffer)
      %same = func.call @text.equal(%ac, %bc) : (buffer, buffer) -> (i1)
      scf.yield %same : i1
    } else {
      %mixed = scalar.xori %ai, %bi : i1
      scf.if %mixed {
        %integer = scf.select %ai, %at, %bt : buffer
        func.call @jinja.check_exact_float_integer(%integer) : (buffer)
      }
      %al = buffer.length %at
      %bl = buffer.length %bt
      %al64 = index.cast %al : offset to i64
      %bl64 = index.cast %bl : offset to i64
      %av = func.call @parse_f64(%at, %zero, %al64) : (buffer, i64, i64) -> (f64)
      %bv = func.call @parse_f64(%bt, %zero, %bl64) : (buffer, i64, i64) -> (f64)
      %same = scalar.cmpf oeq, %av, %bv : f64
      scf.yield %same : i1
    }
    scf.yield %equal : i1
  } else {
    %same_kind = scalar.cmpi eq, %ak, %bk : i64
    %same = scf.if %same_kind -> (i1) {
      %a_string = scalar.cmpi eq, %ak, %zero : i64
      %a_object = scalar.cmpi eq, %ak, %two : i64
      %a_array = scalar.cmpi eq, %ak, %three : i64
      %container = scalar.ori %a_object, %a_array : i1
      %ordinary = scalar.ori %a_string, %container : i1
      %value = scf.if %ordinary -> (i1) {
        %equal = scf.if %container -> (i1) {
          // The first complete-template witness compares scalar values only.
          // Object-order and nested numeric equality need structural semantics;
          // do not pretend canonical JSON byte equality implements them.
          %false = scalar.constant false : i1
          func.call @jinja.check(%false) : (i1)
          scf.yield %false : i1
        } else {
          %equal = func.call @text.equal(%a, %b) : (buffer, buffer) -> (i1)
          scf.yield %equal : i1
        }
        scf.yield %equal : i1
      } else {
        %true = scalar.constant true : i1
        scf.yield %true : i1
      }
      scf.yield %value : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    scf.yield %same : i1
  }
  func.return %result : i1
}

func.def public @jinja.contains(%container: buffer, %kind: i64, %item: buffer, %item_kind: i64) -> (i1) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %three64 = scalar.constant 3 : i64
  %seven64 = scalar.constant 7 : i64
  %object = scalar.cmpi eq, %kind, %two64 : i64
  %string = scalar.cmpi eq, %kind, %zero64 : i64
  %array = scalar.cmpi eq, %kind, %three64 : i64
  %undefined = scalar.cmpi eq, %kind, %seven64 : i64
  %container_ok = scalar.ori %object, %array : i1
  %stringish = scalar.ori %string, %undefined : i1
  %supported = scalar.ori %container_ok, %stringish : i1
  func.call @jinja.check(%supported) : (i1)
  %found = scf.if %object -> (i1) {
    %key_valid = scalar.cmpi eq, %item_kind, %zero64 : i64
    %yes = scf.if %key_valid -> (i1) {
      %value, %type, %found = func.call @text.lookup(%container, %item) : (buffer, buffer) -> (buffer, i64, i1)
      scf.yield %found : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    scf.yield %yes : i1
  } else {
    %found = scf.if %string -> (i1) {
      %key_valid = scalar.cmpi eq, %item_kind, %zero64 : i64
      func.call @jinja.check(%key_valid) : (i1)
      %length = buffer.length %container
      %needle = buffer.length %item
      %fits = index.cmp ule, %needle, %length : offset
      %found = scf.if %fits -> (i1) {
        %zero = index.constant 0 : offset
        %one = index.constant 1 : offset
        %last = index.sub %length, %needle : offset
        %end = index.add %last, %one : offset
        %false = scalar.constant false : i1
        %found = scf.for %p = [%zero to %end step %one](%prior = %false : i1) -> (i1) {
          %comparison = buffer.compare %container[%p], %item[%zero], %needle
          %zero32 = scalar.constant 0 : i32
          %same = scalar.cmpi eq, %comparison, %zero32 : i32
          %next = scalar.ori %prior, %same : i1
          scf.yield %next : i1
        }
        scf.yield %found : i1
      } else {
        %false = scalar.constant false : i1
        scf.yield %false : i1
      }
      scf.yield %found : i1
    } else {
      %found = scf.if %array -> (i1) {
        %members, %type, %count = func.call @members(%container) : (buffer) -> (buffer, i32, i64)
        %bounded = scalar.assume %count [range(%count, 0, 2147483647)] : i64
        %extent = index.cast %bounded : i64 to index
        %zero = index.constant 0 : index
        %one = index.constant 1 : index
        %false = scalar.constant false : i1
        %found = scf.for %p = [%zero to %extent step %one](%prior = %false : i1) -> (i1) {
          %i = index.cast %p : index to i64
          %value, %value_kind = func.call @jinja.member(%container, %members, %count, %i) : (buffer, buffer, i64, i64) -> (buffer, i64)
          %same = func.call @jinja.equal(%value, %value_kind, %item, %item_kind) : (buffer, i64, buffer, i64) -> (i1)
          %next = scalar.ori %prior, %same : i1
          scf.yield %next : i1
        }
        scf.yield %found : i1
      } else {
        %false = scalar.constant false : i1

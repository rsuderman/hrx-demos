  %empty = global.load @jinja.empty : buffer
  %result = scf.for %i = [%zero to %count step %one](%prior = %empty : buffer) -> (buffer) {
    %ordinal = index.cast %i : index to i64
    %item, %item_kind = func.call @jinja.index_sequence(%sequence, %sequence_kind, %ordinal) : (buffer, i64, i64) -> (buffer, i64)
    %text = func.call @jinja.string(%item, %item_kind) : (buffer, i64) -> (buffer)
    %first = index.cmp eq, %i, %zero : index
    %prefix = scf.if %first -> (buffer) {
      scf.yield %prior : buffer
    } else {
      %delimited = func.call @jinja.join(%prior, %delimiter) : (buffer, buffer) -> (buffer)
      scf.yield %delimited : buffer
    }
    %next = func.call @jinja.join(%prefix, %text) : (buffer, buffer) -> (buffer)
    scf.yield %next : buffer
  }
  func.return %result, %zero64 : buffer, i64
}

// Consume the supported reject-equalto iterable in its immediate join/list
// consumer. The delimiter is already coerced before source iteration starts.
// Falsy inputs are empty, matching Jinja's select/reject iterable conversion.
func.def public @jinja.reject_equalto(%value: buffer, %kind: i64, %rejected: buffer, %rejected_kind: i64, %joined: i1, %delimiter: buffer) -> (buffer, i64) {
  %zero64 = scalar.constant 0 : i64
  %three = scalar.constant 3 : i64
  %compact = scalar.constant -2 : i64
  %open = global.load @jinja.open_array : buffer
  %close = global.load @jinja.close_array : buffer
  %comma = global.load @jinja.comma : buffer
  %empty = global.load @jinja.empty : buffer
  %begin = scf.select %joined, %empty, %open : buffer
  %end = scf.select %joined, %empty, %close : buffer
  %between = scf.select %joined, %delimiter, %comma : buffer
  %truth = func.call @jinja.truth(%value, %kind) : (buffer, i64) -> (i1)
  %body = scf.if %truth -> (buffer) {
    %sequence, %sequence_kind = func.call @jinja.list(%value, %kind) : (buffer, i64) -> (buffer, i64)
    // list owns a JSON array. Consume its checked member table directly instead
    // of redispatching this guaranteed array through generic sequence helpers.
    %members, %type, %length = func.call @members(%sequence) : (buffer) -> (buffer, i32, i64)
    %bounded = scalar.assume %length [range(%length, 0, 2147483647)] : i64
    %count = index.cast %bounded : i64 to offset
    %zero = index.constant 0 : offset
    %one = index.constant 1 : offset
    %result, %unused_separator = scf.for %i = [%zero to %count step %one](%prior = %begin : buffer, %separator = %empty : buffer) -> (buffer, buffer) {
      %ordinal = index.cast %i : offset to i64
      %item, %item_kind = func.call @jinja.member(%sequence, %members, %length, %ordinal) : (buffer, buffer, i64, i64) -> (buffer, i64)
      %equal = func.call @jinja.equal(%item, %item_kind, %rejected, %rejected_kind) : (buffer, i64, buffer, i64) -> (i1)
      %next, %next_separator = scf.if %equal -> (buffer, buffer) {
        scf.yield %prior, %separator : buffer, buffer
      } else {
        %prefix = func.call @jinja.join(%prior, %separator) : (buffer, buffer) -> (buffer)
        %text = scf.if %joined -> (buffer) {
          %text = func.call @jinja.string(%item, %item_kind) : (buffer, i64) -> (buffer)
          scf.yield %text : buffer
        } else {
          %json = func.call @jinja.tojson(%item, %item_kind, %compact) : (buffer, i64, i64) -> (buffer)
          scf.yield %json : buffer
        }
        %next = func.call @jinja.join(%prefix, %text) : (buffer, buffer) -> (buffer)
        scf.yield %next, %between : buffer, buffer
      }
      scf.yield %next, %next_separator : buffer, buffer
    }
    scf.yield %result : buffer
  } else {
    scf.yield %begin : buffer
  }
  %result = func.call @jinja.join(%body, %end) : (buffer, buffer) -> (buffer)
  %result_kind = scf.select %joined, %zero64, %three : i64
  func.return %result, %result_kind : buffer, i64
}

load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")
package(default_visibility = ["//visibility:public"])
iree_cc_library(
    name = "registry",
    srcs = ["registry.cc"], hdrs = ["registry.h"],
    cxxopts = ["-std=c++17"],
    deps = [
        "//lib/operations:operation_graph",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c:interop",
        "@hrx_system//loom/src/loom/ir",
        "@hrx_system//loom/src/loom/ops:op_defs",
        "@hrx_system//loom/src/loom/ops/template",
        "@hrx_system//loom/src/loom/ops/config",
        "@hrx_system//loom/src/loom/ops/kernel",
    ],
)
iree_cc_library(
    name = "invocation",
    srcs = ["invocation.cc"], hdrs = ["invocation.h"],
    cxxopts = ["-std=c++17"],
    deps = [
        ":registry", "//lib/dispatch/shapes:result",
        "//tools/loomify-gguf/authoring/commands:command_values",
        "@hrx_system//loom/src/loom/ops/config",
        "@hrx_system//loom/binding/c:loomc",
    ],
)

iree_cc_library(
    name = "parameters",
    srcs = ["parameters.cc"], hdrs = ["parameters.h"],
    cxxopts = ["-std=c++17"],
    deps = [":invocation", "//lib/llama:structure"],
)

iree_cc_library(
    name = "llama_region",
    srcs = ["llama_region.cc"], hdrs = ["llama_region.h"],
    cxxopts = ["-std=c++17"],
    deps = [":invocation", ":parameters", "//lib/llama:structure"],
)

load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
loom_library(name = "profile", srcs = ["gdn_config.loom"])
loom_test(
    name = "gdn_core_execution_test",
    srcs = ["core_checks.loom"],
    deps = ["//lib/kernels/qwen/gdn:core", "//lib/kernels/qwen:spans", ":profile"],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)

cc_test(
    name = "registration_test", size = "small", srcs = ["registration_test.cc"],
    copts = ["-std=c++17"], linkstatic = True,
    data = ["//lib/kernels/qwen/gdn:all_sources"],
    deps = ["//lib/dispatch:qwen_gdn", "//lib/dispatch:registry",
            "//lib/dispatch/shapes:result", "//lib/qwen:structure",
            "//lib/qwen/testing:model_fixture", "//lib/operations:qwen_operations",
            "@hrx_system//loom/binding/c:interop",
            "@hrx_system//loom/binding/c/target/amdgpu",
            "@googletest//:gtest", "@googletest//:gtest_main"],
)

cc_test(
    name = "emission_test", size = "small", srcs = ["emission_test.cc"],
    copts = ["-std=c++17"], linkstatic = True,
    data = ["//lib/kernels/qwen/gdn:all_sources", "//lib/kernels/qwen:all_sources",
            "//lib/kernels/llama:all_sources"],
    deps = ["//lib/dispatch:qwen_gdn", "//lib/dispatch:registry", "//lib/dispatch:invocation",
            "//lib/dispatch/shapes:result", "//lib/qwen:structure",
            "//lib/qwen/testing:model_fixture", "//tools/model:qwen_configuration", "//lib/operations:qwen_operations",
            "@hrx_system//loom/binding/c:interop",
            "@hrx_system//loom/binding/c/target/amdgpu",
            "@googletest//:gtest", "@googletest//:gtest_main"],
)

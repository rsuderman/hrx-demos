load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
cc_binary(
    name = "emit_output", testonly = True, srcs = ["emit_output.cc"], cxxopts = ["-std=c++17"],
    deps = ["//lib/dispatch:registry", "//lib/dispatch:invocation", "//lib/operations:qwen_operations", "//lib/operations:tensor_operations", "//lib/qwen/testing:model_fixture", "@hrx_system//loom/binding/c/target/amdgpu", "@hrx_system//loom/src/loom/ops/buffer", "@hrx_system//loom/src/loom/ops/index"],
)
[genrule(
    name = "module_t%d" % t, testonly = True,
    srcs = ["nontrivial.loom", "//lib/kernels/qwen:all_sources", "//lib/kernels/llama:all_sources"],
    outs = ["output_t%d.loombc" % t, "output_t%d.loom" % t],
    cmd = "$(location :emit_output) . %d $(location output_t%d.loombc) $(location output_t%d.loom)" % (t,t,t),
    tools = [":emit_output"],
) for t in [1,4]]

[loom_test(
    name = "execution_t%d_%s" % (t,format),
    srcs = ["checks_t%d.loom" % t, "output_t%d.%s" % (t,format)],
    benchmark_smoke = False, execution_profiles = [AMDGPU_HARDWARE_PROFILE],
) for t in [1,4] for format in ["loom","loombc"]]

cc_test(
    name = "admission_test", size = "small", srcs = ["admission_test.cc"], copts = ["-std=c++17"], linkstatic = True,
    data = ["//lib/kernels/qwen:all_sources", "//lib/kernels/llama:all_sources"],
    deps = ["//lib/dispatch:registry", "//lib/operations:qwen_operations", "//lib/operations:tensor_operations", "//lib/qwen/testing:model_fixture", "@hrx_system//loom/binding/c/target/amdgpu", "@googletest//:gtest", "@googletest//:gtest_main"],
)

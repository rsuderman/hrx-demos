command.program.def @norm_last() launch(%input: buffer, %gamma: buffer, %control: buffer, %output: buffer) {
  %capacity = index.constant 4 : index
  %begin = index.constant 1 : index
  %origin = index.constant 0 : offset
  kernel.launch @llama32_output_norm_last_f32[%capacity](%capacity, %begin, %origin, %control, %input, %gamma, %output) : [index](index, index, offset, buffer, buffer, buffer, buffer)
  command.return
}
// Control count=2, begin=1 selects source row2 and writes destination row0.
func.def @ref_norm_last(%input: buffer, %gamma: buffer, %control: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %x = buffer.view %input[%origin] : buffer -> view<4x3072xf32>
  %g = buffer.view %gamma[%origin] : buffer -> view<3072xf32>
  %y = buffer.view %output[%origin] : buffer -> view<1x3072xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %row = index.constant 2 : index
  %width = index.constant 3072 : index
  %zero_f = scalar.constant 0.0 : f32
  %width_f = scalar.constant 3072.0 : f32
  %epsilon = scalar.constant 0.00001 : f32
  %sum = scf.for %c = [%zero to %width step %one](%partial = %zero_f : f32) -> (f32) {
    %v = view.load %x[%row, %c] : view<4x3072xf32> -> f32
    %square = scalar.mulf %v, %v : f32
    %next = scalar.addf %partial, %square : f32
    scf.yield %next : f32
  }
  %mean = scalar.divf %sum, %width_f : f32
  %shifted = scalar.addf %mean, %epsilon : f32
  %scale = scalar.rsqrtf %shifted : f32
  scf.for %c = [%zero to %width step %one] {
    %v = view.load %x[%row, %c] : view<4x3072xf32> -> f32
    %weight = view.load %g[%c] : view<3072xf32> -> f32
    %normalized = scalar.mulf %v, %scale : f32
    %norm = scalar.mulf %normalized, %weight : f32
    view.store %norm, %y[0, %c] : f32, view<1x3072xf32>
  }
  func.return
}
check.scenario @last_active_rebases_to_zero {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<12288xf32>
    %gamma = check.generate.iota offset(0.5) step(0.0001) : tensor<3072xf32>
    %control = check.generate.fill value(2) : tensor<1xi32>
    %storage = check.generate.fill value(-99.0) : tensor<3076xf32>
    %output = check.tensor.view %storage offset(8) : tensor<3076xf32> -> tensor<3072xf32>
    check.compare<@norm_last, @ref_norm_last>(%input, %gamma, %control, %output) : (tensor<12288xf32>, tensor<3072xf32>, tensor<1xi32>, tensor<3072xf32>) -> () {
      check.expect.close actual(%storage) expected(%storage) atol(0.00005) rtol(0.00005) nan(same) : tensor<3076xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<12288xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
      check.expect.bitwise actual(%control) expected(%control) : tensor<1xi32>
    }
  }
  check.return
}
// The full fused definition runs bounded synthetic Q6_K weights. Every weight
// row is identical and nonzero, so the independent expected greedy ID is0.
// Row selection/normalization is separately checked against a scalar oracle.
template.decl @llm.output.last_greedy(%capacity: index, %begin: index, %origin: offset, %hidden: index, %vocab: index, %weight_bytes: index, %q8_bytes: offset, %logit_bytes: offset, %partial_bytes: offset, %input: buffer, %control: buffer, %gamma: view<[%hidden]xf32>, %weight: view<[%weight_bytes]xi8>, %normalized: buffer, %token: buffer)
command.program.def @bounded_fused_head() launch(%input: buffer, %control: buffer, %gamma: buffer, %weights: buffer, %normalized: buffer, %token: buffer) {
  %capacity = index.constant 4 : index
  %begin = index.constant 1 : index
  %origin = index.constant 0 : offset
  %hidden = index.constant 3072 : index
  %vocab = index.constant 256 : index
  %weight_bytes = index.constant 645120 : index
  %q8_bytes = index.constant 3456 : offset
  %logit_bytes = index.constant 1024 : offset
  %partial_bytes = index.constant 4 : offset
  %weight = buffer.view %weights[%origin] : buffer -> view<[%weight_bytes]xi8>
  %gamma_view = buffer.view %gamma[%origin] : buffer -> view<[%hidden]xf32>
  template.apply<@llm.output.last_greedy>(%capacity, %begin, %origin, %hidden, %vocab, %weight_bytes, %q8_bytes, %logit_bytes, %partial_bytes, %input, %control, %gamma_view, %weight, %normalized, %token) : (index, index, offset, index, index, index, offset, offset, offset, buffer, buffer, view<[%hidden]xf32>, view<[%weight_bytes]xi8>, buffer, buffer)
  command.return
}
func.def @ref_bounded_head(%input: buffer, %control: buffer, %gamma: buffer, %weights: buffer, %normalized: buffer, %token: buffer) {
  %origin = index.constant 0 : offset
  %ids = buffer.view %token[%origin] : buffer -> view<1xi32>
  %zero = scalar.constant 0 : i32
  view.store %zero, %ids[0] : i32, view<1xi32>
  func.return
}
check.scenario @bounded_fused_greedy {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<12288xf32>
    %gamma = check.generate.fill value(1.0) : tensor<3072xf32>
    %control = check.generate.fill value(2) : tensor<1xi32>
    %weight = check.generate.fill value(1) : tensor<645120xi8>
    %normalized = check.generate.fill value(-99.0) : tensor<3072xf32>
    %token = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@bounded_fused_head, @ref_bounded_head>(%input, %control, %gamma, %weight, %normalized, %token) : (tensor<12288xf32>, tensor<1xi32>, tensor<3072xf32>, tensor<645120xi8>, tensor<3072xf32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%token) expected(%token) : tensor<1xi32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<645120xi8>
      check.expect.bitwise actual(%input) expected(%input) : tensor<12288xf32>
      check.expect.bitwise actual(%control) expected(%control) : tensor<1xi32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
    }
  }
  check.return
}

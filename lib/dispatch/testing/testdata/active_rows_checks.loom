// Existing independent scalar references adapted only for compact-input and
// active-output coordinates. Actual roots come from NativeEmissionSession.
command.program.decl @active.norm() launch(%input: buffer, %gamma: buffer, %control: buffer, %output: buffer)
func.def @reference_norm(%input: buffer, %gamma: buffer, %control: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %x = buffer.view %input[%origin] : buffer -> view<3x3072xf32>
  %g = buffer.view %gamma[%origin] : buffer -> view<3072xf32>
  %y = buffer.view %output[%origin] : buffer -> view<8x3072xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 3 : index
  %begin = index.constant 2 : index
  %width = index.constant 3072 : index
  %zero_f = scalar.constant 0.0 : f32
  %width_f = scalar.constant 3072.0 : f32
  %epsilon = scalar.constant 0.00001 : f32
  scf.for %r = [%zero to %two step %one] {
    %destination = index.add %r, %begin : index
    %sum = scf.for %c = [%zero to %width step %one](%partial = %zero_f : f32) -> (f32) {
      %v = view.load %x[%r, %c] : view<3x3072xf32> -> f32
      %square = scalar.mulf %v, %v : f32
      %next = scalar.addf %partial, %square : f32
      scf.yield %next : f32
    }
    %mean = scalar.divf %sum, %width_f : f32
    %shifted = scalar.addf %mean, %epsilon : f32
    %scale = scalar.rsqrtf %shifted : f32
    scf.for %c = [%zero to %width step %one] {
      %v = view.load %x[%r, %c] : view<3x3072xf32> -> f32
      %weight = view.load %g[%c] : view<3072xf32> -> f32
      %normalized = scalar.mulf %v, %scale : f32
      %norm = scalar.mulf %normalized, %weight : f32
      view.store %norm, %y[%destination, %c] : f32, view<8x3072xf32>
    }
  }
  func.return
}
check.scenario @norm {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<9216xf32>
    %gamma = check.generate.iota offset(0.5) step(0.0001) : tensor<3072xf32>
    %control = check.generate.fill value(3) : tensor<3xi32>
    %output = check.generate.fill value(-99.0) : tensor<24576xf32>
    check.compare<@active.norm, @reference_norm>(%input, %gamma, %control, %output) : (tensor<9216xf32>, tensor<3072xf32>, tensor<3xi32>, tensor<24576xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<9216xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
      check.expect.bitwise actual(%control) expected(%control) : tensor<3xi32>
      check.expect.close actual(%output) expected(%output) atol(0.00005) rtol(0.00005) nan(same) : tensor<24576xf32>
    }
  }
  check.return
}

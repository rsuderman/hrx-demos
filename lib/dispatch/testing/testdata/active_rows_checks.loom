      %high_shifted = scalar.shrui %qh, %high_shift : i32
      %high0 = scalar.andi %high_shifted, %mask3 : i32
      %high = scalar.shli %high0, %shift4 : i32
      %code = scalar.ori %low, %high : i32
      %signed = scalar.subi %code, %center : i32
      %signed_f = scalar.sitofp %signed : i32 to f32
      %half8 = index.mul %half, %c8 : index
      %quad2 = index.mul %quadrant, %c2 : index
      %group = index.add %half8, %quad2 : index
      %part = index.div %j, %c16 : index
      %scale0 = index.add %c192, %group : index
      %scale_index = index.add %scale0, %part : index
      %scale8 = view.load %bytes[%scale_index] : view<210xi8> -> i8
      %scale = scalar.sitofp %scale8 : i8 to f32
      %d_origin = index.add %origin, %delta_add : offset

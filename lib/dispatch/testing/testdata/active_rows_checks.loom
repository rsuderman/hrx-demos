command.program.decl @active.embedding() launch(%ids: buffer, %weight: buffer, %control: buffer, %output: buffer)
func.def @reference_embedding(%ids: buffer, %weight: buffer, %control: buffer, %output: buffer) {
  %zero_o = index.constant 0 : offset
  %ids_view = buffer.view %ids[%zero_o] : buffer -> view<3xi32>
  %out = buffer.view %output[%zero_o] : buffer -> view<8x3072xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c192 = index.constant 192 : index
  %c256 = index.constant 256 : index
  %width = index.constant 3072 : index
  %row_bytes = index.constant 2520 : offset
  %block_bytes = index.constant 210 : offset
  %delta_add = index.constant 208 : offset
  %mask15 = scalar.constant 15 : i32
  %mask3 = scalar.constant 3 : i32
  %shift4 = scalar.constant 4 : i32
  %center = scalar.constant 32 : i32
  %begin = index.constant 2 : index
  %row_end = index.constant 3 : index
  scf.for %row = [%c0 to %row_end step %c1] {
    %destination = index.add %row, %begin : index
    %id32 = view.load %ids_view[%row] : view<3xi32> -> i32
    %id = index.cast %id32 : i32 to index
    %row_origin = index.scale %id, %row_bytes : index, offset -> offset
    scf.for %element = [%c0 to %width step %c1] {
      %block = index.div %element, %c256 : index
      %local = index.rem %element, %c256 : index
      %half = index.div %local, %c128 : index
      %in_half = index.rem %local, %c128 : index
      %quadrant = index.div %in_half, %c32 : index
      %j = index.rem %in_half, %c32 : index
      %block_add = index.scale %block, %block_bytes : index, offset -> offset
      %origin = index.add %row_origin, %block_add : offset
      %bytes = buffer.view %weight[%origin] : buffer -> view<210xi8>
      %half64 = index.mul %half, %c64 : index
      %side = index.rem %quadrant, %c2 : index
      %side32 = index.mul %side, %c32 : index
      %ql_base = index.add %half64, %side32 : index
      %ql_index = index.add %ql_base, %j : index
      %half32 = index.mul %half, %c32 : index
      %qh_base0 = index.add %c128, %half32 : index
      %qh_index = index.add %qh_base0, %j : index
      %ql8 = view.load %bytes[%ql_index] : view<210xi8> -> i8
      %qh8 = view.load %bytes[%qh_index] : view<210xi8> -> i8
      %ql = scalar.extui %ql8 : i8 to i32
      %qh = scalar.extui %qh8 : i8 to i32
      %nibble = index.div %quadrant, %c2 : index
      %low_shift_idx = index.mul %nibble, %c4 : index
      %high_shift_idx = index.mul %quadrant, %c2 : index
      %low_shift = index.cast %low_shift_idx : index to i32
      %high_shift = index.cast %high_shift_idx : index to i32
      %low_shifted = scalar.shrui %ql, %low_shift : i32
      %low = scalar.andi %low_shifted, %mask15 : i32
      %high_shifted = scalar.shrui %qh, %high_shift : i32
      %high0 = scalar.andi %high_shifted, %mask3 : i32
      %high = scalar.shli %high0, %shift4 : i32
      %code = scalar.ori %low, %high : i32
      %signed = scalar.subi %code, %center : i32
      %signed_f = scalar.sitofp %signed : i32 to f32
      %half8 = index.mul %half, %c8 : index
      %quad2 = index.mul %quadrant, %c2 : index
      %group = index.add %half8, %quad2 : index
      %part = index.div %j, %c16 : index
      %scale0 = index.add %c192, %group : index
      %scale_index = index.add %scale0, %part : index
      %scale8 = view.load %bytes[%scale_index] : view<210xi8> -> i8
      %scale = scalar.sitofp %scale8 : i8 to f32
      %d_origin = index.add %origin, %delta_add : offset
      %d_view = buffer.view %weight[%d_origin] : buffer -> view<1xf16>
      %d16 = view.load %d_view[0] : view<1xf16> -> f16
      %d = scalar.extf %d16 : f16 to f32
      %scaled = scalar.mulf %d, %scale : f32
      %value = scalar.mulf %scaled, %signed_f : f32
      view.store %value, %out[%destination, %element] : f32, view<8x3072xf32>
    }
  }
  func.return
}

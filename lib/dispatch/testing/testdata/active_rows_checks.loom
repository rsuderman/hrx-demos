      %high_shift_idx = index.mul %quadrant, %c2 : index
      %low_shift = index.cast %low_shift_idx : index to i32
      %high_shift = index.cast %high_shift_idx : index to i32
      %low_shifted = scalar.shrui %ql, %low_shift : i32

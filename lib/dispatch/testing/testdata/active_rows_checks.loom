      %d16 = view.load %d_view[0] : view<1xf16> -> f16
      %d = scalar.extf %d16 : f16 to f32
      %scaled = scalar.mulf %d, %scale : f32
      %value = scalar.mulf %scaled, %signed_f : f32
      view.store %value, %out[%destination, %element] : f32, view<1x3072xf32>
    }
  }
  func.return
}

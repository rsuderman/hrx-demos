# Actual registered producer -> internally allocated result -> observable buffer.
# The observer is the existing owned residual-add kernel, not synthetic math.
cc_binary(
    name = "emit_registered_norm", testonly = True,
    srcs = ["emit_registered_norm.cc"], cxxopts = ["-std=c++17"],
    deps = ["//lib/dispatch:invocation", "//lib/operations:tensor_operations",
            "@hrx_system//loom/binding/c/target/amdgpu",
            "@hrx_system//loom/binding/c:interop"],
)
genrule(
    name = "registered_norm_module", testonly = True,
    srcs = [
        "//lib/kernels/llama:all_sources",
    ],
    outs = ["registered_norm.loombc"],
    cmd = "$(location :emit_registered_norm) . $@",
    tools = [":emit_registered_norm"],
)
loom_test(
    name = "registered_norm_execution_test",
    srcs = ["testdata/registered_norm_checks.loom", ":registered_norm_module"],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)


  %decode = index.cmp eq, %launch_rows, %one : index
  %small = index.cmp ule, %input_width, %small_width : index
  %eligible = scalar.andi %decode, %small : i1
  %fuse = scalar.andi %pair_q4, %eligible : i1
  scf.if %fuse {
    template.apply<@llm.ffn.q4k_input_contract>(%input_width) : (index)
    %block = index.constant 256 : index
    %block_bytes = index.constant 144 : index
    %blocks = index.div %input_width, %block : index
    %row_bytes = index.mul %blocks, %block_bytes : index
    %expected = index.mul %ffn_width, %row_bytes : index
    %rows_limit = config.get @ggml.linear_q4k_q8_1_x4.token_capacity : index
    %width_limit = config.get @ggml.linear_q4k_q8_1_x4.output_capacity : index
    template.apply<@llm.projection.contract>(%gate_bytes, %expected, %row_capacity, %rows_limit, %ffn_width, %width_limit) : (index, index, index, index, index, index)
    template.apply<@llm.projection.contract>(%up_bytes, %expected, %row_capacity, %rows_limit, %ffn_width, %width_limit) : (index, index, index, index, index, index)

// Policy0/1 retain compatible/canonical packing. Policy2 consumes original F32.
template.decl @llm.projection.pack_input(%policy: index, %launch_rows: index, %row_capacity: index, %input_width: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count: buffer, %input: buffer, %packed: buffer)

template.decl @llm.projection.project_prepared(%policy: index, %rows: index, %capacity: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %fixed_count: i32, %count_origin: offset, %count: buffer, %input: buffer, %packed: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer)

func.def public pure inline @llm.projection.policy(%profile: index, %tag: index) -> (index) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %raw_policy = index.constant 2 : index
  %q4 = index.constant 12 : index
  %q6 = index.constant 14 : index
  %is_f32 = index.cmp eq, %tag, %zero : index
  %is_f16 = index.cmp eq, %tag, %one : index
  %raw = scalar.ori %is_f32, %is_f16 : i1
  %classic = index.cmp eq, %profile, %zero : index
  %is_q4 = index.cmp eq, %tag, %q4 : index
  %is_q6 = index.cmp eq, %tag, %q6 : index
  %compatible_tag = scalar.ori %is_q4, %is_q6 : i1
  %compatible = scalar.andi %classic, %compatible_tag : i1
  %packed_policy = scf.select %compatible, %zero, %one : index
  %policy = scf.select %raw, %raw_policy, %packed_policy : index
  func.return %policy : index
}

kernel.decl @llm.projection.prepare_f32_prefix(%rows: index, %input_width: index) launch(%rows_arg: index, %width_arg: index, %count: buffer, %input: buffer, %output: buffer)

template.decl @llm.projection.policy_rows(%profile: index, %rows: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %count: buffer, %input: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer)

template.def<@llm.projection.policy_rows> @llm_projection_policy_rows(%profile: index, %rows: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %count: buffer, %input: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer) where [range(%profile, 0, 1), range(%rows, 1, 512), range(%input_width, 128, 32768), multiple_of(%input_width, 128)] {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %raw_policy = index.constant 2 : index
  %origin = index.constant 0 : offset
  %dynamic = scalar.constant -1 : i32
  %policy = func.call pure @llm.projection.policy(%profile, %tag) : (index, index) -> (index)
  %raw = index.cmp eq, %policy, %raw_policy : index
  %packed = scf.if %raw -> (buffer) {
    // Ignored by the typed raw provider; do not allocate or read packed storage.
    scf.yield %input : buffer
  } else {
    %word = index.constant 4 : offset
    %block = index.constant 128 : index
    %packet = index.constant 144 : offset
    %elements = index.mul %rows, %input_width : index
    %groups = index.div %elements, %block : index
    %packed_bytes = index.scale %groups, %packet : index, offset -> offset
    %storage = buffer.alloca<global> align(256) %packed_bytes : buffer
    %canonical = index.cmp eq, %policy, %one : index
    scf.if %canonical {
      %bytes = index.scale %elements, %word : index, offset -> offset
      %defined = buffer.alloca<global> align(256) %bytes : buffer
      kernel.launch @llm.projection.prepare_f32_prefix[%rows, %input_width](%rows, %input_width, %count, %input, %defined) : [index, index](index, index, buffer, buffer, buffer)
      template.apply<@llm.projection.pack_input>(%policy, %rows, %rows, %input_width, %zero, %dynamic, %origin, %count, %defined, %storage) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
    } else {
      template.apply<@llm.projection.pack_input>(%policy, %rows, %rows, %input_width, %zero, %dynamic, %origin, %count, %input, %storage) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
    }
    scf.yield %storage : buffer
  }
  template.apply<@llm.projection.project_prepared>(%policy, %rows, %rows, %input_width, %output_width, %tag, %weight_bytes, %dynamic, %origin, %count, %input, %packed, %weight, %output) : (index, index, index, index, index, index, index, i32, offset, buffer, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
  template.return
}

// Defines inactive F32 rows before canonical packing. Existing matrix users
// continue to own and share their packed buffer.
template.decl @llm.projection.prepare_canonical_prefix(%capacity: index, %input_width: index, %count: buffer, %input: buffer, %packed: buffer)

template.def<@llm.projection.prepare_canonical_prefix> @llm_projection_prepare_canonical_prefix(%capacity: index, %input_width: index, %count: buffer, %input: buffer, %packed: buffer) where [range(%capacity, 1, 512)] {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %dynamic = scalar.constant -1 : i32
  %word = index.constant 4 : offset
  %elements = index.mul %capacity, %input_width : index
  %input_bytes = index.scale %elements, %word : index, offset -> offset
  %defined_input = buffer.alloca<global> align(256) %input_bytes : buffer
  kernel.launch @llm.projection.prepare_f32_prefix[%capacity, %input_width](%capacity, %input_width, %count, %input, %defined_input) : [index, index](index, index, buffer, buffer, buffer)
  template.apply<@llm.projection.pack_input>(%one, %capacity, %capacity, %input_width, %zero, %dynamic, %origin, %count, %defined_input, %packed) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
  template.return
}

template.decl @llm.projection.policy_qkv(%profile: index, %rows: index, %hidden: index, %q_size: index, %kv: index, %q_tag: index, %k_tag: index, %v_tag: index, %q_bytes: index, %k_bytes: index, %v_bytes: index, %count: buffer, %normalized: buffer, %q_weight: view<[%q_bytes]xi8>, %k_weight: view<[%k_bytes]xi8>, %v_weight: view<[%v_bytes]xi8>, %q: buffer, %k: buffer, %v: buffer)

template.def<@llm.projection.policy_qkv> @llm_projection_policy_qkv(%profile: index, %rows: index, %hidden: index, %q_size: index, %kv: index, %q_tag: index, %k_tag: index, %v_tag: index, %q_bytes: index, %k_bytes: index, %v_bytes: index, %count: buffer, %normalized: buffer, %q_weight: view<[%q_bytes]xi8>, %k_weight: view<[%k_bytes]xi8>, %v_weight: view<[%v_bytes]xi8>, %q: buffer, %k: buffer, %v: buffer) where [range(%profile, 0, 1), range(%rows, 1, 512), range(%hidden, 128, 32768), multiple_of(%hidden, 128)] {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %dynamic = scalar.constant -1 : i32
  %block = index.constant 128 : index
  %packet = index.constant 144 : offset
  %elements = index.mul %rows, %hidden : index
  %groups = index.div %elements, %block : index
  %bytes = index.scale %groups, %packet : index, offset -> offset
  %qp = func.call pure @llm.projection.policy(%profile, %q_tag) : (index, index) -> (index)
  %kp = func.call pure @llm.projection.policy(%profile, %k_tag) : (index, index) -> (index)
  %vp = func.call pure @llm.projection.policy(%profile, %v_tag) : (index, index) -> (index)
  %qcompat = index.cmp eq, %qp, %zero : index
  %kcompat = index.cmp eq, %kp, %zero : index
  %vcompat = index.cmp eq, %vp, %zero : index
  %qc = index.cmp eq, %qp, %one : index
  %kc = index.cmp eq, %kp, %one : index
  %vc = index.cmp eq, %vp, %one : index
  %qkcompat = scalar.ori %qcompat, %kcompat : i1
  %anycompat = scalar.ori %qkcompat, %vcompat : i1
  %qkc = scalar.ori %qc, %kc : i1
  %anycanonical = scalar.ori %qkc, %vc : i1
  %compatible = scf.if %anycompat -> (buffer) {
    %storage = buffer.alloca<global> align(256) %bytes : buffer
    template.apply<@llm.projection.pack_input>(%zero, %rows, %rows, %hidden, %zero, %dynamic, %origin, %count, %normalized, %storage) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
    scf.yield %storage : buffer
  } else {
    scf.yield %normalized : buffer
  }
  %canonical = scf.if %anycanonical -> (buffer) {
    %storage = buffer.alloca<global> align(256) %bytes : buffer
    template.apply<@llm.projection.prepare_canonical_prefix>(%rows, %hidden, %count, %normalized, %storage) : (index, index, buffer, buffer, buffer)
    scf.yield %storage : buffer
  } else {
    scf.yield %normalized : buffer
  }
  %qpacked = scf.if %qc -> (buffer) {
    scf.yield %canonical : buffer
  } else {
    scf.yield %compatible : buffer
  }
  %kpacked = scf.if %kc -> (buffer) {
    scf.yield %canonical : buffer
  } else {
    scf.yield %compatible : buffer
  }
  %vpacked = scf.if %vc -> (buffer) {
    scf.yield %canonical : buffer
  } else {
    scf.yield %compatible : buffer
  }
  template.apply<@llm.projection.project_prepared>(%qp, %rows, %rows, %hidden, %q_size, %q_tag, %q_bytes, %dynamic, %origin, %count, %normalized, %qpacked, %q_weight, %q) : (index, index, index, index, index, index, index, i32, offset, buffer, buffer, buffer, view<[%q_bytes]xi8>, buffer)
  template.apply<@llm.projection.project_prepared>(%kp, %rows, %rows, %hidden, %kv, %k_tag, %k_bytes, %dynamic, %origin, %count, %normalized, %kpacked, %k_weight, %k) : (index, index, index, index, index, index, index, i32, offset, buffer, buffer, buffer, view<[%k_bytes]xi8>, buffer)
  template.apply<@llm.projection.project_prepared>(%vp, %rows, %rows, %hidden, %kv, %v_tag, %v_bytes, %dynamic, %origin, %count, %normalized, %vpacked, %v_weight, %v) : (index, index, index, index, index, index, index, i32, offset, buffer, buffer, buffer, view<[%v_bytes]xi8>, buffer)
  template.return
}

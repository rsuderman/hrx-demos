load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:loom_testing.bzl", "loom_provider_checks")

package(default_visibility = ["//visibility:private"])

[genrule(
    name = name + "_fixtures",
    testonly = True,
    srcs = [
        script,
        "canonical_fixtures.py",
    ],
    outs = [name + "_checks.loom"],
    cmd = "python3 $(location " + script + ") " + ("$@" if name == "classic" else "$(location canonical_fixtures.py) full $@"),
) for name, script in [
    ("classic", "classic_fixtures.py"),
    ("iq4_xs", "iq4_xs_fixtures.py"),
    ("iq4_nl", "iq4_nl_fixtures.py"),
    ("iq3_s", "iq3_s_fixtures.py"),
    ("q3k", "q3k_fixtures.py"),
]]

[loom_provider_checks(
    name = name,
    checks = [":" + name + "_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = name + "_provider",
    provider_srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
        "//lib/programs/projection:matrix_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
    ],
) for name in [
    "classic",
    "iq4_xs",
    "iq4_nl",
    "iq3_s",
    "q3k",
]]

genrule(
    name = "classic_tiny_fixtures",
    testonly = True,
    srcs = [
        "classic_fixtures.py",
        "canonical_fixtures.py",
    ],
    outs = ["classic_tiny_checks.loom"],
    cmd = "python3 $(location classic_fixtures.py) $@ --tiny",
)

loom_provider_checks(
    name = "classic_tiny",
    checks = [":classic_tiny_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "classic_tiny_provider",
    provider_srcs = [
        "//lib/kernels/projection:block32_sources",
        "//lib/kernels/projection:block32_launch.loom",
        "//lib/kernels/projection:classic_q4.loom",
        "//lib/kernels/quantization:q8_1_x4.loom",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
    ],
)

genrule(
    name = "iq4_xs_tiny_fixtures",
    testonly = True,
    srcs = [
        "iq4_xs_fixtures.py",
        "canonical_fixtures.py",
    ],
    outs = ["iq4_xs_tiny_checks.loom"],
    cmd = "python3 $(location iq4_xs_fixtures.py) $(location canonical_fixtures.py) tiny $@",
)

loom_provider_checks(
    name = "iq4_xs_tiny",
    checks = [":iq4_xs_tiny_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "iq4_xs_tiny_provider",
    provider_srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
        "//lib/programs/projection:matrix_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
    ],
)

genrule(
    name = "fixtures",
    srcs = [],
    outs = ["checks.loom"],
    cmd = "python3 $(location fixtures.py) $@",
    tools = ["fixtures.py"],
)

loom_library(
    name = "provider",
    srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
        "//lib/programs/ffn:gate_up_sources",
        "//lib/programs/ffn:matrix_gate_up_sources",
        "//lib/programs/projection:matrix_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
    ],
)

loom_test(
    name = "execution_test",
    srcs = [":fixtures"],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    deps = [":provider"],
)

loom_merge(
    name = "fixture_module",
    testonly = True,
    srcs = [
        ":fixtures",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
        "//lib/programs/ffn:gate_up_sources",
        "//lib/programs/ffn:matrix_gate_up_sources",
        "//lib/programs/projection:matrix_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
    ],
)

genrule(
    name = "preparation_fixtures",
    srcs = [],
    outs = ["preparation_checks.loom"],
    cmd = "python3 $(location preparation_fixtures.py) $@",
    tools = ["preparation_fixtures.py"],
)

loom_library(
    name = "preparation_provider",
    srcs = ["//lib/kernels/projection:scaled_f16.loom"],
)

loom_test(
    name = "preparation_execution_test",
    srcs = [":preparation_fixtures"],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    deps = [":preparation_provider"],
)

# Host execution of the same linked operation-owned allocation policy in both formats.
[loom_merge(
    name = "output_rows_provider_" + format,
    testonly = True,
    srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
        "//lib/programs/projection:matrix_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "output_rows_" + format + "_test",
    srcs = [
        "output_rows_checks.loom",
        ":output_rows_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [VM_REFERENCE_PROFILE],
) for format in [
    "text",
    "bc",
]]

# Same nonzero logical Q/K/V anchors exercise independent formats/widths and
# both preparation routes. Each scenario also provides a matched bundle timing.
genrule(
    name = "shared_preparation_fixtures",
    srcs = [],
    outs = ["shared_preparation_checks.loom"],
    cmd = "python3 $(location shared_preparation_fixtures.py) $@",
    tools = ["shared_preparation_fixtures.py"],
)


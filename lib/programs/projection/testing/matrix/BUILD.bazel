    name = "policy_qkv_fixtures",
    testonly = True,
    srcs = [
        "policy_qkv_fixtures.py",
        "canonical_fixtures.py",
    ],
    outs = ["policy_qkv_checks.loom"],
    cmd = "python3 $(location policy_qkv_fixtures.py) $(location canonical_fixtures.py) full $@",
)

[loom_merge(
    name = "policy_qkv_" + format,

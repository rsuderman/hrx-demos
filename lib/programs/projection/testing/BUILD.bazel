load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
package(default_visibility = ["//visibility:public"])
cc_test(
    name = "materialization_test",
    size = "small",
    srcs = ["materialization_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = [":provider_text", ":provider_bc", "//lib/programs/projection:interface.loom"],
    deps = [
        "//tools/loomify-gguf:native_linking",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

[loom_merge(name = "provider_" + format, srcs = ["//lib/programs/projection:implementation_sources"], output_format = format, testonly = True) for format in ["text", "bc"]]

# Exercise the same actual operation closure in source and serialized form.
[loom_test(
    name = "operations_" + format + "_test",
    srcs = ["operations_checks.loom", ":provider_" + format],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
) for format in ["text", "bc"]]
exports_files(["fixtures.py", "operations_checks.loom"])

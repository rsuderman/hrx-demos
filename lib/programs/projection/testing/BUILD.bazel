load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_testing.bzl", "loom_checks", "loom_provider_checks")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "operations_checks",
    testonly = True,
    srcs = [
        "fixtures.py",
        "//lib/programs/projection:interface.loom",
    ],
    outs = ["generated_operations_checks.loom"],
    cmd = "python3 $(location fixtures.py) $(location //lib/programs/projection:interface.loom) $@",
)

cc_test(
    name = "materialization_test",
    size = "small",
    srcs = ["materialization_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":provider_bc",
        ":provider_text",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:implementation",
        "//lib/programs/ffn:gate_up",
        "//lib/programs/ffn:gate_up_text",
        "//lib/programs/ffn:matrix_gate_up",
        "//lib/programs/ffn:matrix_gate_up_text",
        "//lib/programs/projection:interface.loom",
        "//lib/programs/projection:matrix",
        "//lib/programs/projection:matrix_text",
        "//lib/programs/projection:packed",
        "//lib/programs/projection:packed_text",
        "//lib/programs/projection:prepared_rows",
        "//lib/programs/projection:prepared_rows_text",
    ],
    linkstatic = True,
    deps = [
        "//lib/loomify:native_linking",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

# Exercise the same actual operation closure in source and serialized form.
loom_provider_checks(
    name = "operations",
    checks = [":operations_checks"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "provider",
    provider_srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/projection:packed_sources",
    ],
)

exports_files([
    "fixtures.py",
])


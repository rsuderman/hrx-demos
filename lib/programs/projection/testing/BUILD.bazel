load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "materialization_test",
    size = "small",
    srcs = ["materialization_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":provider_bc",
        ":provider_text",
        "//lib/programs/projection:interface.loom",
    ],
    linkstatic = True,
    deps = [
        "//lib/loomify:native_linking",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

[loom_merge(
    name = "provider_" + format,
    testonly = True,
    srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/projection:implementation_sources",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

# Exercise the same actual operation closure in source and serialized form.
[loom_test(
    name = "operations_" + format + "_test",
    srcs = [
        "operations_checks.loom",
        ":provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

exports_files([
    "fixtures.py",
    "operations_checks.loom",
])

[loom_test(
    name = "gemma3_operations_" + format + "_test",
    srcs = [
        "gemma3_checks.loom",
        ":provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

[loom_merge(
    name = "f32_rows_provider_" + format,
    testonly = True,
    srcs = [
        "//lib/kernels/projection:f32_rows.loom",
        "//lib/programs/projection:rows.loom",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "f32_rows_" + format + "_test",
    srcs = [
        "f32_rows_checks.loom",
        ":f32_rows_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

check.scenario @f32_rows_spark {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-77.0) : tensor<10240xf32>
    %weight = check.generate.fill value(-33.0) : tensor<40960xf32>
    %count = check.generate.fill value(-123) : tensor<3xi32>
    %owner = check.generate.fill value(-555.0) : tensor<72xf32>
    %output = check.tensor.view %owner offset(16) : tensor<72xf32> -> tensor<64xf32>
    check.generate<@f32.init_spark>(%input, %weight, %count) : (tensor<10240xf32>, tensor<40960xf32>, tensor<3xi32>) -> ()
    check.compare<@f32.actual_spark, @f32.expected_spark>(%input, %weight, %count, %output) : (tensor<10240xf32>, tensor<40960xf32>, tensor<3xi32>, tensor<64xf32>) -> () {
      check.expect.bitwise actual(%owner) expected(%owner) : tensor<72xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<10240xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<40960xf32>

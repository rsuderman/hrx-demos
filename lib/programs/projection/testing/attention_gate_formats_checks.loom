// Independently encoded tag 13; logical d=(head+1)*(block+1)/1024.
func.def @gate.sibling.weight13(%width: index, %weight: buffer) {
  %z = index.constant 0 : index
  %one = index.constant 1 : index
  %heads = index.constant 16 : index
  %bs = index.constant 256 : index
  %blocks = index.div %width, %bs : index
  %stride = index.constant 176 : offset
  %rowbytes = index.scale %blocks, %stride : index, offset -> offset
  %dunit = scalar.constant 0.0009765625 : f32
  scf.for %h = [%z to %heads step %one] {
    %hi = index.add %h, %one : index
    %h32 = index.cast %hi : index to i32
    %hf = scalar.uitofp %h32 : i32 to f32
    %rowbase = index.scale %h, %rowbytes : index, offset -> offset
    scf.for %b = [%z to %blocks step %one] {
      %bi = index.add %b, %one : index
      %b32 = index.cast %bi : index to i32
      %bf = scalar.uitofp %b32 : i32 to f32
      %hb = scalar.mulf %hf, %bf : f32
      %d32 = scalar.mulf %hb, %dunit : f32
      %d16 = scalar.fptrunc %d32 : f32 to f16
      %add = index.scale %b, %stride : index, offset -> offset
      %base = index.add %rowbase, %add : offset
      %bytes = buffer.view %weight[%base] : buffer -> view<176xi8>
      %doff = index.constant 0 : offset
      %dpos = index.add %base, %doff : offset
      %half = buffer.view %weight[%dpos] : buffer -> view<1xf16>
      view.store %d16, %half[0] : f16, view<1xf16>
      // All eight local scales/minima are1: code17*d -1*(16*d) =d.
      %minoff = index.constant 2 : offset
      %minpos = index.add %base, %minoff : offset
      %minhalf = buffer.view %weight[%minpos] : buffer -> view<1xf16>
      %sixteen_f = scalar.constant 16.0 : f32
      %min32 = scalar.mulf %d32, %sixteen_f : f32
      %min16 = scalar.fptrunc %min32 : f32 to f16
      view.store %min16, %minhalf[0] : f16, view<1xf16>
      %s0 = index.constant 4 : index
      %e0 = index.constant 12 : index
      %v0 = scalar.constant 1 : i8
      scf.for %j = [%s0 to %e0 step %one] {
        view.store %v0, %bytes[%j] : i8, view<176xi8>
      }
      %s1 = index.constant 12 : index
      %e1 = index.constant 16 : index
      %v1 = scalar.constant 17 : i8
      scf.for %j = [%s1 to %e1 step %one] {
        view.store %v1, %bytes[%j] : i8, view<176xi8>
      }
      %s2 = index.constant 16 : index
      %e2 = index.constant 48 : index
      %v2 = scalar.constant -1 : i8
      scf.for %j = [%s2 to %e2 step %one] {
        view.store %v2, %bytes[%j] : i8, view<176xi8>
      }
      %s3 = index.constant 48 : index
      %e3 = index.constant 176 : index
      %v3 = scalar.constant 17 : i8
      scf.for %j = [%s3 to %e3 step %one] {
        view.store %v3, %bytes[%j] : i8, view<176xi8>
      }
    }
  }
  func.return
}


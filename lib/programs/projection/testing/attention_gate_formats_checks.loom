// Independent sibling-format signed block and endpoint anchors.
template.decl @llm.projection.pack_input(%policy: index, %rows: index, %capacity: index, %width: index, %begin: index, %fixed: i32, %origin: offset, %count: buffer, %input: buffer, %packed: buffer)

template.decl @llm.projection.canonical_rows_prepacked(%rows: index, %capacity: index, %width: index, %heads: index, %tag: index, %bytes: index, %count: buffer, %input: buffer, %packed: buffer, %weight: view<[%bytes]xi8>, %output: buffer)

config.def @ggml.quantize_q8_1_x4.group_capacity = 60 : index

config.def @ggml.linear_q4k_q8_1_x4.token_capacity = 3 : index

config.def @ggml.linear_q4k_q8_1_x4.output_capacity = 16 : index

config.def @ggml.linear_q5k_q8_1_x4.token_capacity = 3 : index

config.def @ggml.linear_q5k_q8_1_x4.output_capacity = 16 : index

config.def @ggml.linear_q6k_q8_1_x4.token_capacity = 3 : index

config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 16 : index

config.def @ggml.linear_q8_0_q8_1_x4.token_capacity = 3 : index

config.def @ggml.linear_q8_0_q8_1_x4.output_capacity = 16 : index

config.def @ggml.linear_q5_0_q8_1_x4.token_capacity = 3 : index

config.def @ggml.linear_q5_0_q8_1_x4.output_capacity = 16 : index

func.def @gate.sibling.input(%rows: index, %width: index, %active: index, %pattern: index, %input: buffer, %weight: buffer, %count: buffer) {
  %z = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %heads = index.constant 16 : index
  %origin = index.constant 0 : offset
  %last = index.sub %width, %one : index
  %zero_f = scalar.constant 0.0 : f32
  %xunit = scalar.constant 0.031005859375 : f32
  %sparse = index.cmp eq, %pattern, %two : index
  %x = buffer.view %input[%origin] : buffer -> view<[%rows]x[%width]xf32>
  scf.for %r = [%z to %rows step %one] {
    %next = index.add %r, %one : index
    %ri = index.cast %next : index to i32
    %rf = scalar.uitofp %ri : i32 to f32
    %value = scalar.mulf %rf, %xunit : f32
    %negative = scalar.subf %zero_f, %value : f32
    %live = index.cmp ult, %r, %active : index
    scf.for %k = [%z to %width step %one] {
      %first = index.cmp eq, %k, %z : index
      %end = index.cmp eq, %k, %last : index
      %tail = scf.select %end, %negative, %zero_f : f32
      %pair = scf.select %first, %value, %tail : f32
      %quant = scf.select %sparse, %pair, %value : f32
      %v = scf.select %live, %quant, %zero_f : f32
      view.store %v, %x[%r, %k] : f32, view<[%rows]x[%width]xf32>
    }
  }
  %control = buffer.view %count[%origin] : buffer -> view<3xi32>
  %n = index.cast %active : index to i32
  view.store %n, %control[0] : i32, view<3xi32>
  func.return
}

command.def @gate.sibling.project(%rows: index, %width: index, %tag: index, %bytes: index) launch(%input: buffer, %weight: buffer, %packed: buffer, %count: buffer, %output: buffer) {
  %z = index.constant 0 : index
  %one = index.constant 1 : index
  %heads = index.constant 16 : index
  %origin = index.constant 0 : offset
  %fixed = scalar.constant -1 : i32
  %quantized = index.cmp ne, %tag, %z : index
  scf.if %quantized {
    template.apply<@llm.projection.pack_input>(%one, %rows, %rows, %width, %z, %fixed, %origin, %count, %input, %packed) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
  }
  %w = buffer.view %weight[%origin] : buffer -> view<[%bytes]xi8>
  template.apply<@llm.projection.canonical_rows_prepacked>(%rows, %rows, %width, %heads, %tag, %bytes, %count, %input, %packed, %w, %output) : (index, index, index, index, index, index, buffer, buffer, buffer, view<[%bytes]xi8>, buffer)
  command.return
}

func.def @gate.sibling.expected(%rows: index, %active: index, %unit: f32, %output: buffer) {
  %z = index.constant 0 : index
  %one = index.constant 1 : index
  %heads = index.constant 16 : index
  %origin = index.constant 0 : offset
  %zero_f = scalar.constant 0.0 : f32
  %out = buffer.view %output[%origin] : buffer -> view<[%rows]x16xf32>
  scf.for %r = [%z to %rows step %one] {
    %next = index.add %r, %one : index
    %ri = index.cast %next : index to i32
    %rf = scalar.uitofp %ri : i32 to f32
    %live = index.cmp ult, %r, %active : index
    scf.for %h = [%z to %heads step %one] {
      %hi = index.add %h, %one : index
      %h32 = index.cast %hi : index to i32
      %hf = scalar.uitofp %h32 : i32 to f32
      %a = scalar.mulf %rf, %hf : f32
      %b = scalar.mulf %a, %unit : f32
      %v = scf.select %live, %b, %zero_f : f32
      view.store %v, %out[%r, %h] : f32, view<[%rows]x16xf32>
    }
  }
  func.return
}

// Independently encoded tag 6; logical d=(head+1)*(block+1)/1024.
func.def @gate.sibling.weight6(%width: index, %weight: buffer) {
  %z = index.constant 0 : index
  %one = index.constant 1 : index
  %heads = index.constant 16 : index
  %bs = index.constant 32 : index
  %blocks = index.div %width, %bs : index
  %stride = index.constant 22 : offset
  %rowbytes = index.scale %blocks, %stride : index, offset -> offset
  %dunit = scalar.constant 0.0009765625 : f32
  scf.for %h = [%z to %heads step %one] {
    %hi = index.add %h, %one : index
    %h32 = index.cast %hi : index to i32
    %hf = scalar.uitofp %h32 : i32 to f32
    %rowbase = index.scale %h, %rowbytes : index, offset -> offset
    scf.for %b = [%z to %blocks step %one] {
      %bi = index.add %b, %one : index
      %b32 = index.cast %bi : index to i32
      %bf = scalar.uitofp %b32 : i32 to f32
      %hb = scalar.mulf %hf, %bf : f32
      %d32 = scalar.mulf %hb, %dunit : f32
      %d16 = scalar.fptrunc %d32 : f32 to f16
      %add = index.scale %b, %stride : index, offset -> offset
      %base = index.add %rowbase, %add : offset
      %bytes = buffer.view %weight[%base] : buffer -> view<22xi8>
      %doff = index.constant 0 : offset
      %dpos = index.add %base, %doff : offset
      %half = buffer.view %weight[%dpos] : buffer -> view<1xf16>
      view.store %d16, %half[0] : f16, view<1xf16>
      %s0 = index.constant 2 : index
      %e0 = index.constant 4 : index
      %v0 = scalar.constant 0 : i8
      scf.for %j = [%s0 to %e0 step %one] {
        view.store %v0, %bytes[%j] : i8, view<22xi8>
      }
      %s1 = index.constant 4 : index
      %e1 = index.constant 6 : index
      %v1 = scalar.constant -1 : i8
      scf.for %j = [%s1 to %e1 step %one] {
        view.store %v1, %bytes[%j] : i8, view<22xi8>
      }
      %s2 = index.constant 6 : index
      %e2 = index.constant 22 : index
      %v2 = scalar.constant 17 : i8
      scf.for %j = [%s2 to %e2 step %one] {
        view.store %v2, %bytes[%j] : i8, view<22xi8>
      }
    }
  }
  func.return
}

func.def @init.sibling_e2048_t1_n1_q6(%x: buffer, %w: buffer, %count: buffer) {
  %r = index.constant 1 : index
  %k = index.constant 2048 : index
  %active = index.constant 1 : index
  %pattern = index.constant 1 : index
  func.call @gate.sibling.input(%r, %k, %active, %pattern, %x, %w, %count) : (index, index, index, index, buffer, buffer, buffer)
  func.call @gate.sibling.weight6(%k, %w) : (index, buffer)
  func.return
}

command.def @actual.sibling_e2048_t1_n1_q6() launch(%x: buffer, %w: buffer, %p: buffer, %n: buffer, %y: buffer) {
  %r = index.constant 1 : index
  %k = index.constant 2048 : index
  %tag = index.constant 6 : index
  %bytes = index.constant 22528 : index
  command.launch @gate.sibling.project[%r, %k, %tag, %bytes](%x, %w, %p, %n, %y) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @expected.sibling_e2048_t1_n1_q6(%x: buffer, %w: buffer, %p: buffer, %n: buffer, %y: buffer) {
  %r = index.constant 1 : index
  %active = index.constant 1 : index
  %unit = scalar.constant -14.107666015625 : f32
  func.call @gate.sibling.expected(%r, %active, %unit, %y) : (index, index, f32, buffer)
  func.return
}

check.scenario @case.sibling_e2048_t1_n1_q6 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %xs = check.generate.fill value(-77.0) : tensor<2052xf32>
    %ws = check.generate.fill value(91) : tensor<23040xi8>
    %ps = check.generate.fill value(83) : tensor<2816xi8>
    %ys = check.generate.fill value(-99.0) : tensor<20xf32>
    %n = check.generate.fill value(0) : tensor<3xi32>
    %x = check.tensor.view %xs offset(8) : tensor<2052xf32> -> tensor<2048xf32>
    %w = check.tensor.view %ws offset(256) : tensor<23040xi8> -> tensor<22528xi8>
    %p = check.tensor.view %ps offset(256) : tensor<2816xi8> -> tensor<2304xi8>
    %y = check.tensor.view %ys offset(8) : tensor<20xf32> -> tensor<16xf32>
    %before = check.tensor.view %ps offset(0) : tensor<2816xi8> -> tensor<256xi8>
    %after = check.tensor.view %ps offset(2560) : tensor<2816xi8> -> tensor<256xi8>
    check.generate<@init.sibling_e2048_t1_n1_q6>(%x, %w, %n) : (tensor<2048xf32>, tensor<22528xi8>, tensor<3xi32>) -> ()
    check.compare<@actual.sibling_e2048_t1_n1_q6, @expected.sibling_e2048_t1_n1_q6>(%x, %w, %p, %n, %y) : (tensor<2048xf32>, tensor<22528xi8>, tensor<2304xi8>, tensor<3xi32>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%xs) expected(%xs) : tensor<2052xf32>
      check.expect.bitwise actual(%ws) expected(%ws) : tensor<23040xi8>
      check.expect.bitwise actual(%ys) expected(%ys) : tensor<20xf32>
      check.expect.bitwise actual(%n) expected(%n) : tensor<3xi32>
      check.expect.bitwise actual(%before) expected(%before) : tensor<256xi8>
      check.expect.bitwise actual(%after) expected(%after) : tensor<256xi8>
    }
  }
  check.return
}


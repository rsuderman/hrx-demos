load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

exports_files([
    "interface.loom",
    "contract.loom",
    "projection.loom",
    "rows.loom",
    "matrix.loom",
    "prepared_rows.loom",
])

# Definition-owning fragments. Dependencies are supplied once by the final
# architecture composition; a fragment never embeds another fragment.
# Activation and residual definitions belong to their FFN/elementwise owners.
# Keeping them out of packed prevents duplicate providers when fragments link.
filegroup(
    name = "packed_sources",
    srcs = [
        "projection.loom",
        "contract.loom",
        "rows.loom",
        "//lib/kernels/epoch:active_rows.loom",
        "//lib/kernels/projection:block32_launch.loom",
        "//lib/kernels/projection:block32_sources",
        "//lib/kernels/projection:classic_q4.loom",
        "//lib/kernels/projection:f32_rows.loom",
        "//lib/kernels/projection:iq4_xs.loom",
        "//lib/kernels/projection:iq4_nl.loom",
        "//lib/kernels/projection:iq3_s.loom",
        "//lib/kernels/projection:q3k.loom",
        "//lib/kernels/projection:q4k.loom",
        "//lib/kernels/projection:q4k_canonical.loom",
        "//lib/kernels/projection:q4k_compat.loom",
        "//lib/kernels/projection:q5_0.loom",
        "//lib/kernels/projection:q5k.loom",
        "//lib/kernels/projection:q5k_codec.loom",
        "//lib/kernels/projection:q6k.loom",
        "//lib/kernels/projection:q6k_canonical.loom",
        "//lib/kernels/projection:q6k_compat.loom",
        "//lib/kernels/projection:q8_0.loom",
        "//lib/kernels/projection:qk_common.loom",
        "//lib/kernels/projection:qk_mmvq_compat.loom",
        "//lib/kernels/projection:scaled_f16.loom",
        "//lib/kernels/quantization:q8_1_x4.loom",
        "//lib/kernels/quantization:q8_1_x4_canonical.loom",
        "//lib/kernels/quantization:q8_1_x4_mmvq_compat.loom",
    ],
)

filegroup(
    name = "matrix_sources",
    srcs = [
        "matrix.loom",
        "//lib/kernels/projection:f16_staging.loom",
    ],
)

filegroup(
    name = "prepared_rows_sources",
    srcs = ["prepared_rows.loom"],
)

[loom_merge(
    name = name + ("_text" if format == "text" else ""),
    srcs = [":" + name + "_sources"],
    output_format = format,
) for name in [
    "packed",
    "prepared_rows",
    "matrix",
] for format in [
    "bc",
    "text",
]]

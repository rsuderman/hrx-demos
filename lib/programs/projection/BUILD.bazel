load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

exports_files([
    "interface.loom",
    "projection.loom",
    "rows.loom",
    "matrix.loom",
])

filegroup(
    name = "implementation_sources",
    srcs = [
        "projection.loom",
        "rows.loom",
        "//lib/kernels/epoch:active_rows.loom",
        "//lib/kernels/projection:block32_launch.loom",
        "//lib/kernels/projection:block32_sources",
        "//lib/kernels/projection:f32_rows.loom",
        "//lib/kernels/projection:q4k.loom",
        "//lib/kernels/projection:q4k_canonical.loom",
        "//lib/kernels/projection:q4k_compat.loom",
        "//lib/kernels/projection:q5_0.loom",
        "//lib/kernels/projection:q5k.loom",
        "//lib/kernels/projection:q5k_codec.loom",
        "//lib/kernels/projection:q6k.loom",
        "//lib/kernels/projection:q6k_canonical.loom",
        "//lib/kernels/projection:q6k_compat.loom",
        "//lib/kernels/projection:q8_0.loom",
        "//lib/kernels/projection:qk_common.loom",
        "//lib/kernels/projection:qk_mmvq_compat.loom",
        "//lib/kernels/quantization:q8_1_x4.loom",
        "//lib/kernels/quantization:q8_1_x4_canonical.loom",
        "//lib/kernels/quantization:q8_1_x4_mmvq_compat.loom",
    ],
)

loom_merge(
    name = "implementation",
    srcs = [":implementation_sources"],
)

filegroup(
    name = "matrix_sources",
    srcs = [
        "matrix.loom",
        ":implementation_sources",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "//lib/kernels/projection:f16_staging.loom",
        "//lib/kernels/projection:scaled_f16.loom",
    ],
)

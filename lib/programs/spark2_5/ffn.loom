template.decl @llm.ffn.canonical_swiglu(%rows: index, %hidden: index, %ffn: index, %gt: index, %ut: index, %dt: index, %gb: index, %ub: index, %db: index, %count: buffer, %normal: buffer, %gate_weight: view<[%gb]xi8>, %up_weight: view<[%ub]xi8>, %down_weight: view<[%db]xi8>, %down: buffer)

kernel.decl @llm.decoder.rmsnorm_active(%rows$15: index, %width$16: index) launch(%rows$17: index, %width$18: index, %epsilon: f32, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)

kernel.decl @llm.decoder.residual(%rows: index, %width$25: index) launch(%width$26: index, %count: buffer, %source: buffer, %residual: buffer)

config.decl @spark2_5.model.hidden_size : index

config.decl @spark2_5.model.rms_epsilon : f32

func.decl pure @loomify.config.layer_ffn(%layer: index) -> (index, index, index, index, index, index, index)

command.def @loomify.spark2_5.ffn(%layer: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer) where [range(%rows, 1, 512)] {
  %hidden = config.get @spark2_5.model.hidden_size : index
  %epsilon = config.get @spark2_5.model.rms_epsilon : f32
  %word = index.constant 4 : offset
  %ffn, %gt, %ut, %dt, %gb, %ub, %db = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %gamma = command.parameter %parameters, "blk.{}.ffn_norm.weight"[%layer] : view<[%hidden]xf32>
  %gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%gb]xi8>
  %up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%ub]xi8>
  %down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%db]xi8>
  %elements = index.mul %rows, %hidden : index
  %bytes = index.scale %elements, %word : index, offset -> offset
  %normal = buffer.alloca<global> align(256) %bytes : buffer
  %down = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.decoder.rmsnorm_active[%rows, %hidden](%rows, %hidden, %epsilon, %count, %residual, %gamma, %normal) : [index, index](index, index, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  template.apply<@llm.ffn.canonical_swiglu>(%rows, %hidden, %ffn, %gt, %ut, %dt, %gb, %ub, %db, %count, %normal, %gate_weight, %up_weight, %down_weight, %down) : (index, index, index, index, index, index, index, index, index, buffer, buffer, view<[%gb]xi8>, view<[%ub]xi8>, view<[%db]xi8>, buffer)
  kernel.launch @llm.decoder.residual[%rows, %hidden](%hidden, %count, %down, %residual) : [index, index](index, buffer, buffer, buffer)
  command.return
}

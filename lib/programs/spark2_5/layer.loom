// Spark uses pre-norm attention and FFN with raw branch residual additions.
kernel.decl @llm.decoder.rmsnorm_active(%rows$0: index, %width$1: index) launch(%rows$2: index, %width$3: index, %epsilon: f32, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)

kernel.decl @llm.decoder.residual(%rows: index, %width$10: index) launch(%width$11: index, %count: buffer, %source: buffer, %residual: buffer)

config.decl @spark2_5.model.hidden_size : index

config.decl @spark2_5.model.rms_epsilon : f32

command.decl @loomify.spark2_5.attention(%layer: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %output: buffer)

command.decl @loomify.spark2_5.ffn(%layer: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer)

command.def @loomify.spark2_5.layer(%layer: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer) where [range(%rows, 1, 512)] {
  %hidden = config.get @spark2_5.model.hidden_size : index
  %epsilon = config.get @spark2_5.model.rms_epsilon : f32
  %word = index.constant 4 : offset
  %gamma = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<[%hidden]xf32>
  %elements = index.mul %rows, %hidden : index
  %bytes = index.scale %elements, %word : index, offset -> offset
  %normal = buffer.alloca<global> align(256) %bytes : buffer
  %mixed = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.decoder.rmsnorm_active[%rows, %hidden](%rows, %hidden, %epsilon, %count, %residual, %gamma, %normal) : [index, index](index, index, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  command.launch @loomify.spark2_5.attention[%layer, %rows, %control_origin](%parameters, %normal, %count, %epoch, %map, %cache, %mixed) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @llm.decoder.residual[%rows, %hidden](%hidden, %count, %mixed, %residual) : [index, index](index, buffer, buffer, buffer)
  command.launch @loomify.spark2_5.ffn[%layer, %rows](%parameters, %residual, %count) : [index, index](buffer, buffer, buffer)
  command.return
}

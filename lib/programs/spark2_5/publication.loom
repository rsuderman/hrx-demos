config.decl @spark2_5.publication.eos_id : i32

template.decl @llm.publication.epoch_one_stop(%source_stop: i32, %epoch: buffer, %selected_ids: buffer, %output_ids: buffer)

kernel.def @spark2_5_publish_epoch_id() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %selected_ids: buffer, %output_ids: buffer) {
  %eos = config.get @spark2_5.publication.eos_id : i32
  template.apply<@llm.publication.epoch_one_stop>(%eos, %epoch, %selected_ids, %output_ids) : (i32, buffer, buffer, buffer)
  kernel.return
}

config.decl @qwen2.model.hidden_size : index

config.decl @qwen2.model.query_size : index

config.decl @qwen2.model.kv_size : index

config.decl @qwen2.model.query_heads : index

config.decl @qwen2.model.kv_heads : index

config.decl @qwen2.model.layer_count : index

config.decl @qwen2.model.rms_epsilon : f32

config.decl @qwen2.model.rope_log_step : f32

config.decl @qwen2.model.attention_scale : f32

config.decl @qwen2.attention.cache_capacity : index

config.decl @qwen2.attention.pool_capacity : index

config.decl @qwen2.attention.cache_base : offset

config.decl @qwen2.attention.map_origin : offset

template.decl @llm.decoder.matrix_attention(%layer: index, %rows: index, %control_origin: offset, %hidden: index, %qwidth: index, %kv: index, %qh: index, %kh: index, %layers: index, %capacity: index, %pool: index, %cache_base: offset, %map_origin: offset, %rope_step: f32, %epsilon: f32, %scale: f32, %parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer)

template.decl @llm.decoder.prepare_qkv(%layer: index, %rows: index, %control_origin: offset, %capacity: index, %qwidth: index, %kv: index, %qh: index, %kh: index, %rope_step: f32, %epsilon: f32, %parameters: buffer, %q: buffer, %k: buffer, %v: buffer, %query: buffer, %key: buffer, %count: buffer, %epoch: buffer)

kernel.decl @llm.decoder.prepare_qk_bias_h128(%rows: index, %heads: index) launch(%capacity: index, %rope_log_step: f32, %control_origin: offset, %epoch: buffer, %projection: buffer, %bias: buffer, %output: buffer)

kernel.decl @llm.decoder.add_bias_active(%rows: index, %width$64: index) launch(%width$65: index, %count: buffer, %bias: buffer, %projection: buffer)

template.def<@llm.decoder.prepare_qkv> @qwen2_prepare_qkv(%layer: index, %rows: index, %control_origin: offset, %capacity: index, %qwidth: index, %kv: index, %qh: index, %kh: index, %rope_step: f32, %epsilon: f32, %parameters: buffer, %q: buffer, %k: buffer, %v: buffer, %query: buffer, %key: buffer, %count: buffer, %epoch: buffer) where [range(%rows, 1, 512)] {
  %qbias = command.parameter %parameters, "blk.{}.attn_q.bias"[%layer] : view<[%qwidth]xf32>
  %kbias = command.parameter %parameters, "blk.{}.attn_k.bias"[%layer] : view<[%kv]xf32>
  %vbias = command.parameter %parameters, "blk.{}.attn_v.bias"[%layer] : view<[%kv]xf32>
  kernel.launch @llm.decoder.prepare_qk_bias_h128[%rows, %qh](%capacity, %rope_step, %control_origin, %epoch, %q, %qbias, %query) : [index, index](index, f32, offset, buffer, buffer, view<[%qwidth]xf32>, buffer)
  kernel.launch @llm.decoder.prepare_qk_bias_h128[%rows, %kh](%capacity, %rope_step, %control_origin, %epoch, %k, %kbias, %key) : [index, index](index, f32, offset, buffer, buffer, view<[%kv]xf32>, buffer)
  kernel.launch @llm.decoder.add_bias_active[%rows, %kv](%kv, %count, %vbias, %v) : [index, index](index, buffer, view<[%kv]xf32>, buffer)
  template.return
}

command.def @loomify.qwen2.attention(%layer: index, %phase: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer) where [range(%rows, 1, 512), range(%phase, 0, 1)] {
  %hidden = config.get @qwen2.model.hidden_size : index
  %qwidth = config.get @qwen2.model.query_size : index
  %kv = config.get @qwen2.model.kv_size : index
  %qh = config.get @qwen2.model.query_heads : index
  %kh = config.get @qwen2.model.kv_heads : index
  %layers = config.get @qwen2.model.layer_count : index
  %capacity = config.get @qwen2.attention.cache_capacity : index
  %pool = config.get @qwen2.attention.pool_capacity : index
  %cache_base = config.get @qwen2.attention.cache_base : offset
  %map_origin = config.get @qwen2.attention.map_origin : offset
  %epsilon = config.get @qwen2.model.rms_epsilon : f32
  %rope_step = config.get @qwen2.model.rope_log_step : f32
  %scale = config.get @qwen2.model.attention_scale : f32
  template.apply<@llm.decoder.matrix_attention>(%layer, %rows, %control_origin, %hidden, %qwidth, %kv, %qh, %kh, %layers, %capacity, %pool, %cache_base, %map_origin, %rope_step, %epsilon, %scale, %parameters, %normalized, %residual, %count, %epoch, %map, %cache) : (index, index, offset, index, index, index, index, index, index, index, index, offset, offset, f32, f32, f32, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

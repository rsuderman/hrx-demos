template.decl @llm.ffn.matrix_swiglu(%rows: index, %hidden: index, %ffn: index, %epsilon: f32, %gt: index, %dt: index, %gb: index, %db: index, %residual: buffer, %count: buffer, %gamma: view<[%hidden]xf32>, %gate: view<[%gb]xi8>, %up: view<[%gb]xi8>, %down: view<[%db]xi8>)
config.decl @qwen2.model.hidden_size : index
config.decl @qwen2.model.rms_epsilon : f32
func.decl pure @loomify.config.layer_ffn(%layer: index) -> (index, index, index, index, index, index, index)
command.def @loomify.qwen2.ffn(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer) where [range(%rows, 1, 512), range(%phase, 0, 1)] {
  %hidden = config.get @qwen2.model.hidden_size : index
  %epsilon = config.get @qwen2.model.rms_epsilon : f32
  %ffn, %gt, %ut, %dt, %gb, %ub, %db = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %gamma = command.parameter %parameters, "blk.{}.ffn_norm.weight"[%layer] : view<[%hidden]xf32>
  %gate = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%gb]xi8>
  %up = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%gb]xi8>
  %down = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%db]xi8>
  template.apply<@llm.ffn.matrix_swiglu>(%rows, %hidden, %ffn, %epsilon, %gt, %dt, %gb, %db, %residual, %count, %gamma, %gate, %up, %down) : (index, index, index, f32, index, index, index, index, buffer, buffer, view<[%hidden]xf32>, view<[%gb]xi8>, view<[%gb]xi8>, view<[%db]xi8>)
  command.return
}

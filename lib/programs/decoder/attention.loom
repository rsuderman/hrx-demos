// Shared Qwen2/Qwen3 assembly; the selected family supplies prepare_qkv.
func.decl pure @llm.projection.matrix_output_rows(%capacity: index) -> (index)
template.decl @llm.projection.matrix(%rows: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %count: buffer, %input: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer)
template.decl @llm.projection.matrix_qkv(%capacity: index, %input_width: index, %query_width: index, %kv_width: index, %query_tag: index, %key_tag: index, %value_tag: index, %query_bytes: index, %key_bytes: index, %value_bytes: index, %count: buffer, %input: buffer, %query_weight: view<[%query_bytes]xi8>, %key_weight: view<[%key_bytes]xi8>, %value_weight: view<[%value_bytes]xi8>, %query: buffer, %key: buffer, %value: buffer)
kernel.decl @llm.decoder.residual(%rows: index, %width: index) launch(%width: index, %count: buffer, %source: buffer, %residual: buffer)
func.decl pure @loomify.config.layer_attention(%layer: index) -> (index, index, index, index, index, index, index, index)
kernel.decl @llm.decoder.publish_kv_h128(%rows: index, %heads: index) launch(%layer: index, %layers: index, %capacity: index, %pool: index, %cache_base: offset, %control_origin: offset, %map_origin: offset, %epoch: buffer, %map: buffer, %key: buffer, %value: buffer, %cache: buffer)
kernel.decl @llm.decoder.attention_rows_h128(%rows: index, %heads: index, %key_heads: index) launch(%key_heads: index, %layer: index, %layers: index, %capacity: index, %pool: index, %scale: f32, %cache_base: offset, %control_origin: offset, %map_origin: offset, %epoch: buffer, %map: buffer, %query: buffer, %cache: buffer, %output: buffer)
template.decl @llm.decoder.prepare_qkv(%layer: index, %rows: index, %control_origin: offset, %capacity: index, %qwidth: index, %kv: index, %qh: index, %kh: index, %rope_step: f32, %epsilon: f32, %parameters: buffer, %q: buffer, %k: buffer, %v: buffer, %query: buffer, %key: buffer, %count: buffer, %epoch: buffer)
template.decl @llm.decoder.matrix_attention(%layer: index, %rows: index, %control_origin: offset, %hidden: index, %qwidth: index, %kv: index, %qh: index, %kh: index, %layers: index, %capacity: index, %pool: index, %cache_base: offset, %map_origin: offset, %rope_step: f32, %epsilon: f32, %scale: f32, %parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer)
template.def<@llm.decoder.matrix_attention> @llm_decoder_matrix_attention(%layer: index, %rows: index, %control_origin: offset, %hidden: index, %qwidth: index, %kv: index, %qh: index, %kh: index, %layers: index, %capacity: index, %pool: index, %cache_base: offset, %map_origin: offset, %rope_step: f32, %epsilon: f32, %scale: f32, %parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer) where [range(%rows, 1, 512)] {
  %word = index.constant 4 : offset
  %physical_rows = func.call pure @llm.projection.matrix_output_rows(%rows) : (index) -> (index)
  %qt, %kt, %vt, %ot, %qb, %kb, %vb, %ob = func.call pure @loomify.config.layer_attention(%layer) : (index) -> (index, index, index, index, index, index, index, index)
  %qw = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<[%qb]xi8>
  %kw = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<[%kb]xi8>
  %vw = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%vb]xi8>
  %ow = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<[%ob]xi8>
  %q_elements = index.mul %physical_rows, %qwidth : index
  %q_bytes = index.scale %q_elements, %word : index, offset -> offset
  %q = buffer.alloca<global> align(256) %q_bytes : buffer
  %k_elements = index.mul %physical_rows, %kv : index
  %k_bytes = index.scale %k_elements, %word : index, offset -> offset
  %k = buffer.alloca<global> align(256) %k_bytes : buffer
  %v_elements = index.mul %physical_rows, %kv : index
  %v_bytes = index.scale %v_elements, %word : index, offset -> offset
  %v = buffer.alloca<global> align(256) %v_bytes : buffer
  %projected_elements = index.mul %physical_rows, %hidden : index
  %projected_bytes = index.scale %projected_elements, %word : index, offset -> offset
  %projected = buffer.alloca<global> align(256) %projected_bytes : buffer
  %query_elements = index.mul %rows, %qwidth : index
  %query_bytes = index.scale %query_elements, %word : index, offset -> offset
  %query = buffer.alloca<global> align(256) %query_bytes : buffer
  %key_elements = index.mul %rows, %kv : index
  %key_bytes = index.scale %key_elements, %word : index, offset -> offset
  %key = buffer.alloca<global> align(256) %key_bytes : buffer
  %attended_elements = index.mul %rows, %qwidth : index
  %attended_bytes = index.scale %attended_elements, %word : index, offset -> offset
  %attended = buffer.alloca<global> align(256) %attended_bytes : buffer
  template.apply<@llm.projection.matrix_qkv>(%rows, %hidden, %qwidth, %kv, %qt, %kt, %vt, %qb, %kb, %vb, %count, %normalized, %qw, %kw, %vw, %q, %k, %v) : (index, index, index, index, index, index, index, index, index, index, buffer, buffer, view<[%qb]xi8>, view<[%kb]xi8>, view<[%vb]xi8>, buffer, buffer, buffer)
  template.apply<@llm.decoder.prepare_qkv>(%layer, %rows, %control_origin, %capacity, %qwidth, %kv, %qh, %kh, %rope_step, %epsilon, %parameters, %q, %k, %v, %query, %key, %count, %epoch) : (index, index, offset, index, index, index, index, index, f32, f32, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @llm.decoder.publish_kv_h128[%rows, %kh](%layer, %layers, %capacity, %pool, %cache_base, %control_origin, %map_origin, %epoch, %map, %key, %v, %cache) : [index, index](index, index, index, index, offset, offset, offset, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @llm.decoder.attention_rows_h128[%rows, %qh, %kh](%kh, %layer, %layers, %capacity, %pool, %scale, %cache_base, %control_origin, %map_origin, %epoch, %map, %query, %cache, %attended) : [index, index, index](index, index, index, index, index, f32, offset, offset, offset, buffer, buffer, buffer, buffer, buffer)
  template.apply<@llm.projection.matrix>(%rows, %qwidth, %hidden, %ot, %ob, %count, %attended, %ow, %projected) : (index, index, index, index, index, buffer, buffer, view<[%ob]xi8>, buffer)
  kernel.launch @llm.decoder.residual[%rows, %hidden](%hidden, %count, %projected, %residual) : [index, index](index, buffer, buffer, buffer)
  template.return
}

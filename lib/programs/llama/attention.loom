template.decl @llm.projection.pack_input(%policy: index, %launch_rows: index, %row_capacity: index, %input_width: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count: buffer, %input: buffer, %packed: buffer)
template.decl @llm.projection.project_packed(%policy: index, %weight_tag: index, %launch_rows: index, %row_capacity: index, %input_width: index, %output_width: index, %weight_bytes: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count: buffer, %packed: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer)
// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Maintained decoder attention sequence. Numerical providers own arithmetic,
// active-row guards, mapped cache addressing and precision-policy selection.
config.decl @llama.model.hidden_size : index
config.decl @llama.model.kv_size : index
config.decl @llama.attention.cache_base : offset
config.decl @llama.attention.map_origin : offset
config.decl @llama.model.has_rope_frequencies : index
func.decl pure @loomify.config.layer_attention(%layer: index) -> (index, index, index, index, index, index, index, index)


kernel.decl @llama32_rotary_query(%token_capacity0: index) launch(%control_kind: index, %control_origin: offset, %token_begin: index, %control: buffer, %factors: buffer, %projection: buffer, %query: buffer)
kernel.decl @llama32_publish_kv(%token_capacity0: index) launch(%layer0: index, %cache_base: offset, %control_kind: index, %control_origin: offset, %token_begin: index, %map_origin: offset, %control: buffer, %map: buffer, %factors: buffer, %key: buffer, %value: buffer, %cache: buffer)
kernel.decl @llama32_attention_rows(%token_capacity0: index) launch(%layer0: index, %cache_base: offset, %control_kind: index, %control_origin: offset, %token_begin: index, %map_origin: offset, %control: buffer, %map: buffer, %query: buffer, %cache: buffer, %output: buffer)
kernel.decl @llama32_attention_residual(%token_capacity0: index) launch(%control_kind: index, %control_origin: offset, %token_begin: index, %control: buffer, %projected: buffer, %residual: buffer)
kernel.decl @llama32_unit_rope_factors() launch(%factors: buffer)

command.def @loomify.llama.attention(%layer: index, %phase: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %control: buffer, %map: buffer, %cache: buffer) where [range(%rows, 1, 512), range(%phase, 0, 1)] {
  %hidden = config.get @llama.model.hidden_size : index
  %kv = config.get @llama.model.kv_size : index
  %cache_base = config.get @llama.attention.cache_base : offset
  %map_origin = config.get @llama.attention.map_origin : offset
  %q_tag, %k_tag, %v_tag, %o_tag, %q_bytes, %k_bytes, %v_bytes, %o_bytes = func.call pure @loomify.config.layer_attention(%layer) : (index) -> (index, index, index, index, index, index, index, index)
  %q_weight = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<[%q_bytes]xi8>
  %k_weight = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<[%k_bytes]xi8>
  %v_weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%v_bytes]xi8>
  %o_weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<[%o_bytes]xi8>
  %zero = index.constant 0 : index
  %origin = index.constant 0 : offset
  %has_factors = config.get @llama.model.has_rope_frequencies : index
  %from_tensor = index.cmp ne, %has_factors, %zero : index
  %factors = scf.if %from_tensor -> (view<64xf32>) {
    %checkpoint = command.parameter %parameters, "rope_freqs.weight" : view<64xf32>
    scf.yield %checkpoint : view<64xf32>
  } else {
    // The portable command schedule owns device scratch; global.load is a
    // host-VM operation. Initialize the ordinary-RoPE identity in device memory.
    %factor_bytes = index.constant 256 : offset
    %unit_buffer = buffer.alloca<global> align(256) %factor_bytes : buffer
    kernel.launch @llama32_unit_rope_factors[](%unit_buffer) : [](buffer)
    %units = buffer.view %unit_buffer[%origin] : buffer -> view<64xf32>
    scf.yield %units : view<64xf32>
  }
  %dynamic = scalar.constant -1 : i32
  %four = index.constant 4 : offset
  %block = index.constant 128 : index
  %packed_block = index.constant 144 : offset
  %hidden_elements = index.mul %rows, %hidden : index
  %kv_elements = index.mul %rows, %kv : index
  %hidden_bytes = index.scale %hidden_elements, %four : index, offset -> offset
  %kv_bytes = index.scale %kv_elements, %four : index, offset -> offset
  %packed_blocks = index.div %hidden_elements, %block : index
  %packed_bytes = index.scale %packed_blocks, %packed_block : index, offset -> offset
  %packed = buffer.alloca<global> align(256) %packed_bytes : buffer
  %q = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %k = buffer.alloca<global> align(256) %kv_bytes : buffer
  %v = buffer.alloca<global> align(256) %kv_bytes : buffer
  %query = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %attended = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %attention_packed = buffer.alloca<global> align(256) %packed_bytes : buffer
  %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
  // Projection count is the layer's private snapshot, including during decode.
  template.apply<@llm.projection.pack_input>(%zero, %rows, %rows, %hidden, %zero, %dynamic, %origin, %count, %normalized, %packed) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
  template.apply<@llm.projection.project_packed>(%zero, %q_tag, %rows, %rows, %hidden, %hidden, %q_bytes, %zero, %dynamic, %origin, %count, %packed, %q_weight, %q) : (index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%q_bytes]xi8>, buffer)
  template.apply<@llm.projection.project_packed>(%zero, %k_tag, %rows, %rows, %hidden, %kv, %k_bytes, %zero, %dynamic, %origin, %count, %packed, %k_weight, %k) : (index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%k_bytes]xi8>, buffer)
  template.apply<@llm.projection.project_packed>(%zero, %v_tag, %rows, %rows, %hidden, %kv, %v_bytes, %zero, %dynamic, %origin, %count, %packed, %v_weight, %v) : (index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%v_bytes]xi8>, buffer)
  // Position-bearing operations retain the original runtime control packet.
  kernel.launch @llama32_rotary_query[%rows](%phase, %control_origin, %zero, %control, %factors, %q, %query) : [index](index, offset, index, buffer, view<64xf32>, buffer, buffer)
  kernel.launch @llama32_publish_kv[%rows](%layer, %cache_base, %phase, %control_origin, %zero, %map_origin, %control, %map, %factors, %k, %v, %cache) : [index](index, offset, index, offset, index, offset, buffer, buffer, view<64xf32>, buffer, buffer, buffer)
  // Publication precedes causal consumption; the provider clears inactive rows.
  kernel.launch @llama32_attention_rows[%rows](%layer, %cache_base, %phase, %control_origin, %zero, %map_origin, %control, %map, %query, %cache, %attended) : [index](index, offset, index, offset, index, offset, buffer, buffer, buffer, buffer, buffer)
  template.apply<@llm.projection.pack_input>(%zero, %rows, %rows, %hidden, %zero, %dynamic, %origin, %count, %attended, %attention_packed) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
  template.apply<@llm.projection.project_packed>(%zero, %o_tag, %rows, %rows, %hidden, %hidden, %o_bytes, %zero, %dynamic, %origin, %count, %attention_packed, %o_weight, %projected) : (index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%o_bytes]xi8>, buffer)
  kernel.launch @llama32_attention_residual[%rows](%phase, %control_origin, %zero, %control, %projected, %residual) : [index](index, offset, index, buffer, buffer, buffer)
  command.return
}

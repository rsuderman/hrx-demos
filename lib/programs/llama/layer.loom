// The decoder layer owns its snapshot and scratch; residual and this layer's
// cache planes are the only caller-owned mutable values.
config.decl @llama.model.hidden_size : index
kernel.decl @llama32_rmsnorm_active_f32(%rows: index) launch(%rows: index, %begin: index, %origin: offset, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)
command.program.decl @loomify.llama.attention(%layer: index, %phase: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %control: buffer, %map: buffer, %cache: buffer)
command.program.decl @loomify.llama.ffn(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer)

command.program.def @loomify.llama.layer(%layer: index, %phase: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %control: buffer, %map: buffer, %cache: buffer, %count: buffer) where [range(%rows, 1, 512), range(%phase, 0, 1)] {
  %hidden = config.get @llama.model.hidden_size : index
  %gamma = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<[%hidden]xf32>
  %zero = index.constant 0 : index
  %origin = index.constant 0 : offset
  %four = index.constant 4 : offset
  %elements = index.mul %rows, %hidden : index
  %bytes = index.scale %elements, %four : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llama32_rmsnorm_active_f32[%rows](%rows, %zero, %origin, %count, %residual, %gamma, %normalized) : [index](index, index, offset, buffer, buffer, view<[%hidden]xf32>, buffer)
  command.program.launch @loomify.llama.attention[%layer, %phase, %rows, %control_origin](%parameters, %normalized, %residual, %count, %control, %map, %cache) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @loomify.llama.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}

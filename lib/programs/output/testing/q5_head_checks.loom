// Real shared head with Q5_K/canonical projection, real last-row RMS and
// independent ordering/tie expectation. Rows17/19 tie above every other row.
config.def @ggml.linear_q5k_q8_1_x4.token_capacity = 1 : index

config.def @ggml.linear_q5k_q8_1_x4.output_capacity = 256 : index

config.def @ggml.quantize_q8_1_x4.group_capacity = 2 : index

config.def @qwen38.greedy_argmax.output_capacity = 256 : index

kernel.decl @llm.decoder.output_norm_last(%capacity$4: index, %width$5: index) launch(%capacity$6: index, %width$7: index, %begin: index, %origin: offset, %epsilon: f32, %control: buffer, %input: buffer, %gamma: buffer, %output: buffer)

template.decl @llm.output.norm_last(%capacity: index, %begin: index, %origin: offset, %hidden: index, %control: buffer, %input: buffer, %gamma: view<[%hidden]xf32>, %output: buffer)

template.def<@llm.output.norm_last> @q5_head_norm_last(%capacity: index, %begin: index, %origin: offset, %hidden: index, %control: buffer, %input: buffer, %gamma: view<[%hidden]xf32>, %output: buffer) {
  %epsilon = scalar.constant 0.0 : f32
  kernel.launch @llm.decoder.output_norm_last[%capacity, %hidden](%capacity, %hidden, %begin, %origin, %epsilon, %control, %input, %gamma, %output) : [index, index](index, index, index, offset, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  template.return
}

template.decl @llm.output.last_greedy(%capacity: index, %begin: index, %origin: offset, %hidden: index, %vocab: index, %weight_bytes: index, %policy: index, %tag: index, %input: buffer, %control: buffer, %gamma: view<[%hidden]xf32>, %weight: view<[%weight_bytes]xi8>, %token: buffer)

func.def @q5_head.init(%weights: buffer, %input: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %rows = index.constant 256 : index
  %stride = index.constant 176 : offset
  %code_begin = index.constant 48 : offset
  %scale_begin = index.constant 4 : offset
  %twelve = index.constant 12 : index
  %payload = index.constant 128 : index
  %seventeen = index.constant 17 : index
  %nineteen = index.constant 19 : index
  %origin = index.constant 0 : offset
  %unit = scalar.constant 1.0 : f16
  %scale = scalar.constant 1 : i8
  %low = scalar.constant 17 : i8
  %high = scalar.constant 51 : i8
  scf.for %row = [%zero to %rows step %one] {
    %base = index.scale %row, %stride : index, offset -> offset
    %header = buffer.view %weights[%base] : buffer -> view<2xf16>
    view.store %unit, %header[0] : f16, view<2xf16>
    %so = index.add %base, %scale_begin : offset
    %scales = buffer.view %weights[%so] : buffer -> view<12xi8>
    scf.for %s = [%zero to %twelve step %one] {
      view.store %scale, %scales[%s] : i8, view<12xi8>
    }
    %a = index.cmp eq, %row, %seventeen : index
    %b = index.cmp eq, %row, %nineteen : index
    %winner = scalar.ori %a, %b : i1
    %code = scf.select %winner, %high, %low : i8
    %co = index.add %base, %code_begin : offset
    %codes = buffer.view %weights[%co] : buffer -> view<128xi8>
    scf.for %i = [%zero to %payload step %one] {
      view.store %code, %codes[%i] : i8, view<128xi8>
    }
  }
  %x = buffer.view %input[%origin] : buffer -> view<4x256xf32>
  %negative = scalar.constant -1.0 : f32
  scf.for %k = [%zero to %rows step %one] {
    view.store %negative, %x[0, %k] : f32, view<4x256xf32>
    view.store %negative, %x[1, %k] : f32, view<4x256xf32>
  }
  func.return
}

command.def @q5_head.actual() launch(%input: buffer, %count: buffer, %gamma: buffer, %weights: buffer, %normalized: buffer, %token: buffer) {
  %capacity = index.constant 4 : index
  %begin = index.constant 1 : index
  %origin = index.constant 0 : offset
  %hidden = index.constant 256 : index
  %vocab = index.constant 256 : index
  %bytes = index.constant 45056 : index
  %policy = index.constant 1 : index
  %tag = index.constant 13 : index
  %g = buffer.view %gamma[%origin] : buffer -> view<[%hidden]xf32>
  %w = buffer.view %weights[%origin] : buffer -> view<[%bytes]xi8>
  // Keep the independent normalization observation outside production scratch.
  template.apply<@llm.output.norm_last>(%capacity, %begin, %origin, %hidden, %count, %input, %g, %normalized) : (index, index, offset, index, buffer, buffer, view<[%hidden]xf32>, buffer)
  template.apply<@llm.output.last_greedy>(%capacity, %begin, %origin, %hidden, %vocab, %bytes, %policy, %tag, %input, %count, %g, %w, %token) : (index, index, offset, index, index, index, index, index, buffer, buffer, view<[%hidden]xf32>, view<[%bytes]xi8>, buffer)
  command.return
}

func.def @q5_head.expected(%input: buffer, %count: buffer, %gamma: buffer, %weights: buffer, %normalized: buffer, %token: buffer) {
  %origin = index.constant 0 : offset
  %n = buffer.view %normalized[%origin] : buffer -> view<256xf32>
  %t = buffer.view %token[%origin] : buffer -> view<1xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %width = index.constant 256 : index
  %unit = scalar.constant 1.0 : f32
  %id = scalar.constant 17 : i32
  scf.for %k = [%zero to %width step %one] {
    view.store %unit, %n[%k] : f32, view<256xf32>
  }
  view.store %id, %t[0] : i32, view<1xi32>
  func.return
}

check.scenario @q5_canonical_head_nonzero_tied_winner {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.0) : tensor<1024xf32>
    %gamma = check.generate.fill value(1.0) : tensor<256xf32>
    %weights = check.generate.fill value(0) : tensor<45056xi8>
    %count = check.generate.fill value(2) : tensor<3xi32>
    %normal_owner = check.generate.fill value(-99.0) : tensor<264xf32>
    %token_owner = check.generate.fill value(-77) : tensor<9xi32>
    %normalized = check.tensor.view %normal_owner offset(16) : tensor<264xf32> -> tensor<256xf32>
    %token = check.tensor.view %token_owner offset(16) : tensor<9xi32> -> tensor<1xi32>
    check.generate<@q5_head.init>(%weights, %input) : (tensor<45056xi8>, tensor<1024xf32>) -> ()
    check.compare<@q5_head.actual, @q5_head.expected>(%input, %count, %gamma, %weights, %normalized, %token) : (tensor<1024xf32>, tensor<3xi32>, tensor<256xf32>, tensor<45056xi8>, tensor<256xf32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%token_owner) expected(%token_owner) : tensor<9xi32>
      check.expect.approximate actual(%normal_owner) expected(%normal_owner) atol(5.0000000000000002e-05) rtol(5.0000000000000002e-05) nan(same) : tensor<264xf32>, tensor<264xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1024xf32>
      check.expect.bitwise actual(%count) expected(%count) : tensor<3xi32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<256xf32>
      check.expect.bitwise actual(%weights) expected(%weights) : tensor<45056xi8>
    }
  }
  check.return
}

func.def @q5_head.expected_invalid_count(%input: buffer, %count: buffer, %gamma: buffer, %weights: buffer, %normalized: buffer, %token: buffer) {
  %origin = index.constant 0 : offset
  %normal = buffer.view %normalized[%origin] : buffer -> view<256xf32>
  %selected = buffer.view %token[%origin] : buffer -> view<1xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %width = index.constant 256 : index
  %zero_f = scalar.constant 0.0 : f32
  %zero_id = scalar.constant 0 : i32
  scf.for %column = [%zero to %width step %one] {
    view.store %zero_f, %normal[%column] : f32, view<256xf32>
  }
  // The private head still writes the lowest tied ID for finite zero logits.
  view.store %zero_id, %selected[0] : i32, view<1xi32>
  func.return
}

check.scenario @q5_head_invalid_count_still_writes_private_id_0 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.0) : tensor<1024xf32>
    %gamma = check.generate.fill value(1.0) : tensor<256xf32>
    %weights = check.generate.fill value(0) : tensor<45056xi8>
    %count = check.generate.fill value(0) : tensor<3xi32>
    %normal_owner = check.generate.fill value(-99.0) : tensor<264xf32>
    %token_owner = check.generate.fill value(-77) : tensor<9xi32>
    %normalized = check.tensor.view %normal_owner offset(16) : tensor<264xf32> -> tensor<256xf32>
    %token = check.tensor.view %token_owner offset(16) : tensor<9xi32> -> tensor<1xi32>
    check.generate<@q5_head.init>(%weights, %input) : (tensor<45056xi8>, tensor<1024xf32>) -> ()
    check.compare<@q5_head.actual, @q5_head.expected_invalid_count>(%input, %count, %gamma, %weights, %normalized, %token) : (tensor<1024xf32>, tensor<3xi32>, tensor<256xf32>, tensor<45056xi8>, tensor<256xf32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%normal_owner) expected(%normal_owner) : tensor<264xf32>
      check.expect.bitwise actual(%token_owner) expected(%token_owner) : tensor<9xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1024xf32>
      check.expect.bitwise actual(%count) expected(%count) : tensor<3xi32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<256xf32>
      check.expect.bitwise actual(%weights) expected(%weights) : tensor<45056xi8>
    }
  }
  check.return
}


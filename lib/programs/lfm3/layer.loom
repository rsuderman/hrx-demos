kernel.decl @llm.decoder.rmsnorm_active(%rows: index, %width: index) launch(%rows: index, %width: index, %epsilon: f32, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)
kernel.decl @llm.decoder.residual(%rows: index, %width: index) launch(%width: index, %count: buffer, %source: buffer, %residual: buffer)
config.decl @lfm3.model.hidden_size : index
config.decl @lfm3.model.rms_epsilon : f32
config.decl @lfm3.model.post_rms_epsilon : f32
func.decl pure @loomify.config.layer_info(%layer: index) -> (index, index, index)
command.decl @loomify.lfm3.shortconv(%layer: index, %ordinal: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %count: buffer, %epoch: buffer, %cache: buffer, %output: buffer)
command.decl @loomify.lfm3.attention(%layer: index, %ordinal: index, %window: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %output: buffer)
command.decl @loomify.lfm3.ffn(%layer: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer)
command.def @loomify.lfm3.layer(%layer: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer) where [range(%rows, 1, 512)] {
  %hidden = config.get @lfm3.model.hidden_size : index
  %rms_epsilon = config.get @lfm3.model.rms_epsilon : f32
  %post_rms_epsilon = config.get @lfm3.model.post_rms_epsilon : f32
  %word = index.constant 4 : offset
  %zero = index.constant 0 : index
  %kind, %ordinal, %window = func.call pure @loomify.config.layer_info(%layer) : (index) -> (index, index, index)
  %gamma = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<[%hidden]xf32>
  %postgamma = command.parameter %parameters, "blk.{}.post_attention_norm.weight"[%layer] : view<[%hidden]xf32>
  %normal_elements = index.mul %rows, %hidden : index
  %normal_bytes = index.scale %normal_elements, %word : index, offset -> offset
  %normal = buffer.alloca<global> align(256) %normal_bytes : buffer
  %mixed_elements = index.mul %rows, %hidden : index
  %mixed_bytes = index.scale %mixed_elements, %word : index, offset -> offset
  %mixed = buffer.alloca<global> align(256) %mixed_bytes : buffer
  %post_elements = index.mul %rows, %hidden : index
  %post_bytes = index.scale %post_elements, %word : index, offset -> offset
  %post = buffer.alloca<global> align(256) %post_bytes : buffer
  kernel.launch @llm.decoder.rmsnorm_active[%rows, %hidden](%rows, %hidden, %rms_epsilon, %count, %residual, %gamma, %normal) : [index, index](index, index, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  %attention = index.cmp eq, %kind, %zero : index
  scf.if %attention {
    command.launch @loomify.lfm3.attention[%layer, %ordinal, %window, %rows, %control_origin](%parameters, %normal, %count, %epoch, %map, %cache, %mixed) : [index, index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  } else {
    command.launch @loomify.lfm3.shortconv[%layer, %ordinal, %rows, %control_origin](%parameters, %normal, %count, %epoch, %cache, %mixed) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  kernel.launch @llm.decoder.rmsnorm_active[%rows, %hidden](%rows, %hidden, %post_rms_epsilon, %count, %mixed, %postgamma, %post) : [index, index](index, index, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  kernel.launch @llm.decoder.residual[%rows, %hidden](%hidden, %count, %post, %residual) : [index, index](index, buffer, buffer, buffer)
  command.launch @loomify.lfm3.ffn[%layer, %rows](%parameters, %residual, %count) : [index, index](buffer, buffer, buffer)
  command.return
}

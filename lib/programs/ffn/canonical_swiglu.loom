// Independent gate/up/down encodings; callers own normalization and residual order.
template.decl @llm.projection.canonical_rows(%rows: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %count: buffer, %input: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer)

kernel.decl @llm_ffn_swiglu_f32_prefill(%rows$9: index, %width$10: index) launch(%width$11: index, %rows$12: index, %gate: buffer, %up: buffer, %output: buffer)

template.decl @llm.ffn.canonical_swiglu(%rows: index, %hidden: index, %ffn: index, %gt: index, %ut: index, %dt: index, %gb: index, %ub: index, %db: index, %count: buffer, %normal: buffer, %gate_weight: view<[%gb]xi8>, %up_weight: view<[%ub]xi8>, %down_weight: view<[%db]xi8>, %down: buffer)

template.def<@llm.ffn.canonical_swiglu> @llm_ffn_canonical_swiglu(%rows: index, %hidden: index, %ffn: index, %gt: index, %ut: index, %dt: index, %gb: index, %ub: index, %db: index, %count: buffer, %normal: buffer, %gate_weight: view<[%gb]xi8>, %up_weight: view<[%ub]xi8>, %down_weight: view<[%db]xi8>, %down: buffer) where [range(%rows, 1, 512)] {
  %word = index.constant 4 : offset
  %gate_elements = index.mul %rows, %ffn : index
  %gate_bytes = index.scale %gate_elements, %word : index, offset -> offset
  %gate = buffer.alloca<global> align(256) %gate_bytes : buffer
  %up_elements = index.mul %rows, %ffn : index
  %up_bytes = index.scale %up_elements, %word : index, offset -> offset
  %up = buffer.alloca<global> align(256) %up_bytes : buffer
  %activated_elements = index.mul %rows, %ffn : index
  %activated_bytes = index.scale %activated_elements, %word : index, offset -> offset
  %activated = buffer.alloca<global> align(256) %activated_bytes : buffer
  template.apply<@llm.projection.canonical_rows>(%rows, %hidden, %ffn, %gt, %gb, %count, %normal, %gate_weight, %gate) : (index, index, index, index, index, buffer, buffer, view<[%gb]xi8>, buffer)
  template.apply<@llm.projection.canonical_rows>(%rows, %hidden, %ffn, %ut, %ub, %count, %normal, %up_weight, %up) : (index, index, index, index, index, buffer, buffer, view<[%ub]xi8>, buffer)
  kernel.launch @llm_ffn_swiglu_f32_prefill[%rows, %ffn](%ffn, %rows, %gate, %up, %activated) : [index, index](index, index, buffer, buffer, buffer)
  template.apply<@llm.projection.canonical_rows>(%rows, %ffn, %hidden, %dt, %db, %count, %activated, %down_weight, %down) : (index, index, index, index, index, buffer, buffer, view<[%db]xi8>, buffer)
  template.return
}

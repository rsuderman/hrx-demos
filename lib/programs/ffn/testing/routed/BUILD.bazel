load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:loom_testing.bzl", "loom_checks", "loom_provider_checks")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "real_weight_generator",
    testonly = True,
    srcs = [
        "fixtures.py",
        "real_weight_fixtures.py",
    ],
)

# Actual immutable inputs are supplied externally; these are the same public
# production/observer providers used by the bounded maintained checks below.
[loom_merge(
    name = "real_weight_provider_" + format,
    testonly = True,
    srcs = [
        ":observed_stages",
        "//lib/kernels/decoder:implementation_sources",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
        "//lib/programs/ffn:rms_routed_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
        "//lib/programs/projection/testing:fixture_config.loom",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

# The family adapter and these checks call the same production composition.
[genrule(
    name = "rms_routed_c" + str(capacity) + "_q" + str(tag) + "_fixtures",
    testonly = True,
    srcs = [
        "fixtures.py",
        "rms_routed_fixtures.py",
    ],
    outs = ["rms_routed_c" + str(capacity) + "_q" + str(tag) + "_checks.loom"],
    cmd = "python3 $(location rms_routed_fixtures.py) $(location fixtures.py) $@ " + str(capacity) + " " + str(tag),
) for capacity in [
    1,
    8,
    17,
] for tag in [
    12,
    14,
]]

[loom_provider_checks(
    name = "rms_routed_c" + str(capacity) + "_q" + str(tag),
    checks = [":rms_routed_c" + str(capacity) + "_q" + str(tag) + "_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "rms_routed_c" + str(capacity) + "_q" + str(tag) + "_provider",
    provider_srcs = [
        "//lib/kernels/decoder:implementation_sources",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/ffn:rms_routed_sources",
    ],
) for capacity in [
    1,
    8,
    17,
] for tag in [
    12,
    14,
]]

genrule(
    name = "observed_stages",
    testonly = True,
    srcs = [
        "observe.py",
        "//lib/kernels/routing:softmax_top8.loom",
        "//lib/kernels/experts:indexed.loom",
    ],
    outs = ["observed_stages.loom"],
    cmd = "python3 $(location observe.py) $(location //lib/kernels/routing:softmax_top8.loom) $(location //lib/kernels/experts:indexed.loom) $@",
)

# Semantic modules bound the pinned bytecode SSA width without duplicating
# provider math. Each stage/capacity emits its existing scenario subset once.
[genrule(
    name = stage + "_c" + str(capacity) + "_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = [stage + "_c" + str(capacity) + "_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ " + stage + " " + str(capacity),
) for stage in [
    "router",
    "pack",
    "combine",
    "indexed",
    "composition",
] for capacity in [
    1,
    8,
    16,
    17,
]]

genrule(
    name = "activation_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = ["activation_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ activation",
)

genrule(
    name = "format_wire_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = ["format_wire_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ formats_wire",
)

_GATE_FORMATS = [
    12,
    13,
    14,
    8,
]

_DOWN_FORMATS = _GATE_FORMATS + [6]

[genrule(
    name = "format_pair_g" + str(gate) + "_u" + str(up) + "_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = ["format_pair_g" + str(gate) + "_u" + str(up) + "_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ formats_pair " + str(gate) + " " + str(up),
) for gate in _GATE_FORMATS for up in _GATE_FORMATS]

[genrule(
    name = "format_down_q" + str(tag) + "_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = ["format_down_q" + str(tag) + "_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ formats_down " + str(tag),
) for tag in _DOWN_FORMATS]

_COMPOSITIONS = [
    (13, 8, 14),
    (14, 13, 8),
    (8, 14, 6),
    (12, 8, 13),
]

[genrule(
    name = "format_composition_" + str(gate) + "_" + str(up) + "_" + str(down) + "_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = ["format_composition_" + str(gate) + "_" + str(up) + "_" + str(down) + "_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ formats_composition " + str(gate) + " " + str(up) + " " + str(down),
) for gate, up, down in _COMPOSITIONS]

_TAIL_CASES = [
    ("pair_g13_u8_c17", "formats_pair 13 8 17"),
    ("down_q6_c17", "formats_down 6 17"),
    ("composition_13_8_14_c17", "formats_composition 13 8 14 17"),
]

[genrule(
    name = "format_" + name + "_fixtures",
    testonly = True,
    srcs = ["fixtures.py"],
    outs = ["format_" + name + "_checks.loom"],
    cmd = "python3 $(location fixtures.py) $@ " + arguments,
) for name, arguments in _TAIL_CASES]

[loom_checks(
    name = "routed_" + stage + "_c" + str(capacity),
    checks = [":" + stage + "_c" + str(capacity) + "_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "provider",
) for stage in [
    "router",
    "pack",
    "combine",
    "indexed",
    "composition",
] for capacity in [
    1,
    8,
    16,
    17,
]]

loom_provider_checks(
    name = "routed_activation",
    checks = [":activation_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "provider",
    provider_srcs = [
        ":observed_stages",
        "activation.loom",
        "formats.loom",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/ffn:direct_routed_sources",
    ],
)

_FORMAT_CHECKS = ["wire"] + [
    "pair_g" + str(gate) + "_u" + str(up)
    for gate in _GATE_FORMATS
    for up in _GATE_FORMATS
] + ["down_q" + str(tag) for tag in _DOWN_FORMATS] + [
    "composition_" + str(gate) + "_" + str(up) + "_" + str(down)
    for gate, up, down in _COMPOSITIONS
] + [name for name, _ in _TAIL_CASES]

[loom_checks(
    name = "routed_format_" + name,
    checks = [":format_" + name + "_fixtures"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "provider",
) for name in _FORMAT_CHECKS]

cc_test(
    name = "materialization_test",
    size = "small",
    srcs = ["materialization_test.cc"],
    copts = ["-std=c++17"],
    data = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/ffn:direct_routed",
        "//lib/programs/ffn:direct_routed_text",
    ],
    linkstatic = True,
    deps = [
        "//lib/loomify:native_linking",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

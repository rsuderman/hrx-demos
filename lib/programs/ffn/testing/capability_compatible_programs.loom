func.def @test.expected.compatible_q12_rows3.body(%channel0: index, %residual: buffer, %count: buffer) {
  %channel = index.assume %channel0 [range(%channel0, 0, 6143)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %is_zero = index.cmp eq, %channel, %zero : index
  %mod = index.rem %channel, %four : index
  %channel_factor = index.add %mod, %one : index
  %inverse_channel = index.sub %four, %mod : index
  %float_one = scalar.constant 1.0 : f32
  %view_final = buffer.view %residual[%origin] : buffer -> view<3x3072xf32>
  %v_final0_0 = scalar.constant 33.9534912109375 : f32
  %v_final0_1 = scalar.constant 66.906982421875 : f32
  %v_final0_2 = scalar.constant 99.8604736328125 : f32
  %v_final0_3 = scalar.constant 132.81396484375 : f32
  %m2_final0 = index.constant 2 : index
  %m3_final0 = index.constant 3 : index
  %p1_final0 = index.cmp eq, %mod, %one : index
  %p2_final0 = index.cmp eq, %mod, %m2_final0 : index
  %p3_final0 = index.cmp eq, %mod, %m3_final0 : index
  %s1_final0 = scf.select %p1_final0, %v_final0_1, %v_final0_0 : f32
  %s2_final0 = scf.select %p2_final0, %v_final0_2, %s1_final0 : f32
  %s3_final0 = scf.select %p3_final0, %v_final0_3, %s2_final0 : f32
  %limit_final = index.constant 3072 : index
  %valid_final = index.cmp ult, %channel, %limit_final : index
  scf.if %valid_final {
    view.store %s3_final0, %view_final[0, %channel] : f32, view<3x3072xf32>
  }
  %v_final1_0 = scalar.constant -1.6497936248779297 : f32
  %v_final1_1 = scalar.constant -1.2995872497558594 : f32
  %v_final1_2 = scalar.constant -0.94938087463378906 : f32
  %v_final1_3 = scalar.constant -0.59917449951171875 : f32
  %m2_final1 = index.constant 2 : index
  %m3_final1 = index.constant 3 : index
  %p1_final1 = index.cmp eq, %mod, %one : index
  %p2_final1 = index.cmp eq, %mod, %m2_final1 : index
  %p3_final1 = index.cmp eq, %mod, %m3_final1 : index
  %s1_final1 = scf.select %p1_final1, %v_final1_1, %v_final1_0 : f32
  %s2_final1 = scf.select %p2_final1, %v_final1_2, %s1_final1 : f32
  %s3_final1 = scf.select %p3_final1, %v_final1_3, %s2_final1 : f32
  scf.if %valid_final {
    view.store %s3_final1, %view_final[1, %channel] : f32, view<3x3072xf32>
  }
  %v_final2_0 = scalar.constant 35.9534912109375 : f32
  %v_final2_1 = scalar.constant 68.906982421875 : f32
  %v_final2_2 = scalar.constant 101.8604736328125 : f32
  %v_final2_3 = scalar.constant 134.81396484375 : f32
  %m2_final2 = index.constant 2 : index
  %m3_final2 = index.constant 3 : index
  %p1_final2 = index.cmp eq, %mod, %one : index
  %p2_final2 = index.cmp eq, %mod, %m2_final2 : index
  %p3_final2 = index.cmp eq, %mod, %m3_final2 : index
  %s1_final2 = scf.select %p1_final2, %v_final2_1, %v_final2_0 : f32
  %s2_final2 = scf.select %p2_final2, %v_final2_2, %s1_final2 : f32
  %s3_final2 = scf.select %p3_final2, %v_final2_3, %s2_final2 : f32
  scf.if %valid_final {
    view.store %s3_final2, %view_final[2, %channel] : f32, view<3x3072xf32>
  }
  scf.if %is_zero {
    %control = buffer.view %count[%origin] : buffer -> view<3xi32>
    %n = scalar.constant 3 : i32
    %z = scalar.constant 0 : i32
    view.store %n, %control[0] : i32, view<3xi32>
    view.store %z, %control[1] : i32, view<3xi32>
    view.store %z, %control[2] : i32, view<3xi32>
  }

  func.return
}

func.def @reference.compatible_q12_rows3(%root: buffer, %residual: buffer, %count: buffer) {
  %zero = index.constant 0 : index

  kernel.launch @test.init.compatible_q12_rows3(%gate, %up, %down, %gamma, %residual, %count) : (view<[%gate_bytes]xi8>, view<[%gate_bytes]xi8>, view<[%down_bytes]xi8>, view<[%hidden]xf32>, buffer, buffer)
  command.launch @loomify.llama.ffn[%layer, %phase, %rows](%root, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}


load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
package(default_visibility = ["//visibility:public"])
exports_files(["llama_roots.loom", "qwen_roots.loom"])
cc_test(
    name = "ffn_test",
    size = "medium",
    srcs = ["ffn_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = [":llama_fixture", ":llama_fixture_text", ":qwen_fixture", ":qwen_fixture_text"],
    deps = [
        "//tools/loomify-gguf:configuration",
        "//tools/loomify-gguf:native_linking",
        "//tools/loomify-gguf:configuration_fixture",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@hrx_system//loom/binding/c/target/cmd",
        "@googletest//:gtest", "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "emit_real_ffn",
    testonly = True,
    srcs = ["emit_real_ffn.cc"],
    data = [":llama_fixture", ":qwen_fixture"],
    cxxopts = ["-std=c++17"],
    deps = [
        "//tools/loomify-gguf:configuration",
        "//tools/loomify-gguf:native_linking",
        "//tools/model:llama_configuration", "//tools/model:qwen_configuration",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

_LLAMA_FIXTURE = ["llama_roots.loom", "real_llama_roots.loom", "//lib/architectures/llama:implementation"]
_QWEN_FIXTURE = ["qwen_roots.loom", "real_qwen_roots.loom", "//lib/programs/ffn:qwen_adapter.loom", "//lib/programs/ffn:interface.loom", "//lib/programs/ffn:ffn.loom", "//lib/architectures/qwen35:implementation"]
loom_merge(name = "llama_fixture", srcs = _LLAMA_FIXTURE, testonly = True)
loom_merge(name = "llama_fixture_text", srcs = _LLAMA_FIXTURE, output_format = "text", testonly = True)
loom_merge(name = "qwen_fixture", srcs = _QWEN_FIXTURE, testonly = True)
loom_merge(name = "qwen_fixture_text", srcs = _QWEN_FIXTURE, output_format = "text", testonly = True)

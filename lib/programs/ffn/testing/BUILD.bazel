load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

exports_files([
    "llama_roots.loom",
    "qwen_roots.loom",
])

cc_test(
    name = "ffn_test",
    size = "medium",
    srcs = ["ffn_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":llama_fixture",
        ":llama_fixture_text",
        ":qwen_fixture",
        ":qwen_fixture_text",
    ],
    linkstatic = True,
    deps = [
        "//lib/loomify:configuration",
        "//lib/loomify:configuration_fixture",
        "//lib/loomify:native_linking",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@hrx_system//loom/binding/c/target/cmd",
    ],
)

cc_binary(
    name = "emit_real_ffn",
    testonly = True,
    srcs = ["emit_real_ffn.cc"],
    cxxopts = ["-std=c++17"],
    data = [
        ":llama_fixture",
        ":partial_provider",
        ":qwen_fixture",
    ],
    deps = [
        "//lib/loomify:configuration",
        "//lib/loomify:native_linking",
        "//tools/model:model_descriptor",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

# Actual gate/up-only roots use the shared projection/activation providers.
loom_merge(
    name = "partial_provider",
    testonly = True,
    srcs = [
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/ffn:gate_up_sources",
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
    ],
)

_LLAMA_FIXTURE = [
    "//lib/platforms/amdgpu/gfx11:targets.loom",
    "llama_roots.loom",
    "real_llama_roots.loom",
    "//lib/loomify/benchmark:reset_bytes.loom",
    "//lib/architectures/llama:implementation",
]

_QWEN_FIXTURE = [
    "//lib/platforms/amdgpu/gfx11:targets.loom",
    "qwen_roots.loom",
    "real_qwen_roots.loom",
    "//lib/programs/qwen35:ffn_adapter.loom",
    "//lib/programs/ffn:interface.loom",
    "//lib/architectures/qwen35:implementation",
]

loom_merge(
    name = "llama_fixture",
    testonly = True,
    srcs = _LLAMA_FIXTURE,
)

loom_merge(
    name = "llama_fixture_text",
    testonly = True,
    srcs = _LLAMA_FIXTURE,
    output_format = "text",
)

loom_merge(
    name = "qwen_fixture",
    testonly = True,
    srcs = _QWEN_FIXTURE,
)

loom_merge(
    name = "qwen_fixture_text",
    testonly = True,
    srcs = _QWEN_FIXTURE,
    output_format = "text",
)

_FFN27_SOURCES = [
    "//lib/platforms/amdgpu/gfx11:targets.loom",
    "ffn27_config.loom",
    "ffn27_programs.loom",
    "//lib/programs/qwen35:ffn.loom",
    "//lib/kernels/qwen:configured_provider_sources",
]

[loom_merge(
    name = "ffn27_" + format,
    testonly = True,
    srcs = _FFN27_SOURCES,
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "ffn27_" + format + "_test",
    srcs = [
        "ffn27_checks.loom",
        ":ffn27_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

# Add to lib/programs/ffn/testing/BUILD.bazel; shared BUILD owned by I.
_CAPABILITY_COMMON = [
    "//lib/platforms/amdgpu/gfx11:targets.loom",
    "//lib/kernels/decoder:implementation_sources",
    "//lib/programs/ffn:interface.loom",
    "//lib/programs/ffn:ffn.loom",
    "//lib/programs/projection:packed_sources",
    "//lib/programs/projection:prepared_rows_sources",
    "//lib/programs/ffn:gate_up_sources",
    "//lib/kernels/normalization:rmsnorm_row.loom",
    "//lib/kernels/elementwise:residual_row.loom",
    "//lib/kernels/elementwise:ffn_launches.loom",
]

_CAPABILITY_COMPATIBLE = [
    "//lib/kernels/llama:ffn/ffn.loom",
    "//lib/kernels/llama:norm/norm.loom",
    "//lib/programs/llama:ffn_adapter.loom",
]

_CAPABILITY_CANONICAL = [
    "//lib/kernels/qwen:ffn/children.loom",
    "//lib/kernels/qwen:common/layer_decode.loom",
    "//lib/kernels/qwen:common/layer_prefill.loom",
    "//lib/programs/qwen35:ffn_adapter.loom",
]

[loom_merge(
    name = "capability_" + name + "_" + format,
    testonly = True,
    srcs = ["capability_" + name + "_programs.loom"] + _CAPABILITY_COMMON + (_CAPABILITY_COMPATIBLE if name in [
        "compatible",
        "minicpm",
    ] else _CAPABILITY_CANONICAL),
    output_format = format,
) for name in [
    "canonical",
    "compatible",
    "same_hidden",
    "qwen4",
    "minicpm",
] for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "capability_" + name + "_" + format + "_test",
    srcs = [
        "capability_" + name + "_checks.loom",
        ":capability_" + name + "_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for name in [
    "canonical",
    "compatible",
    "same_hidden",
    "qwen4",
    "minicpm",
] for format in [
    "text",
    "bc",
]]

exports_files(["capability_fixtures.py"])

# Actual complete-FFN operation constructor checks.

[loom_merge(
    name = "capability_" + name + "_provider_" + format,
    testonly = True,
    srcs = _CAPABILITY_COMMON + (_CAPABILITY_COMPATIBLE if name in [
        "compatible",
        "minicpm",
    ] else _CAPABILITY_CANONICAL),
    output_format = format,
) for name in [
    "canonical",
    "compatible",
] for format in [
    "text",
    "bc",
]]

cc_test(
    name = "capability_test",
    size = "medium",
    srcs = ["capability_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":capability_canonical_provider_bc",
        ":capability_canonical_provider_text",
        ":capability_compatible_provider_bc",
        ":capability_compatible_provider_text",
        "//lib/programs/ffn:interface.loom",
    ],
    linkstatic = True,
    deps = [
        "//lib/loomify:native_linking",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

genrule(
    name = "gated_fixtures",
    srcs = [
        "gated_fixtures.py",
        "//lib/kernels/qwen/testing/common:fixture_helpers.py",
    ],
    outs = ["gated_checks.loom"],
    cmd = "python3 $(location gated_fixtures.py) $(location //lib/kernels/qwen/testing/common:fixture_helpers.py) $@",
)

[loom_merge(
    name = "gated_" + format,
    testonly = True,
    srcs = [
        ":gated_fixtures",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/programs/ffn:gate_up_sources",
        "//lib/programs/projection:packed_sources",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "gated_" + format + "_test",
    srcs = [":gated_" + format],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

[genrule(
    name = "independent_" + mode + "_fixtures",
    testonly = True,
    srcs = [
        "independent_fixtures.py",
        "//lib/kernels/qwen/testing/common:fixture_helpers.py",
    ],
    outs = ["independent_" + mode + "_checks.loom"],
    cmd = "python3 $(location independent_fixtures.py) $(location //lib/kernels/qwen/testing/common:fixture_helpers.py) " + mode + " $@",
) for mode in [
    "classic",
    "live_qwen",
    "gated_tiny",
    "gated_matrix",
]]

[loom_merge(
    name = "independent_" + mode + "_" + format,
    testonly = True,
    srcs = [":independent_" + mode + "_fixtures"] + ([
        "//lib/programs/projection:packed_sources",
        "//lib/programs/projection:prepared_rows_sources",
        "//lib/programs/ffn:gate_up_sources",
        "//lib/programs/projection:matrix_sources",
        "//lib/programs/ffn:matrix_gate_up_sources",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
        "//lib/platforms/amdgpu/gfx11/projection:sources",
    ] if mode in [
        "gated_tiny",
        "gated_matrix",
    ] else _CAPABILITY_COMMON + (_CAPABILITY_COMPATIBLE if mode == "classic" else _CAPABILITY_CANONICAL + ["//lib/programs/qwen35:ffn.loom"])),
    output_format = format,
) for mode in [
    "classic",
    "live_qwen",
    "gated_tiny",
    "gated_matrix",
] for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "independent_" + mode + "_" + format + "_test",
    srcs = [":independent_" + mode + "_" + format],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for mode in [
    "classic",
    "live_qwen",
    "gated_tiny",
    "gated_matrix",
] for format in [
    "text",
    "bc",
]]

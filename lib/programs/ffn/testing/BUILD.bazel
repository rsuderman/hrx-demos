load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
package(default_visibility = ["//visibility:public"])
exports_files(["llama_roots.loom", "qwen_roots.loom"])
cc_test(
    name = "ffn_test",
    size = "medium",
    srcs = ["ffn_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = [":llama_fixture", ":llama_fixture_text", ":qwen_fixture", ":qwen_fixture_text"],
    deps = [
        "//tools/loomify-gguf:configuration",
        "//tools/loomify-gguf:native_linking",
        "//tools/loomify-gguf:configuration_fixture",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@hrx_system//loom/binding/c/target/cmd",
        "@googletest//:gtest", "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "emit_real_ffn",
    testonly = True,
    srcs = ["emit_real_ffn.cc"],
    data = [":llama_fixture", ":qwen_fixture"],
    cxxopts = ["-std=c++17"],
    deps = [
        "//tools/loomify-gguf:configuration",
        "//tools/loomify-gguf:native_linking",
        "//tools/model:llama_configuration", "//tools/model:qwen_configuration",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

_LLAMA_FIXTURE = ["llama_roots.loom", "real_llama_roots.loom", "//lib/architectures/llama:implementation"]
_QWEN_FIXTURE = ["qwen_roots.loom", "real_qwen_roots.loom", "//lib/programs/ffn:qwen_adapter.loom", "//lib/programs/ffn:interface.loom", "//lib/programs/ffn:ffn.loom", "//lib/architectures/qwen35:implementation"]
loom_merge(name = "llama_fixture", srcs = _LLAMA_FIXTURE, testonly = True)
loom_merge(name = "llama_fixture_text", srcs = _LLAMA_FIXTURE, output_format = "text", testonly = True)
loom_merge(name = "qwen_fixture", srcs = _QWEN_FIXTURE, testonly = True)
loom_merge(name = "qwen_fixture_text", srcs = _QWEN_FIXTURE, output_format = "text", testonly = True)

_FFN27_SOURCES = ["ffn27_programs.loom", "//lib/kernels/qwen:configured_provider_sources"]
[loom_merge(name = "ffn27_" + format, srcs = _FFN27_SOURCES, output_format = format, testonly = True) for format in ["text", "bc"]]
[loom_test(name = "ffn27_" + format + "_test", srcs = ["ffn27_checks.loom", ":ffn27_" + format], benchmark_smoke = False, execution_profiles = [AMDGPU_HARDWARE_PROFILE]) for format in ["text", "bc"]]

# Add to lib/programs/ffn/testing/BUILD.bazel; shared BUILD owned by I.
_CAPABILITY_COMMON = [
    "//lib/programs/ffn:interface.loom",
    "//lib/programs/ffn:ffn.loom",
    "//lib/programs/projection:implementation_sources",
    "//lib/kernels/normalization:rmsnorm_row.loom",
    "//lib/kernels/elementwise:residual_row.loom",
    "//lib/kernels/elementwise:swiglu_row.loom",
    "//lib/kernels/elementwise:ffn_launches.loom",
]
_CAPABILITY_COMPATIBLE = [
    "//lib/kernels/llama:ffn/ffn.loom",
    "//lib/kernels/llama:norm/norm.loom",
    "//lib/architectures/llama:ffn_adapter.loom",
]
_CAPABILITY_CANONICAL = [
    "//lib/kernels/qwen:ffn/children.loom",
    "//lib/kernels/qwen:common/layer_decode.loom",
    "//lib/kernels/qwen:common/layer_prefill.loom",
    "//lib/programs/ffn:qwen_adapter.loom",
]
[loom_merge(
    name = "capability_" + name + "_" + format,
    srcs = ["capability_" + name + "_programs.loom"] + _CAPABILITY_COMMON + (_CAPABILITY_COMPATIBLE if name == "compatible" else _CAPABILITY_CANONICAL),
    output_format = format,
    testonly = True,
) for name in ["canonical", "compatible", "same_hidden"] for format in ["text", "bc"]]
[loom_test(
    name = "capability_" + name + "_" + format + "_test",
    srcs = ["capability_" + name + "_checks.loom", ":capability_" + name + "_" + format],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
) for name in ["canonical", "compatible", "same_hidden"] for format in ["text", "bc"]]
exports_files(["capability_fixtures.py"])

# Actual complete-FFN operation constructor checks.

[loom_merge(
    name = "capability_" + name + "_provider_" + format,
    srcs = _CAPABILITY_COMMON + (_CAPABILITY_COMPATIBLE if name == "compatible" else _CAPABILITY_CANONICAL),
    output_format = format,
    testonly = True,
) for name in ["canonical", "compatible"] for format in ["text", "bc"]]
cc_test(
    name = "capability_test",
    size = "medium",
    srcs = ["capability_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = [
        "//lib/programs/ffn:interface.loom",
        ":capability_canonical_provider_text", ":capability_canonical_provider_bc",
        ":capability_compatible_provider_text", ":capability_compatible_provider_bc",
    ],
    deps = [
        "//tools/loomify-gguf:native_linking",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@googletest//:gtest", "@googletest//:gtest_main",
    ],
)

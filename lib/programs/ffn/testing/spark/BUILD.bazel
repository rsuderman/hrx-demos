load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "checks",
    srcs = [
        "fixtures.py",
        "//lib/kernels/qwen/testing/common:fixture_helpers.py",
    ],
    outs = ["checks.loom"],
    cmd = "python3 $(location fixtures.py) $(location //lib/kernels/qwen/testing/common:fixture_helpers.py) $@",
)

[loom_merge(
    name = "provider_" + format,
    testonly = True,
    srcs = [
        "//lib/programs/ffn:canonical_swiglu.loom",
        "//lib/programs/projection:implementation_sources",
        "//lib/kernels/elementwise:ffn_launches.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "mixed_" + format + "_test",
    srcs = [
        ":checks",
        ":provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

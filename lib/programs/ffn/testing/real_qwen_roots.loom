command.decl @loomify.qwen.ffn(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer)

command.def public @real.qwen.ffn.layer0.prefill() launch(%parameters: buffer, %residual: buffer, %count: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = index.constant 4 : index
  command.launch @loomify.qwen.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}

command.def public @real.qwen.ffn.layer0.decode() launch(%parameters: buffer, %residual: buffer, %count: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 1 : index
  %rows = index.constant 1 : index
  command.launch @loomify.qwen.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}


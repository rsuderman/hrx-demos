command.decl @loomify.llama.ffn(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer) where [range(%layer, 0, 64), range(%phase, 0, 1), range(%rows, 1, 512)]

command.def public @test.llama.ffn.decode() launch(%parameters: buffer, %residual: buffer, %count: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 1 : index
  %rows = index.constant 1 : index
  command.launch @loomify.llama.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}

command.def public @test.llama.ffn.prefill() launch(%parameters: buffer, %residual: buffer, %count: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = index.constant 4 : index
  command.launch @loomify.llama.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}

command.def public @test.llama.ffn.bad_decode_rows() launch(%parameters: buffer, %residual: buffer, %count: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 1 : index
  %rows = index.constant 4 : index
  command.launch @loomify.llama.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}

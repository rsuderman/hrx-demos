// Public profiles bound every product before this helper is used.
template.decl @llm.experts.weight_extent(%K: index, %N: index, %experts: index, %tag: index, %bytes: index)

template.def<@llm.experts.weight_extent> @llm_experts_weight_extent(%K: index, %N: index, %experts: index, %tag: index, %bytes: index) where [range(%K, 1, 2048), range(%N, 1, 2048), eq(%experts, 128)] {
  template.apply<@llm.experts.down_tag>(%tag) : (index)
  %block_values, %block_bytes = func.call pure @llm.experts.encoding_block(%tag) : (index) -> (index, index)
  %blocks = index.div %K, %block_values : index
  %aligned = index.mul %blocks, %block_values : index
  template.apply<@llm.experts.exact_extent>(%K, %aligned) : (index, index)
  %row_bytes = index.mul %blocks, %block_bytes : index
  %expert_bytes = index.mul %N, %row_bytes : index
  %expected = index.mul %experts, %expert_bytes : index
  template.apply<@llm.experts.exact_extent>(%bytes, %expected) : (index, index)
  template.return
}


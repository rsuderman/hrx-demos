// Tensor names and per-layer encoding policy stay in the model adapter.
command.def public @qwen38_ffn_down_decode(%layer: index) launch(%parameters: buffer, %swiglu: buffer, %residual: buffer) where [range(%layer, 0, 63)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %lookup_ffn, %gate_tag, %up_tag, %down_tag, %gate_bytes, %up_bytes, %shape_ffn_down_weight_bytes = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %hidden_size = config.get @qwen.model.hidden_size : index
  %canonical = index.constant 1 : index
  template.apply<@loomify.ffn.admit>(%hidden_size, %lookup_ffn, %canonical) : (index, index, index)
  %format_q4 = index.constant 12 : index
  %format_q6 = index.constant 14 : index
  %ffn_down_is_q6 = index.cmp eq, %down_tag, %format_q6 : index

  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %shape_hidden_row_bytes = config.get @qwen.model.hidden_row_bytes : index
  %ffn_down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<[%shape_ffn_down_weight_bytes]xi8>
  %ffn_down_is_q4 = index.cmp eq, %down_tag, %format_q4 : index
  %mmvq_compat = scalar.constant false : i1
  %old_low = index.cmp uge, %down_tag, %format_q4 : index
  %old_high = index.cmp ule, %down_tag, %format_q6 : index
  %retained = scalar.andi %old_low, %old_high : i1
  scf.if %retained {
    template.apply<@llm.ffn.down_decode>(%hidden_size, %lookup_ffn, %use_generic_quantized_projections, %mmvq_compat, %ffn_down_is_q4, %ffn_down_is_q6, %shape_ffn_down_weight_bytes, %shape_ffn_row_bytes, %shape_hidden_row_bytes, %ffn_down_weight, %swiglu, %residual) : (index, index, i1, i1, i1, i1, index, index, index, view<[%shape_ffn_down_weight_bytes]xi8>, buffer, buffer)
  } else {
    template.apply<@loomify.qwen.ffn_route>(%use_generic_quantized_projections, %mmvq_compat) : (i1, i1)
    %one = index.constant 1 : index
    %origin = index.constant 0 : offset
    %fixed_one = scalar.constant 1 : i32
    %hidden_bytes = index.cast %shape_hidden_row_bytes : index to offset
    %ffn_bytes = index.cast %shape_ffn_row_bytes : index to offset
    %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
    %packed = buffer.alloca<global> align(256) %ffn_bytes : buffer
    template.apply<@llm.projection.pack_input>(%canonical, %one, %one, %lookup_ffn, %recipe_zero, %fixed_one, %origin, %swiglu, %swiglu, %packed) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
    template.apply<@llm.projection.project_packed>(%canonical, %down_tag, %one, %one, %lookup_ffn, %hidden_size, %shape_ffn_down_weight_bytes, %recipe_zero, %fixed_one, %origin, %swiglu, %packed, %ffn_down_weight, %projected) : (index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
    kernel.launch @llm_ffn_residual_add_f32_decode[%hidden_size](%hidden_size, %residual, %projected, %residual) : [index](index, buffer, buffer, buffer)
  }
  command.return
}


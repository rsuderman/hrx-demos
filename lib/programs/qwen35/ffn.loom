func.decl pure @loomify.config.layer_ffn(%layer: index) -> (index, index, index, index, index, index, index)

config.decl @qwen.model.hidden_size : index

command.def public @qwen38_ffn_gate_up_decode(%layer: index) launch(%parameters: buffer, %post_normalized_q8: buffer, %swiglu: buffer) where [range(%layer, 0, 63)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %lookup_ffn, %gate_tag, %up_tag, %down_tag, %shape_ffn_gate_weight_bytes, %up_bytes, %down_bytes = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %hidden_size = config.get @qwen.model.hidden_size : index
  %canonical = index.constant 1 : index
  template.apply<@loomify.ffn.admit>(%hidden_size, %lookup_ffn, %canonical) : (index, index, index)
  %format_q4 = index.constant 12 : index
  %format_q6 = index.constant 14 : index
  %ffn_gate_is_q4 = index.cmp eq, %gate_tag, %format_q4 : index
  %ffn_gate_is_q6 = index.cmp eq, %gate_tag, %format_q6 : index

  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%up_bytes]xi8>
  %mmvq_compat = scalar.constant false : i1
  template.apply<@loomify.qwen.ffn_route>(%use_generic_quantized_projections, %mmvq_compat) : (i1, i1)
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %fixed_one = scalar.constant 1 : i32
  // Canonical decode already owns a one-row packet; fixed_count avoids reading it as a count.
  template.apply<@llm.ffn.swiglu_packed>(%canonical, %one, %one, %hidden_size, %lookup_ffn, %gate_tag, %up_tag, %shape_ffn_gate_weight_bytes, %up_bytes, %recipe_zero, %fixed_one, %origin, %post_normalized_q8, %post_normalized_q8, %ffn_gate_weight, %ffn_up_weight, %swiglu) : (index, index, index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%up_bytes]xi8>, buffer)
  command.return
}

config.decl @qwen.model.projection_implementation : index

config.decl @qwen.model.ffn_row_bytes : index

config.decl @qwen.model.ffn_size : index

command.def public @qwen38_ffn_gate_up_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %post_normalized: buffer, %control: buffer, %swiglu: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 63), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %lookup_ffn, %gate_tag, %up_tag, %down_tag, %shape_ffn_gate_weight_bytes, %up_bytes, %down_bytes = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %hidden_size = config.get @qwen.model.hidden_size : index
  %canonical = index.constant 1 : index
  template.apply<@loomify.ffn.admit>(%hidden_size, %lookup_ffn, %canonical) : (index, index, index)
  %format_q4 = index.constant 12 : index
  %format_q6 = index.constant 14 : index
  %ffn_gate_is_q4 = index.cmp eq, %gate_tag, %format_q4 : index
  %ffn_gate_is_q6 = index.cmp eq, %gate_tag, %format_q6 : index
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index

  %shape_hidden_q8_capacity_bytes = config.get @qwen.model.hidden_q8_capacity_bytes : index
  %shape_hidden_q8_depth4_bytes = config.get @qwen.model.hidden_q8_depth4_bytes : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %token_capacity = index.constant 512 : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%up_bytes]xi8>
  %mmvq_compat = scalar.constant false : i1
  %projection_row_origin = index.constant 0 : index
  %projection_count_origin = index.constant 0 : offset
  %same_tag = index.cmp eq, %gate_tag, %up_tag : index
  %same_bytes = index.cmp eq, %shape_ffn_gate_weight_bytes, %up_bytes : index
  %same = scalar.andi %same_tag, %same_bytes : i1
  %q4_tag = index.constant 12 : index
  %q6_tag = index.constant 14 : index
  %old_low = index.cmp uge, %gate_tag, %q4_tag : index
  %old_high = index.cmp ule, %gate_tag, %q6_tag : index
  %old_tag = scalar.andi %old_low, %old_high : i1
  %retained = scalar.andi %same, %old_tag : i1
  scf.if %retained {
    template.apply<@llm.ffn.gate_up_prefill>(%hidden_size, %lookup_ffn, %use_generic_quantized_projections, %mmvq_compat, %ffn_gate_is_q4, %ffn_gate_is_q6, %token_count, %token_capacity, %schedule_token_count, %projection_row_origin, %projection_count_origin, %uses_m4, %verification_depth, %shape_ffn_capacity_bytes, %shape_ffn_gate_weight_bytes, %up_bytes, %shape_hidden_q8_capacity_bytes, %shape_hidden_q8_depth4_bytes, %ffn_gate_weight, %ffn_up_weight, %post_normalized, %control, %swiglu) : (index, index, i1, i1, i1, i1, index, index, index, index, offset, i1, index, index, index, index, index, index, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%up_bytes]xi8>, buffer, buffer, buffer)
  } else {
    template.apply<@loomify.qwen.ffn_route>(%use_generic_quantized_projections, %uses_m4) : (i1, i1)
    %word = index.constant 4 : offset
    %elements = index.mul %token_count, %hidden_size : index
    %defined_bytes = index.scale %elements, %word : index, offset -> offset
    %defined = buffer.alloca<global> align(256) %defined_bytes : buffer
    kernel.launch @llm.projection.prepare_f32_prefix[%token_count, %hidden_size](%token_count, %hidden_size, %control, %post_normalized, %defined) : [index, index](index, index, buffer, buffer, buffer)
    %packed_bytes = index.cast %shape_hidden_q8_capacity_bytes : index to offset
    %packed = buffer.alloca<global> align(256) %packed_bytes : buffer
    %dynamic = scalar.constant -1 : i32
    template.apply<@llm.projection.pack_input>(%canonical, %token_count, %token_count, %hidden_size, %projection_row_origin, %dynamic, %projection_count_origin, %control, %defined, %packed) : (index, index, index, index, index, i32, offset, buffer, buffer, buffer)
    template.apply<@llm.ffn.swiglu_packed>(%canonical, %token_count, %token_count, %hidden_size, %lookup_ffn, %gate_tag, %up_tag, %shape_ffn_gate_weight_bytes, %up_bytes, %projection_row_origin, %dynamic, %projection_count_origin, %control, %packed, %ffn_gate_weight, %ffn_up_weight, %swiglu) : (index, index, index, index, index, index, index, index, index, index, i32, offset, buffer, buffer, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%up_bytes]xi8>, buffer)
  }
  command.return
}


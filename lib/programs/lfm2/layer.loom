kernel.decl @llm.decoder.rmsnorm_active(%rows: index, %width: index) launch(%rows: index, %width: index, %epsilon: f32, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)
kernel.decl @llm.decoder.residual(%rows: index, %width: index) launch(%width: index, %count: buffer, %source: buffer, %residual: buffer)
config.decl @lfm2.model.hidden_size : index
config.decl @lfm2.model.rms_epsilon : f32
func.decl pure @loomify.config.layer_info(%layer: index) -> (index, index, index)
command.decl @loomify.lfm2.shortconv(%layer: index, %ordinal: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %count: buffer, %epoch: buffer, %cache: buffer, %output: buffer)
command.decl @loomify.lfm2.attention(%layer: index, %ordinal: index, %window: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %normalized: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %output: buffer)
command.decl @loomify.lfm2.ffn(%layer: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer)
kernel.decl @loomify.lfm2.validate_chunk(%rows: index, %capacity: index) launch(%rows: index, %capacity: index, %origin: offset, %count: buffer, %epoch: buffer, %checked_count: buffer, %checked_epoch: buffer)
config.decl @lfm2.attention.cache_capacity : index

command.def @loomify.lfm2.layer(%layer: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer) where [range(%rows, 1, 512)] {
  %hidden = config.get @lfm2.model.hidden_size : index
  %rms_epsilon = config.get @lfm2.model.rms_epsilon : f32
  %word = index.constant 4 : offset
  %zero = index.constant 0 : index
  %capacity = config.get @lfm2.attention.cache_capacity : index
  %count_size = index.constant 12 : offset
  %packet_size = index.constant 20 : offset
  %epoch_bytes = index.add %control_origin, %packet_size : offset
  %checked_count = buffer.alloca<global> align(256) %count_size : buffer
  %checked_epoch = buffer.alloca<global> align(256) %epoch_bytes : buffer
  kernel.launch @loomify.lfm2.validate_chunk[%rows, %capacity](%rows, %capacity, %control_origin, %count, %epoch, %checked_count, %checked_epoch) : [index, index](index, index, offset, buffer, buffer, buffer, buffer)
  %kind, %ordinal, %window = func.call pure @loomify.config.layer_info(%layer) : (index) -> (index, index, index)
  %gamma = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<[%hidden]xf32>
  %normal_elements = index.mul %rows, %hidden : index
  %normal_bytes = index.scale %normal_elements, %word : index, offset -> offset
  %normal = buffer.alloca<global> align(256) %normal_bytes : buffer
  %mixed_elements = index.mul %rows, %hidden : index
  %mixed_bytes = index.scale %mixed_elements, %word : index, offset -> offset
  %mixed = buffer.alloca<global> align(256) %mixed_bytes : buffer
  kernel.launch @llm.decoder.rmsnorm_active[%rows, %hidden](%rows, %hidden, %rms_epsilon, %checked_count, %residual, %gamma, %normal) : [index, index](index, index, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  %attention = index.cmp eq, %kind, %zero : index
  scf.if %attention {
    command.launch @loomify.lfm2.attention[%layer, %ordinal, %window, %rows, %control_origin](%parameters, %normal, %checked_count, %checked_epoch, %map, %cache, %mixed) : [index, index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  } else {
    command.launch @loomify.lfm2.shortconv[%layer, %ordinal, %rows, %control_origin](%parameters, %normal, %checked_count, %checked_epoch, %cache, %mixed) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  kernel.launch @llm.decoder.residual[%rows, %hidden](%hidden, %checked_count, %mixed, %residual) : [index, index](index, buffer, buffer, buffer)
  command.launch @loomify.lfm2.ffn[%layer, %rows](%parameters, %residual, %checked_count) : [index, index](buffer, buffer, buffer)
  command.return
}

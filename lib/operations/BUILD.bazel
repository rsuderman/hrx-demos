load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "operation_graph",
    srcs = ["operation_graph.cc"],
    hdrs = [
        "operation_graph.h",
        "detail/checks.h",
    ],
    cxxopts = _CXXOPTS,
)

iree_cc_library(
    name = "ffn_operations",
    srcs = ["ffn_operations.cc"],
    hdrs = ["ffn_operations.h"],
    cxxopts = _CXXOPTS,
    deps = [":operation_graph"],
)

iree_cc_library(
    name = "tensor_operations",
    srcs = ["tensor_operations.cc"],
    hdrs = ["tensor_operations.h"],
    cxxopts = _CXXOPTS,
    deps = [":operation_graph"],
)

iree_cc_library(
    name = "row_operations",
    srcs = ["row_operations.cc"],
    hdrs = ["row_operations.h"],
    cxxopts = _CXXOPTS,
    deps = [":operation_graph"],
)

iree_cc_library(
    name = "attention_operations",
    srcs = ["attention_operations.cc"],
    hdrs = ["attention_operations.h"],
    cxxopts = _CXXOPTS,
    deps = [":operation_graph"],
)

iree_cc_library(
    name = "control_operations",
    srcs = ["control_operations.cc"],
    hdrs = ["control_operations.h"],
    cxxopts = _CXXOPTS,
    deps = [":operation_graph"],
)

iree_cc_library(
    name = "qwen_operations", srcs = ["qwen_operations.cc"], hdrs = ["qwen_operations.h"],
    cxxopts = _CXXOPTS, deps = [":operation_graph"],
)

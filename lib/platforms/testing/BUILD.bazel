load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:private"])

# Authoring-association inspection, including retained standalone wrappers.
# No configuration resolution or numerical execution is claimed by this fixture.
_SOURCES = [
    "//lib/platforms/amdgpu/gfx11:targets.loom",
    "//lib/kernels/projection:q4k_canonical.loom",
    "//lib/kernels/projection:q4k_compat.loom",
    "//lib/kernels/projection:q5k.loom",
    "//lib/kernels/projection:q5k_codec.loom",
    "//lib/kernels/projection:q6k_compat.loom",
    "//lib/kernels/projection:q5_0.loom",
    "//lib/kernels/projection:classic_q4.loom",
    "//lib/kernels/projection:iq4_xs.loom",
    "//lib/kernels/projection:q8_0.loom",
    "//lib/kernels/selection:greedy_argmax.loom",
    "//lib/kernels/llama:attention/attention_prepare.loom",
    "//lib/kernels/llama:attention/attention_native.loom",
    "//lib/kernels/qwen:common/layer_decode.loom",
    "//lib/kernels/qwen:output/head.loom",
    "//lib/kernels/qwen/attention:attention_prefill_wmma.loom",
    "//lib/kernels/qwen/attention:attention_spans.loom",
]

[loom_merge(
    name = "authored_" + format,
    testonly = True,
    srcs = _SOURCES,
    output_format = format,
) for format in [
    "text",
    "bc",
]]

cc_test(
    name = "associations_test",
    size = "small",
    srcs = ["associations_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":authored_text",
        ":authored_bc",
    ],
    linkstatic = True,
    deps = [
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

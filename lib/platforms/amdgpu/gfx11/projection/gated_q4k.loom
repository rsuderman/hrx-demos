// Curated base64 schedule from the Qwen3-0.6B reference; no model config.
// Target/fragment layout and tile ownership are platform implementation policy.
target.decl @llm.platform.projection.scaled_f16.wave32

template.decl @ggml.q4k.f16_fma16(%weight: buffer, %row_origin: offset, %column: index) -> (vector<16xf16>)

kernel.def target(@llm.platform.projection.scaled_f16.wave32) export("llm.platform.q4k_scaled_f16_swiglu") @llm.platform.q4k_scaled_f16_swiglu(%rows: index, %input_width: index, %n: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %row_tiles = index.div %rows, %c64 : index
  %out_tiles = index.div %n, %c64 : index
  kernel.launch.config workgroups(%out_tiles, %row_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows_arg: index, %k_arg: index, %n_arg: index, %count: buffer, %x: buffer, %scales: buffer, %w: buffer, %w2: buffer, %y: buffer) {
  %rows = index.assume %rows_arg [range(%rows_arg, 64, 8192), multiple_of(%rows_arg, 64)] : index
  %k = index.assume %k_arg [range(%k_arg, 256, 65536), multiple_of(%k_arg, 256)] : index
  %n = index.assume %n_arg [range(%n_arg, 64, 262144), multiple_of(%n_arg, 64)] : index
  %origin = index.constant 0 : offset
  %two = index.constant 2 : offset
  %sixteen = index.constant 16 : offset
  %block_bytes = index.constant 144 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %nibble_mask = vector.splati 252645135 : vector<4xi32>
  %stage_bytes = index.constant 9216 : offset
  %row_tile_count = index.div %rows, %c64 : index
  %out_tile_count = index.div %n, %c64 : index
  %row_group_id = kernel.workgroup.id<y> : index
  %out_group_id = kernel.workgroup.id<x> : index
  %row_group = index.assume %row_group_id [lt(%row_group_id, %row_tile_count)] : index
  %out_group = index.assume %out_group_id [lt(%out_group_id, %out_tile_count)] : index
  %workitem_id = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem_id [range(%workitem_id, 0, 255)] : index
  %subgroup = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %lane_row = index.rem %lane, %c16 : index
  %bounded_subgroup = index.assume %subgroup [range(%subgroup, 0, 7)] : index
  %wave_row_group = index.div %bounded_subgroup, %c2 : index
  %wave_out_group = index.rem %bounded_subgroup, %c2 : index
  %wave_row = index.mul %wave_row_group, %c16 : index
  %wave_out = index.mul %wave_out_group, %c32 : index
  %w_row0 = index.add %wave_out, %lane_row : index
  %w_row1 = index.add %w_row0, %c16 : index
  %row_origin = index.mul %row_group, %c64 : index
  %out_origin = index.mul %out_group, %c64 : index
  %result_row = index.add %row_origin, %wave_row : index
  %result_col0 = index.add %out_origin, %wave_out : index
  %result_col1 = index.add %result_col0, %c16 : index
  %blocks = index.div %k, %c256 : index
  %row_bytes = index.scale %blocks, %block_bytes : index, offset -> offset
  %x_view = buffer.view %x[%origin] : buffer -> view<[%rows]x[%k]xf16>
  // 64x64 output tile with the full row stride n.
  %y_layout = encoding.layout.strided [%n, %c1] : encoding<layout>
  %tile_first = index.madd %row_origin, %n, %out_origin : index
  %four = index.constant 4 : offset
  %tile_offset = index.scale %tile_first, %four : index, offset -> offset
  %y_view = buffer.view %y[%tile_offset] : buffer -> view<64x64xf32, %y_layout>
  %bounded_wave_row = index.assume %wave_row [range(%wave_row, 0, 48)] : index
  %bounded_wave_out = index.assume %wave_out [range(%wave_out, 0, 32)] : index
  %wave_out1 = index.add %bounded_wave_out, %c16 : index
  %x_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %x_stage_view = buffer.view %x_stage[%origin] : buffer -> view<64x72xf16>
  %w_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %w_stage_view = buffer.view %w_stage[%origin] : buffer -> view<64x72xf16>
  %w2_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %w2_stage_view = buffer.view %w2_stage[%origin] : buffer -> view<64x72xf16>
  // Thread t stages 16 values: row t/4, columns (t%4)*16.
  %stage_row = index.div %workitem, %c4 : index
  %stage_quarter = index.rem %workitem, %c4 : index
  %stage_col = index.mul %stage_quarter, %c16 : index
  %x_row = index.add %row_origin, %stage_row : index
  %bounded_x_row = index.assume %x_row [lt(%x_row, %rows)] : index
  %w_out_row = index.add %out_origin, %stage_row : index
  %bounded_w_out_row = index.assume %w_out_row [lt(%w_out_row, %n)] : index
  %w_row_origin = index.scale %bounded_w_out_row, %row_bytes : index, offset -> offset
  %zero8 = vector.splatf 0.0 : vector<8xf32>
  %init = vector.fragment<init> %zero8 shape [%c16, %c16] : vector<8xf32>
  %k_steps = index.div %k, %c64 : index
  %s_view = buffer.view %scales[%origin] : buffer -> view<[%rows]x2xf32>
  // The packet is immutable for prepare plus all sibling projections. Both
  // row_origin and active are workgroup-uniform, including the barrier branch.
  %control = buffer.view %count[%origin] : buffer -> view<3xi32>
  %active32 = view.load %control[%c0] : view<3xi32> -> i32
  %active = index.cast %active32 : i32 to index
  %tile_live = index.cmp ult, %row_origin, %active : index
  scf.if %tile_live {
    %x_scale = view.load %s_view[%bounded_x_row, %c0] : view<[%rows]x2xf32> -> f32
    %x_scales = vector.splat %x_scale : vector<16xf32>
    %g0_raw, %g1_raw, %u0_raw, %u1_raw = scf.for %step = [%c0 to %k_steps step %c1](%g0_acc = %init : vector<8xf32>, %g1_acc = %init : vector<8xf32>, %u0_acc = %init : vector<8xf32>, %u1_acc = %init : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %k_origin = index.mul %step, %c64 : index
      %x_col = index.add %k_origin, %stage_col : index
      %x_half = vector.load %x_view[%bounded_x_row, %x_col] : view<[%rows]x[%k]xf16> -> vector<16xf16>
      vector.store %x_half, %x_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<64x72xf16>
      %w_col = index.add %k_origin, %stage_col : index

      %deq0 = template.apply<@ggml.q4k.f16_fma16>(%w, %w_row_origin, %w_col) : (buffer, offset, index) -> (vector<16xf16>)
      vector.store %deq0, %w_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<64x72xf16>

      %deq1 = template.apply<@ggml.q4k.f16_fma16>(%w2, %w_row_origin, %w_col) : (buffer, offset, index) -> (vector<16xf16>)
      vector.store %deq1, %w2_stage_view[%stage_row, %stage_col] : vector<16xf16>, view<64x72xf16>
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %fc0 = index.constant 0 : index
      %lhs0 = vector.fragment.load<lhs> %x_stage_view[%wave_row, %fc0] shape [%c16, %c16] : view<64x72xf16> -> vector<16xf16>
      %rv000 = vector.load %w_stage_view[%w_row0, %fc0] : view<64x72xf16> -> vector<16xf16>
      %rhs000 = vector.fragment<rhs> %rv000 shape [%c16, %c16] : vector<16xf16>
      %ng0_0 = vector.mma %lhs0, %rhs000, %g0_acc : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv010 = vector.load %w_stage_view[%w_row1, %fc0] : view<64x72xf16> -> vector<16xf16>
      %rhs010 = vector.fragment<rhs> %rv010 shape [%c16, %c16] : vector<16xf16>
      %ng1_0 = vector.mma %lhs0, %rhs010, %g1_acc : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv100 = vector.load %w2_stage_view[%w_row0, %fc0] : view<64x72xf16> -> vector<16xf16>
      %rhs100 = vector.fragment<rhs> %rv100 shape [%c16, %c16] : vector<16xf16>
      %nu0_0 = vector.mma %lhs0, %rhs100, %u0_acc : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv110 = vector.load %w2_stage_view[%w_row1, %fc0] : view<64x72xf16> -> vector<16xf16>
      %rhs110 = vector.fragment<rhs> %rv110 shape [%c16, %c16] : vector<16xf16>
      %nu1_0 = vector.mma %lhs0, %rhs110, %u1_acc : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %fc1 = index.constant 16 : index
      %lhs1 = vector.fragment.load<lhs> %x_stage_view[%wave_row, %fc1] shape [%c16, %c16] : view<64x72xf16> -> vector<16xf16>
      %rv001 = vector.load %w_stage_view[%w_row0, %fc1] : view<64x72xf16> -> vector<16xf16>
      %rhs001 = vector.fragment<rhs> %rv001 shape [%c16, %c16] : vector<16xf16>
      %ng0_1 = vector.mma %lhs1, %rhs001, %ng0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv011 = vector.load %w_stage_view[%w_row1, %fc1] : view<64x72xf16> -> vector<16xf16>
      %rhs011 = vector.fragment<rhs> %rv011 shape [%c16, %c16] : vector<16xf16>
      %ng1_1 = vector.mma %lhs1, %rhs011, %ng1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv101 = vector.load %w2_stage_view[%w_row0, %fc1] : view<64x72xf16> -> vector<16xf16>
      %rhs101 = vector.fragment<rhs> %rv101 shape [%c16, %c16] : vector<16xf16>
      %nu0_1 = vector.mma %lhs1, %rhs101, %nu0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv111 = vector.load %w2_stage_view[%w_row1, %fc1] : view<64x72xf16> -> vector<16xf16>
      %rhs111 = vector.fragment<rhs> %rv111 shape [%c16, %c16] : vector<16xf16>
      %nu1_1 = vector.mma %lhs1, %rhs111, %nu1_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %fc2 = index.constant 32 : index
      %lhs2 = vector.fragment.load<lhs> %x_stage_view[%wave_row, %fc2] shape [%c16, %c16] : view<64x72xf16> -> vector<16xf16>
      %rv002 = vector.load %w_stage_view[%w_row0, %fc2] : view<64x72xf16> -> vector<16xf16>
      %rhs002 = vector.fragment<rhs> %rv002 shape [%c16, %c16] : vector<16xf16>
      %ng0_2 = vector.mma %lhs2, %rhs002, %ng0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv012 = vector.load %w_stage_view[%w_row1, %fc2] : view<64x72xf16> -> vector<16xf16>
      %rhs012 = vector.fragment<rhs> %rv012 shape [%c16, %c16] : vector<16xf16>
      %ng1_2 = vector.mma %lhs2, %rhs012, %ng1_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv102 = vector.load %w2_stage_view[%w_row0, %fc2] : view<64x72xf16> -> vector<16xf16>
      %rhs102 = vector.fragment<rhs> %rv102 shape [%c16, %c16] : vector<16xf16>
      %nu0_2 = vector.mma %lhs2, %rhs102, %nu0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv112 = vector.load %w2_stage_view[%w_row1, %fc2] : view<64x72xf16> -> vector<16xf16>
      %rhs112 = vector.fragment<rhs> %rv112 shape [%c16, %c16] : vector<16xf16>
      %nu1_2 = vector.mma %lhs2, %rhs112, %nu1_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %fc3 = index.constant 48 : index
      %lhs3 = vector.fragment.load<lhs> %x_stage_view[%wave_row, %fc3] shape [%c16, %c16] : view<64x72xf16> -> vector<16xf16>
      %rv003 = vector.load %w_stage_view[%w_row0, %fc3] : view<64x72xf16> -> vector<16xf16>
      %rhs003 = vector.fragment<rhs> %rv003 shape [%c16, %c16] : vector<16xf16>
      %ng0_3 = vector.mma %lhs3, %rhs003, %ng0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv013 = vector.load %w_stage_view[%w_row1, %fc3] : view<64x72xf16> -> vector<16xf16>
      %rhs013 = vector.fragment<rhs> %rv013 shape [%c16, %c16] : vector<16xf16>
      %ng1_3 = vector.mma %lhs3, %rhs013, %ng1_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv103 = vector.load %w2_stage_view[%w_row0, %fc3] : view<64x72xf16> -> vector<16xf16>
      %rhs103 = vector.fragment<rhs> %rv103 shape [%c16, %c16] : vector<16xf16>
      %nu0_3 = vector.mma %lhs3, %rhs103, %nu0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %rv113 = vector.load %w2_stage_view[%w_row1, %fc3] : view<64x72xf16> -> vector<16xf16>
      %rhs113 = vector.fragment<rhs> %rv113 shape [%c16, %c16] : vector<16xf16>
      %nu1_3 = vector.mma %lhs3, %rhs113, %nu1_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %ng0_3, %ng1_3, %nu0_3, %nu1_3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    %inv_bytes = index.constant 4096 : offset
    %inv_tile = buffer.alloca<workgroup> align(16) %inv_bytes : buffer
    %inv_view = buffer.view %inv_tile[%origin] : buffer -> view<64x16xf32>
    %writer = index.cmp ult, %workitem, %c64 : index
    scf.if %writer {
      %inv_row_value = index.add %row_origin, %workitem : index
      %inv_row = index.assume %inv_row_value [lt(%inv_row_value, %rows)] : index
      %inverse = view.load %s_view[%inv_row, %c1] : view<[%rows]x2xf32> -> f32
      %inverse16 = vector.splat %inverse : vector<16xf32>
      %bw = index.assume %workitem [range(%workitem, 0, 63)] : index
      vector.store %inverse16, %inv_view[%bw, %c0] : vector<16xf32>, view<64x16xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %inv_frag = vector.fragment.load<result> %inv_view[%wave_row, %c0] shape [%c16, %c16] : view<64x16xf32> -> vector<8xf32>
    %g0 = vector.mulf %g0_raw, %inv_frag : vector<8xf32>
    %g1 = vector.mulf %g1_raw, %inv_frag : vector<8xf32>
    %u0 = vector.mulf %u0_raw, %inv_frag : vector<8xf32>
    %u1 = vector.mulf %u1_raw, %inv_frag : vector<8xf32>
    %sg0 = vector.siluf<afn> %g0 : vector<8xf32>
    %sg1 = vector.siluf<afn> %g1 : vector<8xf32>
    %act0 = vector.mulf %sg0, %u0 : vector<8xf32>
    %act1 = vector.mulf %sg1, %u1 : vector<8xf32>
    // prepare_scaled_f16 writes a finite positive 2^e inverse for every
    // active row, including exceptional input values, and zero only otherwise.
    // The loaded inverse fragment already carries the exact result-row mapping.
    // Select after the original math: zero multiplication cannot suppress NaNs
    // from finite encoded weights that overflow during half staging.
    %result_live = vector.cmpf ogt, %inv_frag, %zero8 : vector<8xf32> -> vector<8xi1>
    %stored0 = vector.select %result_live, %act0, %zero8 : vector<8xf32>
    %stored1 = vector.select %result_live, %act1, %zero8 : vector<8xf32>
    vector.fragment.store<result> %stored0, %y_view[%bounded_wave_row, %bounded_wave_out] shape [%c16, %c16] : vector<8xf32>, view<64x64xf32, %y_layout>
    vector.fragment.store<result> %stored1, %y_view[%bounded_wave_row, %wave_out1] shape [%c16, %c16] : vector<8xf32>, view<64x64xf32, %y_layout>
  } else {
    // Every result in this tile is inactive, but callers still consume the
    // complete padded output. Store all 4096 values without reading inputs,
    // inverse scales or weights. Each lane owns 16 disjoint scalar results.
    %tile_elements = index.constant 4096 : index
    %zero_f32 = scalar.constant 0.0 : f32
    scf.for %element = [%workitem to %tile_elements step %c256] {
      %local_row0 = index.div %element, %c64 : index
      %local_col0 = index.rem %element, %c64 : index
      %local_row = index.assume %local_row0 [range(%local_row0, 0, 63)] : index
      %local_col = index.assume %local_col0 [range(%local_col0, 0, 63)] : index
      view.store %zero_f32, %y_view[%local_row, %local_col] : f32, view<64x64xf32, %y_layout>
    }
  }
  kernel.return
}

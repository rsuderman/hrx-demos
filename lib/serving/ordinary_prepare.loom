func.decl @ordinary.hidden_size() -> (index)
func.decl @ordinary.layer_count() -> (index)
func.decl @ordinary.kv_size() -> (index)
func.decl @ordinary.history_capacity() -> (index)
func.decl @ordinary.token_capacity() -> (index)
func.decl @ordinary.cache_capacity() -> (index)
func.decl @ordinary.pool_capacity() -> (index)
func.decl @ordinary.cache_base() -> (offset)
func.decl @ordinary.map_origin() -> (offset)
func.decl @loomify.tokens.terminal_marker() -> (buffer)

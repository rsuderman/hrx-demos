func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)
func.decl import("prepare") @source(%directory: buffer, %path: buffer) -> (i32)
func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)
func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)


func.decl @ordinary.epoch_root() -> (buffer)
// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")
// <|eot_id|>
// Empty path component.
global.rodata.def @empty = bytes("")
func.decl @ordinary.unsupported() -> (buffer)
// Reserved slots0/1 retain T/1 tags; all slots register the same epoch root.
// Each complete command has one immutable weight root followed by six native
// issue bindings. No proposal, catch-up, verifier or continuation is declared.
func.def @ordinary_declare_stage(%root: buffer, %tokens: i64, %weights: buffer) -> (i32) {
  %stage = func.call @stage(%root, %tokens) : (buffer, i64) -> (i32)
  %empty = global.load @empty : buffer
  %policy = global.load @policy : buffer
  %zero = scalar.constant 0 : i32
  %registered_source_1 = func.call @source(%empty, %weights) : (buffer, buffer) -> (i32)
  func.call @parameter(%stage, %zero, %zero, %registered_source_1, %policy) : (i32, i32, i32, i32, buffer) -> ()
  func.return %stage : i32
}

// These are the existing native cold records: {bytes, alignment, clear_bytes}
// and {byte_origin, byte_length}. Completion/retirement remains native-owned.
func.def @ordinary_allocation(%records: buffer, %slot_value: index, %bytes: i64, %clear: i64) {
  %origin = index.constant 0 : offset
  %slot = index.assume %slot_value [range(%slot_value, 0, 10)] : index
  %view = buffer.view %records[%origin] : buffer -> view<11x3xi64>
  %alignment = scalar.constant 256 : i64
  view.store %bytes, %view[%slot, 0] : i64, view<11x3xi64>
  view.store %alignment, %view[%slot, 1] : i64, view<11x3xi64>
  view.store %clear, %view[%slot, 2] : i64, view<11x3xi64>
  func.return
}

// All geometry below is the admitted one-row pooled profile. Configuration owns
// capacities and shared offsets; preparation owns the native record layout.
func.def @ordinary_storage() -> (buffer, buffer, buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %eleven = index.constant 11 : index
  %sixty_four = index.constant 64 : index
  %zero64 = scalar.constant 0 : i64
  %four64 = scalar.constant 4 : i64
  %two64 = scalar.constant 2 : i64
  %hidden_i = func.call @ordinary.hidden_size() : () -> (index)
  %layers_i = func.call @ordinary.layer_count() : () -> (index)
  %kv_i = func.call @ordinary.kv_size() : () -> (index)
  %history_i = func.call @ordinary.history_capacity() : () -> (index)
  %tokens_i = func.call @ordinary.token_capacity() : () -> (index)
  %context_i = func.call @ordinary.cache_capacity() : () -> (index)
  %pool_i = func.call @ordinary.pool_capacity() : () -> (index)
  %base_i = func.call @ordinary.cache_base() : () -> (offset)
  %map_i = func.call @ordinary.map_origin() : () -> (offset)
  %hidden = index.cast %hidden_i : index to i64
  %layers = index.cast %layers_i : index to i64
  %kv = index.cast %kv_i : index to i64
  %history = index.cast %history_i : index to i64
  %tokens = index.cast %tokens_i : index to i64
  %context = index.cast %context_i : index to i64
  %pool = index.cast %pool_i : index to i64
  %base = index.cast %base_i : offset to i64
  %map = index.cast %map_i : offset to i64
  %elements = scalar.muli %tokens, %hidden : i64
  %residual = scalar.muli %elements, %four64 : i64
  %history_bytes = scalar.muli %history, %four64 : i64
  %planes = scalar.muli %layers, %two64 : i64
  %pooled_kv = scalar.muli %pool, %kv : i64
  %plane_stride = scalar.muli %pooled_kv, %two64 : i64
  %arena_kv = scalar.muli %planes, %plane_stride : i64
  %arena = scalar.addi %base, %arena_kv : i64
  %page_size = scalar.constant 64 : i64
  %page_bias = scalar.constant 63 : i64
  %rounded = scalar.addi %context, %page_bias : i64
  %pages = scalar.divui %rounded, %page_size : i64
  %map_words = scalar.muli %pages, %four64 : i64
  %map_bytes = scalar.addi %map, %map_words : i64
  %metadata = scalar.constant 2064 : i64
  %output = scalar.constant 64 : i64
  %alloc_bytes = index.constant 264 : offset
  %allocations = buffer.alloca<private> align(8) %alloc_bytes : buffer
  scf.for %slot = [%zero to %eleven step %one] {
    func.call @ordinary_allocation(%allocations, %slot, %zero64, %zero64) : (buffer, index, i64, i64) -> ()
  }
  %slot0 = index.constant 0 : index
  %slot1 = index.constant 1 : index
  %slot2 = index.constant 2 : index
  %slot3 = index.constant 3 : index
  %slot4 = index.constant 4 : index
  %slot5 = index.constant 5 : index
  func.call @ordinary_allocation(%allocations, %slot0, %residual, %residual) : (buffer, index, i64, i64) -> ()
  func.call @ordinary_allocation(%allocations, %slot1, %arena, %base) : (buffer, index, i64, i64) -> ()
  func.call @ordinary_allocation(%allocations, %slot2, %metadata, %zero64) : (buffer, index, i64, i64) -> ()
  func.call @ordinary_allocation(%allocations, %slot3, %map_bytes, %zero64) : (buffer, index, i64, i64) -> ()
  func.call @ordinary_allocation(%allocations, %slot4, %history_bytes, %zero64) : (buffer, index, i64, i64) -> ()
  func.call @ordinary_allocation(%allocations, %slot5, %output, %zero64) : (buffer, index, i64, i64) -> ()
  %views_bytes = index.constant 64 : offset
  %views = buffer.alloca<private> align(8) %views_bytes : buffer
  %views_view = buffer.view %views[%origin] : buffer -> view<8xi64>
  %twelve = scalar.constant 12 : i64
  %row_base = scalar.constant 512 : i64
  %progress_bytes = scalar.constant 32 : i64
  %progress_origin = scalar.addi %row_base, %history_bytes : i64
  view.store %zero64, %views_view[0] : i64, view<8xi64>
  view.store %twelve, %views_view[1] : i64, view<8xi64>
  view.store %row_base, %views_view[2] : i64, view<8xi64>
  view.store %zero64, %views_view[3] : i64, view<8xi64>
  view.store %row_base, %views_view[4] : i64, view<8xi64>
  view.store %history_bytes, %views_view[5] : i64, view<8xi64>
  view.store %progress_origin, %views_view[6] : i64, view<8xi64>
  view.store %progress_bytes, %views_view[7] : i64, view<8xi64>
  %origins_bytes = index.constant 512 : offset
  %origins = buffer.alloca<private> align(8) %origins_bytes : buffer
  %origins_view = buffer.view %origins[%origin] : buffer -> view<64xi64>
  scf.for %slot = [%zero to %sixty_four step %one] {
    view.store %zero64, %origins_view[%slot] : i64, view<64xi64>
  }
  %alignment = scalar.constant 256 : i64
  view.store %alignment, %origins_view[0] : i64, view<64xi64>
  view.store %alignment, %origins_view[1] : i64, view<64xi64>
  view.store %base, %origins_view[2] : i64, view<64xi64>
  %geometry_bytes = index.constant 104 : offset
  %geometry = buffer.alloca<private> align(8) %geometry_bytes : buffer
  %geometry_view = buffer.view %geometry[%origin] : buffer -> view<13xi64>
  %one64 = scalar.constant 1 : i64
  %segment_alignment = scalar.constant 128 : i64
  %page_bytes = scalar.muli %segment_alignment, %kv : i64
  view.store %page_size, %geometry_view[0] : i64, view<13xi64>
  view.store %map, %geometry_view[1] : i64, view<13xi64>
  view.store %zero64, %geometry_view[2] : i64, view<13xi64>
  view.store %page_size, %geometry_view[3] : i64, view<13xi64>
  view.store %alignment, %geometry_view[4] : i64, view<13xi64>
  view.store %base, %geometry_view[5] : i64, view<13xi64>
  view.store %four64, %geometry_view[6] : i64, view<13xi64>
  view.store %one64, %geometry_view[7] : i64, view<13xi64>
  view.store %one64, %geometry_view[8] : i64, view<13xi64>
  view.store %base, %geometry_view[9] : i64, view<13xi64>
  view.store %planes, %geometry_view[10] : i64, view<13xi64>
  view.store %plane_stride, %geometry_view[11] : i64, view<13xi64>
  view.store %page_bytes, %geometry_view[12] : i64, view<13xi64>
  %draft_origins = buffer.alloca<private> align(8) %origin : buffer
  func.return %allocations, %views, %origins, %draft_origins, %geometry : buffer, buffer, buffer, buffer, buffer
}

// Native validates its shared envelope first. This variant additionally caps
// source materialization at512 tokens and the checkpoint's131072 context.
// Shapes are little-endian i64 {tokens, spans}; all returned records are cold,
// retained by their native owner and never freed by a model command.
func.def public @prepare(%prefill: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %draft_depth: i32, %shapes: buffer, %shape_count: i64, %weights: buffer, %options: buffer) -> (i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero32 = scalar.constant 0 : i32
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %capacity_fact = func.call @ordinary.token_capacity() : () -> (index)
  %capacity = index.cast %capacity_fact : index to i64
  %maximum_context_fact = func.call @ordinary.cache_capacity() : () -> (index)
  %maximum_context = index.cast %maximum_context_fact : index to i64
  %maximum_pool = scalar.constant 4194304 : i64
  %maximum_rows = scalar.constant 16 : i64
  %maximum_count = scalar.constant 2147483647 : i64
  %maximum_shapes = scalar.constant 2147483645 : i64
  %page_size = scalar.constant 64 : i64
  %fields, %options_type, %field_count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object_type = scalar.constant 2 : i32
  %object = scalar.cmpi eq, %options_type, %object_type : i32
  %empty_options = scalar.cmpi eq, %field_count, %zero64 : i64
  %empty_object = scalar.andi %object, %empty_options : i1
  %no_draft = scalar.cmpi eq, %draft_depth, %zero32 : i32
  %base_options = scalar.andi %empty_object, %no_draft : i1
  %prefill_min = scalar.cmpi uge, %prefill, %one64 : i64
  %valid_prefill_min = scalar.andi %base_options, %prefill_min : i1
  %prefill_max = scalar.cmpi ule, %prefill, %capacity : i64
  %valid_prefill_max = scalar.andi %valid_prefill_min, %prefill_max : i1
  %context_min = scalar.cmpi uge, %context, %prefill : i64
  %valid_context_min = scalar.andi %valid_prefill_max, %context_min : i1
  %context_max = scalar.cmpi ule, %context, %maximum_context : i64
  %valid_context_max = scalar.andi %valid_context_min, %context_max : i1
  %row_min = scalar.cmpi uge, %rows, %one64 : i64
  %valid_row_min = scalar.andi %valid_context_max, %row_min : i1
  %row_max = scalar.cmpi ule, %rows, %maximum_rows : i64
  %valid_row_max = scalar.andi %valid_row_min, %row_max : i1
  %pool_max = scalar.cmpi ule, %pool, %maximum_pool : i64
  %valid_pool_max = scalar.andi %valid_row_max, %pool_max : i1
  %pin_max = scalar.cmpi ule, %pins, %maximum_count : i64
  %valid_pin_max = scalar.andi %valid_pool_max, %pin_max : i1
  %shape_max = scalar.cmpi ule, %shape_count, %maximum_shapes : i64
  %valid_shape_max = scalar.andi %valid_pin_max, %shape_max : i1
  %remainder = scalar.remui %pool, %page_size : i64
  %pool_aligned = scalar.cmpi eq, %remainder, %zero64 : i64
  %pool_options = scalar.andi %valid_shape_max, %pool_aligned : i1
  %dense = scalar.cmpi eq, %pool, %zero64 : i64
  %packed = scalar.cmpi ne, %shape_count, %zero64 : i64
  %has_epochs = scalar.ori %dense, %packed : i1
  %no_pins = scalar.cmpi eq, %pins, %zero64 : i64
  %pooled = scalar.cmpi ne, %pool, %zero64 : i64
  %valid_pins = scalar.ori %no_pins, %pooled : i1
  %valid_epochs = scalar.andi %pool_options, %has_epochs : i1
  %supported = scalar.andi %valid_epochs, %valid_pins : i1
  %supported32 = scalar.extui %supported : i1 to i32
  %diagnostic = func.call @ordinary.unsupported() : () -> (buffer)
  func.call @require(%supported32, %diagnostic) : (i32, buffer) -> ()
  %expected_context_fact = func.call @ordinary.cache_capacity() : () -> (index)
  %expected_context = index.cast %expected_context_fact : index to i64
  %expected_prefill_fact = func.call @ordinary.token_capacity() : () -> (index)
  %expected_prefill = index.cast %expected_prefill_fact : index to i64
  %context_matches = scalar.cmpi eq, %context, %expected_context : i64
  %prefill_matches = scalar.cmpi eq, %prefill, %expected_prefill : i64
  %single_row = scalar.cmpi eq, %rows, %one64 : i64
  %expected_pool_fact = func.call @ordinary.pool_capacity() : () -> (index)
  %expected_pool = index.cast %expected_pool_fact : index to i64
  %pool_matches = scalar.cmpi eq, %pool, %expected_pool : i64
  %bounded_profile0 = scalar.andi %context_matches, %prefill_matches : i1
  %bounded_profile1 = scalar.andi %single_row, %pool_matches : i1
  %bounded_profile2 = scalar.andi %bounded_profile0, %bounded_profile1 : i1
  %bounded_profile = scalar.andi %bounded_profile2, %no_pins : i1
  %bounded_profile32 = scalar.extui %bounded_profile : i1 to i32
  func.call @require(%bounded_profile32, %diagnostic) : (i32, buffer) -> ()
  %bounded = scalar.assume %shape_count [range(%shape_count, 0, 2147483645)] : i64
  %count = index.cast %bounded : i64 to index
  %view = buffer.view %shapes[%origin] : buffer -> view<[%count]x2xi64>
  %epoch_root = func.call @ordinary.epoch_root() : () -> (buffer)
  %prefill_stage = func.call @ordinary_declare_stage(%epoch_root, %prefill, %weights) : (buffer, i64, buffer) -> (i32)
  %decode_stage = func.call @ordinary_declare_stage(%epoch_root, %one64, %weights) : (buffer, i64, buffer) -> (i32)
  %maximum = scf.for %i = [%zero to %count step %one](%previous = %zero64 : i64) -> (i64) {
    %tokens = view.load %view[%i, 0] : view<[%count]x2xi64> -> i64
    %spans = view.load %view[%i, 1] : view<[%count]x2xi64> -> i64
    %positive = scalar.cmpi uge, %tokens, %one64 : i64
    %token_bound = scalar.cmpi ule, %tokens, %capacity : i64
    %fits_context = scalar.cmpi ule, %tokens, %context : i64
    %span_min = scalar.cmpi uge, %spans, %one64 : i64
    // Serve's default inventory includes larger span capacities. With the
    // admitted one row, native packing selects the same-token span-1 sibling.
    // Keep every ordinal slot; these are capacities, not active span counts.
    %span_bound = scalar.cmpi ule, %spans, %tokens : i64
    %token_range = scalar.andi %positive, %token_bound : i1
    %token_fit = scalar.andi %token_range, %fits_context : i1
    %span_range = scalar.andi %span_min, %span_bound : i1
    %valid_shape = scalar.andi %token_fit, %span_range : i1
    %valid_shape32 = scalar.extui %valid_shape : i1 to i32
    func.call @require(%valid_shape32, %diagnostic) : (i32, buffer) -> ()
    %stage = func.call @ordinary_declare_stage(%epoch_root, %tokens, %weights) : (buffer, i64, buffer) -> (i32)
    %larger = scalar.cmpi ugt, %tokens, %previous : i64
    %next = scf.select %larger, %tokens, %previous : i64
    scf.yield %next : i64
  }
  %smaller = scalar.cmpi ult, %maximum, %prefill : i64
  %packed_prefill = scf.select %smaller, %maximum, %prefill : i64
  %effective_prefill = scf.select %pooled, %packed_prefill, %prefill : i64
  %two64 = scalar.constant 2 : i64
  %stage_count64 = scalar.addi %shape_count, %two64 : i64
  %shared = scalar.trunci %stage_count64 : i64 to i32
  %state_bytes = index.constant 8 : offset
  %state = buffer.alloca<private> align(4) %state_bytes : buffer
  %state_view = buffer.view %state[%origin] : buffer -> view<2xi32>
  view.store %prefill_stage, %state_view[0] : i32, view<2xi32>
  view.store %decode_stage, %state_view[1] : i32, view<2xi32>
  %terminal = func.call @loomify.tokens.terminal_marker() : () -> (buffer)
  %allocations, %views, %origins, %draft_origins, %geometry = func.call @ordinary_storage() : () -> (buffer, buffer, buffer, buffer, buffer)
  func.return %effective_prefill, %shared, %state, %terminal, %allocations, %views, %origins, %draft_origins, %geometry : i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer
}

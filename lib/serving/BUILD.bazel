load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:loom_resources.bzl", "loom_resources")
load("//build_tools:model_assembly.bzl", "assembly_products")
load("//lib/architectures:assemblies.bzl", "ASSEMBLIES")

package(default_visibility = ["//visibility:public"])

exports_files([
    "weights.loom",
    "greedy.loom",
    "request_check.loom",
    "control_interface.loom",
    "ordinary_control.loom",
    "ordinary_prepare.loom",
])

loom_merge(
    name = "greedy",
    srcs = [
        "greedy.loom",
        "request_check.loom",
    ],
)

_PRODUCTS = {
    "//lib/text/common:jinja.loom": "kJinjaHelpers",
    "//lib/text/common:strings.loom": "kTextStrings",
    "//lib/text/common:json.loom": "kTextJson",
    "//lib/text/common:identity.loom": "kTextIdentity",
    ":control_interface.loom": "kControlInterface",
    "//lib/text/generated_input:environment.loom": "kTextEnvironment",
    "//lib/text/generated_input:request.loom": "kTextRequest",
    "//lib/text/generated_input:host.loom": "kTextHost",
    "//lib/text/generated_input:prepare.loom": "kTextPrepare",
    "//lib/text/output:stream.loom": "kTextOutputStream",
    "//lib/text/output:json_calls.loom": "kTextOutputJson",
    "//lib/text/output:tagged_calls.loom": "kTextOutputTagged",
    "//lib/text/output:schema.loom": "kTextOutputSchema",
    "//lib/platforms/amdgpu/gfx11:attention_h256_implementation": "kGfx11AttentionH256Schedule",
    "//lib/platforms/amdgpu/gfx11/projection:implementation": "kGfx11ScaledF16Projection",
    "//lib/platforms/amdgpu/gfx11:targets": "kGfx11Targets",
    ":greedy": "kGreedy",
    ":weights.loom": "kWeights",
}

_PRODUCTS.update(assembly_products(ASSEMBLIES))

filegroup(
    name = "export_products",
    srcs = _PRODUCTS.keys(),
)

loom_resources(
    name = "library_resources_header",
    out = "library_resources.h",
    products = _PRODUCTS,
)

iree_cc_library(
    name = "library_resources",
    hdrs = [":library_resources_header"],
    visibility = [
        "//lib/text/testing:__pkg__",
        "//lib/loomify:__pkg__",
        "//tools/loomify-gguf:__pkg__",
    ],
)

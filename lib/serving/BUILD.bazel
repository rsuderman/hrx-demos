    "//lib/architectures/gemma3:implementation": "kGemmaImplementation",
    "//lib/architectures/gemma3:prepare_library": "kGemmaPreparation",
    "//lib/architectures/gemma3:execution": "kGemmaExecution",
    "//lib/text/protocols/gemma_turns:implementation": "kGemmaTurns",

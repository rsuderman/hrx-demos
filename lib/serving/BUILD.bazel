load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:loom_resources.bzl", "loom_resources")
load("//build_tools:model_assembly.bzl", "assembly_products")
load("//lib/architectures:assemblies.bzl", "ASSEMBLIES")

package(default_visibility = ["//visibility:public"])

exports_files([
    "weights.loom",
    "greedy.loom",
    "request_check.loom",
    "control_interface.loom",
    "ordinary_control.loom",
    "ordinary_prepare.loom",
])

loom_merge(
    name = "greedy",
    srcs = [
        "greedy.loom",
        "request_check.loom",
    ],
)

_PRODUCTS = {
    "//lib/text/protocols/chatml_thinking:compact_reasoning": "kChatmlCompactReasoning",
    "//lib/text/protocols/spark_glm:policy": "kSparkGlm",
    "//lib/text/protocols/chatml_thinking:plain": "kChatmlPlain",
    "//lib/text/protocols/chatml_thinking:hermes_non_thinking": "kChatmlHermesNonThinking",
    "//lib/platforms/amdgpu/gfx11:attention_h256_implementation": "kGfx11AttentionH256Schedule",
    "//lib/platforms/amdgpu/gfx11/projection:implementation": "kGfx11ScaledF16Projection",
    "//lib/text/protocols/chatml_thinking:hermes": "kChatmlHermes",
    "//lib/platforms/amdgpu/gfx11:targets": "kGfx11Targets",
    "//lib/text/protocols/gemma_turns:implementation": "kGemmaTurns",
    "//lib/text/common:implementation": "kTextCommon",
    "//lib/text/protocols/llama_headers:implementation": "kLlamaText",
    "//lib/text/protocols/chatml_thinking:inline_history": "kChatmlInlineHistory",
    "//lib/text/protocols/chatml_thinking:explicit_reasoning": "kChatmlExplicitReasoning",
    ":greedy": "kGreedy",
    ":weights.loom": "kWeights",
}

_PRODUCTS.update(assembly_products(ASSEMBLIES))

filegroup(
    name = "export_products",
    srcs = _PRODUCTS.keys(),
)

loom_resources(
    name = "library_resources_header",
    out = "library_resources.h",
    products = _PRODUCTS,
)

iree_cc_library(
    name = "library_resources",
    hdrs = [":library_resources_header"],
    visibility = [
        "//lib/text/testing:__pkg__",
        "//lib/loomify:__pkg__",
        "//tools/loomify-gguf:__pkg__",
    ],
)

  %layer = index.constant 0 : index
  %phase = index.constant 1 : index
  %rows = index.constant 1 : index
  %origin = index.constant 0 : offset
  %count_bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  kernel.launch @llm.epoch.snapshot_count[](%phase,%origin,%control,%count) : [](index,offset,buffer,buffer)
  command.launch @loomify.llama.layer[%layer,%phase,%rows,%origin](%parameters,%residual,%control,%map,%cache,%count) : [index,index,index,offset](buffer,buffer,buffer,buffer,buffer,buffer)
  command.return
}

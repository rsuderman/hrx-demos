kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

kernel.decl @llama32_publish_epoch_id() launch(%epoch: buffer, %selected: buffer, %output: buffer)

kernel.decl @test.epoch_compute(%capacity$10: index) launch(%capacity$11: index, %residual: buffer, %epoch: buffer, %count: buffer, %arena: buffer, %input: buffer, %selected: buffer)

kernel.decl @test.epoch_initialize() launch(%kind: index, %metadata: buffer, %input: buffer)

kernel.decl @test.epoch_continue() launch(%metadata: buffer, %input: buffer)

command.def @test.epoch.single(%capacity: index) launch(%parameters: buffer, %residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %input: buffer, %output: buffer) {
  %count_bytes = index.constant 12 : offset
  %selected_bytes = index.constant 16 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  %selected = buffer.alloca<global> align(256) %selected_bytes : buffer
  %prefill = index.constant 0 : index
  %descriptor_origin = index.constant 12 : offset
  kernel.launch @llm.epoch.snapshot_count(%prefill, %descriptor_origin, %metadata, %count) : (index, offset, buffer, buffer)
  kernel.launch @test.epoch_compute[%capacity](%capacity, %residual, %metadata, %count, %arena, %input, %selected) : [index](index, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @llama32_publish_epoch_id(%metadata, %selected, %output) : (buffer, buffer, buffer)
  command.return
}


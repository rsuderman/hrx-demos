// Packet unit fixture calls the production unpack/scatter kernels. The small
// deterministic compute is an independent packet observer, not a model oracle.
kernel.decl @loomify_epoch_unpack(%capacity:index) launch(%capacity:index,%metadata:buffer,%input:buffer,%control:buffer,%history:buffer,%progress:buffer)
kernel.decl @loomify_epoch_scatter() launch(%metadata:buffer,%history:buffer,%output:buffer)
kernel.decl @test.epoch_compute(%capacity:index) launch(%capacity:index,%residual:buffer,%control:buffer,%arena:buffer,%history:buffer)
kernel.decl @test.epoch_initialize() launch(%kind:index,%metadata:buffer,%input:buffer)
kernel.decl @test.epoch_continue() launch(%metadata:buffer,%input:buffer)
command.program.def @test.epoch.single(%capacity:index) launch(%parameters:buffer,%residual:buffer,%metadata:buffer,%origins:buffer,%arena:buffer,%input:buffer,%output:buffer) {
  %minimum = index.constant 129 : index
  %large = index.cmp ugt, %capacity, %minimum : index
  %history_capacity = scf.select %large, %capacity, %minimum : index
  %word = index.constant 4 : offset
  %history_bytes = index.scale %history_capacity, %word : index, offset -> offset
  %control_bytes = index.constant 12 : offset
  %progress_bytes = index.constant 32 : offset
  %control = buffer.alloca<global> align(256) %control_bytes : buffer
  %history = buffer.alloca<global> align(256) %history_bytes : buffer
  %progress = buffer.alloca<global> align(256) %progress_bytes : buffer
  kernel.launch @loomify_epoch_unpack[%capacity](%capacity,%metadata,%input,%control,%history,%progress) : [index](index,buffer,buffer,buffer,buffer,buffer)
  kernel.launch @test.epoch_compute[%capacity](%capacity,%residual,%control,%arena,%history) : [index](index,buffer,buffer,buffer,buffer)
  kernel.launch @loomify_epoch_scatter[](%metadata,%history,%output) : [](buffer,buffer,buffer)
  command.return
}
command.program.def public @test.epoch8.0() launch(%parameters:buffer,%residual:buffer,%metadata:buffer,%origins:buffer,%arena:buffer,%input:buffer,%output:buffer) {
  %capacity = index.constant 8 : index
  %kind = index.constant 0 : index
  kernel.launch @test.epoch_initialize[](%kind,%metadata,%input) : [](index,buffer,buffer)
  command.program.launch @test.epoch.single[%capacity](%parameters,%residual,%metadata,%origins,%arena,%input,%output) : [index](buffer,buffer,buffer,buffer,buffer,buffer,buffer)
  kernel.launch @test.epoch_continue[](%metadata,%input) : [](buffer,buffer)
  command.program.launch @test.epoch.single[%capacity](%parameters,%residual,%metadata,%origins,%arena,%input,%output) : [index](buffer,buffer,buffer,buffer,buffer,buffer,buffer)
  command.return
}

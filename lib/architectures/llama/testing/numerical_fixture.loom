// Deterministic packet-bridge unit fixture, not a substitute model recipe.
kernel.def @test.epoch_compute(%capacity0: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%capacity0: index, %residual: buffer, %control: buffer, %arena: buffer, %history: buffer) {
  %capacity = index.assume %capacity0 [range(%capacity0, 1, 512)] : index
  %origin = index.constant 0 : offset
  %cache_origin = index.constant 512 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %words = buffer.view %control[%origin] : buffer -> view<3xi32>
  %tokens = buffer.view %history[%origin] : buffer -> view<[%capacity]xi32>
  %cache = buffer.view %arena[%cache_origin] : buffer -> view<32xi32>
  %result = buffer.view %residual[%origin] : buffer -> view<[%capacity]xi32>
  %n32 = view.load %words[0] : view<3xi32> -> i32
  %p32 = view.load %words[1] : view<3xi32> -> i32
  %n_value = index.cast %n32 : i32 to index
  %n = index.assume %n_value [range(%n_value, 1, 512)] : index
  %position_value = index.cast %p32 : i32 to index
  %position = index.assume %position_value [range(%position_value, 0, 28)] : index
  scf.for %i = [%zero to %n step %one] {
    %row = index.assume %i [range(%i, 0, 511), lt(%i, %capacity)] : index
    %v = view.load %tokens[%row] : view<[%capacity]xi32> -> i32
    %slot_value = index.add %position, %row : index
    %slot = index.assume %slot_value [range(%slot_value, 0, 31)] : index
    view.store %v, %cache[%slot] : i32, view<32xi32>
    %two = scalar.constant 2 : i32
    %twice = scalar.muli %v, %two : i32
    view.store %twice, %result[%row] : i32, view<[%capacity]xi32>
    scf.yield
  }
  %last_value = index.sub %n, %one : index
  %last = index.assume %last_value [range(%last_value, 0, 511), lt(%last_value, %capacity)] : index
  %v = view.load %tokens[%last] : view<[%capacity]xi32> -> i32
  %one32 = scalar.constant 1 : i32
  %next = scalar.addi %v, %one32 : i32
  %stop = scalar.constant 99 : i32
  %terminal = scalar.cmpi eq, %next, %stop : i32
  %eos = view.load %words[2] : view<3xi32> -> i32
  %token = scf.select %terminal, %eos, %next : i32
  view.store %token, %tokens[0] : i32, view<[%capacity]xi32>
  kernel.return
}
kernel.def @test.epoch_continue() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%metadata: buffer, %input: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %words = buffer.view %metadata[%descriptor_origin] : buffer -> view<5xi32>
  %tokens = buffer.view %input[%origin] : buffer -> view<1xi32>
  %one = scalar.constant 1 : i32
  %eight = scalar.constant 8 : i32
  %zero = scalar.constant 0 : i32
  %pending = scalar.constant 13 : i32
  view.store %one, %words[0] : i32, view<5xi32>
  view.store %eight, %words[1] : i32, view<5xi32>
  view.store %zero, %words[2] : i32, view<5xi32>
  view.store %zero, %words[4] : i32, view<5xi32>
  view.store %pending, %tokens[0] : i32, view<1xi32>
  kernel.return
}
kernel.def @test.epoch_initialize() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%kind: index, %metadata: buffer, %input: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %eos_origin = index.constant 2060 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<3xi32>
  %span = buffer.view %metadata[%descriptor_origin] : buffer -> view<5xi32>
  %terminal = buffer.view %metadata[%eos_origin] : buffer -> view<1xi32>
  %tokens = buffer.view %input[%origin] : buffer -> view<3xi32>
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %five = scalar.constant 5 : i32
  %zero = scalar.constant 0 : i32
  %absent = scalar.constant -1 : i32
  %eos = scalar.constant 127 : i32
  %ten = scalar.constant 10 : i32
  %eleven = scalar.constant 11 : i32
  %twelve = scalar.constant 12 : i32
  %eog_input = scalar.constant 98 : i32
  %unselected = index.cmp eq, %kind, %one : index
  %stops = index.cmp eq, %kind, %two : index
  %output_count = scf.select %unselected, %zero, %one32 : i32
  %selection = scf.select %unselected, %absent, %two32 : i32
  %last = scf.select %stops, %eog_input, %twelve : i32
  view.store %three, %header[0] : i32, view<3xi32>
  view.store %one32, %header[1] : i32, view<3xi32>
  view.store %output_count, %header[2] : i32, view<3xi32>
  view.store %three, %span[0] : i32, view<5xi32>
  view.store %five, %span[1] : i32, view<5xi32>
  view.store %zero, %span[2] : i32, view<5xi32>
  view.store %zero, %span[3] : i32, view<5xi32>
  view.store %selection, %span[4] : i32, view<5xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  view.store %ten, %tokens[0] : i32, view<3xi32>
  view.store %eleven, %tokens[1] : i32, view<3xi32>
  view.store %last, %tokens[2] : i32, view<3xi32>
  kernel.return
}

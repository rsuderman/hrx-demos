// Architecture facts for shared ordinary preparation.
global.rodata.def @epoch_root = bytes("67656e6572617465642e6c6c616d615f65706f6368")
global.rodata.def @unsupported = bytes("4c6c616d61203342207265717569726573207461726765742d6f6e6c7920677265656479207374616765732c20656d707479206d6f64656c206f7074696f6e7320616e642076616c696420626f756e6465642063617061636974696573")
func.def public inline @ordinary.epoch_root() -> (buffer) {
  %value = global.load @epoch_root : buffer
  func.return %value : buffer
}
func.def public inline @ordinary.unsupported() -> (buffer) {
  %value = global.load @unsupported : buffer
  func.return %value : buffer
}

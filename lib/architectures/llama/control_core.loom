// Family terminal facts for the shared ordinary single-request host path.
config.decl @llama.publication.end_text_id : i32
config.decl @llama.publication.end_message_id : i32
config.decl @llama.publication.end_turn_id : i32

func.def inline @loomify.serving.terminal_id() -> (i32) {
  %terminal = config.get @llama.publication.end_turn_id : i32
  func.return %terminal : i32
}

func.def public inline @loomify_serving_native_token(%token: i32, %eos: i32) -> (i32) {
  %end_text = config.get @llama.publication.end_text_id : i32
  %end_message = config.get @llama.publication.end_message_id : i32
  %end_turn = config.get @llama.publication.end_turn_id : i32
  %a = scalar.cmpi eq, %token, %end_text : i32
  %b = scalar.cmpi eq, %token, %end_message : i32
  %c = scalar.cmpi eq, %token, %end_turn : i32
  %ab = scalar.ori %a, %b : i1
  %stop = scalar.ori %ab, %c : i1
  %native = scf.select %stop, %eos, %token : i32
  func.return %native : i32
}

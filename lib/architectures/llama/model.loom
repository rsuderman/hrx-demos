// Scalar/layout limits of the maintained adjacent128 rotary recipe. These do
// not identify a checkpoint; matrix encoding and dimensions are operation facts.
config.decl @llama.model.head_size : index
template.decl @loomify.llama.model_layout(%hidden: index, %head: index, %vocabulary: index)
template.def<@loomify.llama.model_layout> @loomify_llama_model_layout(%hidden: index, %head: index, %vocabulary: index) where [range(%hidden, 1024, 32768), multiple_of(%hidden, 1024), eq(%head, 128), range(%vocabulary, 1, 128256)] { template.return }
// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Architecture order lives here; generated configuration contains facts only.
config.decl @runner.llama32.prefill_token_count : index
config.decl @llama.model.hidden_size : index
config.decl @llama.model.vocabulary_size : index
config.decl @llama.model.layer_count : index
config.decl @llama.model.embedding_weight_bytes : index
config.decl @llama.model.output_weight_bytes : index
command.decl @loomify.llama.layer(%layer: index, %phase: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer)
kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)
kernel.decl @llama32_token_embedding_epoch_q6k_f32(%rows: index) launch(%epoch: buffer, %count: buffer, %tokens: buffer, %weight: buffer, %output: buffer)
template.decl @llm.output.last_greedy(%capacity: index, %begin: index, %origin: offset, %hidden: index, %vocab: index, %weight_bytes: index, %q8_bytes: offset, %logit_bytes: offset, %partial_bytes: offset, %input: buffer, %control: buffer, %gamma: view<[%hidden]xf32>, %weight: view<[%weight_bytes]xi8>, %normalized: buffer, %token: buffer)

command.def @loomify.llama.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %selected_ids: buffer) {
  %phase = index.constant 0 : index
  %rows = config.get @runner.llama32.prefill_token_count : index
  %descriptor_origin = index.constant 12 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero_offset = index.constant 0 : offset
  %word = index.constant 4 : offset
  %count_bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  kernel.launch @llm.epoch.snapshot_count[](%phase, %descriptor_origin, %epoch, %count) : [](index, offset, buffer, buffer)
  %layout_hidden = config.get @llama.model.hidden_size : index
  %layout_head = config.get @llama.model.head_size : index
  %layout_vocabulary = config.get @llama.model.vocabulary_size : index
  template.apply<@loomify.llama.model_layout>(%layout_hidden, %layout_head, %layout_vocabulary) : (index, index, index)
  %embedding_bytes = config.get @llama.model.embedding_weight_bytes : index
  %embedding = command.parameter %parameters, "token_embd.weight" : view<[%embedding_bytes]xi8>
  kernel.launch @llama32_token_embedding_epoch_q6k_f32[%rows](%epoch, %count, %input_ids, %embedding, %residual) : [index](buffer, buffer, buffer, view<[%embedding_bytes]xi8>, buffer)
  %layers = config.get @llama.model.layer_count : index
  scf.for %layer = [%zero to %layers step %one] unroll {
    command.launch @loomify.llama.layer[%layer, %phase, %rows, %descriptor_origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  %hidden = config.get @llama.model.hidden_size : index
  %vocab = config.get @llama.model.vocabulary_size : index
  %output_bytes = config.get @llama.model.output_weight_bytes : index
  %gamma = command.parameter %parameters, "output_norm.weight" : view<[%hidden]xf32>
  %weight = command.parameter %parameters, "token_embd.weight" : view<[%output_bytes]xi8>
  %normalized_bytes = index.scale %hidden, %word : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %normalized_bytes : buffer
  %group = index.constant 128 : index
  %packed_group_bytes = index.constant 144 : offset
  %groups = index.div %hidden, %group : index
  %q8_bytes = index.scale %groups, %packed_group_bytes : index, offset -> offset
  %logit_bytes = index.scale %vocab, %word : index, offset -> offset
  %tile = index.constant 4096 : index
  %tile_minus_one = index.constant 4095 : index
  %rounded = index.add %vocab, %tile_minus_one : index
  %parts = index.div %rounded, %tile : index
  %partial_bytes = index.scale %parts, %word : index, offset -> offset
  template.apply<@llm.output.last_greedy>(%rows, %zero, %zero_offset, %hidden, %vocab, %output_bytes, %q8_bytes, %logit_bytes, %partial_bytes, %residual, %count, %gamma, %weight, %normalized, %selected_ids) : (index, index, offset, index, index, index, offset, offset, offset, buffer, buffer, view<[%hidden]xf32>, view<[%output_bytes]xi8>, buffer, buffer)
  command.return
}

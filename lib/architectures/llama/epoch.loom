// Public request boundary; numerical computation writes private selected IDs.
command.program.decl @loomify.llama.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %selected_ids: buffer)
kernel.decl @llama32_publish_epoch_id() launch(%epoch: buffer, %selected_ids: buffer, %output_ids: buffer)
command.program.def public @generated.llama_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %output_ids: buffer) {
  %selected_bytes = index.constant 16 : offset
  %selected_ids = buffer.alloca<global> align(256) %selected_bytes : buffer
  command.program.launch @loomify.llama.model[](%parameters, %residual, %epoch, %rows, %state, %input_ids, %selected_ids) : [](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @llama32_publish_epoch_id[](%epoch, %selected_ids, %output_ids) : [](buffer, buffer, buffer)
  command.return
}

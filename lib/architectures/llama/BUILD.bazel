load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])
exports_files(["control_core.loom", "prepare.loom"])

# Config declarations are intentionally resolved by the final native LINK.
genrule(
    name = "prepare_library",
    srcs = ["prepare.loom", "//lib/serving:ordinary_prepare.loom"],
    outs = ["prepare_library.loombc"],
    tools = ["@hrx_system//loom/src/loom/tools/loom-link"],
    cmd = "$(location @hrx_system//loom/src/loom/tools/loom-link) --mode=merge $(SRCS) --to=bc --output=$@",
)

cc_test(
    name = "prepare_test",
    size = "small",
    srcs = ["testing/prepare_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = ["prepare.loom", ":prepare_library", "//lib/serving:ordinary_prepare.loom"],
    deps = [
        "//lib/serving/testing:ordinary_prepare_harness",
        "//lib/loomify/testing:configuration_fixture",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# One exact set drives source-form fixtures and late-configured bytecode.
_ARCHITECTURE_SOURCES = [
    "model.loom", "epoch.loom",
    "//lib/programs/llama:implementation_sources",
    "//lib/programs/ffn:interface.loom", "//lib/programs/ffn:ffn.loom",
]
_IMPLEMENTATION_SOURCES = _ARCHITECTURE_SOURCES + ["//lib/kernels/llama:configured_provider_sources"]
exports_files(["model.loom", "epoch.loom"])
filegroup(name = "architecture_sources", srcs = _ARCHITECTURE_SOURCES)
loom_merge(name = "implementation", srcs = _IMPLEMENTATION_SOURCES)
loom_merge(name = "implementation_text", srcs = _IMPLEMENTATION_SOURCES, output_format = "text", testonly = True)

loom_merge(name = "layer_fixture", srcs = [":implementation", "testing/configured_layer_roots.loom"], testonly = True)
cc_binary(
    name = "emit_layer_validation", testonly = True,
    srcs = ["testing/emit_layer_validation.cc"], cxxopts = ["-std=c++17"],
    data = [":layer_fixture", "//lib/platforms/amdgpu/gfx11:targets"],
    deps = ["//lib/loomify:configuration", "//lib/loomify:native_linking", "//tools/model:model_descriptor", "@hrx_system//loom/binding/c/target/amdgpu"],
)

loom_merge(
    name = "epoch_fixture", testonly = True,
    srcs = ["//lib/kernels/epoch:count.loom", "//lib/kernels/llama:publication/publication.loom", "testing/numerical_fixture.loom", "testing/epoch_fixture.loom"],
)
loom_test(
    name = "epoch_execution_test", srcs = ["testing/epoch_checks.loom", ":epoch_fixture"],
    benchmark_smoke = False, execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
)

cc_test(
    name = "layer_source_test", size = "small", srcs = ["testing/layer_source_test.cc"],
    copts = ["-std=c++17"], linkstatic = True,
    data = ["//lib/architectures/llama:architecture_sources"],
    deps = ["@hrx_system//loom/binding/c:loomc", "@googletest//:gtest", "@googletest//:gtest_main"],
)
cc_test(
    name = "configured_model_test", size = "large", srcs = ["testing/configured_model_test.cc"],
    copts = ["-std=c++17"], linkstatic = True,
    data = ["//lib/architectures/llama:architecture_sources", "//lib/architectures/llama:implementation", "//lib/architectures/llama:implementation_text", "//lib/platforms/amdgpu/gfx11:targets"],
    deps = ["@hrx_system//loom/src/loom/ops/buffer", "@hrx_system//loom/binding/c:interop", "@hrx_system//loom/src/loom/ops/command", "@hrx_system//loom/src/loom/ops/index", "@hrx_system//loom/src/loom/ops/scalar", "@hrx_system//loom/src/loom/ops/kernel", "//lib/loomify:configuration", "//lib/loomify:configuration_fixture", "//tools/model:model_descriptor", "@hrx_system//loom/binding/c/target/amdgpu", "@hrx_system//loom/binding/c/target/cmd", "@googletest//:gtest", "@googletest//:gtest_main"],
)

loom_merge(name = "execution", srcs = ["control_core.loom", "//loom-pipeline:llm/common/fixed_epoch_abi.loom", "//lib/serving:ordinary_control.loom"])

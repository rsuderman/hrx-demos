load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:model_assembly.bzl", "ordinary_products")
load("//lib/architectures:assemblies.bzl", "assembly")

package(default_visibility = ["//visibility:public"])

ordinary_products(assembly("llama"))

# Config declarations are intentionally resolved by the final native LINK.

cc_test(
    name = "prepare_test",
    size = "small",
    srcs = ["testing/prepare_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":ordinary_prepare_source",
        ":prepare_library",
        "//lib/serving:ordinary_prepare.loom",
    ],
    linkstatic = True,
    deps = [
        "//lib/serving/testing:ordinary_prepare_harness",
        "//lib/loomify/testing:configuration_fixture",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# One exact set drives source-form fixtures and late-configured bytecode.

exports_files([
    "model.loom",
])

loom_merge(
    name = "layer_fixture",
    testonly = True,
    srcs = [
        ":implementation",
        "testing/configured_layer_roots.loom",
    ],
)

cc_binary(
    name = "emit_layer_validation",
    testonly = True,
    srcs = ["testing/emit_layer_validation.cc"],
    cxxopts = ["-std=c++17"],
    data = [
        ":layer_fixture",
        "//lib/platforms/amdgpu/gfx11:targets",
    ],
    deps = [
        "//lib/loomify:configuration",
        "//lib/loomify:native_linking",
        "//tools/model:model_descriptor",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

loom_merge(
    name = "epoch_fixture",
    testonly = True,
    srcs = [
        "//lib/kernels/epoch:count.loom",
        "//lib/kernels/llama:publication/publication.loom",
        "testing/numerical_fixture.loom",
        "testing/epoch_fixture.loom",
    ],
)

loom_test(
    name = "epoch_execution_test",
    srcs = [
        "testing/epoch_checks.loom",
        ":epoch_fixture",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
)

cc_test(
    name = "layer_source_test",
    size = "small",
    srcs = ["testing/layer_source_test.cc"],
    copts = ["-std=c++17"],
    data = ["//lib/architectures/llama:architecture_sources"],
    linkstatic = True,
    deps = [
        "@hrx_system//loom/binding/c:loomc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "configured_model_test",
    size = "large",
    srcs = ["testing/configured_model_test.cc"],
    copts = ["-std=c++17"],
    data = [
        "//lib/architectures/llama:architecture_sources",
        "//lib/architectures/llama:implementation",
        "//lib/architectures/llama:implementation_text",
        "//lib/platforms/amdgpu/gfx11:targets",
    ],
    linkstatic = True,
    deps = [
        "@hrx_system//loom/src/loom/ops/buffer",
        "@hrx_system//loom/binding/c:interop",
        "@hrx_system//loom/src/loom/ops/command",
        "@hrx_system//loom/src/loom/ops/index",
        "@hrx_system//loom/src/loom/ops/scalar",
        "@hrx_system//loom/src/loom/ops/kernel",
        "//lib/loomify:configuration",
        "//lib/loomify:configuration_fixture",
        "//tools/model:model_descriptor",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "@hrx_system//loom/binding/c/target/cmd",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

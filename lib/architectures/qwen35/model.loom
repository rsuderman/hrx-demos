// Complete text-model sequence. Configuration owns admitted GGUF facts only.
config.decl @runner.qwen38.prefill_token_count : index
config.decl @qwen.model.base_layers : index
config.decl @qwen.model.embedding_weight_bytes : index
config.decl @qwen.model.projection_capacity_bytes : index
func.decl pure @loomify.config.layer_route(%slot: index) -> (index, index, index)
kernel.decl @qwen38_token_embedding_q6k_f16_prefill(%tokens: index) launch(%ids: buffer, %weight: buffer, %output: buffer)
command.program.decl @qwen38_gdn_layer_prefill(%tokens: index, %schedule: index, %layer: index, %ordinal: index, %verification: index, %spans: index) launch(%parameters: buffer, %residual: buffer, %state: buffer, %epoch: buffer, %capture: buffer, %rows: buffer)
command.program.decl @qwen38_attention_layer_prefill(%tokens: index, %schedule: index, %layer: index, %ordinal: index, %verification: index, %spans: index) launch(%parameters: buffer, %residual: buffer, %state: buffer, %epoch: buffer, %attended: buffer, %rows: buffer)
command.program.decl @qwen08_epoch_head(%tokens: index, %outputs: index) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %output: buffer)

command.program.def public @generated.qwen_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %resident_arena: buffer, %input: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  %embedding_bytes = config.get @qwen.model.embedding_weight_bytes : index
  %embedding = command.parameter %parameters, "token_embd.weight" : view<[%embedding_bytes]xi8>
  kernel.launch @qwen38_token_embedding_q6k_f16_prefill[%tokens](%input, %embedding, %residual) : [index](buffer, view<[%embedding_bytes]xi8>, buffer)
  // Each complete layer finishes before the next one reuses this scratch.
  %capture_bytes = index.constant 256 : offset
  %capture = buffer.alloca<global> align(256) %capture_bytes : buffer
  %projection_capacity = config.get @qwen.model.projection_capacity_bytes : index
  %attended_bytes = index.cast %projection_capacity : index to offset
  %attended = buffer.alloca<global> align(256) %attended_bytes : buffer
  %layers = config.get @qwen.model.base_layers : index
  scf.for %slot = [%zero to %layers step %one] unroll {
    %kind, %original, %ordinal = func.call pure @loomify.config.layer_route(%slot) : (index) -> (index, index, index)
    %attention = index.cmp eq, %kind, %zero : index
    scf.if %attention {
      command.program.launch @qwen38_attention_layer_prefill[%tokens, %tokens, %original, %ordinal, %zero, %one](%parameters, %residual, %resident_arena, %epoch, %attended, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      command.program.launch @qwen38_gdn_layer_prefill[%tokens, %tokens, %original, %ordinal, %zero, %one](%parameters, %residual, %resident_arena, %epoch, %capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    }
  }
  command.program.launch @qwen08_epoch_head[%tokens, %one](%parameters, %residual, %epoch, %output) : [index, index](buffer, buffer, buffer, buffer)
  command.return
}

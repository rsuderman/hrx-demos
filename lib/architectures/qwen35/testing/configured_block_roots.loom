// True ordinals select both projection metadata and persistent layer slots.
// Raw-buffer callers allocate guarded state through each selected ordinal.
command.def public @validated.qwen.gdn4() launch(%parameters: buffer, %residual: buffer, %state: buffer, %control: buffer, %capture: buffer, %rows: buffer) {
  %t = index.constant 1 : index

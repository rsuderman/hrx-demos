command.def public @validated.qwen.gdn0() launch(%parameters: buffer, %residual: buffer, %state: buffer, %control: buffer, %capture: buffer, %rows: buffer) {
  %one = index.constant 1 : index
  %zero = index.constant 0 : index
  %layer = index.constant 0 : index
  command.launch @qwen38_gdn_layer_prefill[%one, %one, %layer, %zero, %zero, %one](%parameters, %residual, %state, %control, %capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}


  command.launch @qwen38_gdn_layer_prefill[%t, %t, %layer, %ordinal, %zero, %one](%parameters, %residual, %state, %control, %capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}


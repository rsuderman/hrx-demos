// Legal static-T3 work with runtime N supplied by the epoch. Numerical bodies
// remain in the same complete maintained GDN block, including its FFN.
command.program.def public @validated.qwen.gdn0_t3() launch(%parameters:buffer,%residual:buffer,%state:buffer,%control:buffer,%capture:buffer,%rows:buffer) {
  %three = index.constant 3 : index
  %one = index.constant 1 : index
  %zero = index.constant 0 : index
  command.program.launch @qwen38_gdn_layer_prefill[%three,%three,%zero,%zero,%zero,%one](%parameters,%residual,%state,%control,%capture,%rows) : [index,index,index,index,index,index](buffer,buffer,buffer,buffer,buffer,buffer)
  command.return
}

// Same full attention operation at static T3; actual N remains in the epoch.
command.program.def public @validated.qwen.attention3_t3() launch(%parameters:buffer,%residual:buffer,%state:buffer,%control:buffer,%capture:buffer,%rows:buffer) {
  %three = index.constant 3 : index
  %one = index.constant 1 : index
  %zero = index.constant 0 : index
  command.program.launch @qwen38_attention_layer_prefill[%three,%three,%three,%zero,%zero,%one](%parameters,%residual,%state,%control,%capture,%rows) : [index,index,index,index,index,index](buffer,buffer,buffer,buffer,buffer,buffer)

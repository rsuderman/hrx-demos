cc_binary(
    name = "emit_alternating_config",
    testonly = True,
    srcs = ["emit_alternating_config.cc"],
    copts = ["-std=c++17"],
    deps = [
        "//lib/loomify:configuration",
        "//lib/loomify:native_linking",
        "//lib/loomify:configuration_fixture",
        "//tools/model:model_descriptor",
    ],
)

genrule(
    name = "alternating_config",
    testonly = True,
    outs = ["alternating_config.loom"],
    cmd = "$(location :emit_alternating_config) $@",
    tools = [":emit_alternating_config"],
)

loom_merge(
    name = "alternating_state_text",

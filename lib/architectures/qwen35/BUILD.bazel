load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
package(default_visibility = ["//visibility:public"])
exports_files(["control.loom", "model.loom", "prepare.loom"])

# One complete numerical closure. Common/FFN members are owned by their BUILD
# filegroup; complete layers retain their internal FFNs and numerical policy.
filegroup(
    name = "numerical_sources",
    srcs = [
        "//lib/kernels/qwen:configured_provider_sources",
        "//lib/kernels/qwen/gdn:interface.loom",
        "//lib/kernels/qwen/gdn:layer.loom",
        "//lib/kernels/qwen/gdn:common.loom",
        "//lib/kernels/qwen/gdn:prefill.loom",
        "//lib/kernels/qwen/gdn:spans.loom",
        "//lib/kernels/qwen/gdn:clear.loom",
        "//lib/kernels/qwen/attention:layer_interface.loom",
        "//lib/kernels/qwen/attention:layer.loom",
        "//lib/kernels/qwen/attention:clear.loom",
        "//lib/kernels/qwen/attention:attention_common.loom",
        "//lib/kernels/qwen/attention:attention_prefill.loom",
        "//lib/kernels/qwen/attention:attention_prefill_wmma.loom",
        "//lib/kernels/qwen/attention:attention_spans.loom",
        "//lib/kernels/attention:core.loom",
        "//lib/kernels/qwen:output/interface.loom",
        "//lib/kernels/qwen:output/embedding.loom",
        "//lib/kernels/qwen:output/head.loom",
        "//lib/kernels/qwen:output/publication.loom",
        "//lib/kernels/embedding:q6k_rows.loom",
        "//lib/kernels/selection:greedy_argmax.loom",
    ],
)
filegroup(name = "implementation_sources", srcs = ["model.loom", ":numerical_sources"])
loom_merge(name = "implementation", srcs = [":implementation_sources"])
loom_merge(name = "implementation_text", srcs = [":implementation_sources"], output_format = "text", testonly = True)

loom_merge(name = "prepare_library", srcs = ["prepare.loom"])
cc_test(
    name = "prepare_test",
    size = "small",
    srcs = ["//lib/architectures/qwen35/testing:prepare_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = ["prepare.loom", ":prepare_library"],
    deps = [
        "//tools/loomify-gguf:configuration",
        "//tools/loomify-gguf:configuration_fixture",
        "//tools/loomify-gguf/testing:prepare_vm",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/vm",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

// Direct request boundary: the model computes private IDs, then publication
// writes only the selected public slot. Numerical orchestration stays private.
config.decl @runner.qwen38.prefill_token_count : index

command.decl @loomify.qwen.model(%tokens: index) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %selected_ids: buffer)

kernel.decl @qwen08_publish_selected_ids(%output_capacity: index) launch(%epoch: buffer, %private_ids: buffer, %output: buffer)

command.def public @generated.qwen_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %output_ids: buffer) {
  %id_bytes = index.constant 4 : offset
  %selected_ids = buffer.alloca<global> align(256) %id_bytes : buffer
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  command.launch @loomify.qwen.model[%tokens](%parameters, %residual, %epoch, %rows, %state, %input_ids, %selected_ids) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %one = index.constant 1 : index
  kernel.launch @qwen08_publish_selected_ids[%one](%epoch, %selected_ids, %output_ids) : [index](buffer, buffer, buffer)
  command.return
}

// Complete one-token epoch. Physical buffers and persistent state are identical
// to the normal root; only consumed row0 is produced. Unconsumed scratch suffixes
// are private staging and may retain prior bytes.
command.def public @generated.qwen_decode_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %output_ids: buffer) {
  %id_bytes = index.constant 4 : offset
  %selected_ids = buffer.alloca<global> align(256) %id_bytes : buffer
  %one = index.constant 1 : index
  command.launch @loomify.qwen.model[%one](%parameters, %residual, %epoch, %rows, %state, %input_ids, %selected_ids) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen08_publish_selected_ids[%one](%epoch, %selected_ids, %output_ids) : [index](buffer, buffer, buffer)
  command.return
}

// Only architecture root/diagnostic hooks; cold records remain shared.
global.rodata.def @lfm3_epoch_root = bytes("67656e6572617465642e6c666d335f65706f6368")
global.rodata.def @lfm3_unsupported = bytes("4c464d33207265717569726573206f7264696e6172792067726565647920737461676573")
func.def public inline @ordinary.epoch_root() -> (buffer) {
  %value = global.load @lfm3_epoch_root : buffer
  func.return %value : buffer
}
func.def public inline @ordinary.unsupported() -> (buffer) {
  %value = global.load @lfm3_unsupported : buffer
  func.return %value : buffer
}

config.decl @runner.qwen3.prefill_token_count : index

config.decl @qwen3.model.hidden_size : index

config.decl @qwen3.model.rms_epsilon : f32

kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

kernel.decl @llm.decoder.rmsnorm_active(%rows$7: index, %width$8: index) launch(%rows$9: index, %width$10: index, %epsilon: f32, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)

command.decl @loomify.qwen3.layer(%layer: index, %phase: index, %rows: index, %origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer)

command.decl @loomify.qwen3.attention(%layer: index, %phase: index, %rows: index, %origin: offset) launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %epoch: buffer, %map: buffer, %cache: buffer)

command.decl @loomify.qwen3.ffn(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer)

command.def public @validated.qwen3.layer0() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.qwen3.prefill_token_count : index
  %origin = index.constant 12 : offset
  %bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %origin, %epoch, %count) : (index, offset, buffer, buffer)
  command.launch @loomify.qwen3.layer[%layer, %phase, %rows, %origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @validated.qwen3.ffn0() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.qwen3.prefill_token_count : index
  %origin = index.constant 12 : offset
  %bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %origin, %epoch, %count) : (index, offset, buffer, buffer)
  command.launch @loomify.qwen3.ffn[%layer, %phase, %rows](%parameters, %residual, %count) : [index, index, index](buffer, buffer, buffer)
  command.return
}

command.def public @validated.qwen3.attention0() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.qwen3.prefill_token_count : index
  %hidden = config.get @qwen3.model.hidden_size : index
  %epsilon = config.get @qwen3.model.rms_epsilon : f32
  %gamma = command.parameter %parameters, "blk.0.attn_norm.weight" : view<[%hidden]xf32>
  %origin = index.constant 12 : offset
  %bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %origin, %epoch, %count) : (index, offset, buffer, buffer)
  %word = index.constant 4 : offset
  %elements = index.mul %rows, %hidden : index
  %normalized_bytes = index.scale %elements, %word : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %normalized_bytes : buffer
  kernel.launch @llm.decoder.rmsnorm_active[%rows, %hidden](%rows, %hidden, %epsilon, %count, %residual, %gamma, %normalized) : [index, index](index, index, f32, buffer, buffer, view<[%hidden]xf32>, buffer)
  command.launch @loomify.qwen3.attention[%layer, %phase, %rows, %origin](%parameters, %normalized, %residual, %count, %epoch, %map, %cache) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

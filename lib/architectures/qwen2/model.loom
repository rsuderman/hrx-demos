// Architecture order lives here; generated configuration contains facts only.
config.decl @runner.qwen2.prefill_token_count : index

config.decl @qwen2.model.hidden_size : index

config.decl @qwen2.model.vocabulary_size : index

config.decl @qwen2.model.layer_count : index

config.decl @qwen2.model.embedding_weight_bytes : index

config.decl @qwen2.model.embedding_tag : index

config.decl @qwen2.model.output_weight_bytes : index

command.decl @loomify.qwen2.layer(%layer: index, %phase: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer)

kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

template.decl @llm.embedding.ordinary_f32(%rows: index, %hidden: index, %vocabulary: index, %tag: index, %weight_bytes: index, %control_origin: offset, %epoch: buffer, %count: buffer, %ids: buffer, %weight: view<[%weight_bytes]xi8>, %output: view<[%rows]x[%hidden]xf32>)

template.decl @llm.output.last_greedy(%capacity: index, %begin: index, %origin: offset, %hidden: index, %vocab: index, %weight_bytes: index, %policy: index, %weight_tag: index, %input: buffer, %control: buffer, %gamma: view<[%hidden]xf32>, %weight: view<[%weight_bytes]xi8>, %token: buffer)

command.def @loomify.qwen2.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %selected_ids: buffer) {
  %phase = index.constant 0 : index
  %rows = config.get @runner.qwen2.prefill_token_count : index
  %descriptor_origin = index.constant 12 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero_offset = index.constant 0 : offset
  %count_bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %descriptor_origin, %epoch, %count) : (index, offset, buffer, buffer)
  %embedding_bytes = config.get @qwen2.model.embedding_weight_bytes : index
  %embedding = command.parameter %parameters, "token_embd.weight" : view<[%embedding_bytes]xi8>
  %embedding_width = config.get @qwen2.model.hidden_size : index
  %embedding_vocab = config.get @qwen2.model.vocabulary_size : index
  %embedding_tag = config.get @qwen2.model.embedding_tag : index
  %embedding_output = buffer.view %residual[%zero_offset] : buffer -> view<[%rows]x[%embedding_width]xf32>
  template.apply<@llm.embedding.ordinary_f32>(%rows, %embedding_width, %embedding_vocab, %embedding_tag, %embedding_bytes, %descriptor_origin, %epoch, %count, %input_ids, %embedding, %embedding_output) : (index, index, index, index, index, offset, buffer, buffer, buffer, view<[%embedding_bytes]xi8>, view<[%rows]x[%embedding_width]xf32>)
  %layers = config.get @qwen2.model.layer_count : index
  scf.for %layer = [%zero to %layers step %one] unroll {
    command.launch @loomify.qwen2.layer[%layer, %phase, %rows, %descriptor_origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  %hidden = config.get @qwen2.model.hidden_size : index
  %vocab = config.get @qwen2.model.vocabulary_size : index
  %output_bytes = config.get @qwen2.model.output_weight_bytes : index
  %gamma = command.parameter %parameters, "output_norm.weight" : view<[%hidden]xf32>
  %weight = command.parameter %parameters, "token_embd.weight" : view<[%output_bytes]xi8>
  %head_policy = index.constant 0 : index
  %head_tag = index.constant 14 : index
  template.apply<@llm.output.last_greedy>(%rows, %zero, %zero_offset, %hidden, %vocab, %output_bytes, %head_policy, %head_tag, %residual, %count, %gamma, %weight, %selected_ids) : (index, index, offset, index, index, index, index, index, buffer, buffer, view<[%hidden]xf32>, view<[%output_bytes]xi8>, buffer)
  command.return
}

load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
package(default_visibility = ["//visibility:public"])
exports_files(["model.loom", "epoch.loom", "prepare.loom", "control_core.loom"])
_ARCHITECTURE_SOURCES = [
    "model.loom", "epoch.loom",
    "//lib/programs/qwen2:implementation_sources",
]
_IMPLEMENTATION_SOURCES = _ARCHITECTURE_SOURCES + [
    "//lib/kernels/decoder:implementation_sources",
    "//lib/programs/projection:matrix_sources",
    "//lib/kernels/selection:greedy_argmax.loom",
    "//lib/kernels/epoch:count.loom",
    "//lib/kernels/publication:two_stops.loom",
]
filegroup(name = "architecture_sources", srcs = _ARCHITECTURE_SOURCES)
loom_merge(name = "implementation", srcs = _IMPLEMENTATION_SOURCES)
loom_merge(name = "implementation_text", srcs = _IMPLEMENTATION_SOURCES,
           output_format = "text", testonly = True)
loom_merge(name = "prepare_library", srcs = ["prepare.loom", "//lib/serving:ordinary_prepare.loom"])

cc_test(
    name = "prepare_test",
    size = "small",
    srcs = ["testing/prepare_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    data = ["prepare.loom", ":prepare_library", "//lib/serving:ordinary_prepare.loom"],
    deps = [
        "//lib/serving/testing:ordinary_prepare_harness",
        "//lib/loomify/testing:qwen2_fixture",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
loom_merge(name = "execution", srcs = ["control_core.loom", "//loom-pipeline:llm/common/fixed_epoch_abi.loom", "//lib/serving:ordinary_control.loom", "//lib/kernels/publication:two_stops.loom"])

loom_merge(name = "layer_fixture", srcs = [":implementation", "testing/layer_roots.loom"], testonly = True)
cc_binary(
    name = "emit_layer_validation", testonly = True,
    srcs = ["testing/emit_layer_validation.cc"], cxxopts = ["-std=c++17"],
    data = [":layer_fixture", "//lib/platforms/amdgpu/gfx11:targets", "//lib/platforms/amdgpu/gfx11/projection:implementation"],
    deps = ["//lib/loomify:configuration", "//lib/loomify:native_linking", "//tools/model:model_descriptor", "@hrx_system//loom/binding/c/target/amdgpu"],
)

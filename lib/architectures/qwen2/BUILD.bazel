load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:model_assembly.bzl", "ordinary_products")
load("//lib/architectures:assemblies.bzl", "assembly")

package(default_visibility = ["//visibility:public"])

ordinary_products(assembly("qwen2"))

exports_files([
    "model.loom",
])

cc_test(
    name = "prepare_test",
    size = "small",
    srcs = ["testing/prepare_test.cc"],
    copts = ["-std=c++17"],
    data = [
        ":ordinary_prepare_source",
        ":prepare_library",
        "//lib/serving:ordinary_prepare.loom",
    ],
    linkstatic = True,
    deps = [
        "//lib/serving/testing:ordinary_prepare_harness",
        "//lib/loomify/testing:qwen2_fixture",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

loom_merge(
    name = "layer_fixture",
    testonly = True,
    srcs = [
        ":implementation",
        "testing/layer_roots.loom",
    ],
)

cc_binary(
    name = "emit_layer_validation",
    testonly = True,
    srcs = ["testing/emit_layer_validation.cc"],
    cxxopts = ["-std=c++17"],
    data = [
        ":layer_fixture",
        "//lib/platforms/amdgpu/gfx11:targets",
        "//lib/platforms/amdgpu/gfx11/projection:implementation",
    ],
    deps = [
        "//lib/loomify:configuration",
        "//lib/loomify:native_linking",
        "//tools/model:model_descriptor",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

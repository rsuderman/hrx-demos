// Architecture order lives here; generated configuration contains facts only.
config.decl @runner.lfm2.prefill_token_count : index

config.decl @lfm2.model.hidden_size : index

config.decl @lfm2.model.vocabulary_size : index

config.decl @lfm2.model.layer_count : index

config.decl @lfm2.model.embedding_weight_bytes : index

config.decl @lfm2.model.embedding_tag : index

command.decl @loomify.lfm2.layer(%layer: index, %rows: index, %control_origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer)

kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

template.decl @llm.embedding.ordinary_f32(%rows: index, %hidden: index, %vocabulary: index, %tag: index, %weight_bytes: index, %control_origin: offset, %epoch: buffer, %count: buffer, %ids: buffer, %weight: view<[%weight_bytes]xi8>, %output: view<[%rows]x[%hidden]xf32>)

command.decl @loomify.lfm2.head(%rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer, %selected_ids: buffer)

kernel.decl @loomify.lfm2.validate_chunk(%rows$35: index, %capacity$36: index) launch(%rows$37: index, %capacity$38: index, %origin: offset, %count: buffer, %epoch: buffer, %checked_count: buffer, %checked_epoch: buffer)

config.decl @lfm2.attention.cache_capacity : index

command.def @loomify.lfm2.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %selected_ids: buffer) {
  %phase = index.constant 0 : index
  %rows = config.get @runner.lfm2.prefill_token_count : index
  %descriptor_origin = index.constant 12 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero_offset = index.constant 0 : offset
  %count_bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %descriptor_origin, %epoch, %count) : (index, offset, buffer, buffer)
  %capacity = config.get @lfm2.attention.cache_capacity : index
  %count_size = index.constant 12 : offset
  %packet_size = index.constant 20 : offset
  %epoch_bytes = index.add %descriptor_origin, %packet_size : offset
  %checked_count = buffer.alloca<global> align(256) %count_size : buffer
  %checked_epoch = buffer.alloca<global> align(256) %epoch_bytes : buffer
  kernel.launch @loomify.lfm2.validate_chunk[%rows, %capacity](%rows, %capacity, %descriptor_origin, %count, %epoch, %checked_count, %checked_epoch) : [index, index](index, index, offset, buffer, buffer, buffer, buffer)
  %embedding_bytes = config.get @lfm2.model.embedding_weight_bytes : index
  %embedding = command.parameter %parameters, "token_embd.weight" : view<[%embedding_bytes]xi8>
  %embedding_width = config.get @lfm2.model.hidden_size : index
  %embedding_vocab = config.get @lfm2.model.vocabulary_size : index
  %embedding_tag = config.get @lfm2.model.embedding_tag : index
  %embedding_output = buffer.view %residual[%zero_offset] : buffer -> view<[%rows]x[%embedding_width]xf32>
  template.apply<@llm.embedding.ordinary_f32>(%rows, %embedding_width, %embedding_vocab, %embedding_tag, %embedding_bytes, %descriptor_origin, %checked_epoch, %checked_count, %input_ids, %embedding, %embedding_output) : (index, index, index, index, index, offset, buffer, buffer, buffer, view<[%embedding_bytes]xi8>, view<[%rows]x[%embedding_width]xf32>)
  %layers = config.get @lfm2.model.layer_count : index
  scf.for %layer = [%zero to %layers step %one] unroll {
    command.launch @loomify.lfm2.layer[%layer, %rows, %descriptor_origin](%parameters, %residual, %checked_epoch, %map, %cache, %checked_count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  command.launch @loomify.lfm2.head[%rows](%parameters, %residual, %checked_count, %selected_ids) : [index](buffer, buffer, buffer, buffer)
  command.return
}

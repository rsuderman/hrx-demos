command.def public @validated.lfm2.conv_attention_conv() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer) {
  %first = index.constant 1 : index
  %attention = index.constant 2 : index
  %last = index.constant 3 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.lfm2.prefill_token_count : index
  %origin = index.constant 12 : offset
  %bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %origin, %epoch, %count) : (index, offset, buffer, buffer)
  command.launch @loomify.lfm2.layer[%first, %rows, %origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @loomify.lfm2.layer[%attention, %rows, %origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @loomify.lfm2.layer[%last, %rows, %origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.decl @loomify.lfm2.head(%rows: index) launch(%parameters: buffer, %residual: buffer, %count: buffer, %selected_ids: buffer)

command.def public @validated.lfm2.head() launch(%parameters: buffer, %residual: buffer, %count: buffer, %selected_ids: buffer) {
  %rows = config.get @runner.lfm2.prefill_token_count : index
  command.launch @loomify.lfm2.head[%rows](%parameters, %residual, %count, %selected_ids) : [index](buffer, buffer, buffer, buffer)
  command.return
}

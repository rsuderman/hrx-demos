config.decl @runner.lfm2.prefill_token_count : index

kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

command.decl @loomify.lfm2.layer(%layer: index, %rows: index, %origin: offset) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %count: buffer)

command.def public @validated.lfm2.layer0() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.lfm2.prefill_token_count : index
  %origin = index.constant 12 : offset
  %bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %origin, %epoch, %count) : (index, offset, buffer, buffer)
  command.launch @loomify.lfm2.layer[%layer, %rows, %origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @validated.lfm2.layer1() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer) {
  %layer = index.constant 1 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.lfm2.prefill_token_count : index
  %origin = index.constant 12 : offset
  %bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %origin, %epoch, %count) : (index, offset, buffer, buffer)
  command.launch @loomify.lfm2.layer[%layer, %rows, %origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}


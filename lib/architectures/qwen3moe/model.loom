// Public family entry; qwen3.* remains the shared backbone configuration ABI.
command.decl @loomify.qwen3.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %selected_ids: buffer)

command.def @loomify.qwen3moe.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %selected_ids: buffer) {
  command.launch @loomify.qwen3.model(%parameters, %residual, %epoch, %map, %cache, %input_ids, %selected_ids) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

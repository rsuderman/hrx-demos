// Public request boundary; numerical computation writes private selected IDs.
command.decl @loomify.gemma3.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %selected_ids: buffer)
kernel.decl @gemma3_publish_epoch_id() launch(%epoch: buffer, %selected_ids: buffer, %output_ids: buffer)
command.def public @generated.gemma3_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_ids: buffer, %output_ids: buffer) {
  %selected_bytes = index.constant 16 : offset
  %selected_ids = buffer.alloca<global> align(256) %selected_bytes : buffer
  command.launch @loomify.gemma3.model[](%parameters, %residual, %epoch, %rows, %state, %input_ids, %selected_ids) : [](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @gemma3_publish_epoch_id[](%epoch, %selected_ids, %output_ids) : [](buffer, buffer, buffer)
  command.return
}

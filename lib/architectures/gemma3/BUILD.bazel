load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

exports_files([
    "model.loom",
    "epoch.loom",
    "prepare.loom",
    "control_core.loom",
])

_ARCHITECTURE_SOURCES = [
    "model.loom",
    "epoch.loom",
    "//lib/programs/gemma3:implementation_sources",
]

_IMPLEMENTATION_SOURCES = _ARCHITECTURE_SOURCES + ["//lib/kernels/gemma3:implementation_sources"]

filegroup(
    name = "architecture_sources",
    srcs = _ARCHITECTURE_SOURCES,
)

loom_merge(
    name = "implementation",
    srcs = _IMPLEMENTATION_SOURCES,
)

loom_merge(
    name = "implementation_text",
    testonly = True,
    srcs = _IMPLEMENTATION_SOURCES,
    output_format = "text",
)

loom_merge(
    name = "prepare_library",
    srcs = [
        "prepare.loom",
        "//lib/serving:ordinary_prepare.loom",
    ],
)

cc_test(
    name = "prepare_test",
    size = "small",
    srcs = ["testing/prepare_test.cc"],
    copts = ["-std=c++17"],
    data = [
        "prepare.loom",
        ":prepare_library",
        "//lib/serving:ordinary_prepare.loom",
    ],
    linkstatic = True,
    deps = [
        "//lib/serving/testing:ordinary_prepare_harness",
        "//lib/loomify/testing:gemma3_fixture",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

loom_merge(
    name = "execution",
    srcs = [
        "control_core.loom",
        "//loom-pipeline:llm/common/fixed_epoch_abi.loom",
        "//lib/serving:ordinary_control.loom",
        "//lib/kernels/publication:two_stops.loom",
    ],
)

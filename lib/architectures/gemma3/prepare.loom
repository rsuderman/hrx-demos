// Architecture facts for shared ordinary preparation.
global.rodata.def @epoch_root = bytes("67656e6572617465642e67656d6d61335f65706f6368")
global.rodata.def @unsupported = bytes("47656d6d6133207265717569726573206f7264696e617279206772656564792073746167657320616e64206d61746368696e672067656e6572617465642063617061636974696573")
func.def public inline @ordinary.epoch_root() -> (buffer) {
  %value = global.load @epoch_root : buffer
  func.return %value : buffer
}
func.def public inline @ordinary.unsupported() -> (buffer) {
  %value = global.load @unsupported : buffer
  func.return %value : buffer
}

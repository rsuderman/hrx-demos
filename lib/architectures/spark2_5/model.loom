command.def @loomify.spark2_5.model() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %selected_ids: buffer) {
  %phase = index.constant 0 : index
  %rows = config.get @runner.spark2_5.prefill_token_count : index
  %descriptor_origin = index.constant 12 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero_offset = index.constant 0 : offset
  %word = index.constant 4 : offset
  %count_bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  kernel.launch @llm.epoch.snapshot_count(%phase, %descriptor_origin, %epoch, %count) : (index, offset, buffer, buffer)
  %embedding_bytes = config.get @spark2_5.model.embedding_weight_bytes : index
  %embedding = command.parameter %parameters, "token_embd.weight" : view<[%embedding_bytes]xi8>
  %embedding_width = config.get @spark2_5.model.hidden_size : index
  %embedding_vocab = config.get @spark2_5.model.vocabulary_size : index
  kernel.launch @llm.decoder.embedding_q6[%rows, %embedding_width, %embedding_vocab](%embedding_width, %embedding_vocab, %descriptor_origin, %epoch, %count, %input_ids, %embedding, %residual) : [index, index, index](index, index, offset, buffer, buffer, buffer, view<[%embedding_bytes]xi8>, buffer)
  %layers = config.get @spark2_5.model.layer_count : index
  scf.for %layer = [%zero to %layers step %one] unroll {
    command.launch @loomify.spark2_5.layer[%layer, %rows, %descriptor_origin](%parameters, %residual, %epoch, %map, %cache, %count) : [index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  %hidden = config.get @spark2_5.model.hidden_size : index
  %vocab = config.get @spark2_5.model.vocabulary_size : index
  %output_bytes = config.get @spark2_5.model.output_weight_bytes : index
  %gamma = command.parameter %parameters, "output_norm.weight" : view<[%hidden]xf32>
  %tie = config.get @spark2_5.model.tied_output : index
  %tied = index.cmp ne, %tie, %zero : index
  %weight = scf.if %tied -> (view<[%output_bytes]xi8>) {
    %shared = command.parameter %parameters, "token_embd.weight" : view<[%output_bytes]xi8>
    scf.yield %shared : view<[%output_bytes]xi8>
  } else {
    %separate = command.parameter %parameters, "output.weight" : view<[%output_bytes]xi8>
    scf.yield %separate : view<[%output_bytes]xi8>
  }
  %policy = index.constant 1 : index
  %output_tag = config.get @spark2_5.model.output_tag : index
  %normalized_bytes = index.scale %hidden, %word : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %normalized_bytes : buffer
  %group = index.constant 128 : index
  %packed_group_bytes = index.constant 144 : offset
  %groups = index.div %hidden, %group : index
  %q8_bytes = index.scale %groups, %packed_group_bytes : index, offset -> offset
  %logit_bytes = index.scale %vocab, %word : index, offset -> offset
  %tile = index.constant 4096 : index
  %tile_minus_one = index.constant 4095 : index
  %rounded = index.add %vocab, %tile_minus_one : index
  %parts = index.div %rounded, %tile : index
  %partial_bytes = index.scale %parts, %word : index, offset -> offset
  template.apply<@llm.output.last_greedy>(%rows, %zero, %zero_offset, %hidden, %vocab, %output_bytes, %policy, %output_tag, %q8_bytes, %logit_bytes, %partial_bytes, %residual, %count, %gamma, %weight, %normalized, %selected_ids) : (index, index, offset, index, index, index, index, index, offset, offset, offset, buffer, buffer, view<[%hidden]xf32>, view<[%output_bytes]xi8>, buffer, buffer)
  command.return
}

// Synthetic Q6 rows: only token3 is initialized to -1; token0 stays different.
func.def @decoder.fixture.embedding_inputs(%epoch: buffer, %tokens: buffer, %weight: buffer) {
  %origin = index.constant 0 : offset
  %control_origin = index.constant 12 : offset
  %weight_origin = index.constant 2520 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %bytes = index.constant 840 : index
  %block = index.constant 210 : index
  %scale_begin = index.constant 192 : index
  %scale_end = index.constant 208 : index
  %high_d = index.constant 209 : index
  %zero8 = scalar.constant 0 : i8
  %one8 = scalar.constant 1 : i8
  %d8 = scalar.constant 40 : i8
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %three32 = scalar.constant 3 : i32
  %descriptor = buffer.view %epoch[%control_origin] : buffer -> view<5xi32>
  view.store %one32, %descriptor[0] : i32, view<5xi32>
  view.store %zero32, %descriptor[1] : i32, view<5xi32>
  view.store %one32, %descriptor[2] : i32, view<5xi32>
  view.store %zero32, %descriptor[3] : i32, view<5xi32>
  view.store %zero32, %descriptor[4] : i32, view<5xi32>
  %ids = buffer.view %tokens[%origin] : buffer -> view<3xi32>
  view.store %three32, %ids[1] : i32, view<3xi32>
  %row = buffer.view %weight[%weight_origin] : buffer -> view<840xi8>
  scf.for %byte = [%zero to %bytes step %one] {
    %within = index.rem %byte, %block : index
    %above = index.cmp uge, %within, %scale_begin : index
    %below = index.cmp ult, %within, %scale_end : index
    %scale = scalar.andi %above, %below : i1
    %d = index.cmp eq, %within, %high_d : index
    %v0 = scf.select %scale, %one8, %zero8 : i8
    %v = scf.select %d, %d8, %v0 : i8
    view.store %v, %row[%byte] : i8, view<840xi8>
  }
  func.return
}

kernel.def @decoder.fixture.embedding_init() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %tokens: buffer, %weight: buffer) {
  func.call @decoder.fixture.embedding_inputs(%epoch, %tokens, %weight) : (buffer, buffer, buffer)
  kernel.return
}

template.decl @llm.embedding.ordinary_f32(%rows: index, %hidden: index, %vocab: index, %tag: index, %bytes: index, %origin: offset, %epoch: buffer, %count: buffer, %tokens: buffer, %weight: view<[%bytes]xi8>, %output: view<[%rows]x[%hidden]xf32>)

command.def @decoder.actual.embedding() launch(%epoch: buffer, %count: buffer, %tokens: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 3 : index

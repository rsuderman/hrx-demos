  template.apply<@llm.embedding.ordinary_f32>(%rows, %width, %vocab, %tag, %bytes, %origin, %epoch, %count, %tokens, %w, %out) : (index, index, index, index, index, offset, buffer, buffer, buffer, view<[%bytes]xi8>, view<[%rows]x[%width]xf32>)

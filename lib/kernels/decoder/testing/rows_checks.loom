func.def @decoder.expected.poison(%input: buffer) {
  %origin = index.constant 8192 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %width = index.constant 1024 : index
  %bits = scalar.constant 2143289344 : i32
  %nan = scalar.bitcast %bits : i32 to f32
  %view = buffer.view %input[%origin] : buffer -> view<1024xf32>
  scf.for %i = [%zero to %width step %one] {
    view.store %nan, %view[%i] : f32, view<1024xf32>
  }
  func.return
}


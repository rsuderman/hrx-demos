load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "reference_data",
    srcs = ["reference.py"],
    outs = ["reference_data.loom"],
    cmd = "python3 $(location reference.py) $@",
)

[loom_merge(
    name = "rows_provider_" + format,
    testonly = True,
    srcs = [
        "rows_programs.loom",
        ":reference_data",
        "//lib/kernels/decoder:implementation_sources",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "rows_" + format + "_test",
    srcs = [
        "rows_checks.loom",
        ":rows_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]


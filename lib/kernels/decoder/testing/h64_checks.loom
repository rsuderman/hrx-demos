func.decl @decoder.h64.fixture.descriptor_values(%base: index, %epoch: buffer, %map: buffer)

func.decl @decoder.h64.fixture.history_element(%head: index, %physical: index, %lane: index, %cache: buffer)

global.rodata.decl @decoder.h64.attention.oracle.k.expected.63

global.rodata.decl @decoder.h64.attention.oracle.attention.expected

func.def @decoder.h64.expected.poison_attention(%width: index, %input: buffer) {
  %word = index.constant 4 : offset
  %two = index.constant 2 : index
  %row_bytes = index.scale %width, %word : index, offset -> offset
  %origin = index.scale %two, %row_bytes : index, offset -> offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %bits = scalar.constant 2143289344 : i32
  %nan = scalar.bitcast %bits : i32 to f32
  %view = buffer.view %input[%origin] : buffer -> view<[%width]xf32>
  scf.for %i = [%zero to %width step %one] {
    view.store %nan, %view[%i] : f32, view<[%width]xf32>
  }
  func.return
}


// Retained afn trig uses F32 turn reduction. At angle1024 its
// phase error can exceed4e-5; the fixture maximum amplitude times the
// F32 turn-reduction bound is2.23e-4. Keep the F64 oracle and bound
// this high-position case separately; positions0/63 retain tight checks.
check.scenario @decoder.h64.qk.position1023 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(99) : tensor<12xi32>
    %map = check.generate.fill value(99) : tensor<6xi32>
    %input = check.generate.iota offset(-0.5) step(0.000244140625) : tensor<3x2048xf32>
    %gamma = check.generate.iota offset(0.875) step(0.001953125) : tensor<64xf32>
    %storage = check.generate.fill value(123.5) : tensor<6152xf32>
    %out = check.tensor.view %storage offset(16) : tensor<6152xf32> -> tensor<3x2048xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<6152xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(24592) : tensor<6152xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %out offset(16384) : tensor<3x2048xf32> -> tensor<2048xf32>
    check.compare<@decoder.h64.actual.qk1023, @decoder.h64.expected.qk1023>(%epoch, %map, %input, %gamma, %out) : (tensor<12xi32>, tensor<6xi32>, tensor<3x2048xf32>, tensor<64xf32>, tensor<3x2048xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(0.00025000000000000001) rtol(0.0001) nan(same) : tensor<6152xf32>, tensor<6152xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<2048xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<12xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<6xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<3x2048xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<64xf32>
    }
  }
  check.return
}

command.decl @decoder.h64.actual.attention() launch(%epoch: buffer, %map: buffer, %query: buffer, %key: buffer, %value: buffer, %gamma: buffer, %cache: buffer, %output: buffer)

func.def @decoder.h64.expected.attention(%epoch: buffer, %map: buffer, %query: buffer, %key: buffer, %value: buffer, %gamma: buffer, %cache: buffer, %output: buffer) {
  %qw = index.constant 2048 : index
  %kw = index.constant 512 : index
  %base = index.constant 63 : index
  func.call @decoder.h64.expected.poison_attention(%qw, %query) : (index, buffer)
  func.call @decoder.h64.expected.poison_attention(%kw, %key) : (index, buffer)
  func.call @decoder.h64.expected.poison_attention(%kw, %value) : (index, buffer)
  func.call @decoder.h64.fixture.descriptor_values(%base, %epoch, %map) : (index, buffer, buffer)
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %heads = index.constant 8 : index
  %h = index.constant 64 : index
  %pool = index.constant 128 : index
  scf.for %physical = [%zero to %pool step %one] {
    scf.for %head = [%zero to %heads step %one] {
      scf.for %lane = [%zero to %h step %one] {
        func.call @decoder.h64.fixture.history_element(%head, %physical, %lane, %cache) : (index, index, index, buffer)
      }
    }
  }
  %origin = index.constant 0 : offset
  %key_origin = index.constant 262160 : offset
  %value_origin = index.constant 393232 : offset
  %last = index.constant 127 : index
  %bank = global.load @decoder.h64.attention.oracle.k.expected.63 : buffer
  %keys = buffer.view %bank[%origin] : buffer -> view<3x512xf32>
  %values = buffer.view %value[%origin] : buffer -> view<3x512xf32>
  %key_cache = buffer.view %cache[%key_origin] : buffer -> view<128x512xf16>
  %value_cache = buffer.view %cache[%value_origin] : buffer -> view<128x512xf16>
  // The selected page permutation maps logical63->physical127 and64->0.
  scf.for %row = [%zero to %two step %one] {
    %first = index.cmp eq, %row, %zero : index
    %physical = scf.select %first, %last, %zero : index
    scf.for %column = [%zero to %kw step %one] {
      %k = view.load %keys[%row, %column] : view<3x512xf32> -> f32
      %v = view.load %values[%row, %column] : view<3x512xf32> -> f32
      %k16 = scalar.fptrunc %k : f32 to f16
      %v16 = scalar.fptrunc %v : f32 to f16
      view.store %k16, %key_cache[%physical, %column] : f16, view<128x512xf16>
      view.store %v16, %value_cache[%physical, %column] : f16, view<128x512xf16>
    }
  }
  %size = index.constant 6144 : index
  %answers = global.load @decoder.h64.attention.oracle.attention.expected : buffer
  %expected = buffer.view %answers[%origin] : buffer -> view<6144xf32>
  %out = buffer.view %output[%origin] : buffer -> view<6144xf32>
  scf.for %i = [%zero to %size step %one] {
    %v = view.load %expected[%i] : view<6144xf32> -> f32
    view.store %v, %out[%i] : f32, view<6144xf32>
  }
  func.return
}

check.scenario @decoder.h64.attention.paged_crossing63_64 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(99) : tensor<12xi32>
    %map = check.generate.fill value(99) : tensor<6xi32>
    %query = check.generate.iota offset(-0.5) step(0.000244140625) : tensor<3x2048xf32>
    %key = check.generate.iota offset(-0.5) step(0.0009765625) : tensor<3x512xf32>
    %value = check.generate.iota offset(-0.25) step(0.000244140625) : tensor<3x512xf32>
    %gamma = check.generate.iota offset(0.875) step(0.001953125) : tensor<64xf32>
    %storage = check.generate.fill value(123.5) : tensor<6152xf32>
    %out = check.tensor.view %storage offset(16) : tensor<6152xf32> -> tensor<3x2048xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<6152xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(24592) : tensor<6152xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %out offset(16384) : tensor<3x2048xf32> -> tensor<2048xf32>
    %active_out = check.tensor.view %out offset(0) : tensor<3x2048xf32> -> tensor<2x2048xf32>
    %cache = check.generate.fill value(-9.0) : tensor<262160xf16>
    %cache_prefix = check.tensor.view %cache offset(0) : tensor<262160xf16> -> tensor<8xf16>
    %cache_suffix = check.tensor.view %cache offset(524304) : tensor<262160xf16> -> tensor<8xf16>
    %published_key_first = check.tensor.view %cache offset(262160) : tensor<262160xf16> -> tensor<512xf16>
    %published_key_last = check.tensor.view %cache offset(392208) : tensor<262160xf16> -> tensor<512xf16>
    %value_plane = check.tensor.view %cache offset(393232) : tensor<262160xf16> -> tensor<128x512xf16>
    %layer0 = check.tensor.view %cache offset(16) : tensor<262160xf16> -> tensor<131072xf16>
    %keys_untouched = check.tensor.view %cache offset(263184) : tensor<262160xf16> -> tensor<126x512xf16>
    %values_untouched = check.tensor.view %cache offset(394256) : tensor<262160xf16> -> tensor<126x512xf16>
    check.compare<@decoder.h64.actual.attention, @decoder.h64.expected.attention>(%epoch, %map, %query, %key, %value, %gamma, %cache, %out) : (tensor<12xi32>, tensor<6xi32>, tensor<3x2048xf32>, tensor<3x512xf32>, tensor<3x512xf32>, tensor<64xf32>, tensor<262160xf16>, tensor<3x2048xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(0.002) rtol(0.002) nan(same) : tensor<6152xf32>, tensor<6152xf32>
      // Independent oracle asserts RMS(expected)>=.005. This stronger
      // absolute bound implies relativeL2<=.002 over the4096active outputs.
      check.expect.approximate actual(%active_out) expected(%active_out) atol(1.0000000000000001e-05) rtol(0.0) nan(same) : tensor<2x2048xf32>, tensor<2x2048xf32>
      // Prepared K may straddle a half midpoint after retained afn trig.
      // Only these two rows get an F16 relative-precision allowance;
      // raw publication is independently bitwise-tested below.
      check.expect.approximate actual(%published_key_first) expected(%published_key_first) atol(1.0000000000000001e-05) rtol(0.0009765625) nan(same) : tensor<512xf16>, tensor<512xf16>
      check.expect.approximate actual(%published_key_last) expected(%published_key_last) atol(1.0000000000000001e-05) rtol(0.0009765625) nan(same) : tensor<512xf16>, tensor<512xf16>
      check.expect.bitwise actual(%value_plane) expected(%value_plane) : tensor<128x512xf16>
      check.expect.bitwise actual(%cache_prefix) expected(%cache_prefix) : tensor<8xf16>
      check.expect.bitwise actual(%cache_suffix) expected(%cache_suffix) : tensor<8xf16>
      check.expect.bitwise actual(%layer0) expected(%layer0) : tensor<131072xf16>
      check.expect.bitwise actual(%keys_untouched) expected(%keys_untouched) : tensor<126x512xf16>
      check.expect.bitwise actual(%values_untouched) expected(%values_untouched) : tensor<126x512xf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<2048xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<12xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<6xi32>
      check.expect.bitwise actual(%query) expected(%query) : tensor<3x2048xf32>
      check.expect.bitwise actual(%key) expected(%key) : tensor<3x512xf32>
      check.expect.bitwise actual(%value) expected(%value) : tensor<3x512xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<64xf32>
    }
  }
  check.return
}


command.decl @decoder.h64.actual.publication() launch(%epoch: buffer, %map: buffer, %key: buffer, %value: buffer, %cache: buffer)

func.def @decoder.h64.expected.publication(%epoch: buffer, %map: buffer, %key: buffer, %value: buffer, %cache: buffer) {
  %base = index.constant 63 : index
  func.call @decoder.h64.fixture.descriptor_values(%base, %epoch, %map) : (index, buffer, buffer)
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %width = index.constant 512 : index
  %last = index.constant 127 : index
  %origin = index.constant 0 : offset
  %key_origin = index.constant 262160 : offset
  %value_origin = index.constant 393232 : offset
  %keys = buffer.view %key[%origin] : buffer -> view<3x512xf32>
  %values = buffer.view %value[%origin] : buffer -> view<3x512xf32>
  %kc = buffer.view %cache[%key_origin] : buffer -> view<128x512xf16>
  %vc = buffer.view %cache[%value_origin] : buffer -> view<128x512xf16>
  scf.for %row = [%zero to %two step %one] {
    %first = index.cmp eq, %row, %zero : index
    %physical = scf.select %first, %last, %zero : index
    scf.for %column = [%zero to %width step %one] {
      %k = view.load %keys[%row, %column] : view<3x512xf32> -> f32
      %v = view.load %values[%row, %column] : view<3x512xf32> -> f32
      %k16 = scalar.fptrunc %k : f32 to f16
      %v16 = scalar.fptrunc %v : f32 to f16
      view.store %k16, %kc[%physical, %column] : f16, view<128x512xf16>
      view.store %v16, %vc[%physical, %column] : f16, view<128x512xf16>
    }
  }
  func.return
}


    %input = check.generate.iota offset(-0.5) step(0.000244140625) : tensor<3x2048xf32>
    %gamma = check.generate.iota offset(0.875) step(0.001953125) : tensor<128xf32>
    %storage = check.generate.fill value(123.5) : tensor<6152xf32>
    %out = check.tensor.view %storage offset(16) : tensor<6152xf32> -> tensor<3x2048xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<6152xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(24592) : tensor<6152xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %out offset(16384) : tensor<3x2048xf32> -> tensor<2048xf32>
    check.compare<@decoder.actual.qk0, @decoder.expected.qk0>(%epoch, %map, %input, %gamma, %out) : (tensor<12xi32>, tensor<6xi32>, tensor<3x2048xf32>, tensor<128xf32>, tensor<3x2048xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(0.00001) rtol(0.0001) nan(same) : tensor<6152xf32>, tensor<6152xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<2048xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<12xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<6xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<3x2048xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<128xf32>
    }
  }
  check.return
}

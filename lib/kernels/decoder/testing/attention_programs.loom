// Populate only layer1. Physical pages are the reverse of logical pages.
// Future rows remain NaN, making any noncausal read observable.
func.def @decoder.fixture.history_element(%head0: index, %physical0: index, %lane0: index, %cache: buffer) {
  %head = index.assume %head0 [range(%head0, 0, 7)] : index
  %physical = index.assume %physical0 [range(%physical0, 0, 127)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 127)] : index
  %c64 = index.constant 64 : index
  %c63 = index.constant 63 : index
  %c128 = index.constant 128 : index
  %c1024 = index.constant 1024 : index
  %c3 = index.constant 3 : index
  %c17 = index.constant 17 : index
  %c13 = index.constant 13 : index
  %c5 = index.constant 5 : index
  %c7 = index.constant 7 : index
  %first_page = index.cmp ult, %physical, %c64 : index
  %low_logical = index.add %physical, %c64 : index
  %high_logical = index.sub %physical, %c64 : index
  %logical = scf.select %first_page, %low_logical, %high_logical : index
  %history = index.cmp ult, %logical, %c63 : index
  %head3 = index.mul %head, %c3 : index
  %code0 = index.add %logical, %head3 : index
  %code1 = index.add %code0, %lane : index
  %code = index.rem %code1, %c17 : index
  %code32 = index.cast %code : index to i32
  %eight32 = scalar.constant 8 : i32
  %signed_key = scalar.subi %code32, %eight32 : i32
  %key32 = scalar.sitofp %signed_key : i32 to f32
  %key_step = scalar.constant 0.015625 : f32
  %key = scalar.mulf %key32, %key_step : f32
  %logical13 = index.rem %logical, %c13 : index
  %logical32 = index.cast %logical13 : index to i32
  %six32 = scalar.constant 6 : i32
  %signed_value = scalar.subi %logical32, %six32 : i32
  %value32 = scalar.sitofp %signed_value : i32 to f32
  %value_step = scalar.constant 0.125 : f32
  %value_base = scalar.mulf %value32, %value_step : f32
  %head5 = index.rem %head, %c5 : index
  %head32 = index.cast %head5 : index to i32
  %head_value = scalar.uitofp %head32 : i32 to f32
  %head_step = scalar.constant 0.0625 : f32
  %head_part = scalar.mulf %head_value, %head_step : f32
  %lane7 = index.rem %lane, %c7 : index
  %lane32 = index.cast %lane7 : index to i32
  %lane_value = scalar.uitofp %lane32 : i32 to f32
  %lane_step = scalar.constant 0.03125 : f32
  %lane_part = scalar.mulf %lane_value, %lane_step : f32
  %v0 = scalar.addf %value_base, %head_part : f32
  %value = scalar.addf %v0, %lane_part : f32
  %key16 = scalar.fptrunc %key : f32 to f16
  %value16 = scalar.fptrunc %value : f32 to f16
  %nan_bits = scalar.constant 32256 : i16
  %nan = scalar.bitcast %nan_bits : i16 to f16
  %stored_key = scf.select %history, %key16, %nan : f16
  %stored_value = scf.select %history, %value16, %nan : f16
  %head_base = index.mul %head, %c128 : index
  %element = index.add %head_base, %lane : index
  %key_origin = index.constant 524304 : offset
  %value_origin = index.constant 786448 : offset
  %keys = buffer.view %cache[%key_origin] : buffer -> view<128x1024xf16>
  %values = buffer.view %cache[%value_origin] : buffer -> view<128x1024xf16>
  view.store %stored_key, %keys[%physical, %element] : f16, view<128x1024xf16>
  view.store %stored_value, %values[%physical, %element] : f16, view<128x1024xf16>
  func.return
}

kernel.def @decoder.fixture.history() {
  %heads = index.constant 8 : index
  %pool = index.constant 128 : index
  %h = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %pool, %one) workgroup_size(%h, %one, %one) : index

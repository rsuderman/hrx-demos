load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

[loom_merge(
    name = "gemma3_rows_provider_" + format,
    testonly = True,
    srcs = [
        "gemma3_programs.loom",
        "//lib/kernels/attention:normalization.loom",
        "//lib/kernels/attention:rotary.loom",
        "//lib/kernels/elementwise:geglu_row.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "gemma3_rows_" + format + "_test",
    srcs = [
        "gemma3_checks.loom",
        "gemma3_reference_data.loom",
        ":gemma3_rows_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

exports_files([
    "gemma3_reference.py",
    "gemma3_reference_data.loom",
])

[loom_merge(
    name = "tail_provider_" + format,
    testonly = True,
    srcs = [
        "tail_programs.loom",
        "//lib/kernels/elementwise:ffn_launches.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/elementwise:swiglu_launches.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/kernels/qwen:common/layer_decode.loom",
        "//lib/kernels/qwen:common/layer_prefill.loom",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "tail_" + format + "_test",
    srcs = [
        "tail_checks.loom",
        ":tail_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

// Test-only launch adapters: actual shared row operations, independent checks.
template.decl @llm.rmsnorm.row(%width: index, %divisor: f32, %rows: index, %row: index, %origin: offset, %f16_output: i1, %epsilon: f32, %input: buffer, %gamma: buffer, %output: buffer)
template.decl @llm.residual_add_f32.row(%width: index, %rows: index, %row: index, %lhs: buffer, %rhs: buffer, %output: buffer)
template.decl @llm.geglu_tanh_f32.row(%width: index, %rows: index, %row: index, %gate: buffer, %up: buffer, %output: buffer)

kernel.def @gemma.test.rms(%width: index, %rows: index, %active: index) {
  %one = index.constant 1 : index
  %groups = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %rows, %one) workgroup_size(%threads, %one, %one) : index
} launch(%width_arg: index, %rows_arg: index, %active_arg: index, %input: buffer, %gamma: buffer, %output: buffer) {
  %width = index.assume %width_arg [range(%width_arg, 1, 32768)] : index
  %rows = index.assume %rows_arg [range(%rows_arg, 1, 512)] : index
  %active = index.assume %active_arg [range(%active_arg, 1, 512), le(%active_arg, %rows)] : index
  %row0 = kernel.workgroup.id<y> : index
  %row = index.assume %row0 [lt(%row0, %rows)] : index
  %live = index.cmp ult, %row, %active : index
  scf.if %live {
    %width_i32 = index.cast %width : index to i32
    %divisor = scalar.uitofp %width_i32 : i32 to f32
    %epsilon = scalar.constant 9.999999974752427e-7 : f32
    %row_bytes = index.constant 4 : offset
    %stride = index.scale %width, %row_bytes : index, offset -> offset
    %origin = index.scale %row, %stride : index, offset -> offset
    %f16_output = scalar.constant false : i1
    template.apply<@llm.rmsnorm.row>(%width, %divisor, %rows, %row, %origin, %f16_output, %epsilon, %input, %gamma, %output) : (index, f32, index, index, offset, i1, f32, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def @gemma.test.residual(%width: index, %rows: index, %active: index) {
  %one = index.constant 1 : index
  %tile = index.constant 1024 : index
  %tail = index.constant 1023 : index
  %padded = index.add %width, %tail : index
  %groups = index.div %padded, %tile : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %rows, %one) workgroup_size(%threads, %one, %one) : index
} launch(%width_arg: index, %rows_arg: index, %active_arg: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %width = index.assume %width_arg [range(%width_arg, 1024, 32768), multiple_of(%width_arg, 4)] : index
  %rows = index.assume %rows_arg [range(%rows_arg, 1, 512)] : index
  %active = index.assume %active_arg [range(%active_arg, 1, 512), le(%active_arg, %rows)] : index
  %row0 = kernel.workgroup.id<y> : index
  %row = index.assume %row0 [lt(%row0, %rows)] : index
  %live = index.cmp ult, %row, %active : index
  scf.if %live {
    template.apply<@llm.residual_add_f32.row>(%width, %rows, %row, %lhs, %rhs, %output) : (index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def @gemma.test.geglu(%width: index, %rows: index, %active: index) {
  %one = index.constant 1 : index
  %tile = index.constant 256 : index
  %groups = index.div %width, %tile : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %rows, %one) workgroup_size(%threads, %one, %one) : index
} launch(%width_arg: index, %rows_arg: index, %active_arg: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %width = index.assume %width_arg [range(%width_arg, 256, 32768), multiple_of(%width_arg, 256)] : index
  %rows = index.assume %rows_arg [range(%rows_arg, 1, 512)] : index
  %active = index.assume %active_arg [range(%active_arg, 1, 512), le(%active_arg, %rows)] : index
  %row0 = kernel.workgroup.id<y> : index
  %row = index.assume %row0 [lt(%row0, %rows)] : index
  %live = index.cmp ult, %row, %active : index
  scf.if %live {
    template.apply<@llm.geglu_tanh_f32.row>(%width, %rows, %row, %lhs, %rhs, %output) : (index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}


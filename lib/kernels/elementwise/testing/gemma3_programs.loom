command.def public @actual.post_residual_next() launch(%update: buffer, %residual: buffer, %post_gamma: buffer, %next_gamma: buffer, %out: buffer) {
  %width = index.constant 1152 : index
  %one = index.constant 1 : index
  %bytes = index.constant 4608 : offset
  %post = buffer.alloca<global> align(256) %bytes : buffer
  %sum = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @gemma.test.rms[%width, %one, %one](%width, %one, %one, %update, %post_gamma, %post) : [index, index, index](index, index, index, buffer, buffer, buffer)
  kernel.launch @gemma.test.residual[%width, %one, %one](%width, %one, %one, %residual, %post, %sum) : [index, index, index](index, index, index, buffer, buffer, buffer)
  kernel.launch @gemma.test.rms[%width, %one, %one](%width, %one, %one, %sum, %next_gamma, %out) : [index, index, index](index, index, index, buffer, buffer, buffer)
  command.return
}

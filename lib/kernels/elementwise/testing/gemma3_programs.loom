template.decl @llm.attention.head_rms_value(%raw: f32, %divisor: f32, %epsilon: f32, %lane: index, %head_size: index, %gamma: buffer) -> (f32)
template.decl @llm.attention.rope_neox_value(%head_size: index, %half: index, %size: index, %log_step: f32, %position: i32, %lane: index, %input: buffer) -> (f32)
kernel.def @gemma.test.head_norm() {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %gamma: buffer, %out: buffer) {
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %width = index.constant 256 : index
  %divisor = scalar.constant 256.0 : f32
  %epsilon = scalar.constant 9.999999974752427e-7 : f32
  %x = buffer.view %input[%origin] : buffer -> view<256xf32>
  %y = buffer.view %out[%origin] : buffer -> view<256xf32>
  %raw = view.load %x[%lane] : view<256xf32> -> f32
  %value = template.apply<@llm.attention.head_rms_value>(%raw, %divisor, %epsilon, %lane, %width, %gamma) : (f32, f32, f32, index, index, buffer) -> (f32)
  view.store %value, %y[%lane] : f32, view<256xf32>
  kernel.return
}
kernel.def @gemma.test.rotary() {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%size_arg: index, %half_arg: index, %step: f32, %position: i32, %input: buffer, %output: buffer) {
  %half = index.assume %half_arg [range(%half_arg, 1, 128)] : index
  %two = index.constant 2 : index
  %twice_half = index.mul %half, %two : index
  %size = index.assume %size_arg [range(%size_arg, 2, 256), eq(%size_arg, %twice_half)] : index
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %width = index.constant 256 : index
  %value = template.apply<@llm.attention.rope_neox_value>(%width, %half, %size, %step, %position, %lane, %input) : (index, index, index, f32, i32, index, buffer) -> (f32)
  %out = buffer.view %output[%origin] : buffer -> view<256xf32>
  view.store %value, %out[%lane] : f32, view<256xf32>
  kernel.return
}

command.def public @actual.head_local() launch(%input: buffer, %gamma: buffer, %out: buffer) {
  %bytes = index.constant 1024 : offset
  %normalized = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @gemma.test.head_norm[](%input, %gamma, %normalized) : [](buffer, buffer, buffer)
  %size = index.constant 256 : index
  %half = index.constant 128 : index
  %step = scalar.constant -0.071955784156063934 : f32
  %position = scalar.constant 11 : i32
  kernel.launch @gemma.test.rotary[](%size, %half, %step, %position, %normalized, %out) : [](index, index, f32, i32, buffer, buffer)
  command.return
}


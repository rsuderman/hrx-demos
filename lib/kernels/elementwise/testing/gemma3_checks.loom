func.def @oracle.rotary(%case: index, %size: index, %half: index, %input: buffer, %out: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %width = index.constant 256 : index
  %x = buffer.view %input[%origin] : buffer -> view<256xf32>
  %y = buffer.view %out[%origin] : buffer -> view<256xf32>
  %cos_bank = global.load @oracle.rotary.cosines : buffer
  %sin_bank = global.load @oracle.rotary.sines : buffer
  %cosines = buffer.view %cos_bank[%origin] : buffer -> view<288xf64>
  %sines = buffer.view %sin_bank[%origin] : buffer -> view<288xf64>
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %is_zero = index.cmp eq, %case, %zero : index
  %is_one = index.cmp eq, %case, %one : index
  %base12 = scf.select %is_one, %c128, %c256 : index
  %base = scf.select %is_zero, %zero, %base12 : index
  scf.for %c = [%zero to %width step %one] {
    %raw32 = view.load %x[%c] : view<256xf32> -> f32
    %rotates = index.cmp ult, %c, %size : index
    %answer = scf.if %rotates -> (f32) {
      %low = index.cmp ult, %c, %half : index
      %upper = index.add %c, %half : index
      %lower = index.sub %c, %half : index
      %pair = scf.select %low, %c, %lower : index
      %partner = scf.select %low, %upper, %lower : index
      %partner32 = view.load %x[%partner] : view<256xf32> -> f32
      %ordinal = index.add %base, %pair : index
      %cos = view.load %cosines[%ordinal] : view<288xf64> -> f64
      %sin = view.load %sines[%ordinal] : view<288xf64> -> f64
      %raw = scalar.extf %raw32 : f32 to f64
      %other = scalar.extf %partner32 : f32 to f64
      %own = scalar.mulf %raw, %cos : f64
      %cross = scalar.mulf %other, %sin : f64
      %minus = scalar.subf %own, %cross : f64
      %plus = scalar.addf %own, %cross : f64
      %rotated = scf.select %low, %minus, %plus : f64
      %result = scalar.fptrunc %rotated : f64 to f32
      scf.yield %result : f32
    } else {
      scf.yield %raw32 : f32
    }
    view.store %answer, %y[%c] : f32, view<256xf32>
  }
  func.return
}

command.decl @actual.head_local() launch(%input: buffer, %gamma: buffer, %out: buffer)

func.def @expected.head_local(%input: buffer, %gamma: buffer, %out: buffer) {
  %width = index.constant 256 : index
  %one = index.constant 1 : index
  %bytes = index.constant 1024 : offset
  %normalized = buffer.alloca<private> align(4) %bytes : buffer
  %rms_case = index.constant 3 : index
  func.call @oracle.rms(%rms_case, %width, %one, %one, %input, %gamma, %normalized) : (index, index, index, index, buffer, buffer, buffer)
  %size = index.constant 256 : index
  %half = index.constant 128 : index
  %rotary_case = index.constant 0 : index
  func.call @oracle.rotary(%rotary_case, %size, %half, %normalized, %out) : (index, index, index, buffer, buffer)
  func.return
}

check.scenario @head_local_norm_rotary_nonzero_position {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-0.00020000000000000001) step(9.9999999999999995e-07) : tensor<256xf32>
    %gamma = check.generate.iota offset(1.5) step(0.001) : tensor<256xf32>
    %storage = check.generate.fill value(-123.5) : tensor<264xf32>
    %out = check.tensor.view %storage offset(16) : tensor<264xf32> -> tensor<256xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<264xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(1040) : tensor<264xf32> -> tensor<4xf32>
    check.compare<@actual.head_local, @expected.head_local>(%input, %gamma, %out) : (tensor<256xf32>, tensor<256xf32>, tensor<256xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(1.0000000000000001e-05) rtol(0.0001) nan(same) : tensor<264xf32>, tensor<264xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<256xf32>
    }
  }
  check.return
}


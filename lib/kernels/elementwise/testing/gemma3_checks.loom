// Independent F64 math anchors from gemma3_reference.py; basic F64 weighting
// and F32 stage stores stay in the VM. Inputs/cases/guards/budgets are unchanged.
global.rodata.decl @oracle.rms.inverses

global.rodata.decl @oracle.geglu.values

global.rodata.decl @oracle.rotary.cosines

global.rodata.decl @oracle.rotary.sines

func.def @oracle.rms(%case: index, %width: index, %rows: index, %active: index, %input: buffer, %gamma: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %x = buffer.view %input[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %g = buffer.view %gamma[%origin] : buffer -> view<[%width]xf32>
  %y = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %bank = global.load @oracle.rms.inverses : buffer
  %inverses = buffer.view %bank[%origin] : buffer -> view<18xf64>
  %three = index.constant 3 : index
  %safe_case = index.assume %case [range(%case, 0, 5)] : index
  %case_base = index.mul %safe_case, %three : index
  scf.for %r = [%zero to %active step %one] {
    %safe_row = index.assume %r [range(%r, 0, 2)] : index
    %ordinal = index.add %case_base, %safe_row : index
    %inverse = view.load %inverses[%ordinal] : view<18xf64> -> f64
    scf.for %c = [%zero to %width step %one] {
      %v32 = view.load %x[%r, %c] : view<[%rows]x[%width]xf32> -> f32
      %g32 = view.load %g[%c] : view<[%width]xf32> -> f32
      %v = scalar.extf %v32 : f32 to f64
      %w = scalar.extf %g32 : f32 to f64
      %normalized = scalar.mulf %v, %inverse : f64
      %weighted = scalar.mulf %normalized, %w : f64
      %answer = scalar.fptrunc %weighted : f64 to f32
      view.store %answer, %y[%r, %c] : f32, view<[%rows]x[%width]xf32>
    }
  }
  func.return
}

func.def @oracle.residual(%width: index, %rows: index, %active: index, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %a = buffer.view %lhs[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %b = buffer.view %rhs[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %y = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xf32>
  scf.for %r = [%zero to %active step %one] {
    scf.for %c = [%zero to %width step %one] {
      %av = view.load %a[%r, %c] : view<[%rows]x[%width]xf32> -> f32
      %bv = view.load %b[%r, %c] : view<[%rows]x[%width]xf32> -> f32
      %answer = scalar.addf %av, %bv : f32
      view.store %answer, %y[%r, %c] : f32, view<[%rows]x[%width]xf32>
    }
  }
  func.return
}

func.def @oracle.geglu(%width: index, %rows: index, %active: index, %gate: buffer, %up: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %g = buffer.view %gate[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %u = buffer.view %up[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %y = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %bank = global.load @oracle.geglu.values : buffer
  %values = buffer.view %bank[%origin] : buffer -> view<20736xf64>
  scf.for %r = [%zero to %active step %one] {
    scf.for %c = [%zero to %width step %one] {
      %u32 = view.load %u[%r, %c] : view<[%rows]x[%width]xf32> -> f32
      %v = scalar.extf %u32 : f32 to f64
      %row_base = index.mul %r, %width : index
      %ordinal = index.add %row_base, %c : index
      %gelu = view.load %values[%ordinal] : view<20736xf64> -> f64
      %answer64 = scalar.mulf %gelu, %v : f64
      %answer = scalar.fptrunc %answer64 : f64 to f32
      view.store %answer, %y[%r, %c] : f32, view<[%rows]x[%width]xf32>
    }
  }
  func.return
}

command.decl @actual.rms_1152_1_1_low() launch(%lhs: buffer, %rhs: buffer, %output: buffer)

func.def @expected.rms_1152_1_1_low(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %width = index.constant 1152 : index
  %rows = index.constant 1 : index
  %active = index.constant 1 : index
  %rms_case = index.constant 0 : index
  func.call @oracle.rms(%rms_case, %width, %rows, %active, %lhs, %rhs, %output) : (index, index, index, index, buffer, buffer, buffer)
  func.return
}

check.scenario @rms_1152_1_1_low_arithmetic_and_guards {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs_storage = check.generate.iota offset(-0.00020000000000000001) step(9.9999999999999995e-08) : tensor<1160xf32>
    %rhs_storage = check.generate.iota offset(1.5) step(0.0001) : tensor<1160xf32>
    %out_storage = check.generate.fill value(-123.5) : tensor<1160xf32>
    %lhs = check.tensor.view %lhs_storage offset(16) : tensor<1160xf32> -> tensor<1x1152xf32>
    %rhs = check.tensor.view %rhs_storage offset(16) : tensor<1160xf32> -> tensor<1152xf32>
    %out = check.tensor.view %out_storage offset(16) : tensor<1160xf32> -> tensor<1x1152xf32>
    %prefix = check.tensor.view %out_storage offset(0) : tensor<1160xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %out_storage offset(4624) : tensor<1160xf32> -> tensor<4xf32>
    check.compare<@actual.rms_1152_1_1_low, @expected.rms_1152_1_1_low>(%lhs, %rhs, %out) : (tensor<1x1152xf32>, tensor<1152xf32>, tensor<1x1152xf32>) -> () {
      check.expect.bitwise actual(%lhs_storage) expected(%lhs_storage) : tensor<1160xf32>
      check.expect.bitwise actual(%rhs_storage) expected(%rhs_storage) : tensor<1160xf32>
      check.expect.approximate actual(%out_storage) expected(%out_storage) atol(5.0000000000000004e-06) rtol(5.0000000000000002e-05) nan(same) : tensor<1160xf32>, tensor<1160xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
    }
  }
  check.return
}


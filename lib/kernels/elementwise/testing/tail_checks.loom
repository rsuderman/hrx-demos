command.decl @tail_1024_1_out() launch(%lhs: buffer, %rhs: buffer, %out: buffer)

func.def @expected_tail_1024_1_out(%lhs: buffer, %rhs: buffer, %out: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %n = index.constant 1024 : index
  %a = buffer.view %lhs[%origin] : buffer -> view<1024xf32>
  %b = buffer.view %rhs[%origin] : buffer -> view<1024xf32>
  %o = buffer.view %out[%origin] : buffer -> view<1024xf32>
  scf.for %i = [%zero to %n step %one] {
    %av = view.load %a[%i] : view<1024xf32> -> f32
    %bv = view.load %b[%i] : view<1024xf32> -> f32
    %v = scalar.addf %av, %bv : f32
    view.store %v, %o[%i] : f32, view<1024xf32>
  }
  func.return
}

check.scenario @case_tail_1024_1_out {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %as = check.generate.iota offset(-2.0) step(0.125) period(31) : tensor<1028xf32>
    %bs = check.generate.iota offset(1.0) step(-0.25) period(19) : tensor<1028xf32>
    %os = check.generate.fill value(-99.0) : tensor<1028xf32>
    %a = check.tensor.view %as offset(8) : tensor<1028xf32> -> tensor<1024xf32>
    %b = check.tensor.view %bs offset(8) : tensor<1028xf32> -> tensor<1024xf32>
    %o = check.tensor.view %os offset(8) : tensor<1028xf32> -> tensor<1024xf32>
    check.compare<@tail_1024_1_out, @expected_tail_1024_1_out>(%a, %b, %o) : (tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf32>) -> () {
      check.expect.bitwise actual(%as) expected(%as) : tensor<1028xf32>
      check.expect.bitwise actual(%bs) expected(%bs) : tensor<1028xf32>
      check.expect.bitwise actual(%os) expected(%os) : tensor<1028xf32>
    }
  }
  check.return
}


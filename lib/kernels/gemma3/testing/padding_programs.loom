// Focused packet-wrapper contract: canonical pack consumers read all T rows.
config.def @gemma3.model.hidden_size = 1152 : index

config.def @gemma3.model.rms_epsilon = 9.9999999747524271e-07 : f32

kernel.decl @gemma3_rmsnorm_active_f32(%rows$2: index) launch(%rows$3: index, %begin: index, %origin: offset, %count: buffer, %input: buffer, %gamma: buffer, %output: buffer)

kernel.decl @gemma3_geglu(%rows: index, %width$11: index) launch(%width$12: index, %count: buffer, %gate: buffer, %up: buffer, %output: buffer)

command.def @gemma3.padding.norm() launch(%count: buffer, %input: buffer, %gamma: buffer, %output: buffer) {
  %rows = index.constant 3 : index
  %begin = index.constant 0 : index
  %origin = index.constant 0 : offset
  kernel.launch @gemma3_rmsnorm_active_f32[%rows](%rows, %begin, %origin, %count, %input, %gamma, %output) : [index](index, index, offset, buffer, buffer, buffer, buffer)
  command.return
}

command.def @gemma3.padding.geglu() launch(%count: buffer, %input: buffer, %up: buffer, %output: buffer) {
  %rows = index.constant 3 : index
  %width = index.constant 6912 : index
  kernel.launch @gemma3_geglu[%rows, %width](%width, %count, %input, %up, %output) : [index, index](index, buffer, buffer, buffer, buffer)
  command.return
}

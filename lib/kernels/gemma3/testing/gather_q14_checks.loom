// Full physical IDs with sparse deterministic encoded rows, no checkpoint data.
func.def @gemma3.gather.init(%weight: buffer, %ids: buffer, %epoch: buffer, %count: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %tokens = buffer.view %ids[%origin] : buffer -> view<8xi32>
  %descriptor = buffer.view %epoch[%origin] : buffer -> view<8xi32>
  %counts = buffer.view %count[%origin] : buffer -> view<3xi32>
  %active = scalar.constant 4 : i32
  view.store %active, %descriptor[3] : i32, view<8xi32>
  view.store %active, %counts[0] : i32, view<3xi32>
  %id0 = scalar.constant 0 : i32
  %id1 = scalar.constant 262143 : i32
  %id2 = scalar.constant 262144 : i32
  %id3 = scalar.constant 262207 : i32
  view.store %id0, %tokens[0] : i32, view<8xi32>
  view.store %id1, %tokens[1] : i32, view<8xi32>
  view.store %id2, %tokens[2] : i32, view<8xi32>
  view.store %id3, %tokens[3] : i32, view<8xi32>
  scf.for %r = [%zero to %four step %one] {
    %id_word = view.load %tokens[%r] : view<8xi32> -> i32
    %id = index.cast %id_word : i32 to index
    %r32 = index.cast %r : index to i32
    %r8 = scalar.trunci %r32 : i32 to i8
    %row_stride = index.constant 3150 : offset
    %block_stride = index.constant 210 : offset
    %blocks = index.constant 15 : index
    %row = index.scale %id, %row_stride : index, offset -> offset
    scf.for %b = [%zero to %blocks step %one] {
      %block = index.scale %b, %block_stride : index, offset -> offset
      %base = index.add %row, %block : offset
      %encoded = buffer.view %weight[%base] : buffer -> view<210xi8>
      %seventeen = scalar.constant 17 : i8
      %code = scalar.muli %r8, %seventeen : i8
      %ql_end = index.constant 128 : index
      scf.for %j = [%zero to %ql_end step %one] {
        view.store %code, %encoded[%j] : i8, view<210xi8>
      }
      %scale_start = index.constant 192 : index
      %scale_end = index.constant 208 : index
      %unit_scale = scalar.constant 1 : i8
      scf.for %j = [%scale_start to %scale_end step %one] {
        view.store %unit_scale, %encoded[%j] : i8, view<210xi8>
      }
      %d_add = index.constant 208 : offset
      %d_origin = index.add %base, %d_add : offset
      %d = buffer.view %weight[%d_origin] : buffer -> view<1xf16>
      %unit = scalar.constant 1.0 : f16
      view.store %unit, %d[0] : f16, view<1xf16>
    }
  }
  func.return
}

command.decl @gemma3.gather.actual() launch(%weight: buffer, %ids: buffer, %epoch: buffer, %count: buffer, %output: buffer)

func.def @gemma3.gather.expected(%weight: buffer, %ids: buffer, %epoch: buffer, %count: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %out = buffer.view %output[%origin] : buffer -> view<8x3840xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %width = index.constant 3840 : index
  %scale = scalar.constant 61.967735290527344 : f32
  %bias = scalar.constant -32.0 : f32
  scf.for %r = [%zero to %four step %one] {
    %r32 = index.cast %r : index to i32
    %rf = scalar.uitofp %r32 : i32 to f32
    %raw = scalar.addf %rf, %bias : f32
    %value = scalar.mulf %raw, %scale : f32
    scf.for %column = [%zero to %width step %one] {
      view.store %value, %out[%r, %column] : f32, view<8x3840xf32>
    }
  }
  func.return
}

check.scenario @gemma3.gather.full_ids_scaled_q14 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %weight = check.generate.fill value(0) : tensor<825955200xi8>
    %ids = check.generate.fill value(-77) : tensor<8xi32>
    %epoch = check.generate.fill value(0) : tensor<8xi32>
    %count = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@gemma3.gather.init>(%weight, %ids, %epoch, %count) : (tensor<825955200xi8>, tensor<8xi32>, tensor<8xi32>, tensor<3xi32>) -> ()
    %storage = check.generate.fill value(123.5) : tensor<30728xf32>
    %output = check.tensor.view %storage offset(16) : tensor<30728xf32> -> tensor<8x3840xf32>
    %inactive = check.tensor.view %output offset(61440) : tensor<8x3840xf32> -> tensor<4x3840xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<30728xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(122896) : tensor<30728xf32> -> tensor<4xf32>
    check.compare<@gemma3.gather.actual, @gemma3.gather.expected>(%weight, %ids, %epoch, %count, %output) : (tensor<825955200xi8>, tensor<8xi32>, tensor<8xi32>, tensor<3xi32>, tensor<8x3840xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<30728xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<4x3840xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<825955200xi8>
      check.expect.bitwise actual(%ids) expected(%ids) : tensor<8xi32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<8xi32>
      check.expect.bitwise actual(%count) expected(%count) : tensor<3xi32>
    }
  }
  check.return
}

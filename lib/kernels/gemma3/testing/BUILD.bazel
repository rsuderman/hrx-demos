load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

[loom_merge(
    name = "gather_q" + str(tag) + "_provider_" + format,
    testonly = True,
    srcs = [
        "gather_q" + str(tag) + "_programs.loom",
        "//lib/kernels/gemma3:embedding.loom",
        "//lib/kernels/embedding:q6k_rows.loom",
        "//lib/kernels/embedding:q8_0_rows.loom",
        "//lib/kernels/projection:block32_sources",
        "//lib/kernels/epoch:active_rows.loom",
    ],
    output_format = format,
) for tag in [
    14,
    8,
] for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "gather_q" + str(tag) + "_" + format + "_test",
    srcs = [
        "gather_q" + str(tag) + "_checks.loom",
        ":gather_q" + str(tag) + "_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for tag in [
    14,
    8,
] for format in [
    "text",
    "bc",
]]


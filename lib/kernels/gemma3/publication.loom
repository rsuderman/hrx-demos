// Source-derived terminal policy. Preserve raw logits/argmax for reference;
// direct epoch publication canonicalizes the two configured EOG IDs to the
// native terminal. Host publication consumes the same configured token facts.
config.decl @gemma3.publication.eos_id : i32
config.decl @gemma3.publication.end_turn_id : i32

func.def public inline @gemma3_native_token(%token: i32, %eos: i32) -> (i32) {
  %end_text = config.get @gemma3.publication.eos_id : i32
  %end_turn = config.get @gemma3.publication.end_turn_id : i32
  %a = scalar.cmpi eq, %token, %end_text : i32
  %c = scalar.cmpi eq, %token, %end_turn : i32
  %stop = scalar.ori %a, %c : i1
  %native = scf.select %stop, %eos, %token : i32
  func.return %native : i32
}
// Direct numerical publication: one logical winner, one physical output slot.
kernel.def @gemma3_publish_epoch_id() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %selected_ids: buffer, %output_ids: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %eos_origin = index.constant 2060 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %count = view.load %header[2] : view<3xi32> -> i32
  %zero32 = scalar.constant 0 : i32
  %selected = scalar.cmpi ne, %count, %zero32 : i32
  scf.if %selected {
    %descriptor = buffer.view %epoch[%descriptor_origin] : buffer -> view<5xi32>
    %slot_word = view.load %descriptor[4] : view<5xi32> -> i32
    %slot_value = index.cast %slot_word : i32 to index
    %slot = index.assume %slot_value [range(%slot_value, 0, 15)] : index
    %private = buffer.view %selected_ids[%origin] : buffer -> view<4xi32>
    %winner = view.load %private[0] : view<4xi32> -> i32
    %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
    %eos = view.load %terminal[0] : view<1xi32> -> i32
    %token = func.call @gemma3_native_token(%winner, %eos) : (i32, i32) -> (i32)
    %output = buffer.view %output_ids[%origin] : buffer -> view<16xi32>
    view.store %token, %output[%slot] : i32, view<16xi32>
  }
  kernel.return
}

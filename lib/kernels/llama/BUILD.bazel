    "attention/attention_materialized.loom",
    "embedding/embedding.loom",
    "//lib/kernels/embedding:q6k_rows.loom",
]

filegroup(name = "configured_provider_sources", srcs = _CONFIGURED_PROVIDER_SOURCES)
loom_library(name = "configured_providers", srcs = _CONFIGURED_PROVIDER_SOURCES)

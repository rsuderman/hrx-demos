load("@hrx_system//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*.loom"]))

loom_library(
    name = "norm_interface",
    srcs = ["norm/norm_interface.loom"],
)

loom_library(
    name = "ffn_interface",
    srcs = ["ffn/ffn_interface.loom"],
)

loom_library(
    name = "norm",
    srcs = [
        "norm/norm.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "//lib/kernels/epoch:active_rows.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
    ],
)

loom_library(
    name = "ffn",
    srcs = [
        "ffn/ffn.loom",
        "//lib/kernels/elementwise:ffn_launches.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/epoch:active_rows.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/programs/ffn:gate_up_sources",
        "//lib/programs/projection:packed_sources",
    ],
)

loom_library(
    name = "output",
    srcs = [
        "output/output_norm_last.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/epoch:active_rows.loom",
        "//lib/kernels/epoch:count.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/kernels/selection:greedy_argmax.loom",
        "//lib/programs/llama:output.loom",
        "//lib/programs/llama:output_interface.loom",
        "//lib/programs/output:last_greedy.loom",
        "//lib/programs/projection:packed_sources",
    ],
)

loom_library(
    name = "publication",
    srcs = [
        "publication/publication.loom",
        "publication/publication_interface.loom",
        "//lib/kernels/epoch:count.loom",
    ],
)

loom_library(
    name = "attention_native",
    srcs = [
        "attention/attention_materialized.loom",
        "attention/attention_native.loom",
        "attention/attention_prepare.loom",
        "attention/rotary.loom",
        "//lib/kernels/attention:core.loom",
        "//lib/kernels/attention:kv_position.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/programs/projection:packed_sources",
    ],
)

# Generated model facts supply every model configuration definition.
# Keep source and relocatable provider forms on this identical closure.
_CONFIGURED_PROVIDER_SOURCES = [
    "//lib/kernels/decoder:rows.loom",
    "//lib/kernels/attention:normalization.loom",
    "//lib/kernels/attention:rotary.loom",
    "//lib/programs/projection:packed_sources",
    "//lib/programs/projection:prepared_rows_sources",
    "//lib/programs/ffn:gate_up_sources",
    "norm/norm.loom",
    "//lib/kernels/normalization:rmsnorm_row.loom",
    "//lib/kernels/elementwise:residual_row.loom",
    "//lib/kernels/epoch:active_rows.loom",
    "ffn/ffn.loom",
    "//lib/kernels/elementwise:ffn_launches.loom",
    "//lib/kernels/epoch:count.loom",
    "output/output_norm_last.loom",
    "//lib/kernels/selection:greedy_argmax.loom",
    "publication/publication.loom",
    "publication/publication_interface.loom",
    "attention/attention_prepare.loom",
    "attention/attention_native.loom",
    "attention/rotary.loom",
    "//lib/kernels/attention:core.loom",
    "//lib/kernels/attention:kv_position.loom",
    "attention/attention_materialized.loom",
    "embedding/embedding.loom",
    "embedding/q4k_epoch.loom",
    "//lib/kernels/embedding:epoch_f32_sources",
]

filegroup(
    name = "configured_provider_sources",
    srcs = _CONFIGURED_PROVIDER_SOURCES,
)

loom_merge(
    name = "configured_providers",
    srcs = _CONFIGURED_PROVIDER_SOURCES,
)

loom_merge(
    name = "configured_provider_text",
    testonly = True,
    srcs = _CONFIGURED_PROVIDER_SOURCES,
    output_format = "text",
)

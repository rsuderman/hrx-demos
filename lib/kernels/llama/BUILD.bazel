load("@hrx_system//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("@hrx_system//loom/build_tools/bazel:loom_binary.bzl", "loom_kernel_binary")
package(default_visibility = ["//visibility:public"])
exports_files(glob(["**/*.loom"]))
loom_library(name = "norm_interface", srcs = ["norm/norm_interface.loom"])
loom_library(name = "ffn_interface", srcs = ["ffn/ffn_interface.loom"])
loom_library(
    name = "norm",
    srcs = [
        "norm/norm.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "config.loom",
        "active_rows.loom",
    ],
)
loom_library(
    name = "ffn",
    srcs = [
        "ffn/ffn.loom",
        "//lib/kernels/elementwise:ffn_launches.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "config.loom",
        "active_rows.loom",
        "//lib/kernels/projection:q4k.loom",
        "//lib/kernels/projection:q4k_compat.loom",
        "//lib/kernels/projection:q6k.loom",
        "//lib/kernels/projection:q6k_compat.loom",
        "//lib/kernels/projection:qk_common.loom",
        "//lib/kernels/projection:qk_mmvq_compat.loom",
        "//lib/kernels/quantization:q8_1_x4.loom",
        "//lib/kernels/quantization:q8_1_x4_mmvq_compat.loom",
    ],
)
filegroup(
    name = "all_sources",
    srcs = glob(["**/*.loom"]) + [
        "//lib/kernels/normalization:all_sources",
        "//lib/kernels/elementwise:all_sources",
        "//lib/kernels/embedding:all_sources",
        "//lib/kernels/attention:all_sources",
        "//lib/kernels/selection:all_sources",
        "//lib/kernels/projection:llama_sources",
        "//lib/kernels/quantization:llama_sources",
    ],
)

loom_kernel_binary(
    name = "norm_gfx1100",
    deps = [":norm"], roots = ["llama32_rmsnorm_f32"],
    target = "@hrx_system//loom/target/amdgpu:gfx1100",
)

loom_library(
    name = "output",
    srcs = [
        "active_rows.loom",
        "output/head_count.loom",
        "//lib/kernels/projection:q6k.loom",
        "//lib/kernels/quantization:q8_1_x4.loom",
        "output/output.loom",
        "output/output_interface.loom",
        "output/output_norm_last.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "config.loom",
        "output/output_config.loom",
        "//lib/kernels/selection:greedy_argmax.loom",
        "//lib/kernels/quantization:q8_1_x4_mmvq_compat.loom",
        "//lib/kernels/projection:q6k_compat.loom",
        "//lib/kernels/projection:qk_mmvq_compat.loom",
        "//lib/kernels/projection:qk_common.loom",
    ],
)
loom_library(name = "publication", srcs = ["publication/publication.loom", "publication/publication_interface.loom", "output/head_count.loom"])

loom_library(
    name = "attention_dispatch",
    srcs = ["attention/attention_dispatch.loom", "attention/rotary.loom", "//lib/kernels/attention:core.loom", "//lib/kernels/attention:kv_position.loom"],
)
loom_kernel_binary(
    name = "attention_dispatch_gfx1100",
    deps = [":attention_dispatch"],
    roots = ["llama_dispatch_rope", "llama_dispatch_publish_kv", "llama_dispatch_causal_attention"],
    target = "@hrx_system//loom/target/amdgpu:gfx1100",
)

loom_library(
    name = "attention_native",
    srcs = [
        "attention/attention_prepare.loom",
        "attention/attention_native.loom",
        "attention/rotary.loom",
        "//lib/kernels/attention:core.loom",
        "//lib/kernels/attention:kv_position.loom",
        "attention/attention_materialized.loom",
        "//lib/kernels/normalization:rmsnorm_row.loom",
        "//lib/kernels/elementwise:residual_row.loom",
        "//lib/kernels/elementwise:swiglu_row.loom",
        "config.loom",
        "attention/attention_config.loom",
    ],
)


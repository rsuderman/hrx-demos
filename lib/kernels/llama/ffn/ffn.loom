// Curated from loom-pipeline/llm/common/ffn.loom; independently maintained by Loomify.
// Restricted provider: generic QkCompat Q4_K gate/up; Q4_K or Q6_K down.
// Non-admitted format/schedule branches are removed explicitly.
// Shared static FFN command sequences. Geometry, resident representation,
// kernel schedule and borrowed weights are explicit preparation operands.
// Canonical paths pack activations to Q8_1_x4; prepared paths preserve channel8,
// concurrent gate/up, m4 verification and the tuned F16/F32 fusion boundaries.
// This provider does not look up model configuration, layer bits or tensor keys.
template.decl @llm.residual_add_f32.row(%hidden_size0: index, %row_count0: index, %row0: index, %lhs: buffer, %rhs: buffer, %output: buffer)

template.decl @llm.swiglu_f32.row(%ffn_size0: index, %row_count0: index, %row0: index, %gate: buffer, %up: buffer, %output: buffer)

kernel.decl @llm_ffn_swiglu_f32_decode(%ffn_size$18: index) launch(%ffn_size$19: index, %gate: buffer, %up: buffer, %output: buffer)

kernel.def @llm_ffn_swiglu_f32_prefill_active(%token_count: index, %ffn_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 0, 512)] : index
  %unit = index.constant 1 : index
  %channels_per_group = index.constant 256 : index
  %bounded_ffn_size = index.assume %ffn_size [range(%ffn_size, 256, 32768), multiple_of(%ffn_size, 256)] : index
  %workgroup_count = index.div %bounded_ffn_size, %channels_per_group : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%ffn_size: index, %token_count: index, %row_origin: index, %count_origin: offset, %count: buffer, %gate: buffer, %up: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %dynamic = scalar.constant -1 : i32
  %active = func.call @llm.active_row(%token, %row_origin, %dynamic, %count_origin, %count) : (index, index, i32, offset, buffer) -> (i1)
  scf.if %active {
    template.apply<@llm.swiglu_f32.row>(%ffn_size, %bounded_token_count, %token, %gate, %up, %output) : (index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}

// Tail workgroups retain the true logical width for row strides and vector4 guards.
kernel.decl @llm_ffn_residual_add_f32_decode(%hidden_size$44: index) launch(%hidden_size$45: index, %lhs: buffer, %rhs: buffer, %output: buffer)

kernel.def @llm_ffn_residual_add_f32_prefill_active(%token_count: index, %hidden_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 0, 512)] : index
  %unit = index.constant 1 : index
  %channels_per_group = index.constant 1024 : index
  %bounded_hidden_size = index.assume %hidden_size [range(%hidden_size, 1024, 32768), multiple_of(%hidden_size, 256)] : index
  %rounding = index.constant 1023 : index
  %rounded_hidden = index.add %bounded_hidden_size, %rounding : index
  %workgroup_count = index.div %rounded_hidden, %channels_per_group : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%hidden_size0: index, %token_count: index, %row_origin: index, %count_origin: offset, %count: buffer, %lhs: buffer, %rhs: buffer, %output: buffer) {
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 1024, 32768), multiple_of(%hidden_size0, 256)] : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %dynamic = scalar.constant -1 : i32
  %active = func.call @llm.active_row(%token, %row_origin, %dynamic, %count_origin, %count) : (index, index, i32, offset, buffer) -> (i1)
  scf.if %active {
    template.apply<@llm.residual_add_f32.row>(%hidden_size, %bounded_token_count, %token, %lhs, %rhs, %output) : (index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}


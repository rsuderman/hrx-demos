// Standalone leaf scalar sensitivity; no broader whole-model admission claim.
config.def @llama.model.hidden_size = 128 : index

config.def @llama.model.query_heads = 1 : index

config.def @llama.model.kv_heads = 1 : index

config.def @llama.model.head_size = 128 : index

config.def @llama.model.kv_size = 128 : index

config.def @llama.model.layer_count = 1 : index

config.def @llama.attention.cache_capacity = 64 : index

config.def @llama.attention.pool_capacity = 0 : index

config.def @llama.model.rotary_step = 0.75 : f32

config.def @llama.model.attention_scale = 0.125 : f32

kernel.decl @llama32_rotary_query(%tokens: index) launch(%kind: index, %origin: offset, %begin: index, %control: buffer, %factors: buffer, %projection: buffer, %output: buffer)

kernel.decl @llama32_attention_rows(%tokens: index) launch(%layer: index, %cache_base: offset, %kind: index, %origin: offset, %begin: index, %map_origin: offset, %control: buffer, %map: buffer, %query: buffer, %cache: buffer, %output: buffer)

kernel.def @scalar_test_control() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%position: i32, %control: buffer) {
  %origin = index.constant 0 : offset
  %c = buffer.view %control[%origin] : buffer -> view<3xi32>
  %zero = scalar.constant 0 : i32
  view.store %position, %c[0] : i32, view<3xi32>
  view.store %zero, %c[1] : i32, view<3xi32>
  view.store %zero, %c[2] : i32, view<3xi32>
  kernel.return
}

check.case @rotary_generated_step_nonzero_position {
  %one = check.literal value(1) : index
  %zero = check.literal value(0) : index
  %origin = check.literal value(0) : offset
  %position = check.literal value(3) : i32
  %control = check.generate.fill value(0) : tensor<3xi32>
  %factors = check.generate.fill value(1.0) : tensor<64xf32>
  %input = check.generate.fill value(1.0) : tensor<128xf32>
  %output = check.generate.fill value(-99.0) : tensor<192xf32>
  kernel.launch @scalar_test_control(%position, %control) : (i32, tensor<3xi32>)
  kernel.launch @llama32_rotary_query[%one](%one, %origin, %zero, %control, %factors, %input, %output) : [index](index, offset, index, tensor<3xi32>, tensor<64xf32>, tensor<128xf32>, tensor<192xf32>)
  %v0 = check.tensor.view %output offset(0) : tensor<192xf32> -> tensor<1xf32>
  %e0 = check.generate.fill value(-1.1311125046603125) : tensor<1xf32>
  check.expect.approximate actual(%v0) expected(%e0) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<1xf32>, tensor<1xf32>
  %v1 = check.tensor.view %output offset(4) : tensor<192xf32> -> tensor<1xf32>
  %e1 = check.generate.fill value(-0.84887248854057817) : tensor<1xf32>
  check.expect.approximate actual(%v1) expected(%e1) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<1xf32>, tensor<1xf32>
  %v2 = check.tensor.view %output offset(8) : tensor<192xf32> -> tensor<1xf32>
  %e2 = check.generate.fill value(-1.4062468196106603) : tensor<1xf32>
  check.expect.approximate actual(%v2) expected(%e2) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<1xf32>, tensor<1xf32>
  %v3 = check.tensor.view %output offset(12) : tensor<192xf32> -> tensor<1xf32>
  %e3 = check.generate.fill value(0.14989957416518207) : tensor<1xf32>
  check.expect.approximate actual(%v3) expected(%e3) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<1xf32>, tensor<1xf32>
  %v126 = check.tensor.view %output offset(504) : tensor<192xf32> -> tensor<1xf32>
  %e126 = check.generate.fill value(0.99999995963723987) : tensor<1xf32>
  check.expect.approximate actual(%v126) expected(%e126) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<1xf32>, tensor<1xf32>
  %v127 = check.tensor.view %output offset(508) : tensor<192xf32> -> tensor<1xf32>
  %e127 = check.generate.fill value(1.0000000403627585) : tensor<1xf32>
  check.expect.approximate actual(%v127) expected(%e127) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<1xf32>, tensor<1xf32>
  %guard = check.tensor.view %output offset(512) : tensor<192xf32> -> tensor<64xf32>
  %sentinel = check.generate.fill value(-99.0) : tensor<64xf32>
  check.expect.bitwise actual(%guard) expected(%sentinel) : tensor<64xf32>
  check.return
}

kernel.def @scalar_test_cache() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%cache: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %width = index.constant 128 : index
  %origin = index.constant 0 : offset
  %values_origin = index.constant 16384 : offset
  %key = buffer.view %cache[%origin] : buffer -> view<64x128xf16>
  %value = buffer.view %cache[%values_origin] : buffer -> view<64x128xf16>
  %one_f = scalar.constant 1.0 : f16
  %two_f = scalar.constant 2.0 : f16
  view.store %one_f, %key[%one, %zero] : f16, view<64x128xf16>
  scf.for %c = [%zero to %width step %one] {
    view.store %one_f, %value[%zero, %c] : f16, view<64x128xf16>
    view.store %two_f, %value[%one, %c] : f16, view<64x128xf16>
  }
  kernel.return
}

check.case @attention_generated_scale_nonzero_scores {
  %one = check.literal value(1) : index
  %zero = check.literal value(0) : index
  %origin = check.literal value(0) : offset
  %position = check.literal value(1) : i32
  %control = check.generate.fill value(0) : tensor<3xi32>
  %map = check.generate.fill value(0) : tensor<1xi32>
  %cache = check.generate.fill value(0.0) : tensor<16384xf16>
  %query = check.generate.fill value(1.0) : tensor<128xf32>
  %output = check.generate.fill value(-99.0) : tensor<192xf32>
  %values = check.tensor.view %output offset(0) : tensor<192xf32> -> tensor<128xf32>
  %guard = check.tensor.view %output offset(512) : tensor<192xf32> -> tensor<64xf32>
  // score0=0, score1=.125; small-query provider uses F16 P*V.
  // Independently rounded P0=.46875,P1=.53125 -> 1.53125.
  %expected = check.generate.fill value(1.53125) : tensor<128xf32>
  %sentinel = check.generate.fill value(-99.0) : tensor<64xf32>
  kernel.launch @scalar_test_control(%position, %control) : (i32, tensor<3xi32>)
  kernel.launch @scalar_test_cache(%cache) : (tensor<16384xf16>)
  kernel.launch @llama32_attention_rows[%one](%zero, %origin, %one, %origin, %zero, %origin, %control, %map, %query, %cache, %output) : [index](index, offset, index, offset, index, offset, tensor<3xi32>, tensor<1xi32>, tensor<128xf32>, tensor<16384xf16>, tensor<192xf32>)
  check.expect.approximate actual(%values) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<128xf32>, tensor<128xf32>
  check.expect.bitwise actual(%guard) expected(%sentinel) : tensor<64xf32>
  check.return
}

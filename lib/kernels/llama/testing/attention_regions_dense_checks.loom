check.scenario @dense_partial0_n3_p63 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %control = check.generate.fill value(-17) : tensor<7xi32>
    %map = check.generate.fill value(-19) : tensor<10xi32>
    %cache = check.generate.fill value(0.125) : tensor<2097184xf16>
    %factors = check.generate.fill value(1.0) : tensor<64xf32>
    %query = check.generate.fill value(0.0) : tensor<8x3072xf32>
    %key = check.generate.fill value(0.0) : tensor<8x1024xf32>
    %value = check.generate.fill value(0.75) : tensor<8x1024xf32>
    %output = check.generate.fill value(-1.0) : tensor<8x3072xf32>
    %inactive_prefix = check.tensor.view %output offset(0) : tensor<8x3072xf32> -> tensor<6144xf32>
    %inactive_suffix = check.tensor.view %output offset(61440) : tensor<8x3072xf32> -> tensor<9216xf32>
    check.compare<@actual_partial0_n3_p63, @expected_partial0_n3_p63>(%control, %map, %cache, %factors, %query, %key, %value, %output) : (tensor<7xi32>, tensor<10xi32>, tensor<2097184xf16>, tensor<64xf32>, tensor<8x3072xf32>, tensor<8x1024xf32>, tensor<8x1024xf32>, tensor<8x3072xf32>) -> () {
      check.expect.bitwise actual(%control) expected(%control) : tensor<7xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<10xi32>
      check.expect.approximate actual(%cache) expected(%cache) atol(0.0) rtol(0.0) nan(same) : tensor<2097184xf16>, tensor<2097184xf16>
      check.expect.bitwise actual(%factors) expected(%factors) : tensor<64xf32>
      check.expect.bitwise actual(%query) expected(%query) : tensor<8x3072xf32>
      check.expect.bitwise actual(%key) expected(%key) : tensor<8x1024xf32>
      check.expect.bitwise actual(%value) expected(%value) : tensor<8x1024xf32>
      check.expect.bitwise actual(%inactive_prefix) expected(%inactive_prefix) : tensor<6144xf32>
      check.expect.bitwise actual(%inactive_suffix) expected(%inactive_suffix) : tensor<9216xf32>
      check.expect.approximate actual(%output) expected(%output) atol(0.000003) rtol(0.00001) nan(same) : tensor<8x3072xf32>, tensor<8x3072xf32>
    }
  }
  check.return
}

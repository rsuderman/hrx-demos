// Test-only replay/copy/compare helpers; the numerical work is emitted by the
// production session and existing normalized attention/whole-FFN builders.
kernel.def @test.join_packet() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%decode: index, %ordinal: index, %packet: buffer) {
  %origin = index.constant 0 : offset
  %c = buffer.view %packet[%origin] : buffer -> view<3xi32>
  %zero = index.constant 0 : index
  %first = index.cmp eq, %ordinal, %zero : index
  %is_decode = index.cmp ne, %decode, %zero : index
  %three = scalar.constant 3 : i32
  %one = scalar.constant 1 : i32
  %p63 = scalar.constant 63 : i32
  %p67 = scalar.constant 67 : i32
  %p256 = scalar.constant 256 : i32
  %p257 = scalar.constant 257 : i32
  %g7 = scalar.constant 7 : i32
  %g8 = scalar.constant 8 : i32
  %eos = scalar.constant 128001 : i32
  %count = scf.select %first, %three, %one : i32
  %position = scf.select %first, %p63, %p67 : i32
  %decode_position = scf.select %first, %p256, %p257 : i32
  %generated = scf.select %first, %g7, %g8 : i32
  %a = scf.select %is_decode, %decode_position, %count : i32
  %b = scf.select %is_decode, %generated, %position : i32
  view.store %a, %c[0] : i32, view<3xi32>
  view.store %b, %c[1] : i32, view<3xi32>
  view.store %eos, %c[2] : i32, view<3xi32>
  kernel.return
}

kernel.def @test.join_seed(%capacity: index, %compact_capacity: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%capacity: index, %compact_capacity: index, %begin: index, %residual: buffer, %before: buffer, %compact: buffer, %cache: buffer, %before_cache: buffer, %compact_cache: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %width = index.constant 3072 : index
  %extent = index.constant 2097184 : index
  %r = buffer.view %residual[%origin] : buffer -> view<[%capacity]x3072xf32>
  %b = buffer.view %before[%origin] : buffer -> view<[%capacity]x3072xf32>
  %s = buffer.view %compact[%origin] : buffer -> view<[%compact_capacity]x3072xf32>
  scf.for %row = [%zero to %capacity step %one] {
    scf.for %col = [%zero to %width step %one] {
      %v = view.load %r[%row, %col] : view<[%capacity]x3072xf32> -> f32
      view.store %v, %b[%row, %col] : f32, view<[%capacity]x3072xf32>
    }
  }
  scf.for %row = [%zero to %compact_capacity step %one] {
    %source0 = index.add %begin, %row : index
    %source = index.assume %source0 [range(%source0, 0, 7), lt(%source0, %capacity)] : index
    scf.for %col = [%zero to %width step %one] {
      %v = view.load %r[%source, %col] : view<[%capacity]x3072xf32> -> f32
      view.store %v, %s[%row, %col] : f32, view<[%compact_capacity]x3072xf32>
    }
  }
  %a = buffer.view %cache[%origin] : buffer -> view<2097184xi16>
  %b_cache = buffer.view %before_cache[%origin] : buffer -> view<2097184xi16>
  %s_cache = buffer.view %compact_cache[%origin] : buffer -> view<2097184xi16>
  scf.for %i = [%zero to %extent step %one] {
    %v = view.load %a[%i] : view<2097184xi16> -> i16
    view.store %v, %b_cache[%i] : i16, view<2097184xi16>
    view.store %v, %s_cache[%i] : i16, view<2097184xi16>
  }
  kernel.return
}

kernel.def @test.join_compare(%capacity: index, %compact_capacity: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%capacity: index, %compact_capacity: index, %begin: index, %decode: index, %layers: index, %ordinal: index, %packet: buffer, %residual: buffer, %before: buffer, %compact: buffer, %cache: buffer, %before_cache: buffer, %compact_cache: buffer, %status: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %width = index.constant 3072 : index
  %extent = index.constant 2097184 : index
  %plane = index.constant 524288 : index
  %kv = index.constant 1024 : index
  %prefix = index.constant 8 : index
  %end = index.constant 2097160 : index
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %c = buffer.view %packet[%origin] : buffer -> view<3xi32>
  %a = view.load %c[0] : view<3xi32> -> i32
  %b = view.load %c[1] : view<3xi32> -> i32
  %ai = index.cast %a : i32 to index
  %bi = index.cast %b : i32 to index
  %is_decode = index.cmp ne, %decode, %zero : index
  %count0 = scf.select %is_decode, %one, %ai : index
  %count = index.assume %count0 [range(%count0, 1, 3), le(%count0, %compact_capacity)] : index
  %position0 = scf.select %is_decode, %ai, %bi : index
  %position = index.assume %position0 [range(%position0, 0, 508)] : index
  %position_end = index.add %position, %count : index
  %r = buffer.view %residual[%origin] : buffer -> view<[%capacity]x3072xf32>
  %old = buffer.view %before[%origin] : buffer -> view<[%capacity]x3072xf32>
  %small = buffer.view %compact[%origin] : buffer -> view<[%compact_capacity]x3072xf32>
  %all_residual = scf.for %row = [%zero to %capacity step %one](%all = %true : i1) -> (i1) {
    %after_begin = index.cmp uge, %row, %begin : index
    %active = scf.if %after_begin -> (i1) {
      %relative = index.sub %row, %begin : index
      %inside = index.cmp ult, %relative, %count : index
      scf.yield %inside : i1
    } else {
      scf.yield %false : i1
    }
    %row_ok = scf.for %col = [%zero to %width step %one](%ok = %all : i1) -> (i1) {
      %actual = view.load %r[%row, %col] : view<[%capacity]x3072xf32> -> f32
      %prior = view.load %old[%row, %col] : view<[%capacity]x3072xf32> -> f32
      %equal = scf.if %active -> (i1) {
        %relative0 = index.sub %row, %begin : index
        %relative = index.assume %relative0 [range(%relative0, 0, 2), lt(%relative0, %compact_capacity)] : index
        %expected = view.load %small[%relative, %col] : view<[%compact_capacity]x3072xf32> -> f32
        %diff0 = scalar.subf %actual, %expected : f32
        %diff = scalar.absf %diff0 : f32
        %abs_expected = scalar.absf %expected : f32
        %relative_tol = scalar.constant 1.0000000000000001e-05 : f32
        %absolute_tol = scalar.constant 0.0001 : f32
        %rt = scalar.mulf %relative_tol, %abs_expected : f32
        %tol = scalar.addf %rt, %absolute_tol : f32
        %close = scalar.cmpf ole, %diff, %tol : f32
        scf.yield %close : i1
      } else {
        %actual_bits = scalar.bitcast %actual : f32 to i32
        %prior_bits = scalar.bitcast %prior : f32 to i32
        %same = scalar.cmpi eq, %actual_bits, %prior_bits : i32
        scf.yield %same : i1
      }
      %next = scalar.andi %ok, %equal : i1
      scf.yield %next : i1
    }
    scf.yield %row_ok : i1
  }
  %actual_cache = buffer.view %cache[%origin] : buffer -> view<2097184xi16>
  %prior_cache = buffer.view %before_cache[%origin] : buffer -> view<2097184xi16>
  %expected_cache = buffer.view %compact_cache[%origin] : buffer -> view<2097184xi16>
  %all_cache = scf.for %i = [%zero to %extent step %one](%ok = %all_residual : i1) -> (i1) {
    %actual = view.load %actual_cache[%i] : view<2097184xi16> -> i16
    %expected = view.load %expected_cache[%i] : view<2097184xi16> -> i16
    %matches = scalar.cmpi eq, %actual, %expected : i16
    %past_prefix = index.cmp uge, %i, %prefix : index
    %inside = index.cmp ult, %i, %end : index
    %in_arena = scalar.andi %past_prefix, %inside : i1
    %written = scf.if %in_arena -> (i1) {
      %relative = index.sub %i, %prefix : index
      %plane_id = index.div %relative, %plane : index
      %layer = index.div %plane_id, %two : index
      %plane_offset = index.rem %relative, %plane : index
      %token = index.div %plane_offset, %kv : index
      %selected_layer = index.cmp ult, %layer, %layers : index
      %after_position = index.cmp uge, %token, %position : index
      %before_end = index.cmp ult, %token, %position_end : index
      %selected_token = scalar.andi %after_position, %before_end : i1
      %selected = scalar.andi %selected_layer, %selected_token : i1
      scf.yield %selected : i1
    } else {
      scf.yield %false : i1
    }
    %preserved = scf.if %written -> (i1) {
      scf.yield %true : i1
    } else {
      %prior = view.load %prior_cache[%i] : view<2097184xi16> -> i16
      %same = scalar.cmpi eq, %actual, %prior : i16
      scf.yield %same : i1
    }
    %both = scalar.andi %matches, %preserved : i1
    %next = scalar.andi %ok, %both : i1
    scf.yield %next : i1
  }
  %first_row = index.assume %begin [range(%begin, 0, 2), lt(%begin, %capacity)] : index
  %prior = view.load %old[%first_row, %zero] : view<[%capacity]x3072xf32> -> f32
  %after = view.load %r[%first_row, %zero] : view<[%capacity]x3072xf32> -> f32
  %changed = scalar.cmpf one, %after, %prior : f32
  %pass = scalar.andi %all_cache, %changed : i1
  %one32 = scalar.constant 1 : i32
  %zero32 = scalar.constant 0 : i32
  %result = scf.select %pass, %one32, %zero32 : i32
  %status_index = index.assume %ordinal [range(%ordinal, 0, 1)] : index
  %out = buffer.view %status[%origin] : buffer -> view<2xi32>
  view.store %result, %out[%status_index] : i32, view<2xi32>
  kernel.return
}

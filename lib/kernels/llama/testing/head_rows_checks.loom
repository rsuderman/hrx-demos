check.scenario @snapshot_prefill_63 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<24576xf32>
    %gamma = check.generate.iota offset(0.5) step(0.0001) : tensor<3072xf32>
    %control = check.generate.fill value(-99) : tensor<3xi32>
    %raw = check.generate.fill value(7) : tensor<1xi32>
    %history = check.generate.fill value(-99) : tensor<129xi32>
    %progress = check.generate.fill value(-99) : tensor<8xi32>
    %storage = check.generate.fill value(-99.0) : tensor<3076xf32>
    %output = check.tensor.view %storage offset(8) : tensor<3076xf32> -> tensor<3072xf32>
    check.compare<@actual_prefill_63, @reference_prefill_63>(%input, %gamma, %control, %raw, %history, %progress, %output) : (tensor<24576xf32>, tensor<3072xf32>, tensor<3xi32>, tensor<1xi32>, tensor<129xi32>, tensor<8xi32>, tensor<3072xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<24576xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
      check.expect.bitwise actual(%control) expected(%control) : tensor<3xi32>
      check.expect.bitwise actual(%raw) expected(%raw) : tensor<1xi32>
      check.expect.bitwise actual(%history) expected(%history) : tensor<129xi32>
      check.expect.bitwise actual(%progress) expected(%progress) : tensor<8xi32>
      check.expect.close actual(%storage) expected(%storage) atol(0.00005) rtol(0.00005) nan(same) : tensor<3076xf32>
    }
  }
  check.return
}

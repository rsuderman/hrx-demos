command.decl @native.attention() launch(%control: buffer, %map: buffer, %cache: buffer, %factors: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer)
command.decl @native.attention.decode() launch(%control: buffer, %map: buffer, %cache: buffer, %factors: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer)
// Independent scalar oracle: one nonzero-position append to layer1 in native
// page1, followed by two-token attention with historical zero K/V. This includes
// adjacent-pair rotation, factor division, GQA, F16 publication and F16 P*V.
func.def @reference(%control: buffer, %map: buffer, %cache: buffer, %factors: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %q = buffer.view %query[%origin] : buffer -> view<3072xf32>
  %k = buffer.view %key[%origin] : buffer -> view<1024xf32>
  %v = buffer.view %value[%origin] : buffer -> view<1024xf32>
  %f = buffer.view %factors[%origin] : buffer -> view<64xf32>
  %c = buffer.view %cache[%origin] : buffer -> view<524304xf16>
  %o = buffer.view %output[%origin] : buffer -> view<3072xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %eight = index.constant 8 : index
  %heads = index.constant 24 : index
  %width = index.constant 128 : index
  %half = index.constant 64 : index
  %key_base = index.constant 328712 : index
  %value_base = index.constant 459784 : index
  %theta = scalar.constant 0.8146172165870667 : f32
  %one_f = scalar.constant 1.0 : f32
  %zero_f = scalar.constant 0.0 : f32
  %scale = scalar.constant 0.08838834764831845 : f32
  scf.for %h = [%zero to %eight step %one] {
    %hb = index.mul %h, %width : index
    scf.for %pair = [%zero to %half step %one] {
      %freq = scf.for %i = [%zero to %pair step %one](%freq = %one_f : f32) -> (f32) {
        %next = scalar.mulf %freq, %theta : f32
        scf.yield %next : f32
      }
      %factor = view.load %f[%pair] : view<64xf32> -> f32
      %angle = scalar.divf %freq, %factor : f32
      %cs = scalar.cosf<afn> %angle : f32
      %sn = scalar.sinf<afn> %angle : f32
      %p2 = index.mul %pair, %two : index
      %e = index.add %hb, %p2 : index
      %d = index.add %e, %one : index
      %ke = view.load %k[%e] : view<1024xf32> -> f32
      %ko = view.load %k[%d] : view<1024xf32> -> f32
      %ec = scalar.mulf %ke, %cs : f32
      %os = scalar.mulf %ko, %sn : f32
      %es = scalar.mulf %ke, %sn : f32
      %oc = scalar.mulf %ko, %cs : f32
      %re = scalar.subf %ec, %os : f32
      %ro = scalar.addf %es, %oc : f32
      %re16 = scalar.fptrunc %re : f32 to f16
      %ro16 = scalar.fptrunc %ro : f32 to f16
      %ce = index.add %key_base, %e : index
      %co = index.add %key_base, %d : index
      view.store %re16, %c[%ce] : f16, view<524304xf16>
      view.store %ro16, %c[%co] : f16, view<524304xf16>
    }
    scf.for %lane = [%zero to %width step %one] {
      %ix = index.add %hb, %lane : index
      %raw = view.load %v[%ix] : view<1024xf32> -> f32
      %raw16 = scalar.fptrunc %raw : f32 to f16
      %dst = index.add %value_base, %ix : index
      view.store %raw16, %c[%dst] : f16, view<524304xf16>
    }
  }
  scf.for %h = [%zero to %heads step %one] {
    %qh = index.mul %h, %width : index
    %kh = index.div %h, %three : index
    %kb = index.mul %kh, %width : index
    %score = scf.for %pair = [%zero to %half step %one](%acc = %zero_f : f32) -> (f32) {
      %freq = scf.for %i = [%zero to %pair step %one](%freq = %one_f : f32) -> (f32) {
        %next = scalar.mulf %freq, %theta : f32
        scf.yield %next : f32
      }
      %factor = view.load %f[%pair] : view<64xf32> -> f32
      %angle = scalar.divf %freq, %factor : f32
      %cs = scalar.cosf<afn> %angle : f32
      %sn = scalar.sinf<afn> %angle : f32
      %p2 = index.mul %pair, %two : index
      %e = index.add %qh, %p2 : index
      %d = index.add %e, %one : index
      %qe = view.load %q[%e] : view<3072xf32> -> f32
      %qo = view.load %q[%d] : view<3072xf32> -> f32
      %ec = scalar.mulf %qe, %cs : f32
      %os = scalar.mulf %qo, %sn : f32
      %es = scalar.mulf %qe, %sn : f32
      %oc = scalar.mulf %qo, %cs : f32
      %re = scalar.subf %ec, %os : f32
      %ro = scalar.addf %es, %oc : f32
      %ki = index.add %kb, %p2 : index
      %ki0 = index.add %key_base, %ki : index
      %ki1 = index.add %ki0, %one : index
      %ke16 = view.load %c[%ki0] : view<524304xf16> -> f16
      %ko16 = view.load %c[%ki1] : view<524304xf16> -> f16
      %ke = scalar.extf %ke16 : f16 to f32
      %ko = scalar.extf %ko16 : f16 to f32
      %pe = scalar.mulf %re, %ke : f32
      %po = scalar.mulf %ro, %ko : f32
      %sum = scalar.addf %pe, %po : f32
      %scaled = scalar.mulf %sum, %scale : f32
      %next = scalar.addf %acc, %scaled : f32
      scf.yield %next : f32
    }
    %negative = scalar.subf %zero_f, %score : f32
    %ex = scalar.expf<afn> %negative : f32
    %denom = scalar.addf %one_f, %ex : f32
    %prob = scalar.divf %one_f, %denom : f32
    %ph = scalar.fptrunc %prob : f32 to f16
    scf.for %lane = [%zero to %width step %one] {
      %vi = index.add %kb, %lane : index
      %ci = index.add %value_base, %vi : index
      %vh = view.load %c[%ci] : view<524304xf16> -> f16
      %product = scalar.mulf %ph, %vh : f16
      %result = scalar.extf %product : f16 to f32
      %oi = index.add %qh, %lane : index
      view.store %result, %o[%oi] : f32, view<3072xf32>
    }
  }
  func.return
}
check.scenario @native_pooled_layer_append {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %control = check.generate.fill value(1) : tensor<3xi32>
    %map = check.generate.fill value(1) : tensor<1xi32>
    %cache = check.generate.fill value(0.0) : tensor<524304xf16>
    %factors = check.generate.iota offset(1.0) step(0.01) : tensor<64xf32>
    %query = check.generate.iota offset(-0.2) step(0.0001) : tensor<3072xf32>
    %key = check.generate.iota offset(-0.1) step(0.0002) : tensor<1024xf32>
    %value = check.generate.iota offset(-0.5) step(0.001) : tensor<1024xf32>
    %output = check.generate.fill value(0.0) : tensor<3072xf32>
    check.compare<@native.attention, @reference>(%control, %map, %cache, %factors, %query, %key, %value, %output) : (tensor<3xi32>, tensor<1xi32>, tensor<524304xf16>, tensor<64xf32>, tensor<3072xf32>, tensor<1024xf32>, tensor<1024xf32>, tensor<3072xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0006) rtol(0.003) nan(same) : tensor<3072xf32>, tensor<3072xf32>
      check.expect.approximate actual(%cache) expected(%cache) atol(0.0002) rtol(0.002) nan(same) : tensor<524304xf16>, tensor<524304xf16>
      check.expect.bitwise actual(%query) expected(%query) : tensor<3072xf32>
      check.expect.bitwise actual(%key) expected(%key) : tensor<1024xf32>
      check.expect.bitwise actual(%value) expected(%value) : tensor<1024xf32>
    }
  }
  check.return
}

check.scenario @native_decode_pooled_layer_append {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %control = check.generate.fill value(1) : tensor<3xi32>
    %map = check.generate.fill value(1) : tensor<1xi32>
    %cache = check.generate.fill value(0.0) : tensor<524304xf16>
    %factors = check.generate.iota offset(1.0) step(0.01) : tensor<64xf32>
    %query = check.generate.iota offset(-0.2) step(0.0001) : tensor<3072xf32>
    %key = check.generate.iota offset(-0.1) step(0.0002) : tensor<1024xf32>
    %value = check.generate.iota offset(-0.5) step(0.001) : tensor<1024xf32>
    %output = check.generate.fill value(0.0) : tensor<3072xf32>
    check.compare<@native.attention.decode, @reference>(%control, %map, %cache, %factors, %query, %key, %value, %output) : (tensor<3xi32>, tensor<1xi32>, tensor<524304xf16>, tensor<64xf32>, tensor<3072xf32>, tensor<1024xf32>, tensor<1024xf32>, tensor<3072xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0006) rtol(0.003) nan(same) : tensor<3072xf32>, tensor<3072xf32>
      check.expect.approximate actual(%cache) expected(%cache) atol(0.0002) rtol(0.002) nan(same) : tensor<524304xf16>, tensor<524304xf16>
      check.expect.bitwise actual(%query) expected(%query) : tensor<3072xf32>
      check.expect.bitwise actual(%key) expected(%key) : tensor<1024xf32>
      check.expect.bitwise actual(%value) expected(%value) : tensor<1024xf32>
    }
  }
  check.return
}

func.def @reference_noop(%control: buffer, %map: buffer, %cache: buffer, %factors: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  func.return
}
check.scenario @invalid_count_preserves_state {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %control = check.generate.fill value(4) : tensor<3xi32>
    %map = check.generate.fill value(1) : tensor<1xi32>
    %cache = check.generate.fill value(0.0) : tensor<524304xf16>
    %factors = check.generate.iota offset(1.0) step(0.01) : tensor<64xf32>
    %query = check.generate.iota offset(-0.2) step(0.0001) : tensor<3072xf32>
    %key = check.generate.iota offset(-0.1) step(0.0002) : tensor<1024xf32>
    %value = check.generate.iota offset(-0.5) step(0.001) : tensor<1024xf32>
    %output = check.generate.fill value(0.0) : tensor<3072xf32>
    check.compare<@native.attention, @reference_noop>(%control, %map, %cache, %factors, %query, %key, %value, %output) : (tensor<3xi32>, tensor<1xi32>, tensor<524304xf16>, tensor<64xf32>, tensor<3072xf32>, tensor<1024xf32>, tensor<1024xf32>, tensor<3072xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3072xf32>
      check.expect.bitwise actual(%cache) expected(%cache) : tensor<524304xf16>
      check.expect.bitwise actual(%query) expected(%query) : tensor<3072xf32>
      check.expect.bitwise actual(%key) expected(%key) : tensor<1024xf32>
      check.expect.bitwise actual(%value) expected(%value) : tensor<1024xf32>
    }
  }
  check.return
}

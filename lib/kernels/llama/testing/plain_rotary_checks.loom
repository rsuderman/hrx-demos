// Copyright 2026 AMD ROCm Software
// SPDX-License-Identifier: MIT
// Unit-factor adjacent RoPE at actual E2048/Q16/KV8/H128/theta1e8.
// Independent gold: IEEE double angle=p*pow(1e8,-2*pair/128), then
// cos(angle)-sin(angle) and cos(angle)+sin(angle), rounded once to F32.
// This differs from the device recurrence and its range reduction. Query uses
// fixed3e-5 absolute budget; cached key allows one F16 rounding step.
// Nonidentity pages3/2/1/0, active count1/capacity2, nonzero packet/map/cache
// origins, and exact full-buffer guards isolate routing and state ownership.
config.def @llama.model.hidden_size = 2048 : index
config.def @llama.model.query_heads = 16 : index
config.def @llama.model.kv_heads = 8 : index
config.def @llama.model.head_size = 128 : index
config.def @llama.model.kv_size = 1024 : index
config.def @llama.model.layer_count = 1 : index
config.def @llama.attention.cache_capacity = 256 : index
config.def @llama.attention.pool_capacity = 256 : index
config.def @llama.model.rotary_step = 0.7498942093324559 : f32
kernel.decl @llama32_unit_rope_factors() launch(%factors: buffer)
kernel.decl @llama32_rotary_query(%tokens: index) launch(%kind: index, %origin: offset, %begin: index, %control: buffer, %factors: buffer, %projection: buffer, %output: buffer)
kernel.decl @llama32_publish_kv(%tokens: index) launch(%layer: index, %cache_base: offset, %kind: index, %control_origin: offset, %begin: index, %map_origin: offset, %control: buffer, %map: buffer, %factors: buffer, %key: buffer, %value: buffer, %cache: buffer)
func.def @plainrope.setup(%position: i32, %control: buffer, %map: buffer) {
  %origin = index.constant 4 : offset
  %ctl = buffer.view %control[%origin] : buffer -> view<3xi32>
  %mapping = buffer.view %map[%origin] : buffer -> view<4xi32>
  %one = scalar.constant 1 : i32
  %zero = scalar.constant 0 : i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  view.store %one, %ctl[0] : i32, view<3xi32>
  view.store %position, %ctl[1] : i32, view<3xi32>
  view.store %three, %mapping[0] : i32, view<4xi32>
  view.store %two, %mapping[1] : i32, view<4xi32>
  view.store %one, %mapping[2] : i32, view<4xi32>
  view.store %zero, %mapping[3] : i32, view<4xi32>
  func.return
}
kernel.def @plainrope.init() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%position: i32, %control: buffer, %map: buffer) {
  func.call @plainrope.setup(%position, %control, %map) : (i32, buffer, buffer) -> ()
  kernel.return
}
command.def @plainrope.run(%position: index) launch(%control: buffer, %map: buffer, %factors: buffer, %q: buffer, %k: buffer, %v: buffer, %output: buffer, %cache: buffer) {
  %position32 = index.cast %position : index to i32
  kernel.launch @plainrope.init[](%position32, %control, %map) : [](i32, buffer, buffer)
  %two = index.constant 2 : index
  %zero = index.constant 0 : index
  %origin = index.constant 4 : offset
  %cache_begin = index.constant 32 : offset
  %factor_view = buffer.view %factors[%cache_begin] : buffer -> view<64xf32>
  kernel.launch @llama32_unit_rope_factors[](%factor_view) : [](view<64xf32>)
  kernel.launch @llama32_rotary_query[%two](%zero, %origin, %zero, %control, %factor_view, %q, %output) : [index](index, offset, index, buffer, view<64xf32>, buffer, buffer)
  kernel.launch @llama32_publish_kv[%two](%zero, %cache_begin, %zero, %origin, %zero, %origin, %control, %map, %factor_view, %k, %v, %cache) : [index](index, offset, index, offset, index, offset, buffer, buffer, view<64xf32>, buffer, buffer, buffer)
  command.return
}
func.def @plainrope.reference(%ordinal: index, %position: index, %control: buffer, %map: buffer, %factors: buffer, %output: buffer, %cache: buffer) {
  %position32 = index.cast %position : index to i32
  func.call @plainrope.setup(%position32, %control, %map) : (i32, buffer, buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %width = index.constant 128 : index
  %query_width = index.constant 2048 : index
  %kv_width = index.constant 1024 : index
  %page = index.constant 64 : index
  %prefix = index.constant 16 : index
  %plane = index.constant 262144 : index
  %origin = index.constant 0 : offset
  // Independent initializer expectation: only the selected64 values become
  // ones; the eight sentinel words on each side remain bitwise unchanged.
  %factor_origin = index.constant 32 : offset
  %factor_view = buffer.view %factors[%factor_origin] : buffer -> view<64xf32>
  %unit = scalar.constant 1.0 : f32
  scf.for %factor = [%zero to %page step %one] {
    view.store %unit, %factor_view[%factor] : f32, view<64xf32>
  }
  %values = global.load @plainrope.gold : buffer
  %gold = buffer.view %values[%origin] : buffer -> view<5x128xf32>
  %out = buffer.view %output[%origin] : buffer -> view<4112xf32>
  %arena = buffer.view %cache[%origin] : buffer -> view<524320xf16>
  %block = index.div %position, %page : index
  %within = index.rem %position, %page : index
  %mapped = index.sub %three, %block : index
  %page_begin = index.mul %mapped, %page : index
  %physical = index.add %page_begin, %within : index
  %row_add = index.mul %physical, %kv_width : index
  %key_begin = index.add %prefix, %row_add : index
  %value_begin = index.add %key_begin, %plane : index
  %raw_value = scalar.constant 0.75 : f16
  scf.for %column = [%zero to %query_width step %one] {
    %lane = index.rem %column, %width : index
    %expected = view.load %gold[%ordinal, %lane] : view<5x128xf32> -> f32
    view.store %expected, %out[%column] : f32, view<4112xf32>
  }
  scf.for %column = [%zero to %kv_width step %one] {
    %lane = index.rem %column, %width : index
    %expected = view.load %gold[%ordinal, %lane] : view<5x128xf32> -> f32
    %half = scalar.fptrunc %expected : f32 to f16
    %key_index = index.add %key_begin, %column : index
    %value_index = index.add %value_begin, %column : index
    view.store %half, %arena[%key_index] : f16, view<524320xf16>
    view.store %raw_value, %arena[%value_index] : f16, view<524320xf16>
  }
  func.return
}
global.rodata.def @plainrope.gold = bytes("")
command.def public @plainrope.actual0() launch(%control: buffer, %map: buffer, %factors: buffer, %q: buffer, %k: buffer, %v: buffer, %output: buffer, %cache: buffer) {
  %position = index.constant 0 : index
  command.launch @plainrope.run[%position](%control, %map, %factors, %q, %k, %v, %output, %cache) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @plainrope.expected0(%control: buffer, %map: buffer, %factors: buffer, %q: buffer, %k: buffer, %v: buffer, %output: buffer, %cache: buffer) {
  %ordinal = index.constant 0 : index
  %position = index.constant 0 : index
  func.call @plainrope.reference(%ordinal, %position, %control, %map, %factors, %output, %cache) : (index, index, buffer, buffer, buffer, buffer, buffer) -> ()
  func.return
}
check.scenario @plain_rope_p0 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %control = check.generate.fill value(-91) : tensor<5xi32>
    %map = check.generate.fill value(-91) : tensor<6xi32>
    %factors = check.generate.fill value(-13.0) : tensor<80xf32>
    %q = check.generate.fill value(1.0) : tensor<4096xf32>
    %k = check.generate.fill value(1.0) : tensor<2048xf32>
    %v = check.generate.fill value(0.75) : tensor<2048xf32>
    %output = check.generate.fill value(-99.0) : tensor<4112xf32>
    %cache = check.generate.fill value(-7.0) : tensor<524320xf16>
    %active = check.tensor.view %output offset(0) : tensor<4112xf32> -> tensor<2048xf32>
    %inactive = check.tensor.view %output offset(8192) : tensor<4112xf32> -> tensor<2064xf32>
    %cache_prefix = check.tensor.view %cache offset(0) : tensor<524320xf16> -> tensor<196624xf16>
    %cache_key = check.tensor.view %cache offset(393248) : tensor<524320xf16> -> tensor<1024xf16>
    %cache_suffix = check.tensor.view %cache offset(395296) : tensor<524320xf16> -> tensor<326672xf16>
    check.compare<@plainrope.actual0, @plainrope.expected0>(%control, %map, %factors, %q, %k, %v, %output, %cache) : (tensor<5xi32>, tensor<6xi32>, tensor<80xf32>, tensor<4096xf32>, tensor<2048xf32>, tensor<2048xf32>, tensor<4112xf32>, tensor<524320xf16>) -> () {
      check.expect.approximate actual(%active) expected(%active) atol(0.00003) rtol(0.0) nan(same) : tensor<2048xf32>, tensor<2048xf32>
      check.expect.approximate actual(%cache_key) expected(%cache_key) atol(0.001) rtol(0.0) nan(same) : tensor<1024xf16>, tensor<1024xf16>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<2064xf32>
      check.expect.bitwise actual(%cache_prefix) expected(%cache_prefix) : tensor<196624xf16>
      check.expect.bitwise actual(%cache_suffix) expected(%cache_suffix) : tensor<326672xf16>
      check.expect.bitwise actual(%control) expected(%control) : tensor<5xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<6xi32>
      check.expect.bitwise actual(%factors) expected(%factors) : tensor<80xf32>
      check.expect.bitwise actual(%q) expected(%q) : tensor<4096xf32>
      check.expect.bitwise actual(%k) expected(%k) : tensor<2048xf32>
      check.expect.bitwise actual(%v) expected(%v) : tensor<2048xf32>
    }
  }
  check.return
}

config.def @llama.model.hidden_size = 3072 : index

config.def @llama.model.rms_epsilon = 1.0000000000000001e-05 : f32

// GGUF Q/K rows are already permuted for adjacent-pair RoPE.
// rope_freqs.weight supplies 64 F32 divisors; the base alone is insufficient.
config.def @ggml.linear_q4k_q8_1_x4.output_capacity = 8192 : index

// Shared head proofs also cover the Gemma12B vocabulary tail.
config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 262208 : index

// Capacity of the existing shared greedy implementation (historical symbol).
config.def @ggml.linear_q4k_q8_1_x4.token_capacity = 512 : index

config.def @ggml.linear_q6k_q8_1_x4.token_capacity = 512 : index

config.def @ggml.quantize_q8_1_x4.group_capacity = 32768 : index

// Generic projection composition retains declarations for unused formats.

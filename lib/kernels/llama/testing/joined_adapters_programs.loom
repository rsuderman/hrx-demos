// Maintained test call wiring; numerical bodies are linked from owned kernels.

config.def @llama.model.layer_count = 2 : index

config.def @llama.model.query_heads = 24 : index

config.def @llama.model.kv_heads = 8 : index

config.def @llama.model.head_size = 128 : index

config.def @llama.model.kv_size = 1024 : index

config.def @llama.attention.cache_capacity = 512 : %5: index where [range(%5, 1, 131072), range(%5, 1, 131072)]

config.def @llama.attention.pool_capacity = 0 : %6: index where [range(%6, 0, 4194304), multiple_of(%6, 64), range(%6, 0, 4194304), multiple_of(%6, 64)]

config.def @llama.model.hidden_size = 3072 : index

config.def @llama.model.rms_epsilon = 1.0000000000000001e-05 : f32

// GGUF Q/K rows are already permuted for adjacent-pair RoPE.
// rope_freqs.weight supplies 64 F32 divisors; the base alone is insufficient.

config.def @ggml.linear_q4k_q8_1_x4.output_capacity = 8192 : %1005: index where [range(%1005, 1, 262144)]

config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 128256 : %1006: index where [range(%1006, 1, 262144)]

// Capacity of the existing shared greedy implementation (historical symbol).

config.def @ggml.linear_q4k_q8_1_x4.token_capacity = 512 : %1007: index where [range(%1007, 1, 2048)]

config.def @ggml.linear_q6k_q8_1_x4.token_capacity = 512 : %1008: index where [range(%1008, 1, 2048)]

config.def @ggml.quantize_q8_1_x4.group_capacity = 32768 : %1009: index where [range(%1009, 1, 524288)]

// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Snapshot active rows before publication changes the original packet.


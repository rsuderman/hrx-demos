// Explicit checkpoint IDs for this existing independent numerical fixture.
config.def @llama.publication.end_text_id = 128001 : i32
config.def @llama.publication.end_message_id = 128008 : i32
config.def @llama.publication.end_turn_id = 128009 : i32

// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Maintained test call wiring; numerical bodies are linked from owned kernels.

config.def @llama.model.hidden_size = 3072 : index

config.def @llama.model.rms_epsilon = 1.0000000000000001e-05 : f32

config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 128256 : %51: index where [range(%51, 1, 262144)]

config.def @ggml.linear_q6k_q8_1_x4.token_capacity = 512 : %52: index where [range(%52, 1, 2048)]

config.def @ggml.quantize_q8_1_x4.group_capacity = 32768 : %53: index where [range(%53, 1, 524288)]

// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Snapshot active rows for the numerical head; the source packet remains immutable.

config.def @llama.model.vocabulary_size = 128256 : index

config.def @qwen38.greedy_argmax.output_capacity = 128256 : %771: index where [range(%771, 256, 262144)]

// Selects the lowest token ID having the greatest finite logit. The baseline
// reduction provides a one-workgroup oracle. Command programs use the
// two-stage tiled reduction to expose vocabulary parallelism while keeping
// logits and intermediate winners device-local.
amdgpu.target<gfx11-generic> @qwen38_greedy_argmax_gfx11_wave64 {subgroup_size = 64}

// Generic MMQ active-extent selection, shared by explicit producer/consumer policies.

kernel.decl @llama32_publish_epoch_id() launch(%epoch: buffer, %selected_ids: buffer, %output_ids: buffer)

kernel.decl @llm.epoch.snapshot_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

kernel.decl @llama32_output_norm_last_f32(%token_capacity: index) launch(%token_capacity0: index, %token_begin0: index, %control_origin: offset, %control: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @llama32_token_embedding_active_q6k_f32(%token_count0: index) launch(%token_count0: index, %begin: index, %count_origin: offset, %count: buffer, %token_ids: buffer, %weight: buffer, %output: buffer)

template.decl @llm.output.last_greedy(%capacity: index, %begin: index, %origin: offset, %hidden: index, %vocab: index, %weight_bytes: index, %policy: index, %weight_tag: index, %q8_bytes: offset, %logit_bytes: offset, %partial_bytes: offset, %input: buffer, %control: buffer, %gamma: view<[%hidden]xf32>, %weight: view<[%weight_bytes]xi8>, %normalized: buffer, %token: buffer)

command.def public retain @head.rows.prefill() launch(%v0: buffer, %v1: buffer, %v2: buffer, %v3: buffer, %v4: buffer, %v5: buffer, %v6: buffer) {
  command.serial {
    %v7 = index.constant 12 : offset
    %v8 = buffer.alloca<global> align(4) %v7 : buffer
    %v9 = index.constant 0 : index
    %v10 = index.constant 0 : offset
    kernel.launch @llm.epoch.snapshot_count(%v9, %v10, %v2, %v8) : (index, offset, buffer, buffer)
    %v12 = index.constant 8 : index
    %v13 = index.constant 2 : index
    %v14 = index.constant 0 : offset
    kernel.launch @llama32_output_norm_last_f32[%v12](%v12, %v13, %v14, %v8, %v0, %v1, %v6) : [index](index, index, offset, buffer, buffer, buffer, buffer)
  }
  command.return
}

command.def public retain @head.rows.decode() launch(%v0: buffer, %v1: buffer, %v2: buffer, %v3: buffer, %v4: buffer, %v5: buffer, %v6: buffer) {
  command.serial {
    %v7 = index.constant 12 : offset
    %v8 = buffer.alloca<global> align(4) %v7 : buffer
    %v9 = index.constant 1 : index
    %v10 = index.constant 0 : offset
    kernel.launch @llm.epoch.snapshot_count(%v9, %v10, %v2, %v8) : (index, offset, buffer, buffer)
    %v12 = index.constant 1 : index
    %v13 = index.constant 0 : index
    %v14 = index.constant 0 : offset
    kernel.launch @llama32_output_norm_last_f32[%v12](%v12, %v13, %v14, %v8, %v0, %v1, %v6) : [index](index, index, offset, buffer, buffer, buffer, buffer)
  }
  command.return
}


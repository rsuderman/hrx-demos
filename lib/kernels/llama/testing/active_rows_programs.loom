// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Maintained test call wiring; numerical bodies are linked from owned kernels.

config.def @llama.model.hidden_size = 3072 : index

// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT

config.def @llama.model.vocabulary_size = 128256 : index

config.def @llama.model.rms_epsilon = 1.0000000000000001e-05 : f32

// GGUF Q/K rows are already permuted for adjacent-pair RoPE.
// rope_freqs.weight supplies 64 F32 divisors; the base alone is insufficient.

config.def @ggml.linear_q4k_q8_1_x4.output_capacity = 8192 : %173: index where [range(%173, 1, 262144)]

config.def @ggml.linear_q6k_q8_1_x4.output_capacity = 128256 : %174: index where [range(%174, 1, 262144)]

// Capacity of the existing shared greedy implementation (historical symbol).

config.def @ggml.linear_q4k_q8_1_x4.token_capacity = 512 : %175: index where [range(%175, 1, 2048)]

config.def @ggml.linear_q6k_q8_1_x4.token_capacity = 512 : %176: index where [range(%176, 1, 2048)]

config.def @ggml.quantize_q8_1_x4.group_capacity = 32768 : %177: index where [range(%177, 1, 524288)]

// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Test setup copies compact defined rows into otherwise uninitialized native
// storage. No padding is initialized to make the numerical providers safe.


command.decl @registered.norm() launch(%input: buffer, %gamma: buffer, %output: buffer)

// Independent scalar reference; no dispatch or production motif call.
func.def @reference_norm(%input: buffer, %gamma: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %x = buffer.view %input[%origin] : buffer -> view<2x3072xf32>
  %g = buffer.view %gamma[%origin] : buffer -> view<3072xf32>
  %y = buffer.view %output[%origin] : buffer -> view<2x3072xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %width = index.constant 3072 : index
  %zero_f = scalar.constant 0.0 : f32
  %width_f = scalar.constant 3072.0 : f32
  %epsilon = scalar.constant 1.0000000000000001e-05 : f32
  scf.for %r = [%zero to %two step %one] {
    %sum = scf.for %c = [%zero to %width step %one](%partial = %zero_f : f32) -> (f32) {
      %v = view.load %x[%r, %c] : view<2x3072xf32> -> f32
      %square = scalar.mulf %v, %v : f32
      %next = scalar.addf %partial, %square : f32
      scf.yield %next : f32
    }
    %mean = scalar.divf %sum, %width_f : f32
    %shifted = scalar.addf %mean, %epsilon : f32
    %scale = scalar.rsqrtf %shifted : f32
    scf.for %c = [%zero to %width step %one] {
      %v = view.load %x[%r, %c] : view<2x3072xf32> -> f32
      %weight = view.load %g[%c] : view<3072xf32> -> f32
      %normalized = scalar.mulf %v, %scale : f32
      %norm = scalar.mulf %normalized, %weight : f32
      %result = scalar.addf %norm, %v : f32
      view.store %result, %y[%r, %c] : f32, view<2x3072xf32>
    }
  }
  func.return
}

check.scenario @registered_producer_allocation {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<6144xf32>
    %gamma = check.generate.iota offset(0.5) step(0.0001) : tensor<3072xf32>
    %storage = check.generate.fill value(-99.0) : tensor<6148xf32>
    %output = check.tensor.view %storage offset(8) : tensor<6148xf32> -> tensor<6144xf32>
    check.compare<@registered.norm, @reference_norm>(%input, %gamma, %output) : (tensor<6144xf32>, tensor<3072xf32>, tensor<6144xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(5.0000000000000002e-05) rtol(5.0000000000000002e-05) nan(same) : tensor<6148xf32>, tensor<6148xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<6144xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
    }
  }
  check.return
}

}

command.decl @loomify.llama.attention(%layer: index, %phase: index, %rows: index, %origin: offset) launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %control: buffer, %map: buffer, %cache: buffer)

// The fixture initializes borrowed parameters in-place, then calls the ACTUAL
// maintained E→Q/K/V→RoPE→GQA→Q→E→residual command without reproducing it.
kernel.def @minicpm.composed_weights() {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%q: buffer, %k: buffer, %v: buffer, %o: buffer) {
  %origin = index.constant 0 : offset
  %wide = index.constant 1769472 : index
  %narrow = index.constant 221184 : index
  %step = index.constant 256 : index
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : index
  %zero_byte = scalar.constant 0 : i8
  %qw = buffer.view %q[%origin] : buffer -> view<1769472xi8>
  %kw = buffer.view %k[%origin] : buffer -> view<221184xi8>
  %vw = buffer.view %v[%origin] : buffer -> view<221184xi8>
  %ow = buffer.view %o[%origin] : buffer -> view<1769472xi8>
  scf.for %i = [%lane to %wide step %step] {
    view.store %zero_byte, %qw[%i] : i8, view<1769472xi8>
    view.store %zero_byte, %ow[%i] : i8, view<1769472xi8>
  }
  scf.for %i = [%lane to %narrow step %step] {
    view.store %zero_byte, %kw[%i] : i8, view<221184xi8>
    view.store %zero_byte, %vw[%i] : i8, view<221184xi8>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %writer = index.cmp eq, %lane, %zero : index
  scf.if %writer {
    // Input0 projects to Q head15/lane0, K head1/lane0, V head1/lane127.
    // Each is1/128, so input127/254 gives exactly127/128 and254/128.
    %q_base = index.constant 1658880 : offset
    %k_base = index.constant 110592 : offset
    %v_base = index.constant 220320 : offset
    %qd = buffer.view %q[%q_base] : buffer -> view<1xf16>
    %kd = buffer.view %k[%k_base] : buffer -> view<1xf16>
    %vd = buffer.view %v[%v_base] : buffer -> view<1xf16>
    %delta = scalar.constant 0.0078125 : f16
    view.store %delta, %qd[%zero] : f16, view<1xf16>
    view.store %delta, %kd[%zero] : f16, view<1xf16>
    view.store %delta, %vd[%zero] : f16, view<1xf16>
    %scale = scalar.constant 1 : i8
    view.store %scale, %qw[1658884] : i8, view<1769472xi8>
    view.store %scale, %qw[1658896] : i8, view<1769472xi8>
    view.store %scale, %kw[110596] : i8, view<221184xi8>
    view.store %scale, %kw[110608] : i8, view<221184xi8>
    view.store %scale, %vw[220324] : i8, view<221184xi8>
    view.store %scale, %vw[220336] : i8, view<221184xi8>
    // O row1535, column2047: block7/group7/last high nibble.
    %o_base = index.constant 1769328 : offset
    %od = buffer.view %o[%o_base] : buffer -> view<1xf16>
    %one_half = scalar.constant 1.0 : f16
    view.store %one_half, %od[%zero] : f16, view<1xf16>
    view.store %scale, %ow[1769343] : i8, view<1769472xi8>
    %high_nibble = scalar.constant 16 : i8
    view.store %high_nibble, %ow[1769471] : i8, view<1769472xi8>
  }
  kernel.return
}

command.def public @minicpm.composed_attention() launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %control: buffer, %map: buffer, %cache: buffer) {
  %q = command.parameter %parameters, "blk.0.attn_q.weight" : view<1769472xi8>
  %k = command.parameter %parameters, "blk.0.attn_k.weight" : view<221184xi8>
  %v = command.parameter %parameters, "blk.0.attn_v.weight" : view<221184xi8>
  %o = command.parameter %parameters, "blk.0.attn_output.weight" : view<1769472xi8>
  kernel.launch @minicpm.composed_weights(%q, %k, %v, %o) : (view<1769472xi8>, view<221184xi8>, view<221184xi8>, view<1769472xi8>)
  %zero = index.constant 0 : index
  %rows = index.constant 3 : index
  %origin = index.constant 0 : offset
  command.launch @loomify.llama.attention[%zero, %zero, %rows, %origin](%parameters, %normalized, %residual, %count, %control, %map, %cache) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}


      check.expect.bitwise actual(%logit_owner) expected(%logit_owner) : tensor<786628xf32>
      check.expect.bitwise actual(%partial_owner) expected(%partial_owner) : tensor<199xf32>
      check.expect.bitwise actual(%partial_id_owner) expected(%partial_id_owner) : tensor<199xi32>
      check.expect.bitwise actual(%id_owner) expected(%id_owner) : tensor<7xi32>
    }
  }
  check.return
}


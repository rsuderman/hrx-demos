}

// Three independent rows exercise the 65th, 64-element partial tile: last-ID
// winner, low-ID tie across full tiles, and a tie across the old vocabulary end.
func.def @full_vocab_logits(%logits: buffer) {
  %origin = index.constant 0 : offset
  %v = buffer.view %logits[%origin] : buffer -> view<3x262208xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %end = index.constant 262208 : index
  %tile = index.constant 4096 : index
  %low = scalar.constant -1.0 : f32
  %high = scalar.constant 99.0 : f32
  scf.for %c = [%zero to %end step %one] {
    %id = index.cast %c : index to i32
    %ascending = scalar.uitofp %id : i32 to f32
    %local = index.rem %c, %tile : index
    %local32 = index.cast %local : index to i32
    %tied = scalar.uitofp %local32 : i32 to f32
    view.store %ascending, %v[0, %c] : f32, view<3x262208xf32>
    view.store %tied, %v[1, %c] : f32, view<3x262208xf32>
    view.store %low, %v[2, %c] : f32, view<3x262208xf32>
  }
  view.store %high, %v[2, 262143] : f32, view<3x262208xf32>
  view.store %high, %v[2, 262144] : f32, view<3x262208xf32>
  func.return
}

command.def @full_vocab_argmax() launch(%logits: buffer, %partial: buffer, %partial_ids: buffer, %ids: buffer) {
  %rows = index.constant 3 : index
  %vocab = index.constant 262208 : index
  kernel.launch @qwen38_greedy_argmax_partial_rows_f32[%rows, %vocab](%rows, %vocab, %logits, %partial, %partial_ids) : [index, index](index, index, buffer, buffer, buffer)
  kernel.launch @qwen38_greedy_argmax_reduce_rows_f32[%rows, %vocab](%rows, %vocab, %partial, %partial_ids, %ids) : [index, index](index, index, buffer, buffer, buffer)
  command.return
}

func.def @full_vocab_expected(%logits: buffer, %partial: buffer, %partial_ids: buffer, %ids: buffer) {
  %origin = index.constant 0 : offset
  %p = buffer.view %partial[%origin] : buffer -> view<3x65xf32>
  %pi = buffer.view %partial_ids[%origin] : buffer -> view<3x65xi32>
  %out = buffer.view %ids[%origin] : buffer -> view<3xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %parts = index.constant 65 : index
  %tile = index.constant 4096 : index
  %last = index.constant 262207 : index
  %tail = index.constant 64 : index
  %full_max = scalar.constant 4095.0 : f32
  %tail_max = scalar.constant 63.0 : f32
  %low = scalar.constant -1.0 : f32
  %high = scalar.constant 99.0 : f32
  %full_id = scalar.constant 4095 : i32
  %tail_id = scalar.constant 262207 : i32
  %boundary_id = scalar.constant 262143 : i32
  scf.for %part = [%zero to %parts step %one] {
    %begin = index.mul %part, %tile : index
    %next = index.add %part, %one : index
    %end = index.mul %next, %tile : index
    %last0 = index.sub %end, %one : index
    %bounded_last = index.min %last0, %last : index
    %id = index.cast %bounded_last : index to i32
    %value = scalar.uitofp %id : i32 to f32
    %is_tail = index.cmp eq, %part, %tail : index
    %tie_value = scf.select %is_tail, %tail_max, %full_max : f32
    %begin32 = index.cast %begin : index to i32
    view.store %value, %p[0, %part] : f32, view<3x65xf32>
    view.store %id, %pi[0, %part] : i32, view<3x65xi32>
    view.store %tie_value, %p[1, %part] : f32, view<3x65xf32>
    view.store %id, %pi[1, %part] : i32, view<3x65xi32>
    view.store %low, %p[2, %part] : f32, view<3x65xf32>
    view.store %begin32, %pi[2, %part] : i32, view<3x65xi32>
  }
  %image_id = scalar.constant 262144 : i32
  view.store %high, %p[2, 63] : f32, view<3x65xf32>
  view.store %boundary_id, %pi[2, 63] : i32, view<3x65xi32>
  view.store %high, %p[2, 64] : f32, view<3x65xf32>
  view.store %image_id, %pi[2, 64] : i32, view<3x65xi32>
  view.store %tail_id, %out[0] : i32, view<3xi32>
  view.store %full_id, %out[1] : i32, view<3xi32>
  view.store %boundary_id, %out[2] : i32, view<3xi32>
  func.return
}


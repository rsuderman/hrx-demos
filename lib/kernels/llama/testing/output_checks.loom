  scf.for %i = [%begin to %end step %one] {
    view.store %minus_one, %row[%i] : i8, view<210xi8>
  }
  %d0 = scalar.constant 0 : i8
  %d1 = scalar.constant 60 : i8
  view.store %d0, %row[208] : i8, view<210xi8>
  view.store %d1, %row[209] : i8, view<210xi8>
  func.return
}


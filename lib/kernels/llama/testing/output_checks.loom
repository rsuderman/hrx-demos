// All earlier rows decode to zero. Only physical row262207 has positive
// weights, so its independent winning ID also proves the final byte stride.
func.def @full_vocab_q8_weights(%weights: buffer) {
  %last_origin = index.constant 71320304 : offset
  %row = buffer.view %weights[%last_origin] : buffer -> view<272xi8>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %blocks = index.constant 8 : index
  %stride = index.constant 34 : index
  %two = index.constant 2 : index
  %byte_one = scalar.constant 1 : i8
  %d0 = scalar.constant 0 : i8
  %d1 = scalar.constant 60 : i8
  scf.for %block = [%zero to %blocks step %one] {
    %begin = index.mul %block, %stride : index
    %scale_hi = index.add %begin, %one : index
    view.store %d0, %row[%begin] : i8, view<272xi8>
    view.store %d1, %row[%scale_hi] : i8, view<272xi8>
    %payload = index.add %begin, %two : index
    %end = index.add %begin, %stride : index
    scf.for %i = [%payload to %end step %one] {
      view.store %byte_one, %row[%i] : i8, view<272xi8>
    }
  }
  func.return
}


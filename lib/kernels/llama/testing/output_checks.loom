// weights, so its independent winning ID also proves the final byte stride.
func.def @full_vocab_q14_weights(%weights: buffer) {
  %last_origin = index.constant 55063470 : offset
  %row = buffer.view %weights[%last_origin] : buffer -> view<210xi8>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %begin = index.constant 192 : index
  %end = index.constant 208 : index

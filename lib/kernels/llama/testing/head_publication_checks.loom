// Actual registered full head then publication; equal nonzero Q6 vocabulary
// rows independently imply greedy token zero. Embedding reads immutable IDs;
// the private raw winner and selected public output are distinct guarded buffers.
// M3 tests row selection numerically. No isolated history/progress mutation remains.
command.decl @head.full.prefill() launch(%weights: buffer, %input: buffer, %gamma: buffer, %epoch: buffer, %input_ids: buffer, %output_ids: buffer, %selected_ids: buffer)
func.def @init_prefill(%epoch: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %eos_origin = index.constant 2060 : offset
  %selection_origin = index.constant 1292 : offset
  %options_origin = index.constant 1548 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %descriptor = buffer.view %epoch[%descriptor_origin] : buffer -> view<5xi32>
  %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %selection = buffer.view %epoch[%selection_origin] : buffer -> view<64xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<2xi32>
  %extent = scalar.constant 5 : i32
  %one = scalar.constant 1 : i32
  %length = scalar.constant 3 : i32
  %position = scalar.constant 63 : i32
  %begin = scalar.constant 2 : i32
  %zero = scalar.constant 0 : i32
  %slot = scalar.constant 2 : i32
  %eos = scalar.constant 128001 : i32
  view.store %extent, %header[0] : i32, view<3xi32>
  view.store %one, %header[1] : i32, view<3xi32>
  view.store %one, %header[2] : i32, view<3xi32>
  view.store %length, %descriptor[0] : i32, view<5xi32>
  view.store %position, %descriptor[1] : i32, view<5xi32>
  view.store %begin, %descriptor[2] : i32, view<5xi32>
  view.store %zero, %descriptor[3] : i32, view<5xi32>
  view.store %slot, %descriptor[4] : i32, view<5xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  %last = scalar.constant 4 : i32
  view.store %last, %selection[0] : i32, view<64xi32>
  view.store %zero, %options[0] : i32, view<2xi32>
  view.store %zero, %options[1] : i32, view<2xi32>
  func.return
}
kernel.def @init_kernel_prefill() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer) {
  func.call @init_prefill(%epoch) : (buffer) -> ()
  kernel.return
}
command.def public @actual_prefill() launch(%weights: buffer, %input: buffer, %gamma: buffer, %epoch: buffer, %input_ids: buffer, %output_ids: buffer, %selected_ids: buffer) {
  kernel.launch @init_kernel_prefill[](%epoch) : [](buffer)
  command.launch @head.full.prefill[](%weights, %input, %gamma, %epoch, %input_ids, %output_ids, %selected_ids) : [](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @reference_prefill(%weights: buffer, %input: buffer, %gamma: buffer, %epoch: buffer, %input_ids: buffer, %output_ids: buffer, %selected_ids: buffer) {
  func.call @init_prefill(%epoch) : (buffer) -> ()
  %origin = index.constant 0 : offset
  %public = buffer.view %output_ids[%origin] : buffer -> view<20xi32>
  %private = buffer.view %selected_ids[%origin] : buffer -> view<8xi32>
  %winner = scalar.constant 0 : i32
  view.store %winner, %public[2] : i32, view<20xi32>
  view.store %winner, %private[0] : i32, view<8xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<8x3072xf32>
  %begin = index.constant 2 : index
  %end = index.constant 5 : index
  %width = index.constant 3072 : index
  %step = index.constant 1 : index
  %zero_idx = index.constant 0 : index
  %c128 = index.constant 128 : index
  %c32 = index.constant 32 : index
  %delta = scalar.constant 0.00001531839370727539 : f32
  %code0 = scalar.constant -15.0 : f32
  %code1 = scalar.constant -31.0 : f32
  %code2 = scalar.constant -32.0 : f32
  scf.for %row = [%begin to %end step %step] {
    scf.for %col = [%zero_idx to %width step %step] {
      %local = index.rem %col, %c128 : index
      %quadrant = index.div %local, %c32 : index
      %first = index.cmp eq, %quadrant, %zero_idx : index
      %second = index.cmp eq, %quadrant, %step : index
      %upper = scf.select %second, %code1, %code2 : f32
      %code = scf.select %first, %code0, %upper : f32
      %v = scalar.mulf %delta, %code : f32
      view.store %v, %input_view[%row, %col] : f32, view<8x3072xf32>
    }
  }
  func.return
}
check.scenario @registered_head_then_publication_prefill {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %weights = check.generate.fill value(1) : tensor<323205120xi8>
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<8x3072xf32>
    %gamma = check.generate.fill value(1.0) : tensor<3072xf32>
    %epoch = check.generate.fill value(-99) : tensor<1048xi32>
    %input_ids = check.generate.fill value(1) : tensor<129xi32>
    %output_ids = check.generate.fill value(-99) : tensor<20xi32>
    %selected_ids = check.generate.fill value(-99) : tensor<8xi32>
    check.compare<@actual_prefill, @reference_prefill>(%weights, %input, %gamma, %epoch, %input_ids, %output_ids, %selected_ids) : (tensor<323205120xi8>, tensor<8x3072xf32>, tensor<3072xf32>, tensor<1048xi32>, tensor<129xi32>, tensor<20xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%weights) expected(%weights) : tensor<323205120xi8>
      check.expect.bitwise actual(%input) expected(%input) : tensor<8x3072xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%input_ids) expected(%input_ids) : tensor<129xi32>
      check.expect.bitwise actual(%output_ids) expected(%output_ids) : tensor<20xi32>
      check.expect.bitwise actual(%selected_ids) expected(%selected_ids) : tensor<8xi32>
    }
  }
  check.return
}
command.decl @head.full.decode() launch(%weights: buffer, %input: buffer, %gamma: buffer, %epoch: buffer, %input_ids: buffer, %output_ids: buffer, %selected_ids: buffer)
func.def @init_decode(%epoch: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %eos_origin = index.constant 2060 : offset
  %selection_origin = index.constant 1292 : offset
  %options_origin = index.constant 1548 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %descriptor = buffer.view %epoch[%descriptor_origin] : buffer -> view<5xi32>
  %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %selection = buffer.view %epoch[%selection_origin] : buffer -> view<64xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<2xi32>
  %extent = scalar.constant 1 : i32
  %one = scalar.constant 1 : i32
  %length = scalar.constant 1 : i32
  %position = scalar.constant 256 : i32
  %begin = scalar.constant 0 : i32
  %zero = scalar.constant 0 : i32
  %slot = scalar.constant 7 : i32
  %eos = scalar.constant 128001 : i32
  view.store %extent, %header[0] : i32, view<3xi32>
  view.store %one, %header[1] : i32, view<3xi32>
  view.store %one, %header[2] : i32, view<3xi32>
  view.store %length, %descriptor[0] : i32, view<5xi32>
  view.store %position, %descriptor[1] : i32, view<5xi32>
  view.store %begin, %descriptor[2] : i32, view<5xi32>
  view.store %zero, %descriptor[3] : i32, view<5xi32>
  view.store %slot, %descriptor[4] : i32, view<5xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  %last = scalar.constant 0 : i32
  view.store %last, %selection[0] : i32, view<64xi32>
  view.store %zero, %options[0] : i32, view<2xi32>
  view.store %zero, %options[1] : i32, view<2xi32>
  func.return
}
kernel.def @init_kernel_decode() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer) {
  func.call @init_decode(%epoch) : (buffer) -> ()
  kernel.return
}
command.def public @actual_decode() launch(%weights: buffer, %input: buffer, %gamma: buffer, %epoch: buffer, %input_ids: buffer, %output_ids: buffer, %selected_ids: buffer) {
  kernel.launch @init_kernel_decode[](%epoch) : [](buffer)
  command.launch @head.full.decode[](%weights, %input, %gamma, %epoch, %input_ids, %output_ids, %selected_ids) : [](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @reference_decode(%weights: buffer, %input: buffer, %gamma: buffer, %epoch: buffer, %input_ids: buffer, %output_ids: buffer, %selected_ids: buffer) {
  func.call @init_decode(%epoch) : (buffer) -> ()
  %origin = index.constant 0 : offset
  %public = buffer.view %output_ids[%origin] : buffer -> view<20xi32>
  %private = buffer.view %selected_ids[%origin] : buffer -> view<8xi32>
  %winner = scalar.constant 0 : i32
  view.store %winner, %public[7] : i32, view<20xi32>
  view.store %winner, %private[0] : i32, view<8xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<1x3072xf32>
  %begin = index.constant 0 : index
  %end = index.constant 1 : index
  %width = index.constant 3072 : index
  %step = index.constant 1 : index
  %zero_idx = index.constant 0 : index
  %c128 = index.constant 128 : index
  %c32 = index.constant 32 : index
  %delta = scalar.constant 0.00001531839370727539 : f32
  %code0 = scalar.constant -15.0 : f32
  %code1 = scalar.constant -31.0 : f32
  %code2 = scalar.constant -32.0 : f32
  scf.for %row = [%begin to %end step %step] {
    scf.for %col = [%zero_idx to %width step %step] {
      %local = index.rem %col, %c128 : index
      %quadrant = index.div %local, %c32 : index
      %first = index.cmp eq, %quadrant, %zero_idx : index
      %second = index.cmp eq, %quadrant, %step : index
      %upper = scf.select %second, %code1, %code2 : f32
      %code = scf.select %first, %code0, %upper : f32
      %v = scalar.mulf %delta, %code : f32
      view.store %v, %input_view[%row, %col] : f32, view<1x3072xf32>
    }
  }
  func.return
}
check.scenario @registered_head_then_publication_decode {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %weights = check.generate.fill value(1) : tensor<323205120xi8>
    %input = check.generate.iota offset(-3.0) step(0.001) : tensor<1x3072xf32>
    %gamma = check.generate.fill value(1.0) : tensor<3072xf32>
    %epoch = check.generate.fill value(-99) : tensor<1048xi32>
    %input_ids = check.generate.fill value(1) : tensor<129xi32>
    %output_ids = check.generate.fill value(-99) : tensor<20xi32>
    %selected_ids = check.generate.fill value(-99) : tensor<8xi32>
    check.compare<@actual_decode, @reference_decode>(%weights, %input, %gamma, %epoch, %input_ids, %output_ids, %selected_ids) : (tensor<323205120xi8>, tensor<1x3072xf32>, tensor<3072xf32>, tensor<1048xi32>, tensor<129xi32>, tensor<20xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%weights) expected(%weights) : tensor<323205120xi8>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1x3072xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<3072xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%input_ids) expected(%input_ids) : tensor<129xi32>
      check.expect.bitwise actual(%output_ids) expected(%output_ids) : tensor<20xi32>
      check.expect.bitwise actual(%selected_ids) expected(%selected_ids) : tensor<8xi32>
    }
  }
  check.return
}

load("//build_tools:loom_merge.bzl", "loom_merge")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
load("@hrx_system//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
package(default_visibility = ["//visibility:public"])

# The same owned numerical files back each maintained test call sequence.
_NUMERICAL = ["//lib/kernels/llama:configured_provider_sources"]
_CASES = {
    "registered_norm": [],
    "attention_sequence": ["attention_capacity.loom"],
    "attention_regions_dense": [],
    "attention_regions_pooled": [],
    "attention_output": [],
    "llama_count": ["count_observe.loom"],
    "active_rows": ["active_row_seed.loom"],
    "head_rows": [],
    "joined_adapters": ["joined_adapters.loom"],
}
[loom_merge(
    name = case + "_" + format,
    srcs = [case + "_programs.loom"] + helpers + _NUMERICAL,
    output_format = format,
    testonly = True,
) for case, helpers in _CASES.items() for format in (["text", "bc"] if case in ["head_rows", "joined_adapters"] else ["bc"])]

_DIRECT = {
    "embedding": ["embedding_checks.loom", "//lib/kernels/llama:embedding/embedding.loom", "//lib/kernels/embedding:q6k_rows.loom", "//lib/kernels/llama:embedding/embedding_config.loom", "//lib/kernels/llama:active_rows.loom", "//lib/kernels/llama:config.loom"],
    "projection": ["projection_checks.loom", "//lib/kernels/llama:config.loom", "//lib/kernels/llama:active_rows.loom", "//lib/kernels/projection:q4k.loom", "//lib/kernels/projection:q4k_compat.loom", "//lib/kernels/projection:q6k.loom", "//lib/kernels/projection:q6k_compat.loom", "//lib/kernels/projection:qk_common.loom", "//lib/kernels/projection:qk_mmvq_compat.loom", "//lib/kernels/quantization:q8_1_x4.loom", "//lib/kernels/quantization:q8_1_x4_mmvq_compat.loom"],
}
[loom_test(name = name + "_execution_test", srcs = sources, benchmark_smoke = False, execution_profiles = [AMDGPU_HARDWARE_PROFILE]) for name, sources in _DIRECT.items()]
loom_test(name = "output_execution_test", srcs = ["output_checks.loom"], deps = ["//lib/kernels/llama:output", "//lib/kernels/llama:publication"], benchmark_smoke = False, execution_profiles = [AMDGPU_HARDWARE_PROFILE])
_CHECKS = {
    "registered_norm": ["registered_norm_checks.loom"],
    "attention_sequence": ["attention_sequence_checks.loom"],
    "attention_regions_dense": ["attention_regions_reference.loom", "attention_regions_dense_checks.loom"],
    "attention_regions_pooled": ["attention_regions_reference.loom", "attention_regions_pooled_checks.loom"],
    "attention_output": ["attention_output_checks.loom"],
    "llama_count": ["llama_count_checks.loom"],
    "active_rows": ["active_rows_checks.loom", "projection_checks.loom"],
    "head_rows": ["head_rows_checks.loom"],
    "head_publication": ["head_publication_checks.loom"],
    "joined_adapters": ["joined_adapters_checks.loom"],
}
[loom_test(
    name = case + "_" + format + "_execution_test",
    srcs = checks + [":" + ("head_rows" if case == "head_publication" else case) + "_" + format],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
) for case, checks in _CHECKS.items() for format in (["text", "bc"] if case in ["head_publication", "joined_adapters"] else ["bc"])]

genrule(
    name = "token_control_data",
    testonly = True,
    outs = ["token_control_data.loom"],
    tools = ["//tools/loomify-gguf/testing:emit_token_marker"],
    cmd = "$(location //tools/loomify-gguf/testing:emit_token_marker) $@",
)
loom_merge(
    name = "token_control",
    testonly = True,
    srcs = ["//lib/architectures/llama:execution", "//lib/serving:request_check.loom", ":token_control_data"],
)
loom_test(
    name = "token_policy_execution_test",
    srcs = ["token_policy_checks.loom", ":token_control"],
    deps = ["//lib/kernels/llama:publication"],
    benchmark_smoke = False,
    execution_profiles = [VM_REFERENCE_PROFILE],
)

loom_test(name = "scalar_data_execution_test", srcs = ["scalar_data_checks.loom", "//lib/kernels/llama:attention/attention_prepare.loom", "//lib/kernels/llama:attention/attention_native.loom", "//lib/kernels/llama:attention/rotary.loom", "//lib/kernels/llama:attention/attention_materialized.loom", "//lib/kernels/attention:core.loom", "//lib/kernels/attention:kv_position.loom", "//lib/kernels/elementwise:residual_row.loom"], benchmark_smoke = False, execution_profiles = [AMDGPU_HARDWARE_PROFILE])

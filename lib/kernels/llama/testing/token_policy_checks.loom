// Deliberately relocated token IDs prove the actual publication helper does not
// retain the checkpoint's old literals. The independent expected vector is
// [77,77,77,5], with caller-selected canonical EOS77.
config.def @llama.publication.end_text_id = 2 : i32

config.def @llama.publication.end_message_id = 3 : i32

config.def @llama.publication.end_turn_id = 4 : i32

func.decl @llama32_native_token(%token: i32, %eos: i32) -> (i32)

func.decl @loomify_serving_native_token(%token: i32, %eos: i32) -> (i32)

func.def @actual_token_policy(%input: buffer, %output: buffer) {
  %zero = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %eos = scalar.constant 77 : i32
  %x = buffer.view %input[%zero] : buffer -> view<4xi32>
  %y = buffer.view %output[%zero] : buffer -> view<4xi32>
  scf.for %i = [%begin to %end step %step] {
    %v = view.load %x[%i] : view<4xi32> -> i32
    %n = func.call @llama32_native_token(%v, %eos) : (i32, i32) -> (i32)
    view.store %n, %y[%i] : i32, view<4xi32>
  }
  func.return
}

func.def @actual_host_token_policy(%input: buffer, %output: buffer) {
  %zero = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %eos = scalar.constant 77 : i32
  %x = buffer.view %input[%zero] : buffer -> view<4xi32>
  %y = buffer.view %output[%zero] : buffer -> view<4xi32>
  scf.for %i = [%begin to %end step %step] {
    %v = view.load %x[%i] : view<4xi32> -> i32
    %n = func.call @loomify_serving_native_token(%v, %eos) : (i32, i32) -> (i32)
    view.store %n, %y[%i] : i32, view<4xi32>
  }
  func.return
}

func.def @expected_token_policy(%input: buffer, %output: buffer) {
  %zero = index.constant 0 : offset
  %y = buffer.view %output[%zero] : buffer -> view<4xi32>
  %stop = scalar.constant 77 : i32
  %ordinary = scalar.constant 5 : i32
  view.store %stop, %y[0] : i32, view<4xi32>
  view.store %stop, %y[1] : i32, view<4xi32>
  view.store %stop, %y[2] : i32, view<4xi32>
  view.store %ordinary, %y[3] : i32, view<4xi32>
  func.return
}

check.scenario @relocated_stop_ids {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(2) step(1) : tensor<4xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@actual_token_policy, @expected_token_policy>(%input, %output) : (tensor<4xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

check.scenario @relocated_host_stop_ids {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(2) step(1) : tensor<4xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@actual_host_token_policy, @expected_token_policy>(%input, %output) : (tensor<4xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

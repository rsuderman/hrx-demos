func.decl @llm_rotary_token_position(%rows: index, %token: index, %capacity: index, %active: i32, %position: i32) -> (i1, index)
template.decl @llm.rotary.query_row128(%row_count: index, %heads: index, %token: index, %head: index, %lane: index, %position: index, %theta_scale: f32, %projection_origin: offset, %query_origin: offset, %factors: buffer, %projection: buffer, %query: buffer)
template.decl @llm.rotary.kv_separate_row128(%row_count: index, %heads: index, %physical_capacity: index, %token: index, %head: index, %lane: index, %logical_position: index, %physical_position: index, %theta_scale: f32, %projection_origin: offset, %key_origin: offset, %value_origin: offset, %factors: buffer, %key: buffer, %value: buffer, %key_cache: buffer, %value_cache: buffer)
template.decl @llm.attention.row_f32(%query_heads: index, %key_heads: index, %head_size: index, %query_width: index, %cache_width: index, %logical_capacity: index, %pool_capacity: index, %map_origin: offset, %query_origin: offset, %output_origin: offset, %key_origin: offset, %value_origin: offset, %map: buffer, %attention_scale: f32, %position_i32: i32, %head0: index, %lane0: index, %has_gate: i1, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer)
// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT
// Dense explicit-position wrappers around owned numerical templates. Every row
// is active; invalid signed positions perform no reads/writes beyond positions.
// K/V stores preserve every unaddressed cache token. Caller supplies unique
// publication positions, valid finite factors >=1 and initialized causal history.
amdgpu.target<gfx11-generic> @llama_dispatch_attention_wave32 {subgroup_size = 32}

kernel.def target(@llama_dispatch_attention_wave32) @llama_dispatch_rope(%rows0: index, %heads0: index, %capacity0: index) {
  %rows = index.assume %rows0 [range(%rows0, 1, 512)] : index
  %heads = index.constant 24 : index
  %width = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %rows, %one) workgroup_size(%width, %one, %one) : index
} launch(%capacity0: index, %positions: buffer, %factors: buffer, %input: buffer, %output: buffer) {
  %rows = kernel.workgroup.count<y> : index
  %token = kernel.workgroup.id<y> : index
  %head = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %heads = index.constant 24 : index
  %capacity = index.assume %capacity0 [range(%capacity0, 1, 131072)] : index
  %origin = index.constant 0 : offset
  %pv = buffer.view %positions[%origin] : buffer -> view<[%rows]xi32>
  %position32 = view.load %pv[%token] : view<[%rows]xi32> -> i32
  %count32 = index.cast %rows : index to i32
  %valid, %position = func.call @llm_rotary_token_position(%rows, %token, %capacity, %count32, %position32) : (index, index, index, i32, i32) -> (i1, index)
  scf.if %valid {
    %theta = scalar.constant 0.8146172165870667 : f32
    template.apply<@llm.rotary.query_row128>(%rows, %heads, %token, %head, %lane, %position, %theta, %origin, %origin, %factors, %input, %output) : (index, index, index, index, index, index, f32, offset, offset, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def target(@llama_dispatch_attention_wave32) @llama_dispatch_publish_kv(%rows0: index, %heads0: index, %capacity0: index) {
  %rows = index.assume %rows0 [range(%rows0, 1, 512)] : index
  %heads = index.constant 8 : index
  %width = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %rows, %one) workgroup_size(%width, %one, %one) : index
} launch(%capacity0: index, %positions: buffer, %factors: buffer, %key: buffer, %value: buffer, %key_cache: buffer, %value_cache: buffer) {
  %rows = kernel.workgroup.count<y> : index
  %token = kernel.workgroup.id<y> : index
  %head = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %heads = index.constant 8 : index
  %capacity = index.assume %capacity0 [range(%capacity0, 1, 131072)] : index
  %origin = index.constant 0 : offset
  %pv = buffer.view %positions[%origin] : buffer -> view<[%rows]xi32>
  %position32 = view.load %pv[%token] : view<[%rows]xi32> -> i32
  %count32 = index.cast %rows : index to i32
  %valid, %position = func.call @llm_rotary_token_position(%rows, %token, %capacity, %count32, %position32) : (index, index, index, i32, i32) -> (i1, index)
  scf.if %valid {
    %theta = scalar.constant 0.8146172165870667 : f32
    template.apply<@llm.rotary.kv_separate_row128>(%rows, %heads, %capacity, %token, %head, %lane, %position, %position, %theta, %origin, %origin, %origin, %factors, %key, %value, %key_cache, %value_cache) : (index, index, index, index, index, index, index, index, f32, offset, offset, offset, buffer, buffer, buffer, buffer, buffer)

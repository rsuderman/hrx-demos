  kernel.return
}

kernel.def target(@llama_dispatch_attention_wave32) @llama_dispatch_causal_attention(%rows0: index, %qheads0: index, %kvheads0: index, %capacity0: index) {
  %rows = index.assume %rows0 [range(%rows0, 1, 512)] : index
  %qheads = index.constant 24 : index
  %width = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%qheads, %rows, %one) workgroup_size(%width, %one, %one) : index
} launch(%capacity0: index, %kvheads0: index, %positions: buffer, %query: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer) {
  %rows = kernel.workgroup.count<y> : index
  %token = kernel.workgroup.id<y> : index
  %head = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %heads = index.constant 24 : index
  %capacity = index.assume %capacity0 [range(%capacity0, 1, 131072)] : index
  %origin = index.constant 0 : offset
  %pv = buffer.view %positions[%origin] : buffer -> view<[%rows]xi32>
  %position32 = view.load %pv[%token] : view<[%rows]xi32> -> i32
  %count32 = index.cast %rows : index to i32
  %valid, %position = func.call @llm_rotary_token_position(%rows, %token, %capacity, %count32, %position32) : (index, index, index, i32, i32) -> (i1, index)
  scf.if %valid {
    %theta = scalar.constant 0.8146172165870667 : f32
    %kvheads = index.constant 8 : index
    %width = index.constant 128 : index
    %qwidth = index.mul %heads, %width : index
    %kvwidth = index.mul %kvheads, %width : index
    %four = index.constant 4 : offset
    %row_bytes = index.scale %qwidth, %four : index, offset -> offset
    %row_origin = index.scale %token, %row_bytes : index, offset -> offset
    %zero = index.constant 0 : index
    %scale = scalar.constant 0.08838834764831845 : f32
    %no = scalar.constant false : i1
    template.apply<@llm.attention.row_f32>(%heads, %kvheads, %width, %qwidth, %kvwidth, %capacity, %zero, %origin, %row_origin, %row_origin, %origin, %origin, %query, %scale, %position32, %head, %lane, %no, %query, %query, %key_cache, %value_cache, %output) : (index, index, index, index, index, index, index, offset, offset, offset, offset, offset, buffer, f32, i32, index, index, i1, buffer, buffer, buffer, buffer, buffer)
  }
  kernel.return
}

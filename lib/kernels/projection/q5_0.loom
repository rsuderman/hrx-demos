// Q5_0 launcher shares the owned Q8_0 schedule and signed block32 contraction.

// Contracts GGML Q5_0 weight rows directly with the Q8_1 x4 activation
// layout used by the other native GGUF projection kernels. One 22-byte Q5_0
// block represents 32 signed values as an F16 scale followed by high bits and packed signed five-bit codes.
//
// The shared block32 row body owns contraction. One subgroup owns one output row. Eight adjacent lanes consume one Q5_0
// block through native signed dot4 packets, while the active target subgroup
// size determines how many blocks advance together. The same source therefore
// uses four-block wave32 and eight-block wave64 schedules without cloning the
// kernel or naming an architecture in the model program.

config.decl @ggml.linear_q5_0_q8_1_x4.token_capacity : %value: index where [range(%value, 1, 2048)]

config.decl @ggml.linear_q5_0_q8_1_x4.output_capacity : %value: index where [range(%value, 1, 262144)]

amdgpu.target<gfx11-generic> @ggml_q5_gfx11_wave32 {subgroup_size = 32}

func.decl pure @ggml_block32_q8_1_x4_output_tiles(%output_size: index, %subgroup_size: index) -> (index)
func.decl @ggml_block32_q8_1_x4_project(%weight_tag: index, %weight_row_bytes: offset, %token_capacity: index, %output_capacity: index, %token_count: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer)

kernel.def target(@ggml_q5_gfx11_wave32) export("ggml_linear_q5_0_q8_1_x4") @ggml_linear_q5_0_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %subgroup_size = target.subgroup.size : index
  %output_tiles = func.call pure @ggml_block32_q8_1_x4_output_tiles(%output_size, %subgroup_size) : (index, index) -> (index)
  kernel.launch.config workgroups(%output_tiles, %bounded_token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
  %token_capacity = config.get @ggml.linear_q5_0_q8_1_x4.token_capacity : index
  %output_capacity = config.get @ggml.linear_q5_0_q8_1_x4.output_capacity : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), multiple_of(%input_size, 128)] : index
  %tag = index.constant 6 : index
  %block_size = index.constant 32 : index
  %block_bytes = index.constant 22 : offset
  %blocks = index.div %bounded_input_size, %block_size : index
  %weight_row_bytes = index.scale %blocks, %block_bytes : index, offset -> offset
  func.call @ggml_block32_q8_1_x4_project(%tag, %weight_row_bytes, %token_capacity, %output_capacity, %token_count, %bounded_input_size, %output_size, %q8_input, %weight, %output) : (index, offset, index, index, index, index, index, buffer, buffer, buffer) -> ()
  kernel.return
}

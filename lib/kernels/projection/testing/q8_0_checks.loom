// Independent logical fixture: A[t,k] = (((k+5t)%17)-8) * (1+(k/32)%4)*(t+1)/8.
// W[c,k] = (((3k+7c)%19)-9) * (1+(k/32+c)%4)/4.
// The encoder writes canonical Q8_0 weights (32/34) and Q8_1_x4 activations
// (128/144); the scalar oracle never reads either encoded representation.
// Every selected dot is exact in F32: even the absolute 6144-term bound in
// units of 1/32 is <=14155776, below 2^24. Bitwise comparison needs no tolerance.
config.def @ggml.linear_q8_0_q8_1_x4.token_capacity = 2 : index
config.def @ggml.linear_q8_0_q8_1_x4.output_capacity = 1025 : index
kernel.decl @ggml_linear_q8_0_q8_1_x4(%rows:index,%width:index,%cols:index) launch(%rows:index,%width:index,%cols:index,%activation:buffer,%weight:buffer,%output:buffer)

func.def pure @q8_activation_code(%k:index,%row:index) -> (i32) {
  %five = index.constant 5 : index
  %seventeen = index.constant 17 : index
  %shift = index.mul %row, %five : index
  %ordinal = index.add %k, %shift : index
  %remainder = index.rem %ordinal, %seventeen : index
  %value = index.cast %remainder : index to i32
  %bias = scalar.constant 8 : i32
  %code = scalar.subi %value, %bias : i32
  func.return %code : i32
}
func.def pure @q8_weight_code(%k:index,%column:index) -> (i32) {
  %three = index.constant 3 : index
  %seven = index.constant 7 : index
  %nineteen = index.constant 19 : index
  %element = index.mul %k, %three : index
  %shift = index.mul %column, %seven : index
  %ordinal = index.add %element, %shift : index
  %remainder = index.rem %ordinal, %nineteen : index
  %value = index.cast %remainder : index to i32
  %bias = scalar.constant 9 : i32
  %code = scalar.subi %value, %bias : i32
  func.return %code : i32
}
func.def pure @q8_activation_scale(%block:index,%row:index) -> (f32) {
  %four = index.constant 4 : index
  %one = index.constant 1 : index
  %part = index.rem %block, %four : index
  %factor = index.add %part, %one : index
  %row_factor = index.add %row, %one : index
  %integer = index.mul %factor, %row_factor : index
  %integer32 = index.cast %integer : index to i32
  %value = scalar.uitofp %integer32 : i32 to f32
  %eighth = scalar.constant 0.125 : f32
  %scale = scalar.mulf %value, %eighth : f32
  func.return %scale : f32
}
func.def pure @q8_weight_scale(%block:index,%column:index) -> (f32) {
  %four = index.constant 4 : index
  %one = index.constant 1 : index
  %ordinal = index.add %block, %column : index
  %part = index.rem %ordinal, %four : index
  %factor = index.add %part, %one : index
  %integer32 = index.cast %factor : index to i32
  %value = scalar.uitofp %integer32 : i32 to f32
  %quarter = scalar.constant 0.25 : f32
  %scale = scalar.mulf %value, %quarter : f32
  func.return %scale : f32
}

func.def @q8_encode_fixture(%rows:index,%width:index,%cols:index,%activation:buffer,%weights:buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %group_bytes = index.constant 144 : offset
  %block_bytes = index.constant 34 : offset
  %payload_add = index.constant 16 : offset
  %weight_payload_add = index.constant 2 : offset
  %blocks = index.div %width, %c32 : index
  %groups = index.div %width, %c128 : index
  %activation_row_bytes = index.scale %groups, %group_bytes : index, offset -> offset
  %weight_row_bytes = index.scale %blocks, %block_bytes : index, offset -> offset
  %zero32 = scalar.constant 0 : i32
  scf.for %row = [%zero to %rows step %one] {
    %activation_row = index.scale %row, %activation_row_bytes : index, offset -> offset
    scf.for %block = [%zero to %blocks step %one] {
      %group = index.div %block, %four : index
      %inner = index.rem %block, %four : index
      %group_offset = index.scale %group, %group_bytes : index, offset -> offset
      %base = index.add %activation_row, %group_offset : offset
      %payload_base = index.add %base, %payload_add : offset
      %metadata = buffer.view %activation[%base] : buffer -> view<8xf16>
      %payload = buffer.view %activation[%payload_base] : buffer -> view<128xi8>
      %scale = func.call pure @q8_activation_scale(%block,%row) : (index,index) -> (f32)
      %half = scalar.fptrunc %scale : f32 to f16
      %d_index = index.mul %inner, %two : index
      %s_index = index.add %d_index, %one : index
      view.store %half, %metadata[%d_index] : f16, view<8xf16>
      %first_k = index.mul %block, %c32 : index
      %first_byte = index.mul %inner, %c32 : index
      %sum = scf.for %j = [%zero to %c32 step %one](%acc = %zero32 : i32) -> (i32) {
        %k = index.add %first_k, %j : index
        %code = func.call pure @q8_activation_code(%k,%row) : (index,index) -> (i32)
        %byte = scalar.trunci %code : i32 to i8
        %position = index.add %first_byte, %j : index
        view.store %byte, %payload[%position] : i8, view<128xi8>
        %next = scalar.addi %acc, %code : i32
        scf.yield %next : i32
      }
      %sum_float = scalar.sitofp %sum : i32 to f32
      %scaled_sum = scalar.mulf %sum_float, %scale : f32
      %sum_half = scalar.fptrunc %scaled_sum : f32 to f16
      view.store %sum_half, %metadata[%s_index] : f16, view<8xf16>
    }
  }
  scf.for %column = [%zero to %cols step %one] {
    %weight_row = index.scale %column, %weight_row_bytes : index, offset -> offset
    scf.for %block = [%zero to %blocks step %one] {
      %offset = index.scale %block, %block_bytes : index, offset -> offset
      %base = index.add %weight_row, %offset : offset
      %payload_base = index.add %base, %weight_payload_add : offset
      %d = buffer.view %weights[%base] : buffer -> view<1xf16>
      %payload = buffer.view %weights[%payload_base] : buffer -> view<32xi8>
      %scale = func.call pure @q8_weight_scale(%block,%column) : (index,index) -> (f32)
      %half = scalar.fptrunc %scale : f32 to f16
      view.store %half, %d[0] : f16, view<1xf16>
      %first_k = index.mul %block, %c32 : index
      scf.for %j = [%zero to %c32 step %one] {
        %k = index.add %first_k, %j : index
        %code = func.call pure @q8_weight_code(%k,%column) : (index,index) -> (i32)
        %byte = scalar.trunci %code : i32 to i8
        view.store %byte, %payload[%j] : i8, view<32xi8>
      }
    }
  }
  func.return
}

func.def @q8_logical_oracle(%rows:index,%width:index,%cols:index,%output:buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %c32 = index.constant 32 : index
  %origin = index.constant 0 : offset
  %zero_float = scalar.constant 0.0 : f32
  %y = buffer.view %output[%origin] : buffer -> view<[%rows]x[%cols]xf32>
  scf.for %row = [%zero to %rows step %one] {
    scf.for %column = [%zero to %cols step %one] {
      %dot = scf.for %k = [%zero to %width step %one](%acc = %zero_float : f32) -> (f32) {
        %block = index.div %k, %c32 : index
        %activation_code = func.call pure @q8_activation_code(%k,%row) : (index,index) -> (i32)
        %weight_code = func.call pure @q8_weight_code(%k,%column) : (index,index) -> (i32)
        %activation_scale = func.call pure @q8_activation_scale(%block,%row) : (index,index) -> (f32)
        %weight_scale = func.call pure @q8_weight_scale(%block,%column) : (index,index) -> (f32)
        %a_integer = scalar.sitofp %activation_code : i32 to f32
        %w_integer = scalar.sitofp %weight_code : i32 to f32
        %a = scalar.mulf %a_integer, %activation_scale : f32
        %w = scalar.mulf %w_integer, %weight_scale : f32
        %product = scalar.mulf %a, %w : f32
        %next = scalar.addf %acc, %product : f32
        scf.yield %next : f32
      }
      view.store %dot, %y[%row,%column] : f32, view<[%rows]x[%cols]xf32>
    }
  }
  func.return
}


check.scenario @q8_0_tiny {
  check.trial[1](%trial:index,%entropy:check.entropy) {
    %activation_owner = check.generate.fill value(81) : tensor<800xi8>
    %activation = check.tensor.view %activation_owner offset(256) : tensor<800xi8> -> tensor<288xi8>
    %weight_owner = check.generate.fill value(-67) : tensor<1736xi8>
    %weight = check.tensor.view %weight_owner offset(256) : tensor<1736xi8> -> tensor<1224xi8>
    check.generate<@q8_init_tiny>(%activation,%weight) : (tensor<288xi8>,tensor<1224xi8>) -> ()
    %output_owner = check.generate.fill value(-999.0) : tensor<22xf32>
    %output = check.tensor.view %output_owner offset(8) : tensor<22xf32> -> tensor<18xf32>
    // Host fixture anchors are compared within this real projection trial.
    %encoded = check.generate.fill value(0) : tensor<19xi8>
    %known = check.generate.fill value(0) : tensor<19xi8>
    check.generate<@q8_capture_bytes>(%activation,%weight,%encoded) : (tensor<288xi8>,tensor<1224xi8>,tensor<19xi8>) -> ()
    check.generate<@q8_known_bytes>(%known) : (tensor<19xi8>) -> ()
    check.compare<@q8_actual_tiny,@q8_expected_tiny>(%activation,%weight,%output,%encoded,%known) : (tensor<288xi8>,tensor<1224xi8>,tensor<18xf32>,tensor<19xi8>,tensor<19xi8>) -> () {
      check.expect.bitwise actual(%encoded) expected(%known) : tensor<19xi8>
      check.expect.bitwise actual(%activation_owner) expected(%activation_owner) : tensor<800xi8>
      check.expect.bitwise actual(%weight_owner) expected(%weight_owner) : tensor<1736xi8>
      check.expect.bitwise actual(%output_owner) expected(%output_owner) : tensor<22xf32>
    }
  }
  check.return
}


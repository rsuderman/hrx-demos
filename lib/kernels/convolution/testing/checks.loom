// Independent host oracle uses direct causal indexing into the immutable chunk
// and initial history. Device implementation instead advances six registers.
command.decl @shortconv.actual() launch(%count: buffer, %epoch: buffer, %input: buffer, %weight: buffer, %state: buffer, %output: buffer)
func.def @shortconv.expected_width(%width0: index, %count: buffer, %epoch: buffer, %input: buffer, %weight: buffer, %state: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %width = index.assume %width0 [range(%width0, 256, 2048)] : index
  %history_origin = index.constant 16 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %rows = index.constant 8 : index
  %zero_f = scalar.constant 0.0 : f32
  %zero32 = scalar.constant 0 : i32
  %counts = buffer.view %count[%origin] : buffer -> view<3xi32>
  %n32 = view.load %counts[0] : view<3xi32> -> i32
  %n0 = index.cast %n32 : i32 to index
  %n = index.assume %n0 [range(%n0, 1, 8)] : index
  %descriptor = buffer.view %epoch[%origin] : buffer -> view<5xi32>
  %base = view.load %descriptor[1] : view<5xi32> -> i32
  %fresh = scalar.cmpi eq, %base, %zero32 : i32
  %bcx = buffer.view %input[%origin] : buffer -> view<8x3x[%width]xf32>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%width]x7xf32>
  %history = buffer.view %state[%history_origin] : buffer -> view<6x[%width]xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x[%width]xf32>
  scf.for %channel = [%zero to %width step %one] {
    scf.for %row = [%zero to %rows step %one] {
      %live = index.cmp ult, %row, %n : index
      %result = scf.if %live -> (f32) {
        %sum = scf.for %tap = [%zero to %seven step %one](%acc = %zero_f : f32) -> (f32) {
          %joined = index.add %row, %tap : index
          %in_chunk = index.cmp uge, %joined, %six : index
          %sample = scf.if %in_chunk -> (f32) {
            %source0 = index.sub %joined, %six : index
            %source = index.assume %source0 [range(%source0, 0, 7)] : index
            %b = view.load %bcx[%source, 0, %channel] : view<8x3x[%width]xf32> -> f32
            %x = view.load %bcx[%source, 2, %channel] : view<8x3x[%width]xf32> -> f32
            %value = scalar.mulf %b, %x : f32
            scf.yield %value : f32
          } else {
            %value = scf.if %fresh -> (f32) { scf.yield %zero_f : f32 } else {
              %bounded_joined = index.assume %joined [range(%joined, 0, 5)] : index
              %old = view.load %history[%bounded_joined, %channel] : view<6x[%width]xf32> -> f32
              scf.yield %old : f32
            }
            scf.yield %value : f32
          }
          %w = view.load %weights[%channel, %tap] : view<[%width]x7xf32> -> f32
          %next = scalar.fmaf %w, %sample, %acc : f32
          scf.yield %next : f32
        }
        %c = view.load %bcx[%row, 1, %channel] : view<8x3x[%width]xf32> -> f32
        %gated = scalar.mulf %sum, %c : f32
        scf.yield %gated : f32
      } else { scf.yield %zero_f : f32 }
      view.store %result, %out[%row, %channel] : f32, view<8x[%width]xf32>
    }
    // Ascending writes are safe: an old source is destination+n, strictly later.
    scf.for %slot = [%zero to %six step %one] {
      %joined = index.add %slot, %n : index
      %in_chunk = index.cmp uge, %joined, %six : index
      %value = scf.if %in_chunk -> (f32) {
        %source0 = index.sub %joined, %six : index
            %source = index.assume %source0 [range(%source0, 0, 7)] : index
        %b = view.load %bcx[%source, 0, %channel] : view<8x3x[%width]xf32> -> f32
        %x = view.load %bcx[%source, 2, %channel] : view<8x3x[%width]xf32> -> f32
        %product = scalar.mulf %b, %x : f32
        scf.yield %product : f32
      } else {
        %prior = scf.if %fresh -> (f32) { scf.yield %zero_f : f32 } else {
          %bounded_joined = index.assume %joined [range(%joined, 0, 5)] : index
              %old = view.load %history[%bounded_joined, %channel] : view<6x[%width]xf32> -> f32
          scf.yield %old : f32
        }
        scf.yield %prior : f32
      }
      view.store %value, %history[%slot, %channel] : f32, view<6x[%width]xf32>
    }
  }
  func.return
}
func.def @shortconv.expected(%count: buffer, %epoch: buffer, %input: buffer, %weight: buffer, %state: buffer, %output: buffer) {
  %width = index.constant 256 : index
  func.call @shortconv.expected_width(%width, %count, %epoch, %input, %weight, %state, %output) : (index, buffer, buffer, buffer, buffer, buffer, buffer) -> ()
  func.return
}
check.scenario @shortconv.n1_fresh_poison {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.generate.fill value(1) : tensor<3xi32>
    %epoch = check.generate.fill value(0) : tensor<5xi32>
    %input = check.generate.iota offset(0.25) step(0.0009765625) : tensor<8x3x256xf32>
    %weight = check.generate.iota offset(-0.25) step(0.000244140625) : tensor<256x7xf32>
    %state = check.generate.fill value(-777.0) : tensor<1544xf32>
    %storage = check.generate.fill value(123.5) : tensor<2056xf32>
    %output = check.tensor.view %storage offset(16) : tensor<2056xf32> -> tensor<8x256xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<2056xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(8208) : tensor<2056xf32> -> tensor<4xf32>
    %state_prefix = check.tensor.view %state offset(0) : tensor<1544xf32> -> tensor<4xf32>
    %state_suffix = check.tensor.view %state offset(6160) : tensor<1544xf32> -> tensor<4xf32>
    %history = check.tensor.view %state offset(16) : tensor<1544xf32> -> tensor<6x256xf32>
    check.compare<@shortconv.actual, @shortconv.expected>(%count, %epoch, %input, %weight, %state, %output) : (tensor<3xi32>, tensor<5xi32>, tensor<8x3x256xf32>, tensor<256x7xf32>, tensor<1544xf32>, tensor<8x256xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00001) rtol(0.00001) nan(same) : tensor<8x256xf32>, tensor<8x256xf32>
      check.expect.bitwise actual(%history) expected(%history) : tensor<6x256xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%state_prefix) expected(%state_prefix) : tensor<4xf32>
      check.expect.bitwise actual(%state_suffix) expected(%state_suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<8x3x256xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<256x7xf32>
      check.expect.bitwise actual(%count) expected(%count) : tensor<3xi32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<5xi32>
    }
  }
  check.return
}

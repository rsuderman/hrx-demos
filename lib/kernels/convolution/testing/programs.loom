kernel.def @shortconv.fixture_stage() {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%start0: index, %n0: index, %initial: buffer, %input: buffer, %chunk: buffer, %count: buffer, %epoch: buffer) {
  %start = index.assume %start0 [range(%start0, 0, 7)] : index
  %n = index.assume %n0 [range(%n0, 1, 8)] : index

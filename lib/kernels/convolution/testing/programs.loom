kernel.decl @llm.convolution.shortconv7(%rows: index, %width: index) launch(%rows: index, %width: index, %history_origin: offset, %control_origin: offset, %count: buffer, %epoch: buffer, %input: buffer, %weight: buffer, %state: buffer, %output: buffer)
command.def @shortconv.actual() launch(%count: buffer, %epoch: buffer, %input: buffer, %weight: buffer, %state: buffer, %output: buffer) {
  %rows = index.constant 8 : index
  %width = index.constant 256 : index
  %history_origin = index.constant 16 : offset
  %control_origin = index.constant 0 : offset
  kernel.launch @llm.convolution.shortconv7[%rows, %width](%rows, %width, %history_origin, %control_origin, %count, %epoch, %input, %weight, %state, %output) : [index, index](index, index, offset, offset, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

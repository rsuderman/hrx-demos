  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %rows = index.constant 8 : index
  %three = index.constant 3 : index
  %width = index.constant 256 : index
  %lane = kernel.workitem.id<x> : index
  %source = buffer.view %input[%origin] : buffer -> view<8x3x256xf32>
  %out = buffer.view %chunk[%origin] : buffer -> view<8x3x256xf32>
  %zero_f = scalar.constant 0.0 : f32
  scf.for %row = [%zero to %rows step %one] {
    %active = index.cmp ult, %row, %n : index
    scf.for %part = [%zero to %three step %one] {
      %value = scf.if %active -> (f32) {
        %row0 = index.add %start, %row : index
        %input_row = index.assume %row0 [range(%row0, 0, 7)] : index
        %v = view.load %source[%input_row, %part, %lane] : view<8x3x256xf32> -> f32
        scf.yield %v : f32
      } else { scf.yield %zero_f : f32 }
      view.store %value, %out[%row, %part, %lane] : f32, view<8x3x256xf32>
    }
  }
  %first = index.cmp eq, %lane, %zero : index
  scf.if %first {
    %initial_view = buffer.view %initial[%origin] : buffer -> view<5xi32>
    %base = view.load %initial_view[1] : view<5xi32> -> i32
    %start32 = index.cast %start : index to i32
    %position = scalar.addi %base, %start32 : i32
    %n32 = index.cast %n : index to i32
    %zero32 = scalar.constant 0 : i32
    %c = buffer.view %count[%origin] : buffer -> view<3xi32>
    view.store %n32, %c[0] : i32, view<3xi32>
    view.store %zero32, %c[1] : i32, view<3xi32>
    view.store %zero32, %c[2] : i32, view<3xi32>
    %e = buffer.view %epoch[%origin] : buffer -> view<5xi32>
    view.store %n32, %e[0] : i32, view<5xi32>
    view.store %position, %e[1] : i32, view<5xi32>
    view.store %zero32, %e[2] : i32, view<5xi32>
    view.store %zero32, %e[3] : i32, view<5xi32>
    view.store %zero32, %e[4] : i32, view<5xi32>
  }
  kernel.return
}
kernel.def @shortconv.fixture_collect() {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%start0: index, %n0: index, %chunk: buffer, %output: buffer) {
  %start = index.assume %start0 [range(%start0, 0, 7)] : index
  %n = index.assume %n0 [range(%n0, 1, 8)] : index
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %lane = kernel.workitem.id<x> : index
  %source = buffer.view %chunk[%origin] : buffer -> view<8x256xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x256xf32>
  scf.for %row = [%zero to %n step %one] {
    %output0 = index.add %start, %row : index
    %output_row = index.assume %output0 [range(%output0, 0, 7)] : index
    %input_row = index.assume %row [range(%row, 0, 7)] : index
    %value = view.load %source[%input_row, %lane] : view<8x256xf32> -> f32
    view.store %value, %out[%output_row, %lane] : f32, view<8x256xf32>
  }
  kernel.return
}

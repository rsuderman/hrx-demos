      %wq0, %sc0, %mn0 = scf.if %ok -> (vector<32xi8>, f32, f32) {
        %v, %a, %b = func.call @llm.experts.q4_codes(%w, %o, %within) : (buffer, offset, index) -> (vector<32xi8>, f32, f32)

  %tokens = index.assume %tokens_arg [range(%tokens_arg, 8, 4096), multiple_of(%tokens_arg, 8)] : index
  %group_id = kernel.workgroup.id<y> : index
  %a_id = kernel.workgroup.id<x> : index
  %a = index.assume %a_id [lt(%a_id, %tokens)] : index
  %multiplier = index.constant 8 : index
  %active = func.call @llm.experts.active(%tokens, %multiplier, %a, %count) : (index, index, index, buffer) -> (i1)
  scf.if %active {
    %workitem_id = kernel.workitem.id<x> : index
    %workitem = index.assume %workitem_id [range(%workitem_id, 0, 63)] : index
    %wave_id = kernel.subgroup.id : index
    %wave = index.assume %wave_id [range(%wave_id, 0, 1)] : index
    %lane_id = kernel.subgroup.lane.id : index
    %lane = index.assume %lane_id [range(%lane_id, 0, 31)] : index
    %zero = index.constant 0 : offset
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %cKU = index.constant 8 : index
    %rows_per = index.constant 2 : index
    %cW = index.constant 2 : index
    %row_bytes = index.constant 1152 : offset
    %expert_bytes = index.constant 884736 : offset
    %block_bytes = index.constant 144 : offset
    %zero_f = scalar.constant 0.0 : f32
    %zero32 = vector.splatf 0.0 : vector<32xf32>
    %c0_i32 = scalar.constant 0 : i32
    %cE1_i32 = scalar.constant 127 : i32
    %ids_view = buffer.view %ids[%zero] : buffer -> view<[%tokens]xi32>
    %eid = view.load %ids_view[%a] : view<[%tokens]xi32> -> i32
    %elo = scalar.maxsi %eid, %c0_i32 : i32
    %ehi = scalar.minsi %elo, %cE1_i32 : i32
    %eb32 = scalar.assume %ehi [range(%ehi, 0, 127)] : i32
    %e = index.cast %eb32 : i32 to index
    %e_off = index.scale %e, %expert_bytes : index, offset -> offset
    %xrows = index.div %tokens, %cKU : index
    %xr_v = index.div %a, %cKU : index
    %xr = index.assume %xr_v [lt(%xr_v, %xrows)] : index
    %cgroups = index.constant 64 : index
    %xq_view = buffer.view %x[%zero] : buffer -> view<[%xrows]x64x8xi32>
    %cK = index.constant 2048 : index
    %xm_bytes = index.cast %cK : index to offset
    %xm_off = index.scale %xrows, %xm_bytes : index, offset -> offset
    %xm_view = buffer.view %x[%xm_off] : buffer -> view<[%xrows]x64x2xf32>
    %zero32i8 = vector.splati 0 : vector<32xi8>
    %zero1i = vector.splati 0 : vector<1xi32>
    %row_base = index.mul %group_id, %rows_per : index
    %ok = index.cmp ult, %workitem, %cgroups : index
    %g_last = index.constant 63 : index
    %g_c = index.min %workitem, %g_last : index
    %g = index.assume %g_c [range(%g_c, 0, 63)] : index
    %cgpb = index.constant 8 : index
    %blk = index.div %g, %cgpb : index
    %within = index.rem %g, %cgpb : index
    %ba = index.scale %blk, %block_bytes : index, offset -> offset
    %q0, %da0, %xs0 = scf.if %ok -> (vector<32xi8>, f32, f32) {
      %tk0 = index.assume %xr [lt(%xr, %xrows)] : index
      %cw = vector.load %xq_view[%tk0, %g, %c0] : view<[%xrows]x64x8xi32> -> vector<8xi32>
      %cb = vector.bitcast %cw : vector<8xi32> to vector<32xi8>

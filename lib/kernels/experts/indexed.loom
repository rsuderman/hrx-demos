      %rr = index.assume %wr0 [range(%wr0, 0, 1)] : index
      %t0 = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 1)] : index
        %p = view.load %pv[0, %bw, %rr] : view<2x2x2xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %t1 = scf.for %ww = [%c0 to %cW step %c1](%acc = %zero_f : f32) -> (f32) {
        %bw = index.assume %ww [range(%ww, 0, 1)] : index
        %p = view.load %pv[1, %bw, %rr] : view<2x2x2xf32> -> f32
        %nx = scalar.addf %acc, %p : f32
        scf.yield %nx : f32
      }
      %value = func.call @llm.experts.swiglu(%t0, %t1) : (f32, f32) -> (f32)
      %out_row = index.add %row_base, %rr : index
      func.call @llm.experts.store_row(%y, %tokens, %n, %a, %out_row, %value, %c0_i32) : (buffer, index, index, index, index, f32, i32)
    }
  } else {
    // Uniform per assignment workgroup, including every barrier in the active body.
    %origin_inactive = index.constant 0 : offset
    %output_inactive = buffer.view %y[%origin_inactive] : buffer -> view<[%tokens]x[%n]xf32>
    %thread_inactive = kernel.workitem.id<x> : index
    %two_inactive = index.constant 2 : index
    %writer_inactive = index.cmp ult, %thread_inactive, %two_inactive : index
    scf.if %writer_inactive {
      %base_inactive = index.mul %group_id, %two_inactive : index
      // y has exactly n/2 workgroups and only threads0/1 write this pair.
      %col_inactive_raw = index.add %base_inactive, %thread_inactive : index
      %col_inactive = index.assume %col_inactive_raw [lt(%col_inactive_raw, %n)] : index
      %zero_inactive = scalar.constant 0.0 : f32
      view.store %zero_inactive, %output_inactive[%a, %col_inactive] : f32, view<[%tokens]x[%n]xf32>
    }
  }
  kernel.return
}

kernel.def target(@llm.platform.experts.wave32) @llm.experts.indexed_down_q4(%n: index, %tokens: index) {
  %c1 = index.constant 1 : index

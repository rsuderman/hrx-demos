        view.store %s0, %pv[0, %wave, %rb] : f32, view<2x2x2xf32>
      }
      %wq1, %sc1, %mn1 = scf.if %ok -> (vector<32xi8>, f32, f32) {
        %v, %a, %b = func.call @llm.experts.q4_codes(%w2, %o, %within) : (buffer, offset, index) -> (vector<32xi8>, f32, f32)
        scf.yield %v, %a, %b : vector<32xi8>, f32, f32
      } else {

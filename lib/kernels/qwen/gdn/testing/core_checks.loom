func.def @reference_layout(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 3 : index
  func.call @test_gdn_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %count = index.constant 262144 : index
  %width = index.constant 128 : index
  %value = index.constant 7 : index
  %key = index.constant 11 : index
  %offset = index.constant 256 : offset
  %matrix = buffer.view %state[%offset] : buffer -> view<262144xf32>
  // A one-cell impulse decomposes into a constant key-vector and an orthogonal
  // component. Their eigenvalues are1/4 and1/2 respectively for this fixture.
  %baseline = scalar.constant 0.05800485314420897 : f32
  %orthogonal = scalar.constant 0.015625 : f32
  %mean = scalar.constant -0.0001068115234375 : f32
  scf.for %i = [%zero to %count step %one] {
    %column = index.div %i, %width : index
    %row = index.rem %i, %width : index
    %selected_column = index.cmp eq, %column, %value : index
    %expected = scf.if %selected_column -> (f32) {
      %selected_key = index.cmp eq, %row, %key : index
      %z = scalar.constant 0.0 : f32
      %bump = scf.select %selected_key, %orthogonal, %z : f32
      %delta = scalar.addf %mean, %bump : f32
      %v = scalar.addf %baseline, %delta : f32
      scf.yield %v : f32
    } else { scf.yield %baseline : f32 }
    view.store %expected, %matrix[%i] : f32, view<262144xf32>
  }
  %origin = index.constant 0 : offset
  %out = buffer.view %output[%origin] : buffer -> view<8x2048xf32>
  %row1 = index.constant 2 : index
  %baseline1 = scalar.constant 0.044194173824159216 : f32
  %bump1 = scalar.constant 0.000244140625 : f32
  %columns1 = index.constant 2048 : index
  scf.for %c = [%zero to %columns1 step %one] {
    %selected = index.cmp eq, %c, %value : index
    %z = scalar.constant 0.0 : f32
    %delta = scf.select %selected, %bump1, %z : f32
    %expected = scalar.addf %baseline1, %delta : f32
    view.store %expected, %out[%row1, %c] : f32, view<8x2048xf32>
  }
  %row2 = index.constant 3 : index
  %baseline2 = scalar.constant 0.05524271728019902 : f32
  %bump2 = scalar.constant 6.103515625e-05 : f32
  %columns2 = index.constant 2048 : index
  scf.for %c = [%zero to %columns2 step %one] {
    %selected = index.cmp eq, %c, %value : index
    %z = scalar.constant 0.0 : f32
    %delta = scf.select %selected, %bump2, %z : f32
    %expected = scalar.addf %baseline2, %delta : f32
    view.store %expected, %out[%row2, %c] : f32, view<8x2048xf32>
  }
  %row3 = index.constant 4 : index
  %baseline3 = scalar.constant 0.05800485314420897 : f32
  %bump3 = scalar.constant 1.52587890625e-05 : f32
  %columns3 = index.constant 2048 : index
  scf.for %c = [%zero to %columns3 step %one] {
    %selected = index.cmp eq, %c, %value : index
    %z = scalar.constant 0.0 : f32
    %delta = scf.select %selected, %bump3, %z : f32
    %expected = scalar.addf %baseline3, %delta : f32
    view.store %expected, %out[%row3, %c] : f32, view<8x2048xf32>
  }
  func.return
}

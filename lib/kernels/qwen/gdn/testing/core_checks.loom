// SPDX-License-Identifier: MIT
// Independent constant-channel state anchors, not copied recurrent math.
func.def @test_gdn_epoch(%n: index, %epoch: buffer, %rows: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %five = index.constant 5 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %n32 = index.cast %n : index to i32
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %minus = scalar.constant -1 : i32
  %control = buffer.view %epoch[%origin] : buffer -> view<1048xi32>
  view.store %n32, %control[%zero] : i32, view<1048xi32>
  view.store %one32, %control[%one] : i32, view<1048xi32>
  view.store %zero32, %control[%two] : i32, view<1048xi32>
  view.store %n32, %control[%three] : i32, view<1048xi32>
  view.store %zero32, %control[%four] : i32, view<1048xi32>
  view.store %two32, %control[%five] : i32, view<1048xi32>
  view.store %zero32, %control[%six] : i32, view<1048xi32>
  view.store %minus, %control[%seven] : i32, view<1048xi32>
  %table = buffer.view %rows[%origin] : buffer -> view<4xi64>
  %zero64 = scalar.constant 0 : i64
  scf.for %i = [%zero to %four step %one] { view.store %zero64, %table[%i] : i64, view<4xi64> }
  func.return
}
kernel.def @test_gdn_epoch_kernel() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%n: index, %epoch: buffer, %rows: buffer) {
  func.call @test_gdn_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  kernel.return
}
command.program.def public @actual_rec1() launch(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 1 : index
  %one = index.constant 1 : index
  %offset = index.constant 256 : offset
  kernel.launch @test_gdn_epoch_kernel[](%n, %epoch, %rows) : [](index, buffer, buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @reference_rec1(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 1 : index
  func.call @test_gdn_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %begin = index.constant 2 : index
  %width = index.constant 2048 : index
  %elements = index.constant 262144 : index
  %origin = index.constant 0 : offset
  %offset = index.constant 256 : offset
  %matrix = buffer.view %state[%offset] : buffer -> view<262144xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x2048xf32>
  %initial = view.load %matrix[%zero] : view<262144xf32> -> f32
  // With normalized Q=K=1/sqrt128, V=1, alpha=bias=beta=0 and A=-1:
  // decay=1/2; one scalar state entry advances m'=m/4+1/(2sqrt128).
  // Query readout (including scale1/sqrt128) equals m' exactly in real arithmetic.
  %quarter = scalar.constant 0.25 : f32
  %increment = scalar.constant 0.04419417382415922 : f32
  %final = scf.for %t = [%zero to %n step %one](%m = %initial : f32) -> (f32) {
    %decayed = scalar.mulf %m, %quarter : f32
    %next = scalar.addf %decayed, %increment : f32
    %row = index.add %t, %begin : index
    scf.for %c = [%zero to %width step %one] { view.store %next, %out[%row, %c] : f32, view<8x2048xf32> }
    scf.yield %next : f32
  }
  scf.for %i = [%zero to %elements step %one] { view.store %final, %matrix[%i] : f32, view<262144xf32> }
  func.return
}
check.scenario @recurrent_zero_1 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %qkv = check.generate.fill value(1.0) : tensor<49152xf32>
    %inverse = check.generate.fill value(0.08838834764831845) : tensor<256xf32>
    %alpha = check.generate.fill value(0.0) : tensor<128xf32>
    %beta = check.generate.fill value(0.0) : tensor<128xf32>
    %a = check.generate.fill value(-1.0) : tensor<16xf32>
    %bias = check.generate.fill value(0.0) : tensor<16xf32>
    %state = check.generate.fill value(0.0) : tensor<262272xf32>
    %state_prefix = check.tensor.view %state offset(0) : tensor<262272xf32> -> tensor<64xf32>
    %state_suffix = check.tensor.view %state offset(1048832) : tensor<262272xf32> -> tensor<64xf32>
    %output = check.generate.fill value(-99.0) : tensor<16384xf32>
    %output_prefix = check.tensor.view %output offset(0) : tensor<16384xf32> -> tensor<4096xf32>
    %output_suffix = check.tensor.view %output offset(24576) : tensor<16384xf32> -> tensor<10240xf32>
    check.compare<@actual_rec1, @reference_rec1>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<49152xf32>, tensor<256xf32>, tensor<128xf32>, tensor<128xf32>, tensor<16xf32>, tensor<16xf32>, tensor<262272xf32>, tensor<16384xf32>) -> () {
      check.expect.close actual(%state) expected(%state) atol(0.00001) rtol(0.00001) nan(same) : tensor<262272xf32>
      check.expect.bitwise actual(%state_prefix) expected(%state_prefix) : tensor<64xf32>
      check.expect.bitwise actual(%state_suffix) expected(%state_suffix) : tensor<64xf32>
      check.expect.close actual(%output) expected(%output) atol(0.00001) rtol(0.00001) nan(same) : tensor<16384xf32>
      check.expect.bitwise actual(%output_prefix) expected(%output_prefix) : tensor<4096xf32>
      check.expect.bitwise actual(%output_suffix) expected(%output_suffix) : tensor<10240xf32>
      check.expect.bitwise actual(%qkv) expected(%qkv) : tensor<49152xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%rows) expected(%rows) : tensor<4xi64>
    }
  }
  check.return
}

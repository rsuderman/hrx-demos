    %a = check.generate.fill value(-1.0) : tensor<16xf32>
    %bias = check.generate.fill value(0.0) : tensor<16xf32>
    %state = check.generate.fill value(0.0) : tensor<262272xf32>
    %state_prefix = check.tensor.view %state offset(0) : tensor<262272xf32> -> tensor<64xf32>
    %state_suffix = check.tensor.view %state offset(1048832) : tensor<262272xf32> -> tensor<64xf32>
    %output = check.generate.fill value(-99.0) : tensor<16384xf32>
    %output_prefix = check.tensor.view %output offset(0) : tensor<16384xf32> -> tensor<4096xf32>
    %output_suffix = check.tensor.view %output offset(40960) : tensor<16384xf32> -> tensor<6144xf32>
    check.compare<@actual_layout, @reference_layout>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<49152xf32>, tensor<256xf32>, tensor<128xf32>, tensor<128xf32>, tensor<16xf32>, tensor<16xf32>, tensor<262272xf32>, tensor<16384xf32>) -> () {
      check.expect.close actual(%state) expected(%state) atol(0.00001) rtol(0.00001) nan(same) : tensor<262272xf32>
      check.expect.bitwise actual(%state_prefix) expected(%state_prefix) : tensor<64xf32>
      check.expect.bitwise actual(%state_suffix) expected(%state_suffix) : tensor<64xf32>
      check.expect.close actual(%output) expected(%output) atol(0.00001) rtol(0.00001) nan(same) : tensor<16384xf32>
      check.expect.bitwise actual(%output_prefix) expected(%output_prefix) : tensor<4096xf32>
      check.expect.bitwise actual(%output_suffix) expected(%output_suffix) : tensor<6144xf32>
      check.expect.bitwise actual(%qkv) expected(%qkv) : tensor<49152xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%rows) expected(%rows) : tensor<4xi64>
    }
  }
  check.return
}


command.program.def public @actual_rec512() launch(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 512 : index
  %one = index.constant 1 : index
  %offset = index.constant 256 : offset
  kernel.launch @test_gdn_epoch_full_kernel[](%n, %epoch, %rows) : [](index, buffer, buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @reference_rec512(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 512 : index
  func.call @test_gdn_epoch_full(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %begin = index.constant 0 : index
  %width = index.constant 2048 : index
  %elements = index.constant 262144 : index
  %origin = index.constant 0 : offset
  %offset = index.constant 256 : offset
  %matrix = buffer.view %state[%offset] : buffer -> view<262144xf32>
  %out = buffer.view %output[%origin] : buffer -> view<512x2048xf32>
  %initial = view.load %matrix[%zero] : view<262144xf32> -> f32
  // With normalized Q=K=1/sqrt128, V=1, alpha=bias=beta=0 and A=-1:
  // decay=1/2; one scalar state entry advances m'=m/4+1/(2sqrt128).
  // Query readout (including scale1/sqrt128) equals m' exactly in real arithmetic.
  %quarter = scalar.constant 0.25 : f32
  %increment = scalar.constant 0.04419417382415922 : f32
  %final = scf.for %t = [%zero to %n step %one](%m = %initial : f32) -> (f32) {
    %decayed = scalar.mulf %m, %quarter : f32
    %next = scalar.addf %decayed, %increment : f32
    %row = index.add %t, %begin : index
    scf.for %c = [%zero to %width step %one] { view.store %next, %out[%row, %c] : f32, view<512x2048xf32> }
    scf.yield %next : f32
  }
  scf.for %i = [%zero to %elements step %one] { view.store %final, %matrix[%i] : f32, view<262144xf32> }
  func.return
}
check.scenario @recurrent_zero_512 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %qkv = check.generate.fill value(1.0) : tensor<3145728xf32>
    %inverse = check.generate.fill value(0.08838834764831845) : tensor<16384xf32>
    %alpha = check.generate.fill value(0.0) : tensor<8192xf32>
    %beta = check.generate.fill value(0.0) : tensor<8192xf32>
    %a = check.generate.fill value(-1.0) : tensor<16xf32>
    %bias = check.generate.fill value(0.0) : tensor<16xf32>
    %state = check.generate.fill value(0.0) : tensor<262272xf32>
    %state_prefix = check.tensor.view %state offset(0) : tensor<262272xf32> -> tensor<64xf32>

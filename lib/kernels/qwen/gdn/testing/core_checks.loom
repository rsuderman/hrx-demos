func.def @reference_conv1(%epoch: buffer, %rows: buffer, %input: buffer, %weight: buffer, %history: buffer, %output: buffer, %inverse: buffer) {
  %n = index.constant 1 : index
  func.call @test_gdn_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %begin = index.constant 2 : index
  %width = index.constant 6144 : index
  %heads = index.constant 32 : index
  %origin = index.constant 0 : offset
  %offset = index.constant 256 : offset
  %h = buffer.view %history[%offset] : buffer -> view<6144x3xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x6144xf32>
  %inv = buffer.view %inverse[%origin] : buffer -> view<8x32xf32>
  %h0 = view.load %h[%zero, %zero] : view<6144x3xf32> -> f32
  %h1 = view.load %h[%zero, %one] : view<6144x3xf32> -> f32
  %h2 = view.load %h[%zero, %two] : view<6144x3xf32> -> f32
  %x = scalar.constant 0.125 : f32
  %w0 = scalar.constant 0.125 : f32
  %w1 = scalar.constant 0.15625 : f32
  %w2 = scalar.constant 0.1875 : f32
  %w3 = scalar.constant 0.21875 : f32
  %sqrt128 = scalar.constant 11.313708498984761 : f32
  %epsilon = scalar.constant 0.000001 : f32
  %onef = scalar.constant 1.0 : f32
  %last0, %last1, %last2 = scf.for %t = [%zero to %n step %one](%old0 = %h0 : f32, %old1 = %h1 : f32, %old2 = %h2 : f32) -> (f32, f32, f32) {
    %v0 = scalar.mulf %old0, %w0 : f32
    %v1 = scalar.mulf %old1, %w1 : f32
    %v2 = scalar.mulf %old2, %w2 : f32
    %v3 = scalar.mulf %x, %w3 : f32
    %s0 = scalar.addf %v0, %v1 : f32
    %s1 = scalar.addf %v2, %v3 : f32
    %sum = scalar.addf %s0, %s1 : f32
    %negative = scalar.negf %sum : f32
    %exponential = scalar.expf<afn> %negative : f32
    %denominator = scalar.addf %onef, %exponential : f32
    %activated = scalar.divf %sum, %denominator : f32
    %abs = scalar.absf %activated : f32
    %length = scalar.mulf %abs, %sqrt128 : f32
    %safe = scalar.maxnumf %length, %epsilon : f32
    %inverse_value = scalar.divf %onef, %safe : f32
    %row = index.add %t, %begin : index
    scf.for %c = [%zero to %width step %one] { view.store %activated, %out[%row, %c] : f32, view<8x6144xf32> }
    scf.for %head = [%zero to %heads step %one] { view.store %inverse_value, %inv[%row, %head] : f32, view<8x32xf32> }
    scf.yield %old1, %old2, %x : f32, f32, f32
  }
  scf.for %c = [%zero to %width step %one] {
    view.store %last0, %h[%c, %zero] : f32, view<6144x3xf32>
    view.store %last1, %h[%c, %one] : f32, view<6144x3xf32>
    view.store %last2, %h[%c, %two] : f32, view<6144x3xf32>
  }
  func.return
}

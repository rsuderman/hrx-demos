    check.compare<@actual_continuation, @reference_continuation>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<49152xf32>, tensor<256xf32>, tensor<128xf32>, tensor<128xf32>, tensor<16xf32>, tensor<16xf32>, tensor<524544xf32>, tensor<16384xf32>) -> () {

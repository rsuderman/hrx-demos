  kernel.launch @test_gdn_impulse[](%state) : [](buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return

  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @test_gdn_continue_kernel[](%epoch) : [](buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @reference_continuation(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 3 : index
  func.call @test_gdn_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  func.call @test_gdn_fork(%rows, %state) : (buffer, buffer) -> ()
  func.call @test_gdn_continue(%epoch) : (buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %two = index.constant 2 : index
  %width = index.constant 2048 : index
  %count = index.constant 262144 : index
  %origin = index.constant 0 : offset
  %writer_origin = index.constant 1049344 : offset
  %read_origin = index.constant 256 : offset
  %anchor = buffer.view %state[%read_origin] : buffer -> view<262144xf32>
  %writer = buffer.view %state[%writer_origin] : buffer -> view<262144xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x2048xf32>
  %initial = view.load %anchor[%zero] : view<262144xf32> -> f32
  %quarter = scalar.constant 0.25 : f32
  %increment = scalar.constant 0.04419417382415922 : f32
  %final = scf.for %t = [%zero to %four step %one](%m = %initial : f32) -> (f32) {
    %d = scalar.mulf %m, %quarter : f32
    %next = scalar.addf %d, %increment : f32
    %three = index.constant 3 : index
    %last = index.cmp eq, %t, %three : index
    %row0 = index.add %t, %two : index
    %row = scf.select %last, %two, %row0 : index
    scf.for %c = [%zero to %width step %one] { view.store %next, %out[%row, %c] : f32, view<8x2048xf32> }
    scf.yield %next : f32
  }
  scf.for %i = [%zero to %count step %one] { view.store %final, %writer[%i] : f32, view<262144xf32> }
  func.return
}

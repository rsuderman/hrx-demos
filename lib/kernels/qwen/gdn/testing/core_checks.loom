  kernel.launch @qwen38_gdn_conv_spans[%one](%epoch, %rows, %offset, %epsilon, %input, %weight, %history, %output, %inverse) : [index](buffer, buffer, offset, f32, buffer, buffer, buffer, buffer, buffer)

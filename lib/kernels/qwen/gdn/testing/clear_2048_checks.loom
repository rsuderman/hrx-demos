// Guarded poison regression: every declared raw row must be initialized.
kernel.decl @qwen08_gdn_clear_raw(%tokens: index) launch(%tokens: index, %output: buffer)

check.case @clear_2048_rows1 {
  %tokens = check.literal value(1) : index
  %owner = check.generate.fill value(91.0) : tensor<2176xf32>
  %prefix = check.tensor.view %owner offset(0) : tensor<2176xf32> -> tensor<64xf32>
  %raw = check.tensor.view %owner offset(256) : tensor<2176xf32> -> tensor<2048xf32>
  %suffix = check.tensor.view %owner offset(8448) : tensor<2176xf32> -> tensor<64xf32>
  %guard = check.generate.fill value(91.0) : tensor<64xf32>
  %zero = check.generate.fill value(0.0) : tensor<2048xf32>
  kernel.launch @qwen08_gdn_clear_raw[%tokens](%tokens, %raw) : [index](index, tensor<2048xf32>)
  check.expect.bitwise actual(%raw) expected(%zero) : tensor<2048xf32>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<64xf32>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<64xf32>
  check.return
}

check.case @clear_2048_rows3 {
  %tokens = check.literal value(3) : index
  %owner = check.generate.fill value(91.0) : tensor<6272xf32>
  %prefix = check.tensor.view %owner offset(0) : tensor<6272xf32> -> tensor<64xf32>
  %raw = check.tensor.view %owner offset(256) : tensor<6272xf32> -> tensor<6144xf32>
  %suffix = check.tensor.view %owner offset(24832) : tensor<6272xf32> -> tensor<64xf32>
  %guard = check.generate.fill value(91.0) : tensor<64xf32>
  %zero = check.generate.fill value(0.0) : tensor<6144xf32>
  kernel.launch @qwen08_gdn_clear_raw[%tokens](%tokens, %raw) : [index](index, tensor<6144xf32>)
  check.expect.bitwise actual(%raw) expected(%zero) : tensor<6144xf32>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<64xf32>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<64xf32>
  check.return
}

// Exact initialization/state contract through production clear, recurrence and
// norm-gate children. This isolates the stateful numerical tail, not projection/FFN.
kernel.decl @qwen08_gdn_clear_raw(%tokens$0: index) launch(%tokens$1: index, %output: buffer)

kernel.decl @qwen38_gdn_norm_gate_prefill(%tokens: index) launch(%capacity: index, %epsilon: f32, %raw: buffer, %weight: buffer, %z: buffer, %output: buffer)

kernel.decl @qwen38_gdn_recurrent_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)

func.def @test_gdn_epoch(%n: index, %epoch: buffer, %rows: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %five = index.constant 5 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %n32 = index.cast %n : index to i32
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %minus = scalar.constant -1 : i32
  %control = buffer.view %epoch[%origin] : buffer -> view<1048xi32>
  view.store %n32, %control[%zero] : i32, view<1048xi32>
  view.store %one32, %control[%one] : i32, view<1048xi32>
  view.store %zero32, %control[%two] : i32, view<1048xi32>
  view.store %n32, %control[%three] : i32, view<1048xi32>
  view.store %zero32, %control[%four] : i32, view<1048xi32>
  view.store %two32, %control[%five] : i32, view<1048xi32>
  view.store %zero32, %control[%six] : i32, view<1048xi32>
  view.store %minus, %control[%seven] : i32, view<1048xi32>
  %table = buffer.view %rows[%origin] : buffer -> view<4xi64>
  %zero64 = scalar.constant 0 : i64
  scf.for %i = [%zero to %four step %one] {
    view.store %zero64, %table[%i] : i64, view<4xi64>
  }
  func.return
}

kernel.def @test_gdn_epoch_kernel() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%n: index, %epoch: buffer, %rows: buffer) {
  func.call @test_gdn_epoch(%n, %epoch, %rows) : (index, buffer, buffer)
  kernel.return
}

command.def public @partial_actual() launch(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %raw: buffer, %weight: buffer, %z: buffer, %output: buffer) {
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %offset = index.constant 256 : offset
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  kernel.launch @test_gdn_epoch_kernel(%one, %epoch, %rows) : (index, buffer, buffer)
  kernel.launch @qwen08_gdn_clear_raw[%three](%three, %raw) : [index](index, buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %raw) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_gdn_norm_gate_prefill[%three](%three, %epsilon, %raw, %weight, %z, %output) : [index](index, f32, buffer, buffer, buffer, buffer)
  command.return
}

func.def @partial_expected(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %raw: buffer, %weight: buffer, %z: buffer, %output: buffer) {
  %one = index.constant 1 : index
  func.call @test_gdn_epoch(%one, %epoch, %rows) : (index, buffer, buffer)
  %zero = index.constant 0 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %width = index.constant 6144 : index
  %state_count = index.constant 786432 : index
  %origin = index.constant 0 : offset
  %state_origin = index.constant 256 : offset
  %s = buffer.view %state[%state_origin] : buffer -> view<786432xf32>
  %r = buffer.view %raw[%origin] : buffer -> view<3x6144xf32>
  %out = buffer.view %output[%origin] : buffer -> view<3x6144xf32>
  // Closed-form single-step anchor for constant normalized Q/K, V=1,
  // initial state .125, decay .5 and beta .5: m'=.125/4+1/(2sqrt128).
  %initial = view.load %s[%zero] : view<786432xf32> -> f32
  %quarter = scalar.constant 0.25 : f32
  %increment = scalar.constant 0.044194173824159223 : f32
  %decayed = scalar.mulf %initial, %quarter : f32
  %next = scalar.addf %decayed, %increment : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %square = scalar.mulf %next, %next : f32
  %biased = scalar.addf %square, %epsilon : f32
  %inv = scalar.rsqrtf %biased : f32
  %normalized = scalar.mulf %next, %inv : f32
  // gamma=.5, z=.125; independent host SiLU(.125)*.5.
  %gate = scalar.constant 0.033200585835859948 : f32
  %gated = scalar.mulf %normalized, %gate : f32
  %zero_f = scalar.constant 0.0 : f32
  scf.for %t = [%zero to %three step %one] {
    %active = index.cmp eq, %t, %two : index
    %v = scf.select %active, %next, %zero_f : f32
    %g = scf.select %active, %gated, %zero_f : f32
    scf.for %c = [%zero to %width step %one] {
      view.store %v, %r[%t, %c] : f32, view<3x6144xf32>
      view.store %g, %out[%t, %c] : f32, view<3x6144xf32>
    }
  }
  scf.for %i = [%zero to %state_count step %one] {
    view.store %next, %s[%i] : f32, view<786432xf32>
  }
  func.return
}

check.scenario @partial_active_6144_positive_poison {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %qkv = check.generate.fill value(1.0) : tensor<81920xf32>
    %inverse = check.generate.fill value(0.088388347648318447) : tensor<256xf32>
    %alpha = check.generate.fill value(0.0) : tensor<384xf32>
    %beta = check.generate.fill value(0.0) : tensor<384xf32>
    %a = check.generate.fill value(-1.0) : tensor<48xf32>
    %bias = check.generate.fill value(0.0) : tensor<48xf32>
    %state = check.generate.fill value(0.125) : tensor<786560xf32>
    %prefix = check.tensor.view %state offset(0) : tensor<786560xf32> -> tensor<64xf32>
    %suffix = check.tensor.view %state offset(3145984) : tensor<786560xf32> -> tensor<64xf32>
    %raw = check.generate.fill value(91.0) : tensor<18496xf32>
    %raw_suffix = check.tensor.view %raw offset(73728) : tensor<18496xf32> -> tensor<64xf32>
    %weight = check.generate.fill value(0.5) : tensor<128xf32>
    %z = check.generate.fill value(0.125) : tensor<18432xf32>
    %output = check.generate.fill value(-99.0) : tensor<18496xf32>
    %output_suffix = check.tensor.view %output offset(73728) : tensor<18496xf32> -> tensor<64xf32>
    check.compare<@partial_actual, @partial_expected>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %raw, %weight, %z, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<81920xf32>, tensor<256xf32>, tensor<384xf32>, tensor<384xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786560xf32>, tensor<18496xf32>, tensor<128xf32>, tensor<18432xf32>, tensor<18496xf32>) -> () {
      check.expect.approximate actual(%state) expected(%state) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<786560xf32>, tensor<786560xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<64xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<64xf32>
      check.expect.approximate actual(%raw) expected(%raw) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<18496xf32>, tensor<18496xf32>
      check.expect.bitwise actual(%raw_suffix) expected(%raw_suffix) : tensor<64xf32>
      check.expect.approximate actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<18496xf32>, tensor<18496xf32>
      check.expect.bitwise actual(%output_suffix) expected(%output_suffix) : tensor<64xf32>
      check.expect.bitwise actual(%qkv) expected(%qkv) : tensor<81920xf32>
    }
  }
  check.return
}

check.scenario @partial_active_6144_negative_poison {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %qkv = check.generate.fill value(1.0) : tensor<81920xf32>
    %inverse = check.generate.fill value(0.088388347648318447) : tensor<256xf32>
    %alpha = check.generate.fill value(0.0) : tensor<384xf32>
    %beta = check.generate.fill value(0.0) : tensor<384xf32>
    %a = check.generate.fill value(-1.0) : tensor<48xf32>
    %bias = check.generate.fill value(0.0) : tensor<48xf32>
    %state = check.generate.fill value(0.125) : tensor<786560xf32>
    %prefix = check.tensor.view %state offset(0) : tensor<786560xf32> -> tensor<64xf32>
    %suffix = check.tensor.view %state offset(3145984) : tensor<786560xf32> -> tensor<64xf32>
    %raw = check.generate.fill value(-37.0) : tensor<18496xf32>

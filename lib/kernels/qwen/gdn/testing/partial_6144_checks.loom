    check.compare<@partial_actual, @partial_expected>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %raw, %weight, %z, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<81920xf32>, tensor<256xf32>, tensor<384xf32>, tensor<384xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786560xf32>, tensor<18496xf32>, tensor<128xf32>, tensor<18432xf32>, tensor<18496xf32>) -> () {
      check.expect.approximate actual(%state) expected(%state) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<786560xf32>, tensor<786560xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<64xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<64xf32>
      check.expect.approximate actual(%raw) expected(%raw) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<18496xf32>, tensor<18496xf32>
      check.expect.bitwise actual(%raw_suffix) expected(%raw_suffix) : tensor<64xf32>
      check.expect.approximate actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<18496xf32>, tensor<18496xf32>
      check.expect.bitwise actual(%output_suffix) expected(%output_suffix) : tensor<64xf32>
      check.expect.bitwise actual(%qkv) expected(%qkv) : tensor<81920xf32>
    }
  }
  check.return
}

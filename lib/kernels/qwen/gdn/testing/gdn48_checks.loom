// Closed-form one-hot recurrence: tests all 48 value heads against 16 distinct
// key heads. The full state oracle detects modulo-vs-contiguous head routing.
kernel.decl @qwen38_gdn_recurrent_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)
func.def @test_gdn48_epoch(%n: index, %epoch: buffer, %rows: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %five = index.constant 5 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %n32 = index.cast %n : index to i32
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %minus = scalar.constant -1 : i32
  %control = buffer.view %epoch[%origin] : buffer -> view<1048xi32>
  view.store %n32, %control[%zero] : i32, view<1048xi32>
  view.store %one32, %control[%one] : i32, view<1048xi32>
  view.store %zero32, %control[%two] : i32, view<1048xi32>
  view.store %n32, %control[%three] : i32, view<1048xi32>
  view.store %zero32, %control[%four] : i32, view<1048xi32>
  view.store %two32, %control[%five] : i32, view<1048xi32>
  view.store %zero32, %control[%six] : i32, view<1048xi32>
  view.store %minus, %control[%seven] : i32, view<1048xi32>
  %table = buffer.view %rows[%origin] : buffer -> view<4xi64>
  %zero64 = scalar.constant 0 : i64
  scf.for %i = [%zero to %four step %one] { view.store %zero64, %table[%i] : i64, view<4xi64> }
  func.return
}
kernel.def @test_gdn48_epoch_kernel() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%n: index, %epoch: buffer, %rows: buffer) {
  func.call @test_gdn48_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  kernel.return
}
func.def @gdn48_inputs(%qkv: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %sixteen = index.constant 16 : index
  %heads = index.constant 48 : index
  %D = index.constant 128 : index
  %K = index.constant 2048 : index
  %V = index.constant 4096 : index
  %origin = index.constant 0 : offset
  %q = buffer.view %qkv[%origin] : buffer -> view<8x10240xf32>
  %unit = scalar.constant 1.0 : f32
  scf.for %t = [%two to %four step %one] {
    scf.for %h = [%zero to %sixteen step %one] {
      %base = index.mul %h, %D : index
      %qi = index.add %base, %h : index
      %ki = index.add %qi, %K : index
      view.store %unit, %q[%t, %qi] : f32, view<8x10240xf32>
      view.store %unit, %q[%t, %ki] : f32, view<8x10240xf32>
    }
    scf.for %h = [%zero to %heads step %one] {
      %value = index.add %h, %one : index
      %v32 = index.cast %value : index to i32
      %f = scalar.uitofp %v32 : i32 to f32
      %base = index.mul %h, %D : index
      %start = index.add %base, %V : index
      scf.for %c = [%zero to %D step %one] {
        %i = index.add %start, %c : index
        view.store %f, %q[%t, %i] : f32, view<8x10240xf32>
      }
    }
  }
  func.return
}
kernel.def @gdn48_input_kernel() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%qkv: buffer) {
  func.call @gdn48_inputs(%qkv) : (buffer) -> ()
  kernel.return
}
command.program.def public @gdn48_actual() launch(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 2 : index
  %one = index.constant 1 : index
  %offset = index.constant 256 : offset
  kernel.launch @test_gdn48_epoch_kernel[](%n, %epoch, %rows) : [](index, buffer, buffer)
  kernel.launch @gdn48_input_kernel[](%qkv) : [](buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @gdn48_expected(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %n = index.constant 2 : index
  func.call @test_gdn48_epoch(%n, %epoch, %rows) : (index, buffer, buffer) -> ()
  func.call @gdn48_inputs(%qkv) : (buffer) -> ()
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %D = index.constant 128 : index
  %K = index.constant 16 : index
  %heads = index.constant 48 : index
  %r1 = index.constant 2 : index
  %r2 = index.constant 3 : index
  %offset = index.constant 256 : offset
  %origin = index.constant 0 : offset
  %matrix = buffer.view %state[%offset] : buffer -> view<48x128x128xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x6144xf32>
  // Initial S=.125. Nonselected key entries decay to .03125 after two
  // tokens; selected entry is .0078125 + .625*(head+1). No recurrence loop.
  %base = scalar.constant 0.03125 : f32
  %s1base = scalar.constant 0.03125 : f32
  %s2base = scalar.constant 0.0078125 : f32
  %half = scalar.constant 0.5 : f32
  %five_eighths = scalar.constant 0.625 : f32
  %scale = scalar.constant 0.088388347648318447 : f32
  scf.for %h = [%zero to %heads step %one] {
    %kh = index.rem %h, %K : index
    %v = index.add %h, %one : index
    %v32 = index.cast %v : index to i32
    %vf = scalar.uitofp %v32 : i32 to f32
    %vhalf = scalar.mulf %vf, %half : f32
    %vfinal = scalar.mulf %vf, %five_eighths : f32
    %s1 = scalar.addf %s1base, %vhalf : f32
    %s2 = scalar.addf %s2base, %vfinal : f32
    %o1 = scalar.mulf %s1, %scale : f32
    %o2 = scalar.mulf %s2, %scale : f32
    %start = index.mul %h, %D : index
    scf.for %c = [%zero to %D step %one] {
      %channel = index.add %start, %c : index
      view.store %o1, %out[%r1, %channel] : f32, view<8x6144xf32>
      view.store %o2, %out[%r2, %channel] : f32, view<8x6144xf32>
      scf.for %k = [%zero to %D step %one] {
        %hit = index.cmp eq, %k, %kh : index
        %value = scf.select %hit, %s2, %base : f32
        view.store %value, %matrix[%h, %c, %k] : f32, view<48x128x128xf32>
      }
    }
  }
  func.return
}
check.scenario @gdn48_modulo_heads_nonzero_state {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %qkv = check.generate.fill value(0.0) : tensor<81920xf32>
    %inverse = check.generate.fill value(1.0) : tensor<256xf32>
    %alpha = check.generate.fill value(0.0) : tensor<384xf32>
    %beta = check.generate.fill value(0.0) : tensor<384xf32>
    %a = check.generate.fill value(-1.0) : tensor<48xf32>
    %bias = check.generate.fill value(0.0) : tensor<48xf32>
    %state = check.generate.fill value(0.125) : tensor<786560xf32>
    %output = check.generate.fill value(-99.0) : tensor<49152xf32>
    %state_prefix = check.tensor.view %state offset(0) : tensor<786560xf32> -> tensor<64xf32>
    %state_suffix = check.tensor.view %state offset(3145984) : tensor<786560xf32> -> tensor<64xf32>
    %output_prefix = check.tensor.view %output offset(0) : tensor<49152xf32> -> tensor<12288xf32>
    %output_suffix = check.tensor.view %output offset(98304) : tensor<49152xf32> -> tensor<24576xf32>
    check.compare<@gdn48_actual, @gdn48_expected>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<81920xf32>, tensor<256xf32>, tensor<384xf32>, tensor<384xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786560xf32>, tensor<49152xf32>) -> () {
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%rows) expected(%rows) : tensor<4xi64>
      check.expect.bitwise actual(%qkv) expected(%qkv) : tensor<81920xf32>
      check.expect.bitwise actual(%inverse) expected(%inverse) : tensor<256xf32>
      check.expect.bitwise actual(%alpha) expected(%alpha) : tensor<384xf32>
      check.expect.bitwise actual(%beta) expected(%beta) : tensor<384xf32>
      check.expect.bitwise actual(%a) expected(%a) : tensor<48xf32>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<48xf32>
      check.expect.close actual(%state) expected(%state) atol(0.00002) rtol(0.00002) nan(same) : tensor<786560xf32>
      check.expect.close actual(%output) expected(%output) atol(0.00002) rtol(0.00002) nan(same) : tensor<49152xf32>
      check.expect.bitwise actual(%state_prefix) expected(%state_prefix) : tensor<64xf32>
      check.expect.bitwise actual(%state_suffix) expected(%state_suffix) : tensor<64xf32>
      check.expect.bitwise actual(%output_prefix) expected(%output_prefix) : tensor<12288xf32>
      check.expect.bitwise actual(%output_suffix) expected(%output_suffix) : tensor<24576xf32>
    }
  }
  check.return
}

// Two separate committed invocations must continue the same state. The
// closed-form oracle remains the two-token result above, without replay math.
kernel.def @gdn48_continue_epoch() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer) {
  %zero = index.constant 0 : index
  %three = index.constant 3 : index
  %five = index.constant 5 : index
  %origin = index.constant 0 : offset
  %one32 = scalar.constant 1 : i32
  %three32 = scalar.constant 3 : i32
  %e = buffer.view %epoch[%origin] : buffer -> view<1048xi32>
  view.store %one32, %e[%zero] : i32, view<1048xi32>
  view.store %one32, %e[%three] : i32, view<1048xi32>
  view.store %three32, %e[%five] : i32, view<1048xi32>
  kernel.return
}
command.program.def public @gdn48_continued_actual() launch(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %one = index.constant 1 : index
  %offset = index.constant 256 : offset
  kernel.launch @test_gdn48_epoch_kernel[](%one, %epoch, %rows) : [](index, buffer, buffer)
  kernel.launch @gdn48_input_kernel[](%qkv) : [](buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @gdn48_continue_epoch[](%epoch) : [](buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%one](%epoch, %rows, %offset, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @gdn48_continued_expected(%epoch: buffer, %rows: buffer, %qkv: buffer, %inverse: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  func.call @gdn48_expected(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> ()
  %zero = index.constant 0 : index
  %three = index.constant 3 : index
  %five = index.constant 5 : index
  %origin = index.constant 0 : offset
  %one32 = scalar.constant 1 : i32
  %three32 = scalar.constant 3 : i32
  %e = buffer.view %epoch[%origin] : buffer -> view<1048xi32>
  view.store %one32, %e[%zero] : i32, view<1048xi32>
  view.store %one32, %e[%three] : i32, view<1048xi32>
  view.store %three32, %e[%five] : i32, view<1048xi32>
  func.return
}
check.scenario @gdn48_committed_continuation {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %qkv = check.generate.fill value(0.0) : tensor<81920xf32>
    %inverse = check.generate.fill value(1.0) : tensor<256xf32>
    %alpha = check.generate.fill value(0.0) : tensor<384xf32>
    %beta = check.generate.fill value(0.0) : tensor<384xf32>
    %a = check.generate.fill value(-1.0) : tensor<48xf32>
    %bias = check.generate.fill value(0.0) : tensor<48xf32>
    %state = check.generate.fill value(0.125) : tensor<786560xf32>
    %output = check.generate.fill value(-99.0) : tensor<49152xf32>
    %state_prefix = check.tensor.view %state offset(0) : tensor<786560xf32> -> tensor<64xf32>
    %state_suffix = check.tensor.view %state offset(3145984) : tensor<786560xf32> -> tensor<64xf32>
    %output_prefix = check.tensor.view %output offset(0) : tensor<49152xf32> -> tensor<12288xf32>
    %output_suffix = check.tensor.view %output offset(98304) : tensor<49152xf32> -> tensor<24576xf32>
    check.compare<@gdn48_continued_actual, @gdn48_continued_expected>(%epoch, %rows, %qkv, %inverse, %alpha, %beta, %a, %bias, %state, %output) : (tensor<1048xi32>, tensor<4xi64>, tensor<81920xf32>, tensor<256xf32>, tensor<384xf32>, tensor<384xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786560xf32>, tensor<49152xf32>) -> () {
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%rows) expected(%rows) : tensor<4xi64>
      check.expect.bitwise actual(%qkv) expected(%qkv) : tensor<81920xf32>
      check.expect.bitwise actual(%inverse) expected(%inverse) : tensor<256xf32>
      check.expect.bitwise actual(%alpha) expected(%alpha) : tensor<384xf32>
      check.expect.bitwise actual(%beta) expected(%beta) : tensor<384xf32>
      check.expect.bitwise actual(%a) expected(%a) : tensor<48xf32>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<48xf32>
      check.expect.close actual(%state) expected(%state) atol(0.00002) rtol(0.00002) nan(same) : tensor<786560xf32>
      check.expect.close actual(%output) expected(%output) atol(0.00002) rtol(0.00002) nan(same) : tensor<49152xf32>
      check.expect.bitwise actual(%state_prefix) expected(%state_prefix) : tensor<64xf32>
      check.expect.bitwise actual(%state_suffix) expected(%state_suffix) : tensor<64xf32>
      check.expect.bitwise actual(%output_prefix) expected(%output_prefix) : tensor<12288xf32>
      check.expect.bitwise actual(%output_suffix) expected(%output_suffix) : tensor<24576xf32>
    }
  }
  check.return
}

// The second 256-lane V slab has exactly 128 active lanes per key head.
// A constant-channel four-tap anchor checks every live channel and all guards.
kernel.decl @qwen38_gdn_conv_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer)
command.program.def public @gdn48_conv_actual() launch(%epoch: buffer, %rows: buffer, %input: buffer, %weight: buffer, %history: buffer, %output: buffer, %inverse: buffer) {
  %one = index.constant 1 : index
  %offset = index.constant 256 : offset
  %epsilon = scalar.constant 0.000001 : f32
  kernel.launch @test_gdn48_epoch_kernel[](%one, %epoch, %rows) : [](index, buffer, buffer)
  kernel.launch @qwen38_gdn_conv_spans[%one](%epoch, %rows, %offset, %epsilon, %input, %weight, %history, %output, %inverse) : [index](buffer, buffer, offset, f32, buffer, buffer, buffer, buffer, buffer)
  command.return
}
func.def @gdn48_conv_expected(%epoch: buffer, %rows: buffer, %input: buffer, %weight: buffer, %history: buffer, %output: buffer, %inverse: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %width = index.constant 10240 : index
  %heads = index.constant 32 : index
  %origin = index.constant 0 : offset
  %offset = index.constant 256 : offset
  func.call @test_gdn48_epoch(%one, %epoch, %rows) : (index, buffer, buffer) -> ()
  %h = buffer.view %history[%offset] : buffer -> view<10240x3xf32>
  %out = buffer.view %output[%origin] : buffer -> view<8x10240xf32>
  %inv = buffer.view %inverse[%origin] : buffer -> view<8x32xf32>
  // Independent fixed dot product: .03125*(.125+.15625+.1875)+.125*.21875.
  %sum = scalar.constant 0.0419921875 : f32
  %negative = scalar.negf %sum : f32
  %exp = scalar.expf<afn> %negative : f32
  %unit = scalar.constant 1.0 : f32
  %den = scalar.addf %unit, %exp : f32
  %activated = scalar.divf %sum, %den : f32
  %sqrt128 = scalar.constant 11.313708498984761 : f32
  %length = scalar.mulf %activated, %sqrt128 : f32
  %inverse_value = scalar.divf %unit, %length : f32
  %old = scalar.constant 0.03125 : f32
  %current = scalar.constant 0.125 : f32
  scf.for %c = [%zero to %width step %one] {
    view.store %old, %h[%c, %zero] : f32, view<10240x3xf32>
    view.store %old, %h[%c, %one] : f32, view<10240x3xf32>
    view.store %current, %h[%c, %two] : f32, view<10240x3xf32>
    view.store %activated, %out[%two, %c] : f32, view<8x10240xf32>
  }
  scf.for %h = [%zero to %heads step %one] { view.store %inverse_value, %inv[%two, %h] : f32, view<8x32xf32> }
  func.return
}
check.scenario @gdn48_convolution_second_slab {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %rows = check.generate.fill value(0) : tensor<4xi64>
    %input = check.generate.fill value(0.125) : tensor<81920xf32>
    %weight = check.generate.iota offset(0.125) step(0.03125) period(4) : tensor<40960xf32>
    %history = check.generate.fill value(0.03125) : tensor<30848xf32>
    %prefix = check.tensor.view %history offset(0) : tensor<30848xf32> -> tensor<64xf32>
    %suffix = check.tensor.view %history offset(123136) : tensor<30848xf32> -> tensor<64xf32>
    %output = check.generate.fill value(-99.0) : tensor<81920xf32>
    %before = check.tensor.view %output offset(0) : tensor<81920xf32> -> tensor<20480xf32>
    %after = check.tensor.view %output offset(122880) : tensor<81920xf32> -> tensor<51200xf32>
    %inverse = check.generate.fill value(-99.0) : tensor<256xf32>
    check.compare<@gdn48_conv_actual, @gdn48_conv_expected>(%epoch, %rows, %input, %weight, %history, %output, %inverse) : (tensor<1048xi32>, tensor<4xi64>, tensor<81920xf32>, tensor<40960xf32>, tensor<30848xf32>, tensor<81920xf32>, tensor<256xf32>) -> () {
      check.expect.bitwise actual(%history) expected(%history) : tensor<30848xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<64xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<64xf32>
      check.expect.close actual(%output) expected(%output) atol(0.000001) rtol(0.000001) nan(same) : tensor<81920xf32>
      check.expect.bitwise actual(%before) expected(%before) : tensor<20480xf32>
      check.expect.bitwise actual(%after) expected(%after) : tensor<51200xf32>
      check.expect.close actual(%inverse) expected(%inverse) atol(0.00001) rtol(0.000001) nan(same) : tensor<256xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<81920xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<40960xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
      check.expect.bitwise actual(%rows) expected(%rows) : tensor<4xi64>
    }
  }
  check.return
}

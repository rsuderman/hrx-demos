func.def @reference.proj_14_3_512(%input: buffer, %weight: buffer, %packed: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %end = index.constant 13 : index
  scf.for %channel = [%zero to %end step %one] {
    func.call @test.init.proj_14_3_512.body(%channel, %input, %weight) : (index, buffer, buffer) -> ()
    func.call @test.expected.proj_14_3_512.body(%channel, %packed, %output) : (index, buffer, buffer) -> ()
  }
  func.return
}
func.def @test.init.ffn_0_1.body(%channel0: index, %input: buffer, %gate: buffer, %up: buffer, %down: buffer, %residual: buffer) {
  %channel = index.assume %channel0 [range(%channel0, 0, 3583)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %is_zero = index.cmp eq, %channel, %zero : index
  %mod = index.rem %channel, %four : index
  %channel_factor = index.add %mod, %one : index
  %inverse_channel = index.sub %four, %mod : index
  %float_one = scalar.constant 1.0 : f32
  %x = buffer.view %input[%origin] : buffer -> view<1x1024xf32>
  %r0 = index.constant 0 : index
  %rn = index.constant 1 : index
  %cn = index.constant 1024 : index
  %c32 = index.constant 32 : index
  %c8 = index.constant 8 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %u = scalar.constant 0.9921875 : f32
  scf.if %is_zero {
    scf.for %r = [%r0 to %rn step %one] {
      %rp = index.add %r, %one : index
      scf.for %c = [%r0 to %cn step %one] {
        %group = index.div %c, %c32 : index
        %g8 = index.rem %group, %c8 : index
        %gp = index.add %g8, %one : index
        %factor = index.mul %rp, %one : index
        %fi = index.cast %factor : index to i32
        %ff = scalar.uitofp %fi : i32 to f32
        %v0 = scalar.mulf %ff, %u : f32
        %parity = index.rem %r, %c2 : index
        %negative = index.cmp eq, %parity, %one : index
        %nv = scalar.negf %v0 : f32
        %v = scf.select %negative, %nv, %v0 : f32
        view.store %v, %x[%r, %c] : f32, view<1x1024xf32>
      }
    }
  }
  %b0_g = index.constant 0 : index
  %bn_g = index.constant 4 : index
  %stride_g = index.constant 144 : offset
  %row_bytes_g = index.constant 576 : offset
  %row_origin_g = index.scale %channel, %row_bytes_g : index, offset -> offset

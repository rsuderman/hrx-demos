func.def @reference.proj_14_3_256(%input: buffer, %weight: buffer, %packed: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %end = index.constant 13 : index
  scf.for %channel = [%zero to %end step %one] {
    func.call @test.init.proj_14_3_256.body(%channel, %input, %weight) : (index, buffer, buffer) -> ()
    func.call @test.expected.proj_14_3_256.body(%channel, %packed, %output) : (index, buffer, buffer) -> ()
  }
  func.return
}
func.def @test.init.proj_12_3_512.body(%channel0: index, %input: buffer, %weight: buffer) {
  %channel = index.assume %channel0 [range(%channel0, 0, 12)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %is_zero = index.cmp eq, %channel, %zero : index
  %mod = index.rem %channel, %four : index
  %channel_factor = index.add %mod, %one : index
  %inverse_channel = index.sub %four, %mod : index
  %float_one = scalar.constant 1.0 : f32
  %x = buffer.view %input[%origin] : buffer -> view<3x512xf32>
  %r0 = index.constant 0 : index
  %rn = index.constant 3 : index
  %cn = index.constant 512 : index
  %c32 = index.constant 32 : index
  %c8 = index.constant 8 : index
  %c4 = index.constant 4 : index
  %c2 = index.constant 2 : index
  %u = scalar.constant 0.9921875 : f32
  scf.if %is_zero {
    scf.for %r = [%r0 to %rn step %one] {
      %rp = index.add %r, %one : index
      scf.for %c = [%r0 to %cn step %one] {
        %group = index.div %c, %c32 : index
        %g8 = index.rem %group, %c8 : index
        %gp = index.add %g8, %one : index
        %factor = index.mul %rp, %gp : index
        %fi = index.cast %factor : index to i32
        %ff = scalar.uitofp %fi : i32 to f32
        %v0 = scalar.mulf %ff, %u : f32
        %parity = index.rem %group, %c4 : index
        %negative = index.cmp eq, %parity, %c2 : index
        %nv = scalar.negf %v0 : f32
        %v = scf.select %negative, %nv, %v0 : f32
        view.store %v, %x[%r, %c] : f32, view<3x512xf32>
      }
    }
  }
  %b0_w = index.constant 0 : index
  %bn_w = index.constant 2 : index
  %stride_w = index.constant 144 : offset
  %row_bytes_w = index.constant 288 : offset
  %row_origin_w = index.scale %channel, %row_bytes_w : index, offset -> offset
  scf.for %b_w = [%b0_w to %bn_w step %one] {
    %bo_w = index.scale %b_w, %stride_w : index, offset -> offset
    %o_w = index.add %row_origin_w, %bo_w : offset
    %bytes_w = buffer.view %weight[%o_w] : buffer -> view<144xi8>
    %lo_w0 = index.constant 0 : index
    %hi_w0 = index.constant 4 : index
    %byte_w0 = scalar.constant 0 : i8
    scf.for %i_w0 = [%lo_w0 to %hi_w0 step %one] {
      view.store %byte_w0, %bytes_w[%i_w0] : i8, view<144xi8>
    }
    %lo_w1 = index.constant 4 : index
    %hi_w1 = index.constant 8 : index
    %byte_w1 = scalar.constant 1 : i8
    scf.for %i_w1 = [%lo_w1 to %hi_w1 step %one] {
      view.store %byte_w1, %bytes_w[%i_w1] : i8, view<144xi8>
    }
    %lo_w2 = index.constant 8 : index
    %hi_w2 = index.constant 12 : index
    %byte_w2 = scalar.constant 1 : i8
    scf.for %i_w2 = [%lo_w2 to %hi_w2 step %one] {
      view.store %byte_w2, %bytes_w[%i_w2] : i8, view<144xi8>
    }
    %lo_w3 = index.constant 12 : index
    %hi_w3 = index.constant 16 : index
    %byte_w3 = scalar.constant 17 : i8
    scf.for %i_w3 = [%lo_w3 to %hi_w3 step %one] {
      view.store %byte_w3, %bytes_w[%i_w3] : i8, view<144xi8>
    }
    %lo_w4 = index.constant 16 : index
    %hi_w4 = index.constant 144 : index
    %byte_w4 = scalar.constant 33 : i8
    scf.for %i_w4 = [%lo_w4 to %hi_w4 step %one] {
      view.store %byte_w4, %bytes_w[%i_w4] : i8, view<144xi8>
    }
    %divisor_w = scalar.constant 32.0 : f32
    %cf_i_w = index.cast %channel_factor : index to i32
    %cf_f_w = scalar.uitofp %cf_i_w : i32 to f32
    %unit_d_w = scalar.divf %cf_f_w, %divisor_w : f32
    %bp_w = index.add %b_w, %one : index
    %bi_w = index.cast %bp_w : index to i32
    %bf_w = scalar.uitofp %bi_w : i32 to f32
    %d_f_w = scalar.mulf %unit_d_w, %bf_w : f32
    %d_w = scalar.fptrunc %d_f_w : f32 to f16
    %d_add_w = index.constant 0 : offset
    %d_o_w = index.add %o_w, %d_add_w : offset
    %d_view_w = buffer.view %weight[%d_o_w] : buffer -> view<1xf16>
    view.store %d_w, %d_view_w[0] : f16, view<1xf16>
    %min_add_w = index.constant 2 : offset
    %min_o_w = index.add %o_w, %min_add_w : offset
    %min_view_w = buffer.view %weight[%min_o_w] : buffer -> view<1xf16>
    %min_f_w = scalar.constant 0.015625 : f32
    %min_w = scalar.fptrunc %min_f_w : f32 to f16
    view.store %min_w, %min_view_w[0] : f16, view<1xf16>
  }

  func.return
}

func.def @reference.proj_13_3_512(%input: buffer, %weight: buffer, %packed: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %end = index.constant 13 : index
  scf.for %channel = [%zero to %end step %one] {
    func.call @test.init.proj_13_3_512.body(%channel, %input, %weight) : (index, buffer, buffer) -> ()
    func.call @test.expected.proj_13_3_512.body(%channel, %packed, %output) : (index, buffer, buffer) -> ()
  }
  func.return
}
func.def @test.init.proj_14_3_512.body(%channel0: index, %input: buffer, %weight: buffer) {
  %channel = index.assume %channel0 [range(%channel0, 0, 12)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %is_zero = index.cmp eq, %channel, %zero : index
  %mod = index.rem %channel, %four : index
  %channel_factor = index.add %mod, %one : index
  %inverse_channel = index.sub %four, %mod : index
  %float_one = scalar.constant 1.0 : f32

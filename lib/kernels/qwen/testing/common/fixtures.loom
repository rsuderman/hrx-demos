    %hi_w1 = index.constant 192 : index
    %byte_w1 = scalar.constant -86 : i8
    scf.for %i_w1 = [%lo_w1 to %hi_w1 step %one] {
      view.store %byte_w1, %bytes_w[%i_w1] : i8, view<210xi8>
    }

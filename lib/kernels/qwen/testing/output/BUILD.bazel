load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")

# Copyright 2026 AMD ROCm Software
# SPDX-License-Identifier: MIT
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

_NUMERICAL = [
    "//lib/platforms/amdgpu/gfx11:targets.loom",
    "output_config.loom",
    "//lib/programs/qwen35:output.loom",
    "//lib/programs/qwen35:output_interface.loom",
    "//lib/kernels/qwen:configured_provider_sources",
    "//lib/kernels/qwen:output/interface.loom",
    "//lib/kernels/qwen:output/embedding.loom",
    "//lib/kernels/qwen:output/head.loom",
    "//lib/kernels/qwen:output/publication.loom",
    "//lib/kernels/embedding:q6k_rows.loom",
    "//lib/kernels/selection:greedy_argmax.loom",
]

[loom_merge(
    name = "output_t%d_%s" % (t, format),
    testonly = True,
    srcs = [
        "output_t%d_programs.loom" % t,
        "nontrivial.loom",
    ] + _NUMERICAL,
    output_format = format,
) for t in [
    1,
    4,
] for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "execution_t%d_%s" % (t, format),
    srcs = [
        "checks_t%d.loom" % t,
        ":output_t%d_%s" % (t, format),
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for t in [
    1,
    4,
] for format in [
    "text",
    "bc",
]]

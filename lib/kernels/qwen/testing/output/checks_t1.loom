command.def @m4_anchor_actual() launch(%weight: buffer, %input: buffer, %packed: buffer, %output: buffer) {
  %four = index.constant 4 : index
  %hidden = index.constant 1024 : index
  kernel.launch @qwen38_token_embedding_q6k_known_weights(%weight) : (buffer)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%four, %hidden](%four, %hidden, %input, %packed) : [index, index](index, index, buffer, buffer)
  kernel.launch @ggml_linear_q6k_q8_1_x4_m4[%four, %hidden, %four](%four, %hidden, %four, %packed, %weight, %output) : [index, index, index](index, index, index, buffer, buffer, buffer)
  command.return
}

func.def @m4_anchor_expected(%weight: buffer, %input: buffer, %packed: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %out = buffer.view %output[%origin] : buffer -> view<4x4xf32>
  // 1024 * (-32) * (3*(column+1)) * (1365/4096) *127*(129/16384).
  // The constant is the independently rounded F32 contraction for column0.
  %base = scalar.constant -32758.0 : f32
  scf.for %r = [%zero to %four step %one] {
    scf.for %c = [%zero to %four step %one] {
      %ordinal = index.add %c, %one : index
      %word = index.cast %ordinal : index to i32
      %scale = scalar.sitofp %word : i32 to f32
      %value = scalar.mulf %base, %scale : f32
      view.store %value, %out[%r, %c] : f32, view<4x4xf32>
    }
  }
  func.return
}


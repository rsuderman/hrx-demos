kernel.def @set_replay_ids() {
  %tokens = index.constant 1 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%tokens, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%first_id: i32, %ids: buffer) {
  %r = kernel.workgroup.id<x> : index
  %zero = index.constant 0 : index
  %two = index.constant 2 : index
  %origin = index.constant 0 : offset
  %data = buffer.view %ids[%origin] : buffer -> view<512xi32>
  %parity = index.rem %r, %two : index
  %even = index.cmp eq, %parity, %zero : index
  %one_id = scalar.constant 1 : i32
  %two_id = scalar.constant 2 : i32
  %id = scf.select %even, %one_id, %two_id : i32
  %first = index.cmp eq, %r, %zero : index
  %value = scf.select %first, %first_id, %id : i32
  view.store %value, %data[%r] : i32, view<512xi32>
  kernel.return
}

kernel.def @set_replay_epoch() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%count: i32, %selected: i32, %epoch: buffer) {
  %origin = index.constant 0 : offset
  %selection_origin = index.constant 1292 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %selection = buffer.view %epoch[%selection_origin] : buffer -> view<64xi32>
  %tokens = scalar.constant 1 : i32
  %spans = scalar.constant 1 : i32
  view.store %tokens, %header[0] : i32, view<3xi32>
  view.store %spans, %header[1] : i32, view<3xi32>
  view.store %count, %header[2] : i32, view<3xi32>
  %slot_origin = index.constant 28 : offset
  %slot_view = buffer.view %epoch[%slot_origin] : buffer -> view<1xi32>
  %slot_zero = scalar.constant 0 : i32
  %slot_none = scalar.constant -1 : i32

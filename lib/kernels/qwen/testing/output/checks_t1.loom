kernel.def @qwen38_token_embedding_q6k_known_weights() {
  %one = index.constant 1 : index
  %rows = index.constant 4 : index
  %threads = index.constant 4 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%weight: buffer) {
  %row = kernel.workgroup.id<x> : index
  %block = kernel.workitem.id<x> : index
  %row_bytes = index.constant 840 : offset
  %block_bytes = index.constant 210 : offset
  %scale_add = index.constant 192 : offset
  %delta_add = index.constant 208 : offset
  %row_origin = index.scale %row, %row_bytes : index, offset -> offset
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %origin = index.add %row_origin, %block_add : offset
  %scale_origin = index.add %origin, %scale_add : offset
  %delta_origin = index.add %origin, %delta_add : offset
  %one32 = scalar.constant 1 : i32
  %three32 = scalar.constant 3 : i32
  %row32 = index.cast %row : index to i32
  %ordinal = scalar.addi %row32, %one32 : i32
  %scale32 = scalar.muli %ordinal, %three32 : i32
  %scale = scalar.trunci %scale32 : i32 to i8
  %scales = buffer.view %weight[%scale_origin] : buffer -> view<16xi8>
  %zero = index.constant 0 : index
  %sixteen = index.constant 16 : index
  %one = index.constant 1 : index
  scf.for %i = [%zero to %sixteen step %one] {
    view.store %scale, %scales[%i] : i8, view<16xi8>
  }
  %delta = scalar.constant 0.333251953125 : f16
  %delta_view = buffer.view %weight[%delta_origin] : buffer -> view<1xf16>
  view.store %delta, %delta_view[0] : f16, view<1xf16>
  kernel.return
}


// The actual canonical one-row provider retains M4 row-zero arithmetic. The
// original M4 provider is test-only, and the independent anchor above remains.
kernel.decl @ggml_linear_q6k_q8_1_x4(%rows$535: index, %width$536: index, %outputs$537: index) launch(%rows$538: index, %width$539: index, %outputs$540: index, %input: buffer, %weight: buffer, %output: buffer)

command.def @single_row_anchor_actual() launch(%weight: buffer, %input: buffer, %packed: buffer, %output: buffer) {
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %hidden = index.constant 1024 : index
  kernel.launch @qwen38_token_embedding_q6k_known_weights(%weight) : (buffer)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%one, %hidden](%one, %hidden, %input, %packed) : [index, index](index, index, buffer, buffer)
  kernel.launch @ggml_linear_q6k_q8_1_x4[%one, %hidden, %four](%one, %hidden, %four, %packed, %weight, %output) : [index, index, index](index, index, index, buffer, buffer, buffer)
  command.return
}

func.def @single_row_anchor_expected(%weight: buffer, %input: buffer, %packed: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %out = buffer.view %output[%origin] : buffer -> view<4xf32>
  // Same independently rounded contraction as the original M4 anchor.
  %base = scalar.constant -32758.0 : f32
  scf.for %c = [%zero to %four step %one] {
    %ordinal = index.add %c, %one : index
    %word = index.cast %ordinal : index to i32
    %scale = scalar.sitofp %word : i32 to f32
    %value = scalar.mulf %base, %scale : f32
    view.store %value, %out[%c] : f32, view<4xf32>
  }
  func.return
}


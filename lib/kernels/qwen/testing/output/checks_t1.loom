    %packed = check.generate.fill value(-11) : tensor<4x1152xi8>
    %output = check.generate.fill value(-77.0) : tensor<4x4xf32>
    %padding = check.tensor.view %output offset(16) : tensor<4x4xf32> -> tensor<12xf32>
    check.compare<@single_row_anchor_actual, @single_row_anchor_expected>(%weight, %input, %packed, %output) : (tensor<4x4x210xi8>, tensor<4x1024xf32>, tensor<4x1152xi8>, tensor<4x4xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.01) rtol(9.9999999999999995e-07) nan(same) : tensor<4x4xf32>, tensor<4x4xf32>
      check.expect.bitwise actual(%padding) expected(%padding) : tensor<12xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<4x1024xf32>
    }
  }
  check.return
}

// Both numerical subjects execute on the target. The VM oracle only expects
// zero byte mismatches; it never attempts to execute a command program.
kernel.def @retained_row_byte_mismatches() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%packed: buffer, %logits: buffer, %old_packed: buffer, %old_logits: buffer, %mismatches: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %q8_bytes = index.constant 1152 : index
  %logit_bytes = index.constant 16 : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %q8 = buffer.view %packed[%origin] : buffer -> view<1152xi8>
  %old_q8 = buffer.view %old_packed[%origin] : buffer -> view<1152xi8>
  %y = buffer.view %logits[%origin] : buffer -> view<16xi8>
  %old_y = buffer.view %old_logits[%origin] : buffer -> view<16xi8>
  %q8_errors = scf.for %i = [%zero to %q8_bytes step %one](%errors = %zero32 : i32) -> (i32) {
    %a = view.load %q8[%i] : view<1152xi8> -> i8
    %b = view.load %old_q8[%i] : view<1152xi8> -> i8
    %different = scalar.cmpi ne, %a, %b : i8
    %increment = scf.select %different, %one32, %zero32 : i32
    %next = scalar.addi %errors, %increment : i32
    scf.yield %next : i32
  }
  %logit_errors = scf.for %i = [%zero to %logit_bytes step %one](%errors = %zero32 : i32) -> (i32) {
    %a = view.load %y[%i] : view<16xi8> -> i8
    %b = view.load %old_y[%i] : view<16xi8> -> i8
    %different = scalar.cmpi ne, %a, %b : i8
    %increment = scf.select %different, %one32, %zero32 : i32
    %next = scalar.addi %errors, %increment : i32
    scf.yield %next : i32
  }
  %out = buffer.view %mismatches[%origin] : buffer -> view<2xi32>
  view.store %q8_errors, %out[0] : i32, view<2xi32>
  view.store %logit_errors, %out[1] : i32, view<2xi32>
  kernel.return
}

command.def @retained_row_proof_actual() launch(%weight: buffer, %input: buffer, %packed: buffer, %output: buffer, %mismatches: buffer) {
  %q8_bytes = index.constant 4608 : offset
  %logit_bytes = index.constant 64 : offset
  %old_packed = buffer.alloca<global> align(256) %q8_bytes : buffer
  %old_logits = buffer.alloca<global> align(256) %logit_bytes : buffer
  command.launch @single_row_anchor_actual(%weight, %input, %packed, %output) : (buffer, buffer, buffer, buffer)
  command.launch @m4_anchor_actual(%weight, %input, %old_packed, %old_logits) : (buffer, buffer, buffer, buffer)
  kernel.launch @retained_row_byte_mismatches(%packed, %output, %old_packed, %old_logits, %mismatches) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @retained_row_proof_expected(%weight: buffer, %input: buffer, %packed: buffer, %output: buffer, %mismatches: buffer) {
  %origin = index.constant 0 : offset
  %zero = scalar.constant 0 : i32
  %out = buffer.view %mismatches[%origin] : buffer -> view<2xi32>
  view.store %zero, %out[0] : i32, view<2xi32>
  view.store %zero, %out[1] : i32, view<2xi32>
  func.return
}

check.scenario @single_row_matches_original_row_zero_T1 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %weight = check.generate.fill value(0) : tensor<4x4x210xi8>
    %input = check.generate.iota offset(-2.0) step(0.0030000000000000001) : tensor<4x1024xf32>
    %packed = check.generate.fill value(-11) : tensor<4x1152xi8>
    %output = check.generate.fill value(-77.0) : tensor<4x4xf32>
    %mismatches = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@retained_row_proof_actual, @retained_row_proof_expected>(%weight, %input, %packed, %output, %mismatches) : (tensor<4x4x210xi8>, tensor<4x1024xf32>, tensor<4x1152xi8>, tensor<4x4xf32>, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%mismatches) expected(%mismatches) : tensor<2xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<4x1024xf32>
    }
  }
  check.return
}

// Target-only scenario subjects keep reference evaluation outside timing.
check.benchmark<@registered_head_t1_count1_public_guard> @qwen_selected_head_t1

check.benchmark<@single_row_nonzero_canonical_anchor_T1> @qwen_single_row_projection_t1

// Larger source capacity is independent of the one-row output capacity.
func.def @init_epoch_last(%epoch: buffer) {
  func.call @init_epoch_1(%epoch) : (buffer)
  %origin = index.constant 0 : offset
  %selection_origin = index.constant 1292 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %selection = buffer.view %epoch[%selection_origin] : buffer -> view<64xi32>
  %tokens = scalar.constant 128 : i32
  %last = scalar.constant 127 : i32
  view.store %tokens, %header[0] : i32, view<3xi32>
  view.store %last, %selection[0] : i32, view<64xi32>
  func.return
}

kernel.def @init_epoch_kernel_last() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer) {
  func.call @init_epoch_last(%epoch) : (buffer)
  kernel.return
}

command.def @normalize_actual_last_single() launch(%input: buffer, %gamma: buffer, %epoch: buffer, %output: buffer) {
  kernel.launch @init_epoch_kernel_last(%epoch) : (buffer)
  %one = index.constant 1 : index
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  kernel.launch @qwen38_output_normalize_spans[%one](%epoch, %epsilon, %input, %gamma, %output) : [index](buffer, f32, buffer, buffer, buffer)
  command.return
}

func.def @normalize_expected_last_single(%input: buffer, %gamma: buffer, %epoch: buffer, %output: buffer) {
  func.call @init_epoch_last(%epoch) : (buffer)
  %origin = index.constant 0 : offset
  %x = buffer.view %input[%origin] : buffer -> view<512x1024xf32>
  %g = buffer.view %gamma[%origin] : buffer -> view<1024xf32>
  %out = buffer.view %output[%origin] : buffer -> view<5x1024xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 1 : index
  %width = index.constant 1024 : index
  %zero_f = scalar.constant 0.0 : f32
  scf.for %r = [%zero to %four step %one] {
    scf.for %c = [%zero to %width step %one] {
      view.store %zero_f, %out[%r, %c] : f32, view<5x1024xf32>
    }
  }
  %row = index.constant 127 : index
  %width_f = scalar.constant 1024.0 : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %sum = scf.for %c = [%zero to %width step %one](%partial = %zero_f : f32) -> (f32) {
    %value = view.load %x[%row, %c] : view<512x1024xf32> -> f32
    %square = scalar.mulf %value, %value : f32
    %next = scalar.addf %partial, %square : f32
    scf.yield %next : f32
  }
  %mean = scalar.divf %sum, %width_f : f32
  %biased = scalar.addf %mean, %epsilon : f32
  %scale = scalar.rsqrtf %biased : f32
  scf.for %c = [%zero to %width step %one] {
    %value = view.load %x[%row, %c] : view<512x1024xf32> -> f32
    %weight = view.load %g[%c] : view<1024xf32> -> f32
    %normalized = scalar.mulf %value, %scale : f32
    %expected = scalar.mulf %normalized, %weight : f32
    view.store %expected, %out[0, %c] : f32, view<5x1024xf32>
  }
  func.return
}

check.scenario @selected_rms_last_single_row_with_guard_T1 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2.0) step(0.001) : tensor<512x1024xf32>
    %gamma = check.generate.iota offset(0.5) step(0.001) : tensor<1024xf32>
    %epoch = check.generate.fill value(-313) : tensor<1048xi32>
    %output = check.generate.fill value(-77.0) : tensor<5x1024xf32>
    %guard = check.tensor.view %output offset(4096) : tensor<5x1024xf32> -> tensor<4x1024xf32>
    check.compare<@normalize_actual_last_single, @normalize_expected_last_single>(%input, %gamma, %epoch, %output) : (tensor<512x1024xf32>, tensor<1024xf32>, tensor<1048xi32>, tensor<5x1024xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<5x1024xf32>, tensor<5x1024xf32>
      check.expect.bitwise actual(%guard) expected(%guard) : tensor<4x1024xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<512x1024xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<1024xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
    }
  }
  check.return
}

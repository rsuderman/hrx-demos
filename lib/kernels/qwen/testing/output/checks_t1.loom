  %slot_zero = scalar.constant 0 : i32
  %slot_none = scalar.constant -1 : i32
  %count_zero = scalar.cmpi eq, %count, %slot_zero : i32
  %slot = scf.select %count_zero, %slot_none, %slot_zero : i32
  view.store %slot, %slot_view[0] : i32, view<1xi32>
  view.store %row, %selection[0] : i32, view<64xi32>

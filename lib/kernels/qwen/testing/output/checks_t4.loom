    %output = check.generate.fill value(-77.0) : tensor<4x4xf32>
    check.compare<@m4_anchor_actual, @m4_anchor_expected>(%weight, %input, %packed, %output) : (tensor<4x4x210xi8>, tensor<4x1024xf32>, tensor<4x1152xi8>, tensor<4x4xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.01) rtol(0.000001) nan(same) : tensor<4x4xf32>
    }
  }
  check.return
}


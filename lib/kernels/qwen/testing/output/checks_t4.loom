check.scenario @selected_rms_t4_count0_private_padding_guard {
  check.trial[1](%trial: index, %entropy: check.entropy) {
  %input = check.generate.iota offset(-2.0) step(0.001) : tensor<512x1024xf32>
  %gamma = check.generate.iota offset(0.5) step(0.001) : tensor<1024xf32>
  %epoch = check.generate.fill value(0) : tensor<1048xi32>
  %output = check.generate.fill value(-77.0) : tensor<5x1024xf32>
  %private_padding = check.tensor.view %output offset(0) : tensor<5x1024xf32> -> tensor<4x1024xf32>
  %outside_guard = check.tensor.view %output offset(16384) : tensor<5x1024xf32> -> tensor<1024xf32>
  check.compare<@normalize_actual_0, @normalize_expected_0>(%input, %gamma, %epoch, %output) : (tensor<512x1024xf32>, tensor<1024xf32>, tensor<1048xi32>, tensor<5x1024xf32>) -> () {
    check.expect.close actual(%output) expected(%output) atol(0.00001) rtol(0.00001) nan(same) : tensor<5x1024xf32>
    check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
    check.expect.bitwise actual(%private_padding) expected(%private_padding) : tensor<4x1024xf32>
    check.expect.bitwise actual(%outside_guard) expected(%outside_guard) : tensor<1024xf32>
  }
  }
  check.return
}
command.program.def @normalize_actual_1() launch(%input: buffer, %gamma: buffer, %epoch: buffer, %output: buffer) {
  kernel.launch @init_epoch_kernel_1[](%epoch) : [](buffer)
  %four = index.constant 4 : index
  %epsilon = scalar.constant 0.000001 : f32
  kernel.launch @qwen38_output_normalize_spans[%four](%epoch, %epsilon, %input, %gamma, %output) : [index](buffer, f32, buffer, buffer, buffer)
  command.return
}
func.def @normalize_expected_1(%input: buffer, %gamma: buffer, %epoch: buffer, %output: buffer) {
  func.call @init_epoch_1(%epoch) : (buffer) -> ()
  %origin = index.constant 0 : offset
  %x = buffer.view %input[%origin] : buffer -> view<512x1024xf32>
  %g = buffer.view %gamma[%origin] : buffer -> view<1024xf32>
  %out = buffer.view %output[%origin] : buffer -> view<5x1024xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %width = index.constant 1024 : index
  %zero_f = scalar.constant 0.0 : f32
  scf.for %r = [%zero to %four step %one] {
    scf.for %c = [%zero to %width step %one] {
      view.store %zero_f, %out[%r, %c] : f32, view<5x1024xf32>
    }
  }
  %row = index.constant 1 : index
  %width_f = scalar.constant 1024.0 : f32
  %epsilon = scalar.constant 0.000001 : f32
  %sum = scf.for %c = [%zero to %width step %one](%partial = %zero_f : f32) -> (f32) {
    %value = view.load %x[%row, %c] : view<512x1024xf32> -> f32
    %square = scalar.mulf %value, %value : f32
    %next = scalar.addf %partial, %square : f32
    scf.yield %next : f32
  }
  %mean = scalar.divf %sum, %width_f : f32
  %biased = scalar.addf %mean, %epsilon : f32
  %scale = scalar.rsqrtf %biased : f32
  scf.for %c = [%zero to %width step %one] {
    %value = view.load %x[%row, %c] : view<512x1024xf32> -> f32
    %weight = view.load %g[%c] : view<1024xf32> -> f32
    %normalized = scalar.mulf %value, %scale : f32
    %expected = scalar.mulf %normalized, %weight : f32
    view.store %expected, %out[0, %c] : f32, view<5x1024xf32>
  }
  func.return
}
check.scenario @selected_rms_t4_count1_private_padding_guard {
  check.trial[1](%trial: index, %entropy: check.entropy) {
  %input = check.generate.iota offset(-2.0) step(0.001) : tensor<512x1024xf32>
  %gamma = check.generate.iota offset(0.5) step(0.001) : tensor<1024xf32>
  %epoch = check.generate.fill value(0) : tensor<1048xi32>
  %output = check.generate.fill value(-77.0) : tensor<5x1024xf32>
  %private_padding = check.tensor.view %output offset(4096) : tensor<5x1024xf32> -> tensor<3x1024xf32>
  %outside_guard = check.tensor.view %output offset(16384) : tensor<5x1024xf32> -> tensor<1024xf32>
  check.compare<@normalize_actual_1, @normalize_expected_1>(%input, %gamma, %epoch, %output) : (tensor<512x1024xf32>, tensor<1024xf32>, tensor<1048xi32>, tensor<5x1024xf32>) -> () {
    check.expect.close actual(%output) expected(%output) atol(0.00001) rtol(0.00001) nan(same) : tensor<5x1024xf32>
    check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<1048xi32>
    check.expect.bitwise actual(%private_padding) expected(%private_padding) : tensor<3x1024xf32>
    check.expect.bitwise actual(%outside_guard) expected(%outside_guard) : tensor<1024xf32>
  }
  }
  check.return
}


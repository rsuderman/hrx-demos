kernel.def @set_replay_ids() {
  %tokens = index.constant 4 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%tokens, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%first_id: i32, %ids: buffer) {
  %r = kernel.workgroup.id<x> : index
  %zero = index.constant 0 : index
  %two = index.constant 2 : index
  %origin = index.constant 0 : offset
  %data = buffer.view %ids[%origin] : buffer -> view<512xi32>
  %parity = index.rem %r, %two : index
  %even = index.cmp eq, %parity, %zero : index
  %one_id = scalar.constant 1 : i32
  %two_id = scalar.constant 2 : i32
  %id = scf.select %even, %one_id, %two_id : i32
  %first = index.cmp eq, %r, %zero : index
  %value = scf.select %first, %first_id, %id : i32
  view.store %value, %data[%r] : i32, view<512xi32>
  kernel.return
}
kernel.def @set_replay_epoch() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%count: i32, %selected: i32, %epoch: buffer) {
  %origin = index.constant 0 : offset
  %selection_origin = index.constant 1292 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %selection = buffer.view %epoch[%selection_origin] : buffer -> view<64xi32>
  %tokens = scalar.constant 4 : i32
  %spans = scalar.constant 1 : i32
  view.store %tokens, %header[0] : i32, view<3xi32>
  view.store %spans, %header[1] : i32, view<3xi32>
  view.store %count, %header[2] : i32, view<3xi32>
  %slot_origin = index.constant 28 : offset
  %slot_view = buffer.view %epoch[%slot_origin] : buffer -> view<1xi32>
  %slot_zero = scalar.constant 0 : i32
  %slot_none = scalar.constant -1 : i32
  %count_zero = scalar.cmpi eq, %count, %slot_zero : i32
  %slot = scf.select %count_zero, %slot_none, %slot_zero : i32
  view.store %slot, %slot_view[0] : i32, view<1xi32>
  view.store %selected, %selection[0] : i32, view<64xi32>
  kernel.return
}
kernel.def @record_replay_step() {
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%four, %one, %one) : index
} launch(%stage: index, %output: buffer, %trace: buffer) {
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %out = buffer.view %output[%origin] : buffer -> view<4xi32>
  %history = buffer.view %trace[%origin] : buffer -> view<3x4xi32>
  %bounded_stage = index.assume %stage [range(%stage, 0, 2)] : index
  %value = view.load %out[%lane] : view<4xi32> -> i32
  view.store %value, %history[%bounded_stage, %lane] : i32, view<3x4xi32>
  kernel.return
}
command.program.def @nontrivial_replay_actual() launch(%parameters: buffer, %ids: buffer, %residual: buffer, %epoch: buffer, %output: buffer, %trace: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %none = scalar.constant 0 : i32
  %active = scalar.constant 1 : i32
  %id1 = scalar.constant 1 : i32
  %id2 = scalar.constant 2 : i32
  %first = scalar.constant 0 : i32
  %last = scalar.constant 1 : i32
  command.program.launch @qwen.output.init[](%parameters) : [](buffer)
  kernel.launch @set_replay_ids[](%id1, %ids) : [](i32, buffer)
  command.program.launch @qwen.output.embedding.t4[](%parameters, %ids, %residual) : [](buffer, buffer, buffer)
  kernel.launch @set_replay_epoch[](%active, %first, %epoch) : [](i32, i32, buffer)
  command.program.launch @qwen.output.head.t4[](%parameters, %residual, %epoch, %output) : [](buffer, buffer, buffer, buffer)
  kernel.launch @record_replay_step[](%zero, %output, %trace) : [](index, buffer, buffer)
  kernel.launch @set_replay_epoch[](%none, %first, %epoch) : [](i32, i32, buffer)
  command.program.launch @qwen.output.head.t4[](%parameters, %residual, %epoch, %output) : [](buffer, buffer, buffer, buffer)
  kernel.launch @record_replay_step[](%one, %output, %trace) : [](index, buffer, buffer)
  kernel.launch @set_replay_epoch[](%active, %last, %epoch) : [](i32, i32, buffer)
  command.program.launch @qwen.output.head.t4[](%parameters, %residual, %epoch, %output) : [](buffer, buffer, buffer, buffer)
  kernel.launch @record_replay_step[](%two, %output, %trace) : [](index, buffer, buffer)
  command.return
}
func.def @nontrivial_replay_expected(%parameters: buffer, %ids: buffer, %residual: buffer, %epoch: buffer, %output: buffer, %trace: buffer) {
  %origin = index.constant 0 : offset
  %out = buffer.view %output[%origin] : buffer -> view<4xi32>
  %history = buffer.view %trace[%origin] : buffer -> view<3x4xi32>
  %winner2 = scalar.constant 2 : i32
  %winner1 = scalar.constant 1 : i32
  %guard = scalar.constant -77 : i32
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  view.store %winner1, %out[0] : i32, view<4xi32>
  scf.for %r = [%zero to %three step %one] {
    %final = index.cmp eq, %r, %two : index
    %winner = scf.select %final, %winner1, %winner2 : i32
    view.store %winner, %history[%r, 0] : i32, view<3x4xi32>
    scf.for %c = [%one to %four step %one] {
      view.store %guard, %history[%r, %c] : i32, view<3x4xi32>
    }
  }
  func.return
}
check.scenario @registered_nontrivial_tied_bank_t4_replay1_0_1 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<209000000xi8>
    %ids = check.generate.fill value(0) : tensor<512xi32>
    %residual = check.generate.fill value(-77.0) : tensor<512x1024xf32>
    %epoch = check.generate.fill value(0) : tensor<1048xi32>
    %output = check.generate.fill value(-77) : tensor<20xi32>
    %trace = check.generate.fill value(-88) : tensor<3x4xi32>
    check.compare<@nontrivial_replay_actual, @nontrivial_replay_expected>(%parameters, %ids, %residual, %epoch, %output, %trace) : (tensor<209000000xi8>, tensor<512xi32>, tensor<512x1024xf32>, tensor<1048xi32>, tensor<20xi32>, tensor<3x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xi32>
      check.expect.bitwise actual(%trace) expected(%trace) : tensor<3x4xi32>
    }
  }
  check.return
}


# Full-layer fixtures call the owned numerical layer directly. The independent
# logical oracle/runner remains beside these maintained call sequences.
exports_files(["layer_fixture.py", "run_layer_fixture.sh"])
[genrule(
    name = "layer_" + encoding,
    testonly = True,
    srcs = ["//lib/platforms/amdgpu/gfx11:targets.loom", "//lib/kernels/qwen/testing/common:ffn_facts.loom", "attention_" + encoding + "_programs.loom", "//lib/architectures/qwen35:numerical_sources", "//lib/platforms/amdgpu/gfx11:attention_h256_schedule"],
    outs = ["layer_" + encoding + ".loombc"],
    tools = ["@hrx_system//loom/src/loom/tools/loom-link"],
    cmd = "$(execpath @hrx_system//loom/src/loom/tools/loom-link) $(SRCS) --mode=link --require-resolved-config --root=@attention_layer --to=bc --output=$@",
) for encoding in ["q5", "q6"]]

# Same independent GQA oracle, expanded to 24Q/4KV and reversed physical pages.
genrule(
    name = "wmma27_checks",
    srcs = ["wmma_checks.loom"],
    outs = ["wmma27_checks.loom"],
    tools = ["wmma27_fixture.py"],
    cmd = "python3 $(location wmma27_fixture.py) $(location wmma_checks.loom) $@",
)
loom_test(
    name = "wmma27_execution_test",
    srcs = ["config27.loom", ":wmma27_checks",
            "//lib/kernels/qwen/attention:attention_common.loom",
        "//lib/kernels/attention:rotary.loom",
        "//lib/kernels/attention:normalization.loom",
            "//lib/kernels/attention:core.loom",

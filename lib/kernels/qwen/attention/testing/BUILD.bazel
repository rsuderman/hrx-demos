    srcs = ["config.loom", "preparation_reference.loom", "query_checks.loom",
            "//lib/kernels/qwen/attention:attention_common.loom",
            "//lib/kernels/attention:core.loom",
            "//lib/kernels/attention:kv_position.loom",
            "//lib/kernels/qwen/attention:attention_prefill.loom",
            "//lib/kernels/qwen:common/spans.loom"],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)


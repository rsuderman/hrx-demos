            "//lib/kernels/qwen/attention:attention_prefill_wmma.loom",
            "//lib/platforms/amdgpu/gfx11:attention_h256_schedule",
            "//lib/platforms/amdgpu/gfx11:targets.loom",
            "//lib/kernels/qwen/attention:attention_spans.loom",
            "//lib/kernels/qwen:common/spans.loom"],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],

func.def @kv_reference_n2_p63_continue(%epoch: buffer, %rows: buffer, %key: buffer, %value: buffer, %weight: buffer, %arena: buffer) {
  %count = index.constant 2 : index
  %position = index.constant 63 : index
  func.call @kv_init(%count, %position, %epoch, %rows, %key, %value, %weight) : (index, index, buffer, buffer, buffer, buffer, buffer) -> ()
  func.call @kv_publish_expected(%count, %position, %arena) : (index, index, buffer) -> ()
  %one = index.constant 1 : index
  %next_position = index.constant 65 : index
  func.call @kv_metadata(%one, %next_position, %epoch, %rows) : (index, index, buffer, buffer) -> ()
  func.call @kv_publish_expected(%one, %next_position, %arena) : (index, index, buffer) -> ()
  func.return
}


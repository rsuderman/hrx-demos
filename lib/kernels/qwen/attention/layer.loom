// Curated from loom-pipeline/llm/qwen/programs/qwen38/attention_layer_prefill.loom.
// Ordinary canonical 0.8B text branch; verification=0, positive epoch spans.
// All complete-layer norms/residuals and shared FFN occur exactly once.
config.decl @qwen.model.hidden_size : index
config.decl @qwen.model.attention_width : index
config.decl @qwen.model.kv_size : index
config.decl @qwen.model.query_gate_size : index
config.decl @qwen.model.head_size : index
config.decl @qwen.model.rms_epsilon : f32
config.decl @qwen.model.attention_q6_layers : i32
config.decl @qwen.model.query_q5_weight_bytes : index
config.decl @qwen.model.query_q6_weight_bytes : index
config.decl @qwen.model.key_q5_weight_bytes : index
config.decl @qwen.model.key_q6_weight_bytes : index
config.decl @qwen.model.value_weight_bytes : index
config.decl @qwen.model.projection_weight_bytes : index
config.decl @qwen.model.hidden_capacity_bytes : index
config.decl @qwen.model.hidden_q8_capacity_bytes : index
config.decl @qwen.model.query_gate_capacity_bytes : index
config.decl @qwen.model.kv_capacity_bytes : index
config.decl @qwen.model.projection_capacity_bytes : index
config.decl @qwen.model.ffn_capacity_bytes : index
config.decl @qwen.model.kv_plane_token_bytes : index
config.decl @qwen38.attention.pool_capacity : index
kernel.decl @qwen38_rmsnorm_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_residual_add_f32_prefill(%token_count: index) launch(%token_capacity: index, %lhs: buffer, %rhs: buffer, %output: buffer)
kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_capacity: index, %input_size_data: index, %input: buffer, %output: buffer)
kernel.decl @ggml_linear_q5k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_capacity: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_capacity: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_attention_query_prepare_spans(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %epsilon: f32, %projection: buffer, %weight: buffer, %query: buffer, %gate: buffer)
kernel.decl @qwen38_attention_kv_prepare_spans(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %weight: buffer, %state: buffer)
kernel.decl @qwen38_attention_spans_f16_wmma(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %query: buffer, %gate: buffer, %state: buffer, %output: buffer)
kernel.decl @qwen38_attention_clear_attended(%token_capacity: index) launch(%token_capacity: index, %output: buffer)
command.program.decl @qwen38_ffn_gate_up_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %post_normalized: buffer, %control: buffer, %swiglu: buffer)
command.program.decl @qwen38_ffn_down_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %control: buffer, %swiglu: buffer, %residual: buffer)
command.program.def public @qwen38_attention_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %attention_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 23), range(%attention_ordinal, 0, 5), eq(%verification_depth, 0), range(%span_capacity, 1, 64)] {
  %zero = index.constant 0 : index
  %one32 = scalar.constant 1 : i32
  %zero32 = scalar.constant 0 : i32
  %layer32 = index.cast %layer : index to i32
  %bit = scalar.shli %one32, %layer32 : i32
  %mask = config.get @qwen.model.attention_q6_layers : i32
  %selected = scalar.andi %mask, %bit : i32
  %q6 = scalar.cmpi ne, %selected, %zero32 : i32
  %hidden_size = config.get @qwen.model.hidden_size : index
  %attention_size = config.get @qwen.model.attention_width : index
  %kv_size = config.get @qwen.model.kv_size : index
  %query_gate_size = config.get @qwen.model.query_gate_size : index
  %head_size = config.get @qwen.model.head_size : index
  %epsilon = config.get @qwen.model.rms_epsilon : f32
  %q5_bytes = config.get @qwen.model.query_q5_weight_bytes : index
  %q6_bytes = config.get @qwen.model.query_q6_weight_bytes : index
  %query_bytes = scf.select %q6, %q6_bytes, %q5_bytes : index
  %k5_bytes = config.get @qwen.model.key_q5_weight_bytes : index
  %k6_bytes = config.get @qwen.model.key_q6_weight_bytes : index
  %key_bytes = scf.select %q6, %k6_bytes, %k5_bytes : index
  %value_bytes = config.get @qwen.model.value_weight_bytes : index
  %output_bytes = config.get @qwen.model.projection_weight_bytes : index
  %input_norm_weight = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<[%hidden_size]xf32>
  %query_weight = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<[%query_bytes]xi8>
  %query_norm_weight = command.parameter %parameters, "blk.{}.attn_q_norm.weight"[%layer] : view<[%head_size]xf32>
  %key_weight = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<[%key_bytes]xi8>
  %key_norm_weight = command.parameter %parameters, "blk.{}.attn_k_norm.weight"[%layer] : view<[%head_size]xf32>
  %value_weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%value_bytes]xi8>
  %output_weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<[%output_bytes]xi8>
  %post_norm_weight = command.parameter %parameters, "blk.{}.post_attention_norm.weight"[%layer] : view<[%hidden_size]xf32>
  %hidden_capacity = config.get @qwen.model.hidden_capacity_bytes : index
  %hidden_q8_capacity = config.get @qwen.model.hidden_q8_capacity_bytes : index
  %query_gate_capacity = config.get @qwen.model.query_gate_capacity_bytes : index
  %kv_capacity = config.get @qwen.model.kv_capacity_bytes : index
  %attention_capacity = config.get @qwen.model.projection_capacity_bytes : index
  %ffn_capacity = config.get @qwen.model.ffn_capacity_bytes : index
  %hidden_allocation = index.cast %hidden_capacity : index to offset
  %hidden_q8_allocation = index.cast %hidden_q8_capacity : index to offset
  %query_gate_allocation = index.cast %query_gate_capacity : index to offset
  %kv_allocation = index.cast %kv_capacity : index to offset
  %attention_allocation = index.cast %attention_capacity : index to offset
  %ffn_allocation = index.cast %ffn_capacity : index to offset
  %capacity = index.constant 512 : index
  %normalized = buffer.alloca<global> align(256) %hidden_allocation : buffer
  %normalized_q8 = buffer.alloca<global> align(256) %hidden_q8_allocation : buffer
  %query_gate_projection = buffer.alloca<global> align(256) %query_gate_allocation : buffer
  %key_projection = buffer.alloca<global> align(256) %kv_allocation : buffer
  %value_projection = buffer.alloca<global> align(256) %kv_allocation : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%capacity, %epsilon, %residual, %input_norm_weight, %normalized) : [index](index, f32, buffer, view<[%hidden_size]xf32>, buffer)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %hidden_size](%capacity, %hidden_size, %normalized, %normalized_q8) : [index, index](index, index, buffer, buffer)
  scf.if %q6 {
    kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %query_gate_size](%capacity, %hidden_size, %query_gate_size, %normalized_q8, %query_weight, %query_gate_projection) : [index, index, index](index, index, index, buffer, view<[%query_bytes]xi8>, buffer)
    kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %kv_size](%capacity, %hidden_size, %kv_size, %normalized_q8, %key_weight, %key_projection) : [index, index, index](index, index, index, buffer, view<[%key_bytes]xi8>, buffer)
  } else {
    kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %query_gate_size](%capacity, %hidden_size, %query_gate_size, %normalized_q8, %query_weight, %query_gate_projection) : [index, index, index](index, index, index, buffer, view<[%query_bytes]xi8>, buffer)
    kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %hidden_size, %kv_size](%capacity, %hidden_size, %kv_size, %normalized_q8, %key_weight, %key_projection) : [index, index, index](index, index, index, buffer, view<[%key_bytes]xi8>, buffer)
  }
  kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %hidden_size, %kv_size](%capacity, %hidden_size, %kv_size, %normalized_q8, %value_weight, %value_projection) : [index, index, index](index, index, index, buffer, view<[%value_bytes]xi8>, buffer)
  %query = buffer.alloca<global> align(256) %attention_allocation : buffer
  %gate = buffer.alloca<global> align(256) %attention_allocation : buffer
  %pool = config.get @qwen38.attention.pool_capacity : index
  %plane_token_bytes = config.get @qwen.model.kv_plane_token_bytes : index
  %plane_bytes0 = index.mul %pool, %plane_token_bytes : index
  %two = index.constant 2 : index
  %layer_stride = index.mul %plane_bytes0, %two : index
  %layer_stride_offset = index.cast %layer_stride : index to offset
  %layer_origin = index.scale %attention_ordinal, %layer_stride_offset : index, offset -> offset
  // Span kernels write N only; full-T downstream consumers require initialized
  // attended padding. Keep this clear inside the complete numerical producer.
  kernel.launch @qwen38_attention_clear_attended[%token_count](%token_count, %attention_output) : [index](index, buffer)
  command.concurrent {
    kernel.launch @qwen38_attention_query_prepare_spans[%token_count, %span_capacity](%control, %epsilon, %query_gate_projection, %query_norm_weight, %query, %gate) : [index, index](buffer, f32, buffer, view<[%head_size]xf32>, buffer, buffer)
    kernel.launch @qwen38_attention_kv_prepare_spans[%token_count, %span_capacity](%control, %rows, %layer_origin, %epsilon, %key_projection, %value_projection, %key_norm_weight, %attention_cache) : [index, index](buffer, buffer, offset, f32, buffer, buffer, view<[%head_size]xf32>, buffer)
  }
  kernel.launch @qwen38_attention_spans_f16_wmma[%token_count, %span_capacity](%control, %rows, %layer_origin, %query, %gate, %attention_cache, %attention_output) : [index, index](buffer, buffer, offset, buffer, buffer, buffer, buffer)
  // Preserve the canonical seed's roomy attention allocation for Q8 packing.
  %packed_attention = buffer.alloca<global> align(256) %attention_allocation : buffer
  %projected = buffer.alloca<global> align(256) %hidden_allocation : buffer
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %attention_size](%capacity, %attention_size, %attention_output, %packed_attention) : [index, index](index, index, buffer, buffer)
  kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %attention_size, %hidden_size](%capacity, %attention_size, %hidden_size, %packed_attention, %output_weight, %projected) : [index, index, index](index, index, index, buffer, view<[%output_bytes]xi8>, buffer)
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%capacity, %residual, %projected, %residual) : [index](index, buffer, buffer, buffer)
  %post_normalized = buffer.alloca<global> align(256) %hidden_allocation : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%capacity, %epsilon, %residual, %post_norm_weight, %post_normalized) : [index](index, f32, buffer, view<[%hidden_size]xf32>, buffer)
  %swiglu = buffer.alloca<global> align(256) %ffn_allocation : buffer
  command.program.launch @qwen38_ffn_gate_up_prefill[%token_count, %schedule_token_count, %layer, %verification_depth, %span_capacity](%parameters, %post_normalized, %control, %swiglu) : [index, index, index, index, index](buffer, buffer, buffer, buffer)
  command.program.launch @qwen38_ffn_down_prefill[%token_count, %schedule_token_count, %layer, %verification_depth, %span_capacity](%parameters, %control, %swiglu, %residual) : [index, index, index, index, index](buffer, buffer, buffer, buffer)
  command.return
}

// Curated from loom-pipeline/llm/qwen/kernels/qwen38/attention_prefill_wmma.loom.
// Independently maintained by Loomify; ordinary Qwen text attention.

// Qwen3.8-27B tiled causal full-attention prefill.
//
// One four-wave workgroup computes 16 query rows for one query head. QK uses
// four 16x16 F16 WMMA fragments across each 64-row cache block. Scores cross
// LDS so each wave owns four complete query rows for online softmax. F16
// probabilities then cross LDS for four sequential 64-channel P*V tiles.
// K and V retain the production token-major persistent cache layout.
// The shared body receives logical and physical extents explicitly; only
// concrete wrappers resolve the model's cache-capacity configuration.

// Model geometry is supplied by the selected architecture catalog.
config.decl @qwen.model.kv_heads : index

config.decl @qwen.model.attention_heads : index

config.decl @qwen.model.head_size : index

config.decl @qwen.model.kv_size : index

config.decl @qwen.model.attention_scale : f32

config.decl @qwen.model.attention_width : index

target.decl @llm.platform.attention.h256_prefill.wave64

config.decl @qwen38.attention.cache_capacity : %value: index where [range(%value, 1, 262144)]

func.decl @qwen38_kv_position(%logical_capacity: index, %map: buffer, %map_origin: offset, %position: index, %pool_capacity: index) -> (index)

template.decl @qwen38.attention.wmma(%logical_capacity: index, %query_tile: index, %query_head: index, %workitem: index, %subgroup: index, %lane: index, %control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer, %control_origin: offset, %token_begin: index, %key_cache_origin: offset, %value_cache_origin: offset, %map: buffer, %map_origin: offset, %pool_capacity: index)

// H256/256-thread WMMA schedule with F16 staging and F16-rounded result.
// 16 query rows per tile, 64 cache rows per iteration; packed/paged cache
// addressing, causal positions and gate multiplication match the adapter ABI.
template.decl @llm.attention.prefill_wmma_h256(%shape_kv_size: index, %shape_attention_width: index, %query_heads: index, %key_heads: index, %c256: index, %attention_scale: f32, %logical_capacity: index, %query_tile: index, %query_head: index, %workitem: index, %subgroup: index, %lane: index, %control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer, %control_origin: offset, %token_begin: index, %key_cache_origin: offset, %value_cache_origin: offset, %map: buffer, %map_origin: offset, %pool_capacity: index)

template.def<@qwen38.attention.wmma> device @qwen38_attention_wmma(%logical_capacity: index, %query_tile: index, %query_head: index, %workitem: index, %subgroup: index, %lane: index, %control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer, %control_origin: offset, %token_begin: index, %key_cache_origin: offset, %value_cache_origin: offset, %map: buffer, %map_origin: offset, %pool_capacity: index) {
  %shape_kv_size = config.get @qwen.model.kv_size : index
  %shape_attention_width = config.get @qwen.model.attention_width : index
  %query_heads = config.get @qwen.model.attention_heads : index
  %key_heads = config.get @qwen.model.kv_heads : index
  %c256 = config.get @qwen.model.head_size : index
  %attention_scale = config.get @qwen.model.attention_scale : f32
  template.apply<@llm.attention.prefill_wmma_h256>(%shape_kv_size, %shape_attention_width, %query_heads, %key_heads, %c256, %attention_scale, %logical_capacity, %query_tile, %query_head, %workitem, %subgroup, %lane, %control, %query, %gate, %key_cache, %value_cache, %output, %control_origin, %token_begin, %key_cache_origin, %value_cache_origin, %map, %map_origin, %pool_capacity) : (index, index, index, index, index, f32, index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset, buffer, offset, index)
  template.return
}

kernel.def target(@llm.platform.attention.h256_prefill.wave64) export("qwen38_attention_prefill_f16_wmma") @qwen38_attention_prefill_f16_wmma(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c24 = config.get @qwen.model.attention_heads : index
  %c256 = config.get @qwen.model.head_size : index
  %padded_token_count = index.add %token_count, %c15 : index
  %query_tile_count = index.div %padded_token_count, %c16 : index
  kernel.launch.config workgroups(%query_tile_count, %c24, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer) {
  %query_tile = kernel.workgroup.id<x> : index
  %query_head0 = kernel.workgroup.id<y> : index
  %query_head = index.assume %query_head0 [range(%query_head0, 0, 23)] : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 3)] : index
  %lane = kernel.subgroup.lane.id : index
  %origin = index.constant 0 : offset
  %token_begin = index.constant 0 : index
  %query_noalias, %gate_noalias, %key_noalias, %value_noalias, %output_noalias = buffer.assume.noalias %query, %gate, %key_cache, %value_cache, %output : buffer, buffer, buffer, buffer, buffer
  %logical_capacity = config.get @qwen38.attention.cache_capacity : index
  template.apply<@qwen38.attention.wmma>(%logical_capacity, %query_tile, %query_head, %workitem, %subgroup, %lane, %control, %query_noalias, %gate_noalias, %key_noalias, %value_noalias, %output_noalias, %origin, %token_begin, %origin, %origin, %control, %origin, %token_begin) : (index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset, buffer, offset, index)
  kernel.return
}

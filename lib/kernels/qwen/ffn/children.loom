// Complete 1024-channel tiles make device width equal grid_x*1024. Deriving
// it from the grid preserves vector4 bounds through neutral launch composition.

template.def<@llm.ffn.down_decode> @llm_ffn_down_decode(%hidden_size: index, %ffn_size: index, %use_generic_quantized_projections: i1, %use_mmvq_compat: i1, %ffn_down_is_q4: i1, %ffn_down_is_q6: i1, %shape_ffn_down_weight_bytes: index, %shape_ffn_row_bytes: index, %shape_hidden_row_bytes: index, %ffn_down_weight: view<[%shape_ffn_down_weight_bytes]xi8>, %swiglu: buffer, %residual: buffer) where [eq(%hidden_size, 1024), eq(%ffn_size, 3584), eq(%use_generic_quantized_projections, 1), eq(%use_mmvq_compat, 0), eq(%ffn_down_is_q4, 0)] {
  %projection_row_origin = index.constant 0 : index
  %projection_count_origin = index.constant 0 : offset
  %projection_fixed_count = scalar.constant 1 : i32
  %token_count = index.constant 1 : index
  %hidden_bytes = index.cast %shape_hidden_row_bytes : index to offset
  %ffn_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  
    %swiglu_q8_bytes = index.cast %shape_ffn_row_bytes : index to offset
    %swiglu_q8 = buffer.alloca<global> align(256) %swiglu_q8_bytes : buffer
    
      kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %ffn_size](%token_count, %ffn_size, %swiglu, %swiglu_q8) : [index, index](index, index, buffer, buffer)
    
    scf.if %ffn_down_is_q4 {
      
        kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_count, %ffn_size, %hidden_size, %swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
      
    } else {
      scf.if %ffn_down_is_q6 {
        
          kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_count, %ffn_size, %hidden_size, %swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
        
      } else {
        kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %ffn_size, %hidden_size](%token_count, %ffn_size, %hidden_size, %swiglu_q8, %ffn_down_weight, %ffn_output) : [index, index, index](index, index, index, buffer, view<[%shape_ffn_down_weight_bytes]xi8>, buffer)
      }
    }
  
  kernel.launch @llm_ffn_residual_add_f32_decode[%hidden_size](%residual, %ffn_output, %residual) : [index](buffer, buffer, buffer)
  template.return
}


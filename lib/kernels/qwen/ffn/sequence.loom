func.decl pure @loomify.config.layer_ffn(%layer: index) -> (index, index, index, index, index, index, index)
config.decl @qwen.model.hidden_size : index

command.program.def public @qwen38_ffn_gate_up_decode(%layer: index) launch(%parameters: buffer, %post_normalized_q8: buffer, %swiglu: buffer) where [range(%layer, 0, 63)] {
  %projection_implementation = config.get @qwen.model.projection_implementation : index
  %recipe_zero = index.constant 0 : index
  %use_generic_quantized_projections = index.cmp ne, %projection_implementation, %recipe_zero : index
  %lookup_ffn, %gate_tag, %up_tag, %down_tag, %shape_ffn_gate_weight_bytes, %up_bytes, %down_bytes = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %hidden_size = config.get @qwen.model.hidden_size : index
  %canonical = index.constant 1 : index
  template.apply<@loomify.ffn.match_up>(%gate_tag, %up_tag, %shape_ffn_gate_weight_bytes, %up_bytes) : (index, index, index, index)
  template.apply<@loomify.ffn.admit>(%hidden_size, %lookup_ffn, %canonical, %gate_tag, %down_tag, %shape_ffn_gate_weight_bytes, %down_bytes) : (index, index, index, index, index, index, index)
  %format_q4 = index.constant 12 : index
  %format_q6 = index.constant 14 : index
  %ffn_gate_is_q4 = index.cmp eq, %gate_tag, %format_q4 : index
  %ffn_gate_is_q6 = index.cmp eq, %gate_tag, %format_q6 : index

  %shape_ffn_row_bytes = config.get @qwen.model.ffn_row_bytes : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>
  %mmvq_compat = scalar.constant false : i1
  template.apply<@llm.ffn.gate_up_decode>(%hidden_size, %lookup_ffn, %use_generic_quantized_projections, %mmvq_compat, %ffn_gate_is_q4, %ffn_gate_is_q6, %shape_ffn_gate_weight_bytes, %shape_ffn_row_bytes, %ffn_gate_weight, %ffn_up_weight, %post_normalized_q8, %swiglu) : (index, index, i1, i1, i1, i1, index, index, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer, buffer)
  command.return
}


  %lookup_ffn, %gate_tag, %up_tag, %down_tag, %shape_ffn_gate_weight_bytes, %up_bytes, %down_bytes = func.call pure @loomify.config.layer_ffn(%layer) : (index) -> (index, index, index, index, index, index, index)
  %hidden_size = config.get @qwen.model.hidden_size : index
  %canonical = index.constant 1 : index
  template.apply<@loomify.ffn.match_up>(%gate_tag, %up_tag, %shape_ffn_gate_weight_bytes, %up_bytes) : (index, index, index, index)
  template.apply<@loomify.ffn.admit>(%hidden_size, %lookup_ffn, %canonical, %gate_tag, %down_tag, %shape_ffn_gate_weight_bytes, %down_bytes) : (index, index, index, index, index, index, index)
  %format_q4 = index.constant 12 : index
  %format_q6 = index.constant 14 : index
  %ffn_gate_is_q4 = index.cmp eq, %gate_tag, %format_q4 : index
  %ffn_gate_is_q6 = index.cmp eq, %gate_tag, %format_q6 : index
  %shape_ffn_capacity_bytes = config.get @qwen.model.ffn_capacity_bytes : index

  %shape_hidden_q8_capacity_bytes = config.get @qwen.model.hidden_q8_capacity_bytes : index
  %shape_hidden_q8_depth4_bytes = config.get @qwen.model.hidden_q8_depth4_bytes : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %verifying = index.cmp eq, %verification_depth, %c4 : index
  %isolated = index.cmp eq, %span_capacity, %c0 : index
  %uses_m4 = scalar.andi %verifying, %isolated : i1
  %token_capacity = index.constant 512 : index
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<[%shape_ffn_gate_weight_bytes]xi8>

  %mmvq_compat = scalar.constant false : i1
  %projection_row_origin = index.constant 0 : index
  %projection_count_origin = index.constant 0 : offset
  template.apply<@llm.ffn.gate_up_prefill>(%hidden_size, %lookup_ffn, %use_generic_quantized_projections, %mmvq_compat, %ffn_gate_is_q4, %ffn_gate_is_q6, %token_count, %token_capacity, %schedule_token_count, %projection_row_origin, %projection_count_origin, %uses_m4, %verification_depth, %shape_ffn_capacity_bytes, %shape_ffn_gate_weight_bytes, %shape_hidden_q8_capacity_bytes, %shape_hidden_q8_depth4_bytes, %ffn_gate_weight, %ffn_up_weight, %post_normalized, %control, %swiglu) : (index, index, i1, i1, i1, i1, index, index, index, index, offset, i1, index, index, index, index, index, view<[%shape_ffn_gate_weight_bytes]xi8>, view<[%shape_ffn_gate_weight_bytes]xi8>, buffer, buffer, buffer)
  command.return

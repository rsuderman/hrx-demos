load("@hrx_system//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("//build_tools:loom_merge.bzl", "loom_merge")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*.loom"]))

filegroup(
    name = "all_sources",
    srcs = glob(["**/*.loom"]) + [
        "//lib/kernels/attention:all_sources",
        "//lib/kernels/elementwise:all_sources",
        "//lib/kernels/embedding:all_sources",
        "//lib/kernels/normalization:all_sources",
        "//lib/kernels/projection:qwen_sources",
        "//lib/kernels/quantization:qwen_sources",
        "//lib/kernels/selection:all_sources",
    ],
)

loom_library(
    name = "spans",
    srcs = ["common/spans.loom"],
    deps = ["//lib/kernels/attention:kv_position"],
)

# Generated model facts supply every model configuration definition.
# Keep source and relocatable provider forms on this identical closure.
_CONFIGURED_PROVIDER_SOURCES = [
    "//lib/programs/ffn:ffn.loom",
    "//lib/programs/projection:packed_sources",
    "//lib/programs/projection:prepared_rows_sources",
    "//lib/programs/ffn:gate_up_sources",
    "common/shared_interface.loom",
    "common/layer_decode.loom",
    "common/layer_prefill.loom",
    "ffn/children.loom",
    "//lib/kernels/elementwise:ffn_launches.loom",
    "//lib/kernels/normalization:rmsnorm_row.loom",
    "//lib/kernels/elementwise:residual_row.loom",
    "common/spans.loom",
    "//lib/kernels/attention:kv_position.loom",
]

loom_library(
    name = "shared",
    srcs = _CONFIGURED_PROVIDER_SOURCES,
)

filegroup(
    name = "configured_provider_sources",
    srcs = _CONFIGURED_PROVIDER_SOURCES,
)

loom_merge(
    name = "configured_providers",
    srcs = _CONFIGURED_PROVIDER_SOURCES,
)

loom_merge(
    name = "configured_provider_text",
    testonly = True,
    srcs = _CONFIGURED_PROVIDER_SOURCES,
    output_format = "text",
)

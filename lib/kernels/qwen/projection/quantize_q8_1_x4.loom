// Curated from loom-pipeline/llm/motifs/ggml/quantize_q8_1_x4.loom at0aed77a.
// Independently maintained ordinary canonical Qwen closure.
template.decl @ggml.quantize_q8_1_x4.group_body(%publish_output: i1, %group_count0: index, %group0: index, %input: buffer, %output: buffer)

// Defines GGML's block_q8_1_x4 physical-layout accessors and packs contiguous
// F32 activations into that layout. Four logical 32-element Q8_1 blocks share
// one 144-byte physical group:
//
//   struct block_q8_1_x4 {
//     f16 ds[4][2];   // per-block (scale, quantized_sum * scale)
//     i32 qs[4][8];   // four signed i8 values per packed word
//   };

template.decl @ggml.quantize_q8_1_x4.group_body_policy(%native_estimate: i1, %mmq_estimate: i1, %publish_output: i1, %group_count0: index, %group0: index, %input: buffer, %output: buffer)

kernel.def export("ggml_quantize_q8_1_x4_f32") @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), multiple_of(%input_size, 128)] : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  %elements_per_group = index.constant 128 : index
  %element_count = index.mul %bounded_token_count, %bounded_input_size : index
  %group_count = index.div %element_count, %elements_per_group : index
  kernel.launch.config workgroups(%group_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer) {
  %group_capacity = config.get @ggml.quantize_q8_1_x4.group_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), multiple_of(%input_size, 128)] : index
  %elements_per_group = index.constant 128 : index
  %element_count = index.mul %bounded_token_count, %bounded_input_size : index
  %group_count0 = index.div %element_count, %elements_per_group : index
  %group_count = index.assume %group_count0 [range(%group_count0, 1, 524288), le(%group_count0, %group_capacity)] : index
  %group0 = kernel.workgroup.id<x> : index
  %group = index.assume %group0 [lt(%group0, %group_capacity)] : index
  %publish_output = scalar.constant true : i1
  template.apply<@ggml.quantize_q8_1_x4.group_body>(%publish_output, %group_count, %group, %input, %output) : (i1, index, index, buffer, buffer)
  kernel.return
}

// This check-only inspector keeps the production packer ABI exact while
// exposing packed words and heterogeneous metadata as comparable tensors.

config.decl @ggml.quantize_q8_1_x4.group_capacity : %value: index where [range(%value, 1, 524288)]

// Loads one logical 32-element Q8_1 block from the four-way physical packing.
// `row_byte_base` addresses the first x4 group for one activation row.

template.def<@ggml.quantize_q8_1_x4.group_body> device @ggml_quantize_q8_1_x4_group_body(%publish_output: i1, %group_count0: index, %group0: index, %input: buffer, %output: buffer) {
  %native_estimate = scalar.constant false : i1
  %mmq_estimate = scalar.constant false : i1
  template.apply<@ggml.quantize_q8_1_x4.group_body_policy>(%native_estimate, %mmq_estimate, %publish_output, %group_count0, %group0, %input, %output) : (i1, i1, i1, index, index, buffer, buffer)
  template.return
}

// A 32-lane workgroup owns one physical group. Each eight-lane cohort loads
// four values, computes one Q8_1 block, and writes disjoint metadata and packed
// words. The LDS reductions make the independent eight-lane cohorts explicit.
// Workload values size the exact launch; group_capacity remains a device-body
// specialization and addressing bound.

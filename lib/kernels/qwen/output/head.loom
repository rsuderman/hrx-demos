    %logits_view = buffer.view %logits[%c0_offset] : buffer -> view<[%token_count]x[%bounded_output_size]xf32>
    %value = view.load %logits_view[%row, %initial_candidate] : view<[%token_count]x[%bounded_output_size]xf32> -> f32

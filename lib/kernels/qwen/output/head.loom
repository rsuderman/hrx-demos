kernel.decl @qwen08_publish_selected_ids(%output_capacity: index) launch(%epoch: buffer, %private_ids: buffer, %output: buffer)
// Four private projection rows preserve the existing ordinary canonical Q6 route.
// Public selected capacity remains1; publication consumes only epoch output_count.
command.program.def @qwen08_epoch_head(%token_capacity: index, %output_capacity: index) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %output: buffer) where [range(%token_capacity, 1, 512), range(%output_capacity, 1, 1)] {
  %four = index.constant 4 : index
  %hidden = index.constant 1024 : index
  %vocab = index.constant 248320 : index
  %origin = index.constant 0 : offset
  %norm_bytes = index.constant 16384 : offset
  %q8_bytes = index.constant 4608 : offset
  %logit_bytes = index.constant 3973120 : offset
  %partial_bytes = index.constant 976 : offset
  %id_bytes = index.constant 16 : offset
  %normalized = buffer.alloca<global> align(256) %norm_bytes : buffer
  %q8 = buffer.alloca<global> align(256) %q8_bytes : buffer
  %logits = buffer.alloca<global> align(256) %logit_bytes : buffer
  %partial_logits = buffer.alloca<global> align(256) %partial_bytes : buffer
  %partial_ids = buffer.alloca<global> align(256) %partial_bytes : buffer
  %private_ids = buffer.alloca<global> align(256) %id_bytes : buffer
  %epsilon = config.get @qwen.model.rms_epsilon : f32
  %gamma = command.parameter %parameters, "output_norm.weight" : view<1024xf32>
  %weight = command.parameter %parameters, "token_embd.weight" : view<208588800xi8>
  kernel.launch @qwen38_output_normalize_spans[%four](%epoch, %epsilon, %residual, %gamma, %normalized) : [index](buffer, f32, buffer, view<1024xf32>, buffer)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%four, %hidden](%four, %hidden, %normalized, %q8) : [index, index](index, index, buffer, buffer)
  kernel.launch @ggml_linear_q6k_q8_1_x4_m4[%four, %hidden, %vocab](%four, %hidden, %vocab, %q8, %weight, %logits) : [index, index, index](index, index, index, buffer, view<208588800xi8>, buffer)
  kernel.launch @qwen38_greedy_argmax_partial_rows_f32[%four, %vocab](%four, %vocab, %logits, %partial_logits, %partial_ids) : [index, index](index, index, buffer, buffer, buffer)
  kernel.launch @qwen38_greedy_argmax_reduce_rows_f32[%four, %vocab](%four, %vocab, %partial_logits, %partial_ids, %private_ids) : [index, index](index, index, buffer, buffer, buffer)
  kernel.launch @qwen08_publish_selected_ids[%output_capacity](%epoch, %private_ids, %output) : [index](buffer, buffer, buffer)
  command.return
}

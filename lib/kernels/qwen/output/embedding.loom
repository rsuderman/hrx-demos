// Curated ordinary Qwen0.8B closure from loom-pipeline at0aed77a.
config.decl @qwen.model.hidden_size : index

config.decl @qwen.model.hidden_row_bytes : index

config.decl @qwen.model.embedding_row_bytes : index

template.decl @ggml.q6k.f32_vector4(%weight: buffer, %weight_row_byte_base: offset, %q6_block: index, %q6_group: index, %packet: index) -> (vector<4xf32>)

template.decl @ggml.q6k.f16_vector4(%weight: buffer, %weight_row_byte_base: offset, %q6_block: index, %q6_group: index, %packet: index) -> (vector<4xf16>)

template.decl @llm.token_embedding_q6k_f16.row(%hidden_size: index, %embedding_row_bytes: index, %token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer)

template.decl @qwen38.token_embedding_q6k_f16.row(%token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer)

template.def<@ggml.q6k.f16_vector4> device @ggml_q6k_f16_vector4(%weight: buffer, %weight_row_byte_base: offset, %q6_block: index, %q6_group: index, %packet: index) -> (vector<4xf16>) {
  %values_f32 = template.apply<@ggml.q6k.f32_vector4>(%weight, %weight_row_byte_base, %q6_block, %q6_group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf32>)
  %values = vector.fptrunc %values_f32 : vector<4xf32> to vector<4xf16>
  template.return %values : vector<4xf16>
}

template.def<@llm.token_embedding_q6k_f16.row> device @llm_token_embedding_q6k_f16_row(%hidden_size: index, %embedding_row_bytes: index, %token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer) {
  %workitem = kernel.workitem.id<x> : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %packets = index.div %hidden_size, %c4 : index
  %row_bytes = index.cast %embedding_row_bytes : index to offset
  %token_id = index.cast %token_id_i32 : i32 to index
  %row_byte_base = index.scale %token_id, %row_bytes : index, offset -> offset
  %weight_noalias, %output_noalias = buffer.assume.noalias %weight, %output : buffer, buffer
  %output_view = buffer.view %output_noalias[%output_byte_offset] : buffer -> view<[%hidden_size]xf32>
  scf.for %chunk = [%workitem to %packets step %c256] {
    %block = index.div %chunk, %c64 : index
    %block_packet = index.rem %chunk, %c64 : index
    %group = index.div %block_packet, %c8 : index
    %packet = index.rem %block_packet, %c8 : index
    %values_f16 = template.apply<@ggml.q6k.f16_vector4>(%weight_noalias, %row_byte_base, %block, %group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf16>)
    %values = vector.extf %values_f16 : vector<4xf16> to vector<4xf32>
    %element_base = index.mul %chunk, %c4 : index
    vector.store %values, %output_view[%element_base] : vector<4xf32>, view<[%hidden_size]xf32>
  }
  template.return
}

template.def<@qwen38.token_embedding_q6k_f16.row> device @qwen38_token_embedding_q6k_f16_row(%token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer) {
  %hidden_size = config.get @qwen.model.hidden_size : index
  %row_bytes = config.get @qwen.model.embedding_row_bytes : index
  template.apply<@llm.token_embedding_q6k_f16.row>(%hidden_size, %row_bytes, %token_id_i32, %output_byte_offset, %weight, %output) : (index, index, i32, offset, buffer, buffer)
  template.return
}

kernel.def export("qwen38_token_embedding_q6k_f16_prefill") @qwen38_token_embedding_q6k_f16_prefill(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_ids: buffer, %weight: buffer, %output: buffer) {
  %shape_hidden_row_bytes = config.get @qwen.model.hidden_row_bytes : index
  %token0 = kernel.workgroup.id<x> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %c0_offset = index.constant 0 : offset
  %output_row_bytes = index.cast %shape_hidden_row_bytes : index to offset
  %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<512xi32>
  %token_id_i32 = view.load %token_ids_view[%token] : view<512xi32> -> i32
  %output_byte_offset = index.scale %token, %output_row_bytes : index, offset -> offset
  template.apply<@qwen38.token_embedding_q6k_f16.row>(%token_id_i32, %output_byte_offset, %weight, %output) : (i32, offset, buffer, buffer)
  kernel.return
}

template.decl @llm.token_embedding_q4k_f32.row(%hidden: index, %row_bytes: index, %id: i32, %origin: offset, %weight: buffer, %output: buffer)

kernel.def export("qwen38_token_embedding_q4k_f32_prefill") @qwen38_token_embedding_q4k_f32_prefill(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_ids: buffer, %weight: buffer, %output: buffer) {
  %hidden = config.get @qwen.model.hidden_size : index
  %row_bytes = config.get @qwen.model.embedding_row_bytes : index
  %shape_hidden_row_bytes = config.get @qwen.model.hidden_row_bytes : index
  %token0 = kernel.workgroup.id<x> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %c0_offset = index.constant 0 : offset
  %output_row_bytes = index.cast %shape_hidden_row_bytes : index to offset
  %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<512xi32>
  %token_id_i32 = view.load %token_ids_view[%token] : view<512xi32> -> i32
  %output_byte_offset = index.scale %token, %output_row_bytes : index, offset -> offset
  template.apply<@llm.token_embedding_q4k_f32.row>(%hidden, %row_bytes, %token_id_i32, %output_byte_offset, %weight, %output) : (index, index, i32, offset, buffer, buffer)
  kernel.return
}

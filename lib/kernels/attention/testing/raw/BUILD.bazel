load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_testing.bzl", "loom_provider_checks")

package(default_visibility = ["//visibility:public"])

loom_provider_checks(
    name = "raw",
    checks = ["checks.loom"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "provider",
    provider_srcs = [
        "programs.loom",
        "//lib/kernels/attention:raw_rows.loom",
        "//lib/kernels/decoder:implementation_sources",
    ],
)

loom_provider_checks(
    name = "geometry",
    checks = ["geometry_checks.loom"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "geometry_provider",
    provider_srcs = [
        "geometry_programs.loom",
        "//lib/kernels/attention:raw_rows.loom",
        "//lib/kernels/decoder:implementation_sources",
    ],
)

    check.compare<@spark.state.publication_two, @spark.state.publication_two.expected>(%epoch, %selected, %output) : (tensor<520xi32>, tensor<4xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<24xi32>
      check.expect.bitwise actual(%selected) expected(%selected) : tensor<4xi32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<520xi32>
    }
  }
  check.return
}


// Uniform zero-key attention has an independent F64 mean oracle. Physical
// values depend separately on slot, KV head and lane. Reversed64-token pages
// and512-token windows therefore affect the independently computed answer.
func.def @spark.state.expected(%window: index, %epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %sixteen = index.constant 16 : index
  %h = index.constant 256 : index
  %pool = index.constant 1024 : index
  %page = index.constant 64 : index
  %last_page = index.constant 15 : index
  %position_base = index.constant 511 : index
  %kbase = index.constant 16 : offset
  %vbase = index.constant 2097168 : offset
  %origin = index.constant 0 : offset
  %keys = buffer.view %cache[%kbase] : buffer -> view<1024x4x256xf16>
  %values = buffer.view %cache[%vbase] : buffer -> view<1024x4x256xf16>
  %out = buffer.view %output[%origin] : buffer -> view<4x16x256xf32>
  %gates = buffer.view %gate[%origin] : buffer -> view<4x16xf32>
  %zero_f = scalar.constant 0.0 : f32
  %zero64 = scalar.constant 0.0 : f64
  %zero16 = scalar.fptrunc %zero_f : f32 to f16
  %pstep = scalar.constant 0.001953125 : f32
  %hstep = scalar.constant 2.0 : f32
  %lstep = scalar.constant 0.00390625 : f32
  %unit = scalar.constant 1.0 : f32
  scf.for %p = [%zero to %pool step %one] {
    scf.for %head = [%zero to %four step %one] {
      scf.for %lane = [%zero to %h step %one] {
        %p32 = index.cast %p : index to i32
        %h32 = index.cast %head : index to i32
        %l32 = index.cast %lane : index to i32
        %pf = scalar.uitofp %p32 : i32 to f32
        %hf = scalar.uitofp %h32 : i32 to f32
        %lf = scalar.uitofp %l32 : i32 to f32
        %a = scalar.mulf %pf, %pstep : f32
        %b = scalar.mulf %hf, %hstep : f32
        %c = scalar.mulf %lf, %lstep : f32
        %ab = scalar.addf %a, %b : f32
        %v = scalar.addf %ab, %c : f32
        %half = scalar.fptrunc %v : f32 to f16
        view.store %zero16, %keys[%p, %head, %lane] : f16, view<1024x4x256xf16>
        view.store %half, %values[%p, %head, %lane] : f16, view<1024x4x256xf16>
      }
    }
  }
  scf.for %row = [%zero to %four step %one] {
    %active = index.cmp ult, %row, %three : index
    %position = index.add %position_base, %row : index
    %end = index.add %position, %one : index
    %windowed = index.cmp ne, %window, %zero : index
    %long = index.cmp ugt, %end, %window : index
    %trim = scalar.andi %windowed, %long : i1
    %low = index.sub %end, %window : index
    %begin = scf.select %trim, %low, %zero : index
    %length = index.sub %end, %begin : index
    %len32 = index.cast %length : index to i32
    %divisor = scalar.uitofp %len32 : i32 to f64
    scf.for %head = [%zero to %sixteen step %one] {
      %kvhead = index.div %head, %four : index
      scf.for %lane = [%zero to %h step %one] {
        %result = scf.if %active -> (f32) {
          %sum = scf.for %logical = [%begin to %end step %one](%acc = %zero64 : f64) -> (f64) {
            %logical_page = index.div %logical, %page : index
            %physical_page = index.sub %last_page, %logical_page : index
            %within = index.rem %logical, %page : index
            %page_base = index.mul %physical_page, %page : index
            %physical = index.add %page_base, %within : index
            %half = view.load %values[%physical, %kvhead, %lane] : view<1024x4x256xf16> -> f16
            %v = scalar.extf %half : f16 to f64
            %next = scalar.addf %acc, %v : f64
            scf.yield %next : f64
          }
          %mean64 = scalar.divf %sum, %divisor : f64
          %mean = scalar.fptrunc %mean64 : f64 to f32
          %logit = view.load %gates[%row, %head] : view<4x16xf32> -> f32
          %negative = scalar.negf %logit : f32
          %ex = scalar.expf %negative : f32
          %den = scalar.addf %unit, %ex : f32
          %sigmoid = scalar.divf %unit, %den : f32
          %v = scalar.mulf %mean, %sigmoid : f32
          scf.yield %v : f32
        } else {
          scf.yield %zero_f : f32
        }
        view.store %result, %out[%row, %head, %lane] : f32, view<4x16x256xf32>
      }
    }
  }
  func.return
}

command.decl @spark.state.global() launch(%epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer)

func.def @spark.state.expected.global(%epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %window = index.constant 0 : index
  func.call @spark.state.expected(%window, %epoch, %map, %query, %gate, %cache, %output) : (index, buffer, buffer, buffer, buffer, buffer, buffer)
  func.return
}

check.scenario @spark.state.global_boundary {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch_storage = check.generate.iota offset(-2029) step(508) : tensor<9xi32>
    %map_storage = check.generate.iota offset(19) step(-1) : tensor<20xi32>
    %query = check.generate.iota offset(-0.5) step(1.52587890625e-05) : tensor<4x4096xf32>
    %gate = check.generate.iota offset(-2.0) step(0.125) : tensor<4x16xf32>
    %cache = check.generate.fill value(23.0) : tensor<2097168xf16>
    %storage = check.generate.fill value(123.5) : tensor<16392xf32>
    %output = check.tensor.view %storage offset(16) : tensor<16392xf32> -> tensor<4x4096xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<16392xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(65552) : tensor<16392xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %output offset(49152) : tensor<4x4096xf32> -> tensor<4096xf32>
    check.compare<@spark.state.global, @spark.state.expected.global>(%epoch_storage, %map_storage, %query, %gate, %cache, %output) : (tensor<9xi32>, tensor<20xi32>, tensor<4x4096xf32>, tensor<4x16xf32>, tensor<2097168xf16>, tensor<4x4096xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(3.0000000000000001e-05) rtol(3.0000000000000001e-05) nan(same) : tensor<4x4096xf32>, tensor<4x4096xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<4096xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%cache) expected(%cache) : tensor<2097168xf16>
      check.expect.bitwise actual(%epoch_storage) expected(%epoch_storage) : tensor<9xi32>
      check.expect.bitwise actual(%map_storage) expected(%map_storage) : tensor<20xi32>
      check.expect.bitwise actual(%query) expected(%query) : tensor<4x4096xf32>
      check.expect.bitwise actual(%gate) expected(%gate) : tensor<4x16xf32>
    }
  }
  check.return
}


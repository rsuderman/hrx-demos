// Independent analytic logits are [0,2,-1] times query-head amplitude.
// No owned dot/reduction/softmax helper is used by this F64 scalar oracle.
func.def @spark.state.nonzero_qk.expected(%epoch: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %kbase = index.constant 16 : offset
  %vbase = index.constant 1552 : offset
  %keys = buffer.view %cache[%kbase] : buffer -> view<3x256xf16>
  %values = buffer.view %cache[%vbase] : buffer -> view<3x256xf16>
  %q = buffer.view %query[%origin] : buffer -> view<2x2x256xf32>
  %gates = buffer.view %gate[%origin] : buffer -> view<2x2xf32>
  %out = buffer.view %output[%origin] : buffer -> view<2x2x256xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %h = index.constant 256 : index
  %last = index.constant 255 : index
  %zero_f = scalar.constant 0.0 : f32
  %positive = scalar.constant 32.0 : f32
  %negative = scalar.constant -16.0 : f32
  %pstep = scalar.constant 2.0 : f32
  %lstep = scalar.constant 0.00390625 : f32
  %q0 = scalar.constant 1.0 : f32
  %q1 = scalar.constant 2.0 : f32
  view.store %q0, %q[0, 0, 255] : f32, view<2x2x256xf32>
  view.store %q1, %q[0, 1, 255] : f32, view<2x2x256xf32>
  scf.for %p = [%zero to %three step %one] {
    %first = index.cmp eq, %p, %zero : index
    %second = index.cmp eq, %p, %one : index
    %tail = scf.select %second, %positive, %negative : f32
    %key_tail = scf.select %first, %zero_f, %tail : f32
    %p32 = index.cast %p : index to i32
    %pf = scalar.uitofp %p32 : i32 to f32
    %a = scalar.mulf %pf, %pstep : f32
    scf.for %lane = [%zero to %h step %one] {
      %upper = index.cmp eq, %lane, %last : index
      %key = scf.select %upper, %key_tail, %zero_f : f32
      %key16 = scalar.fptrunc %key : f32 to f16
      %l32 = index.cast %lane : index to i32
      %lf = scalar.uitofp %l32 : i32 to f32
      %b = scalar.mulf %lf, %lstep : f32
      %v = scalar.addf %a, %b : f32
      %half = scalar.fptrunc %v : f32 to f16
      view.store %key16, %keys[%p, %lane] : f16, view<3x256xf16>
      view.store %half, %values[%p, %lane] : f16, view<3x256xf16>
    }
  }
  %zero64 = scalar.constant 0.0 : f64
  %one64 = scalar.constant 1.0 : f64
  %two64 = scalar.constant 2.0 : f64
  %three64 = scalar.constant 3.0 : f64
  scf.for %row = [%zero to %two step %one] {
    %active = index.cmp eq, %row, %zero : index
    scf.for %head = [%zero to %two step %one] {
      %head32 = index.cast %head : index to i32
      %head64 = scalar.uitofp %head32 : i32 to f64
      %amplitude = scalar.addf %head64, %one64 : f64
      %twice = scalar.mulf %amplitude, %two64 : f64
      %triple = scalar.mulf %amplitude, %three64 : f64
      %log_w0 = scalar.negf %twice : f64
      %log_w2 = scalar.negf %triple : f64
      %w0 = scalar.expf %log_w0 : f64
      %w2 = scalar.expf %log_w2 : f64
      %partial_den = scalar.addf %w0, %one64 : f64
      %den = scalar.addf %partial_den, %w2 : f64
      %logit = view.load %gates[%row, %head] : view<2x2xf32> -> f32
      %logit64 = scalar.extf %logit : f32 to f64
      %negative_logit = scalar.negf %logit64 : f64
      %gate_exp = scalar.expf %negative_logit : f64
      %gate_den = scalar.addf %one64, %gate_exp : f64
      %sigmoid = scalar.divf %one64, %gate_den : f64
      scf.for %lane = [%zero to %h step %one] {
        %result = scf.if %active -> (f32) {
          %v0 = view.load %values[0, %lane] : view<3x256xf16> -> f16
          %v1 = view.load %values[1, %lane] : view<3x256xf16> -> f16
          %v2 = view.load %values[2, %lane] : view<3x256xf16> -> f16
          %a = scalar.extf %v0 : f16 to f64
          %b = scalar.extf %v1 : f16 to f64
          %c = scalar.extf %v2 : f16 to f64
          %weighted_a = scalar.mulf %a, %w0 : f64
          %weighted_c = scalar.mulf %c, %w2 : f64
          %ab = scalar.addf %weighted_a, %b : f64
          %sum = scalar.addf %ab, %weighted_c : f64
          %mean = scalar.divf %sum, %den : f64
          %gated = scalar.mulf %mean, %sigmoid : f64
          %value = scalar.fptrunc %gated : f64 to f32
          scf.yield %value : f32
        } else {
          scf.yield %zero_f : f32
        }
        view.store %result, %out[%row, %head, %lane] : f32, view<2x2x256xf32>
      }
    }
  }
  func.return
}

command.decl @spark.state.nonzero_qk() launch(%epoch: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer)

check.scenario @spark.state.nonzero_upper_half_qk {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.iota offset(1) step(1) : tensor<5xi32>
    %query = check.generate.fill value(0.0) : tensor<2x512xf32>
    %gate = check.generate.iota offset(0.0) step(1.0) : tensor<2x2xf32>
    %cache = check.generate.fill value(23.0) : tensor<1552xf16>
    %storage = check.generate.fill value(123.5) : tensor<1032xf32>
    %output = check.tensor.view %storage offset(16) : tensor<1032xf32> -> tensor<2x512xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<1032xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(4112) : tensor<1032xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %output offset(2048) : tensor<2x512xf32> -> tensor<512xf32>
    check.compare<@spark.state.nonzero_qk, @spark.state.nonzero_qk.expected>(%epoch, %query, %gate, %cache, %output) : (tensor<5xi32>, tensor<2x512xf32>, tensor<2x2xf32>, tensor<1552xf16>, tensor<2x512xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.0000000000000001e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<2x512xf32>, tensor<2x512xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<512xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%query) expected(%query) : tensor<2x512xf32>
      check.expect.bitwise actual(%gate) expected(%gate) : tensor<2x2xf32>
      check.expect.bitwise actual(%cache) expected(%cache) : tensor<1552xf16>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<5xi32>
    }
  }
  check.return
}

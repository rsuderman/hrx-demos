// Independent packet interpretation and source-stop mapping, without invoking
// any production publication function. Raw private winners remain unchanged.
func.def @spark.state.publication.expected(%two: i1, %epoch: buffer, %selected: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %packet = buffer.view %epoch[%origin] : buffer -> view<520xi32>
  %winner_words = buffer.view %selected[%origin] : buffer -> view<4xi32>
  %out = buffer.view %output[%origin] : buffer -> view<16xi32>
  %count = view.load %packet[2] : view<520xi32> -> i32
  %zero = scalar.constant 0 : i32
  %has_output = scalar.cmpi ne, %count, %zero : i32
  scf.if %has_output {
    %slot32 = view.load %packet[7] : view<520xi32> -> i32
    %slot_value = index.cast %slot32 : i32 to index
    %slot = index.assume %slot_value [range(%slot_value, 0, 15)] : index
    %terminal = view.load %packet[515] : view<520xi32> -> i32
    %winner = view.load %winner_words[0] : view<4xi32> -> i32
    %first = scalar.constant 1337 : i32
    %second = scalar.constant 1433 : i32
    %is_first = scalar.cmpi eq, %winner, %first : i32
    %is_second = scalar.cmpi eq, %winner, %second : i32
    %extra_stop = scalar.andi %two, %is_second : i1
    %stop = scalar.ori %is_first, %extra_stop : i1
    %token = scf.select %stop, %terminal, %winner : i32
    view.store %token, %out[%slot] : i32, view<16xi32>
  }
  func.return
}


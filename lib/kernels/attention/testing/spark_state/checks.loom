command.decl @spark.state.publish_kv() launch(%epoch: buffer, %map: buffer, %key: buffer, %value: buffer, %cache: buffer)

func.def @spark.state.publish_kv.expected(%epoch: buffer, %map: buffer, %key: buffer, %value: buffer, %cache: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %width = index.constant 1024 : index
  %page = index.constant 64 : index
  %last_page = index.constant 15 : index
  %position_base = index.constant 511 : index
  %origin = index.constant 0 : offset
  %kbase = index.constant 16 : offset
  %vbase = index.constant 2097168 : offset
  %keys = buffer.view %key[%origin] : buffer -> view<4x1024xf32>
  %values = buffer.view %value[%origin] : buffer -> view<4x1024xf32>
  %kc = buffer.view %cache[%kbase] : buffer -> view<1024x1024xf16>
  %vc = buffer.view %cache[%vbase] : buffer -> view<1024x1024xf16>
  scf.for %row = [%zero to %three step %one] {
    %logical = index.add %position_base, %row : index
    %logical_page = index.div %logical, %page : index
    %physical_page = index.sub %last_page, %logical_page : index
    %within = index.rem %logical, %page : index
    %begin = index.mul %physical_page, %page : index
    %physical = index.add %begin, %within : index
    scf.for %column = [%zero to %width step %one] {
      %k = view.load %keys[%row, %column] : view<4x1024xf32> -> f32
      %v = view.load %values[%row, %column] : view<4x1024xf32> -> f32
      %kh = scalar.fptrunc %k : f32 to f16
      %vh = scalar.fptrunc %v : f32 to f16
      view.store %kh, %kc[%physical, %column] : f16, view<1024x1024xf16>
      view.store %vh, %vc[%physical, %column] : f16, view<1024x1024xf16>
    }
  }
  func.return
}


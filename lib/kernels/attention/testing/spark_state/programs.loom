// Nonzero upper-half QK fixture: only dimension255 contributes to each dot.
kernel.def @spark.state.nonzero_fixture() {
  %positions = index.constant 3 : index
  %threads = index.constant 256 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%positions, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%query: buffer, %cache: buffer) {
  %p = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %kbase = index.constant 16 : offset
  %vbase = index.constant 1552 : offset
  %keys = buffer.view %cache[%kbase] : buffer -> view<3x256xf16>
  %values = buffer.view %cache[%vbase] : buffer -> view<3x256xf16>
  %q = buffer.view %query[%origin] : buffer -> view<2x2x256xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %last = index.constant 255 : index
  %zero_f = scalar.constant 0.0 : f32
  %positive = scalar.constant 32.0 : f32
  %negative = scalar.constant -16.0 : f32
  %first = index.cmp eq, %p, %zero : index
  %second = index.cmp eq, %p, %one : index
  %key_tail = scf.select %second, %positive, %negative : f32
  %score = scf.select %first, %zero_f, %key_tail : f32
  %upper = index.cmp eq, %lane, %last : index
  %key = scf.select %upper, %score, %zero_f : f32
  %key16 = scalar.fptrunc %key : f32 to f16
  %p32 = index.cast %p : index to i32
  %l32 = index.cast %lane : index to i32
  %pf = scalar.uitofp %p32 : i32 to f32
  %lf = scalar.uitofp %l32 : i32 to f32
  %pstep = scalar.constant 2.0 : f32
  %lstep = scalar.constant 0.00390625 : f32
  %a = scalar.mulf %pf, %pstep : f32
  %b = scalar.mulf %lf, %lstep : f32
  %value = scalar.addf %a, %b : f32
  %value16 = scalar.fptrunc %value : f32 to f16
  view.store %key16, %keys[%p, %lane] : f16, view<3x256xf16>
  view.store %value16, %values[%p, %lane] : f16, view<3x256xf16>
  %write_q = scalar.andi %first, %upper : i1
  scf.if %write_q {
    %q0 = scalar.constant 1.0 : f32
    %q1 = scalar.constant 2.0 : f32
    view.store %q0, %q[0, 0, 255] : f32, view<2x2x256xf32>
    view.store %q1, %q[0, 1, 255] : f32, view<2x2x256xf32>
  }
  kernel.return
}

command.def @spark.state.nonzero_qk() launch(%epoch: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %rows = index.constant 2 : index
  %qh = index.constant 2 : index
  %kh = index.constant 1 : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %capacity = index.constant 3 : index
  %scale = scalar.constant 0.0625 : f32
  %base = index.constant 16 : offset
  %origin = index.constant 0 : offset
  kernel.launch @spark.state.nonzero_fixture(%query, %cache) : (buffer, buffer)
  kernel.launch @llm.attention.gated_window_rows_h256[%rows, %qh, %kh](%kh, %zero, %one, %capacity, %zero, %scale, %zero, %base, %origin, %origin, %epoch, %epoch, %query, %gate, %cache, %output) : [index, index, index](index, index, index, index, index, f32, index, offset, offset, offset, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

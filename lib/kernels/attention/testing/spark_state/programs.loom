// Fixture population is independent of the imported attention operation.
kernel.def @spark.state.cache_fixture() {
  %pool = index.constant 1024 : index
  %heads = index.constant 4 : index
  %h = index.constant 256 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%pool, %heads, %one) workgroup_size(%h, %one, %one) : index
} launch(%cache: buffer) {
  %p = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %kbase = index.constant 16 : offset
  %vbase = index.constant 2097168 : offset
  %keys = buffer.view %cache[%kbase] : buffer -> view<1024x4x256xf16>
  %values = buffer.view %cache[%vbase] : buffer -> view<1024x4x256xf16>
  %p32 = index.cast %p : index to i32
  %head32 = index.cast %head : index to i32
  %lane32 = index.cast %lane : index to i32
  %pf = scalar.uitofp %p32 : i32 to f32
  %hf = scalar.uitofp %head32 : i32 to f32
  %lf = scalar.uitofp %lane32 : i32 to f32
  %pstep = scalar.constant 0.001953125 : f32
  %hstep = scalar.constant 2.0 : f32
  %lstep = scalar.constant 0.00390625 : f32
  %a = scalar.mulf %pf, %pstep : f32
  %b = scalar.mulf %hf, %hstep : f32
  %c = scalar.mulf %lf, %lstep : f32
  %ab = scalar.addf %a, %b : f32
  %value = scalar.addf %ab, %c : f32
  %half = scalar.fptrunc %value : f32 to f16
  %zero = scalar.constant 0.0 : f32
  %zero16 = scalar.fptrunc %zero : f32 to f16
  view.store %zero16, %keys[%p, %head, %lane] : f16, view<1024x4x256xf16>
  view.store %half, %values[%p, %head, %lane] : f16, view<1024x4x256xf16>
  kernel.return
}


// A deterministic cache fixture, not a reference attention implementation.
// Zero keys give uniform weights; distinct physical values expose map/window bugs.
kernel.def @gated.fixture_cache() {
  %physical = index.constant 128 : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%physical, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%cache: buffer) {
  %p = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %key_origin = index.constant 16 : offset
  %value_origin = index.constant 32784 : offset
  %keys = buffer.view %cache[%key_origin] : buffer -> view<128x128xf16>
  %values = buffer.view %cache[%value_origin] : buffer -> view<128x128xf16>
  %zero = scalar.constant 0.0 : f32
  %zero16 = scalar.fptrunc %zero : f32 to f16
  %p32 = index.cast %p : index to i32
  %lane32 = index.cast %lane : index to i32
  %pf = scalar.uitofp %p32 : i32 to f32
  %lf = scalar.uitofp %lane32 : i32 to f32
  %pstep = scalar.constant 0.125 : f32
  %lstep = scalar.constant 0.00390625 : f32
  %a = scalar.mulf %pf, %pstep : f32
  %b = scalar.mulf %lf, %lstep : f32
  %v = scalar.addf %a, %b : f32
  %half = scalar.fptrunc %v : f32 to f16
  view.store %zero16, %keys[%p, %lane] : f16, view<128x128xf16>
  view.store %half, %values[%p, %lane] : f16, view<128x128xf16>
  kernel.return
}

    %cache = check.generate.fill value(23.0) : tensor<32784xf16>
    %cache_prefix = check.tensor.view %cache offset(0) : tensor<32784xf16> -> tensor<8xf16>
    %cache_suffix = check.tensor.view %cache offset(65552) : tensor<32784xf16> -> tensor<8xf16>
    %storage = check.generate.fill value(123.5) : tensor<776xf32>
    %output = check.tensor.view %storage offset(16) : tensor<776xf32> -> tensor<3x256xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<776xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(3088) : tensor<776xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %output offset(2048) : tensor<3x256xf32> -> tensor<256xf32>
    check.compare<@gated.local, @gated.expected.local>(%epoch, %map, %query, %gate, %cache, %output) : (tensor<5xi32>, tensor<2xi32>, tensor<3x256xf32>, tensor<3x2xf32>, tensor<32784xf16>, tensor<3x256xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00002) rtol(0.00002) nan(same) : tensor<3x256xf32>, tensor<3x256xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<256xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%cache) expected(%cache) : tensor<32784xf16>
      check.expect.bitwise actual(%cache_prefix) expected(%cache_prefix) : tensor<8xf16>
      check.expect.bitwise actual(%cache_suffix) expected(%cache_suffix) : tensor<8xf16>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<5xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<2xi32>
      check.expect.bitwise actual(%query) expected(%query) : tensor<3x256xf32>
      check.expect.bitwise actual(%gate) expected(%gate) : tensor<3x2xf32>
    }
  }
  check.return

// Independent uniform-attention oracle: the fixture's keys are zero, so every
// included logical token has equal weight. No production softmax/map helpers.
func.def @gated.expected(%window: index, %epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %key_origin = index.constant 16 : offset
  %value_origin = index.constant 32784 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %width = index.constant 128 : index
  %page = index.constant 64 : index
  %zero_f = scalar.constant 0.0 : f32
  %zero64 = scalar.constant 0.0 : f64
  %pstep = scalar.constant 0.125 : f32
  %lstep = scalar.constant 0.00390625 : f32
  %unit_f = scalar.constant 1.0 : f32
  %keys = buffer.view %cache[%key_origin] : buffer -> view<128x128xf16>
  %values = buffer.view %cache[%value_origin] : buffer -> view<128x128xf16>
  %zero16 = scalar.fptrunc %zero_f : f32 to f16
  scf.for %p = [%zero to %width step %one] {
    scf.for %lane = [%zero to %width step %one] {
      %p32 = index.cast %p : index to i32
      %l32 = index.cast %lane : index to i32
      %pf = scalar.uitofp %p32 : i32 to f32
      %lf = scalar.uitofp %l32 : i32 to f32
      %a = scalar.mulf %pf, %pstep : f32
      %b = scalar.mulf %lf, %lstep : f32
      %v = scalar.addf %a, %b : f32
      %half = scalar.fptrunc %v : f32 to f16
      view.store %zero16, %keys[%p, %lane] : f16, view<128x128xf16>
      view.store %half, %values[%p, %lane] : f16, view<128x128xf16>
    }
  }
  %out = buffer.view %output[%origin] : buffer -> view<3x2x128xf32>
  %gates = buffer.view %gate[%origin] : buffer -> view<3x2xf32>
  scf.for %row = [%zero to %three step %one] {
    %active = index.cmp ult, %row, %two : index
    %base = index.constant 63 : index
    %position = index.add %base, %row : index
    %end = index.add %position, %one : index
    %windowed = index.cmp ne, %window, %zero : index
    %low = index.sub %end, %window : index
    %begin = scf.select %windowed, %low, %zero : index
    %length = index.sub %end, %begin : index
    %len32 = index.cast %length : index to i32
    %divisor = scalar.uitofp %len32 : i32 to f64
    scf.for %head = [%zero to %two step %one] {
      scf.for %lane = [%zero to %width step %one] {
        %result = scf.if %active -> (f32) {
          %sum = scf.for %logical = [%begin to %end step %one](%acc = %zero64 : f64) -> (f64) {
            // Input map is [1,0], hence a64-token rotation of physical slots.
            %shifted = index.add %logical, %page : index
            %physical = index.rem %shifted, %width : index
            %half = view.load %values[%physical, %lane] : view<128x128xf16> -> f16
            %v = scalar.extf %half : f16 to f64
            %next = scalar.addf %acc, %v : f64
            scf.yield %next : f64
          }
          %mean64 = scalar.divf %sum, %divisor : f64
          %mean = scalar.fptrunc %mean64 : f64 to f32
          %logit = view.load %gates[%row, %head] : view<3x2xf32> -> f32
          %negative = scalar.negf %logit : f32
          %ex = scalar.expf %negative : f32
          %denom = scalar.addf %unit_f, %ex : f32
          %sigmoid = scalar.divf %unit_f, %denom : f32
          %value = scalar.mulf %mean, %sigmoid : f32
          scf.yield %value : f32
        } else { scf.yield %zero_f : f32 }
        view.store %result, %out[%row, %head, %lane] : f32, view<3x2x128xf32>
      }
    }
  }
  func.return
}
command.decl @gated.global() launch(%epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer)
func.def @gated.expected.global(%epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %window = index.constant 0 : index
  func.call @gated.expected(%window, %epoch, %map, %query, %gate, %cache, %output) : (index, buffer, buffer, buffer, buffer, buffer, buffer) -> ()
  func.return
}
check.scenario @gated.global.page_boundary {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.iota offset(2) step(61) : tensor<5xi32>
    %map = check.generate.iota offset(1) step(-1) : tensor<2xi32>
    %query = check.generate.iota offset(-0.5) step(0.001953125) : tensor<3x256xf32>
    %gate = check.generate.iota offset(-1.0) step(1.0) : tensor<3x2xf32>
    %cache = check.generate.fill value(23.0) : tensor<32784xf16>
    %cache_prefix = check.tensor.view %cache offset(0) : tensor<32784xf16> -> tensor<8xf16>
    %cache_suffix = check.tensor.view %cache offset(65552) : tensor<32784xf16> -> tensor<8xf16>
    %storage = check.generate.fill value(123.5) : tensor<776xf32>
    %output = check.tensor.view %storage offset(16) : tensor<776xf32> -> tensor<3x256xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<776xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(3088) : tensor<776xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %output offset(2048) : tensor<3x256xf32> -> tensor<256xf32>
    check.compare<@gated.global, @gated.expected.global>(%epoch, %map, %query, %gate, %cache, %output) : (tensor<5xi32>, tensor<2xi32>, tensor<3x256xf32>, tensor<3x2xf32>, tensor<32784xf16>, tensor<3x256xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00002) rtol(0.00002) nan(same) : tensor<3x256xf32>, tensor<3x256xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<256xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%cache) expected(%cache) : tensor<32784xf16>
      check.expect.bitwise actual(%cache_prefix) expected(%cache_prefix) : tensor<8xf16>
      check.expect.bitwise actual(%cache_suffix) expected(%cache_suffix) : tensor<8xf16>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<5xi32>
      check.expect.bitwise actual(%map) expected(%map) : tensor<2xi32>
      check.expect.bitwise actual(%query) expected(%query) : tensor<3x256xf32>
      check.expect.bitwise actual(%gate) expected(%gate) : tensor<3x2xf32>
    }
  }
  check.return
}
command.decl @gated.local() launch(%epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer)
func.def @gated.expected.local(%epoch: buffer, %map: buffer, %query: buffer, %gate: buffer, %cache: buffer, %output: buffer) {
  %window = index.constant 2 : index
  func.call @gated.expected(%window, %epoch, %map, %query, %gate, %cache, %output) : (index, buffer, buffer, buffer, buffer, buffer, buffer) -> ()

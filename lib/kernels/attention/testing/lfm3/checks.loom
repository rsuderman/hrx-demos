// Independent scalar host RMS/rotation oracle. No device template calls.
func.def @factored.qk.expected(%use_factors: i1, %step: f32, %epoch: buffer, %input: buffer, %gamma: buffer, %factors: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %h = index.constant 128 : index
  %half = index.constant 64 : index
  %width = index.constant 256 : index
  %zero_f = scalar.constant 0.0 : f32
  %divisor = scalar.constant 128.0 : f32
  %epsilon = scalar.constant 0.00001 : f32
  %input_view = buffer.view %input[%origin] : buffer -> view<3x256xf32>
  %weights = buffer.view %gamma[%origin] : buffer -> view<128xf32>
  %divisors = buffer.view %factors[%origin] : buffer -> view<64xf32>
  %out = buffer.view %output[%origin] : buffer -> view<3x256xf32>
  %descriptor = buffer.view %epoch[%origin] : buffer -> view<5xi32>
  %n32 = view.load %descriptor[0] : view<5xi32> -> i32
  %base32 = view.load %descriptor[1] : view<5xi32> -> i32
  %n = index.cast %n32 : i32 to index
  scf.for %row = [%zero to %three step %one] {
    %live = index.cmp ult, %row, %n : index
    scf.for %head = [%zero to %two step %one] {
      %head_base = index.mul %head, %h : index
      %sum = scf.if %live -> (f32) {
        %total = scf.for %lane = [%zero to %h step %one](%acc = %zero_f : f32) -> (f32) {
          %element = index.add %head_base, %lane : index
          %x = view.load %input_view[%row, %element] : view<3x256xf32> -> f32
          %square = scalar.mulf %x, %x : f32
          %next = scalar.addf %acc, %square : f32
          scf.yield %next : f32
        }
        scf.yield %total : f32
      } else { scf.yield %zero_f : f32 }
      %mean = scalar.divf %sum, %divisor : f32
      %stable = scalar.addf %mean, %epsilon : f32
      %inverse = scalar.rsqrtf %stable : f32
      scf.for %lane = [%zero to %h step %one] {
        %element = index.add %head_base, %lane : index
        %result = scf.if %live -> (f32) {
          %low = index.cmp ult, %lane, %half : index
          %pair = index.rem %lane, %half : index
          %partner_lane = scf.if %low -> (index) {
            %next = index.add %lane, %half : index
            scf.yield %next : index
          } else { scf.yield %pair : index }
          %partner = index.add %head_base, %partner_lane : index
          %a = view.load %input_view[%row, %element] : view<3x256xf32> -> f32
          %b = view.load %input_view[%row, %partner] : view<3x256xf32> -> f32
          %ga = view.load %weights[%lane] : view<128xf32> -> f32
          %gb = view.load %weights[%partner_lane] : view<128xf32> -> f32
          %na = scalar.mulf %a, %inverse : f32
          %nb = scalar.mulf %b, %inverse : f32
          %x = scalar.mulf %na, %ga : f32
          %y = scalar.mulf %nb, %gb : f32
          %pair32 = index.cast %pair : index to i32
          %pf = scalar.uitofp %pair32 : i32 to f32
          %log = scalar.mulf %pf, %step : f32
          %frequency = scalar.expf %log : f32
          %row32 = index.cast %row : index to i32
          %pos32 = scalar.addi %base32, %row32 : i32
          %position = scalar.uitofp %pos32 : i32 to f32
          %raw_angle = scalar.mulf %position, %frequency : f32
          %factor = scf.if %use_factors -> (f32) {
            %v = view.load %divisors[%pair] : view<64xf32> -> f32
            scf.yield %v : f32
          } else {
            %unit = scalar.constant 1.0 : f32
            scf.yield %unit : f32
          }
          %angle = scalar.divf %raw_angle, %factor : f32
          %sine = scalar.sinf %angle : f32
          %cosine = scalar.cosf %angle : f32
          %own = scalar.mulf %x, %cosine : f32
          %other = scalar.mulf %y, %sine : f32
          %rotated = scf.if %low -> (f32) {
            %v = scalar.subf %own, %other : f32
            scf.yield %v : f32
          } else {
            %v = scalar.addf %own, %other : f32
            scf.yield %v : f32
          }
          scf.yield %rotated : f32
        } else { scf.yield %zero_f : f32 }
        view.store %result, %out[%row, %element] : f32, view<3x256xf32>
      }
    }
  }
  func.return
}
command.decl @factored.qk.global() launch(%epoch: buffer, %input: buffer, %gamma: buffer, %factors: buffer, %output: buffer)
func.def @factored.qk.expected.global(%epoch: buffer, %input: buffer, %gamma: buffer, %factors: buffer, %output: buffer) {
  %flag = scalar.constant true : i1
  %step = scalar.constant -0.21586735546588898 : f32
  func.call @factored.qk.expected(%flag, %step, %epoch, %input, %gamma, %factors, %output) : (i1, f32, buffer, buffer, buffer, buffer, buffer) -> ()
  func.return
}
check.scenario @factored.qk.global_case {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.iota offset(2) step(15) : tensor<5xi32>
    %input = check.generate.iota offset(-0.75) step(0.00390625) : tensor<3x256xf32>
    %gamma = check.generate.iota offset(0.75) step(0.001953125) : tensor<128xf32>
    %factors = check.generate.iota offset(1.0) step(0.125) : tensor<64xf32>
    %storage = check.generate.fill value(123.5) : tensor<776xf32>
    %output = check.tensor.view %storage offset(16) : tensor<776xf32> -> tensor<3x256xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<776xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(3088) : tensor<776xf32> -> tensor<4xf32>
    %inactive = check.tensor.view %output offset(2048) : tensor<3x256xf32> -> tensor<256xf32>
    check.compare<@factored.qk.global, @factored.qk.expected.global>(%epoch, %input, %gamma, %factors, %output) : (tensor<5xi32>, tensor<3x256xf32>, tensor<128xf32>, tensor<64xf32>, tensor<3x256xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00002) rtol(0.0001) nan(same) : tensor<3x256xf32>, tensor<3x256xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<256xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<3x256xf32>
      check.expect.bitwise actual(%gamma) expected(%gamma) : tensor<128xf32>
      check.expect.bitwise actual(%factors) expected(%factors) : tensor<64xf32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<5xi32>
    }
  }
  check.return
}
command.decl @factored.qk.local() launch(%epoch: buffer, %input: buffer, %gamma: buffer, %factors: buffer, %output: buffer)
func.def @factored.qk.expected.local(%epoch: buffer, %input: buffer, %gamma: buffer, %factors: buffer, %output: buffer) {
  %flag = scalar.constant false : i1
  %step = scalar.constant -0.14391157031059265 : f32
  func.call @factored.qk.expected(%flag, %step, %epoch, %input, %gamma, %factors, %output) : (i1, f32, buffer, buffer, buffer, buffer, buffer) -> ()
  func.return
}

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.loom"]))

# Preserve the legacy row-codec closure; epoch composition has its own helpers.
filegroup(
    name = "all_sources",
    srcs = glob(
        ["*.loom"],
        exclude = [
            "epoch_f32.loom",
            "storage.loom",
            "ordinary_f32.loom",
            "gather_f32.loom",
        ],
    ),
)

_ROW_CODEC_SOURCES = [
    "q4k_rows.loom",
    "q5k_rows.loom",
    "q6k_rows.loom",
    "q8_0_rows.loom",
    "storage.loom",
    "//lib/kernels/projection:block32_sources",
    "//lib/kernels/projection:q4k.loom",
    "//lib/kernels/projection:q5k_codec.loom",
    "//lib/kernels/projection:qk_common.loom",
]

filegroup(
    name = "epoch_f32_sources",
    srcs = _ROW_CODEC_SOURCES + [
        "epoch_f32.loom",
        "//lib/kernels/epoch:active_rows.loom",
    ],
)

filegroup(
    name = "ordinary_f32_sources",
    srcs = _ROW_CODEC_SOURCES + [
        "ordinary_f32.loom",
        "//lib/kernels/epoch:active_rows.loom",
    ],
)

filegroup(
    name = "gather_f32_sources",
    srcs = _ROW_CODEC_SOURCES + ["gather_f32.loom"],
)

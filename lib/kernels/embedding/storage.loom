// Command-time encoding and signed-extent admission shared by F32 gathers.
template.decl @llm.embedding.block_bytes(%tag: index) -> (index)

template.def<@llm.embedding.block_bytes> @llm_embedding_q8_bytes(%tag: index) -> (index) where [eq(%tag, 8)] {
  %bytes = index.constant 34 : index
  template.return %bytes : index
}

template.def<@llm.embedding.block_bytes> @llm_embedding_q4k_bytes(%tag: index) -> (index) where [eq(%tag, 12)] {
  %bytes = index.constant 144 : index
  template.return %bytes : index
}

template.def<@llm.embedding.block_bytes> @llm_embedding_q5k_bytes(%tag: index) -> (index) where [eq(%tag, 13)] {
  %bytes = index.constant 176 : index
  template.return %bytes : index
}

template.def<@llm.embedding.block_bytes> @llm_embedding_q6k_bytes(%tag: index) -> (index) where [eq(%tag, 14)] {
  %bytes = index.constant 210 : index
  template.return %bytes : index
}

template.decl @llm.embedding.bounded_extent(%value: index, %limit: index)

template.def<@llm.embedding.bounded_extent> @llm_embedding_bounded_extent(%value: index, %limit: index) where [le(%value, %limit)] {
  template.return
}

template.decl @llm.embedding.exact_extent(%actual: index, %expected: index)

template.def<@llm.embedding.exact_extent> @llm_embedding_exact_extent(%actual: index, %expected: index) where [eq(%actual, %expected)] {
  template.return
}

template.decl @llm.embedding.table_contract(%rows: index, %hidden: index, %vocabulary: index, %tag: index, %weight_bytes: index)

template.decl @llm.embedding.row_geometry(%hidden: index, %tag: index)

template.def<@llm.embedding.row_geometry> @llm_embedding_f16_geometry(%hidden: index, %tag: index) where [eq(%tag, 1), range(%hidden, 32, 32768)] {
  template.return
}

template.def<@llm.embedding.row_geometry> @llm_embedding_q8_geometry(%hidden: index, %tag: index) where [eq(%tag, 8), range(%hidden, 32, 32768), multiple_of(%hidden, 32)] {
  template.return
}

template.def<@llm.embedding.row_geometry> @llm_embedding_k_geometry(%hidden: index, %tag: index) where [range(%tag, 12, 14), ge(%hidden, 256), multiple_of(%hidden, 256)] {
  template.return
}

template.def<@llm.embedding.table_contract> @llm_embedding_table_contract(%rows: index, %hidden: index, %vocabulary: index, %tag: index, %weight_bytes: index) where [range(%rows, 1, 2048), ge(%hidden, 32), range(%vocabulary, 1, 2147483648)] {
  template.apply<@llm.embedding.row_geometry>(%hidden, %tag) : (index, index)
  %maximum = index.constant 9223372036854775807 : index
  %word = index.constant 4 : index
  %f16_tag = index.constant 1 : index
  %f16 = index.cmp eq, %tag, %f16_tag : index
  scf.if %f16 {
    %half_bytes = index.constant 2 : index
    %hidden_byte_limit = index.div %maximum, %half_bytes : index
    template.apply<@llm.embedding.bounded_extent>(%hidden, %hidden_byte_limit) : (index, index)
    %stride = index.mul %hidden, %half_bytes : index
    %vocabulary_limit = index.div %maximum, %stride : index
    template.apply<@llm.embedding.bounded_extent>(%vocabulary, %vocabulary_limit) : (index, index)
    %expected = index.mul %vocabulary, %stride : index
    template.apply<@llm.embedding.exact_extent>(%weight_bytes, %expected) : (index, index)
  } else {
    %q8_tag = index.constant 8 : index
    %q8 = index.cmp eq, %tag, %q8_tag : index
    scf.if %q8 {
      %q8_limit = index.constant 32768 : index
      template.apply<@llm.embedding.bounded_extent>(%hidden, %q8_limit) : (index, index)
    }
    %small_block = index.constant 32 : index
    %large_block = index.constant 256 : index
    %block_values = scf.select %q8, %small_block, %large_block : index
    %block_bytes = template.apply<@llm.embedding.block_bytes>(%tag) : (index) -> (index)
    %blocks = index.div %hidden, %block_values : index
    %block_limit = index.div %maximum, %block_bytes : index
    template.apply<@llm.embedding.bounded_extent>(%blocks, %block_limit) : (index, index)
    %stride = index.mul %blocks, %block_bytes : index
    %vocabulary_limit = index.div %maximum, %stride : index
    template.apply<@llm.embedding.bounded_extent>(%vocabulary, %vocabulary_limit) : (index, index)
    %expected = index.mul %vocabulary, %stride : index
    template.apply<@llm.embedding.exact_extent>(%weight_bytes, %expected) : (index, index)
  }
  %element_limit = index.div %maximum, %word : index
  %hidden_limit = index.div %element_limit, %rows : index
  template.apply<@llm.embedding.bounded_extent>(%hidden, %hidden_limit) : (index, index)
  template.return
}

template.decl @llm.token_embedding_q4k_f32.row(%hidden: index, %row_bytes: index, %token: i32, %output_origin: offset, %weight: buffer, %output: buffer)

template.decl @llm.token_embedding_q5k_f32.row(%hidden: index, %row_bytes: index, %token: i32, %output_origin: offset, %weight: buffer, %output: buffer)

template.decl @llm.token_embedding_q6k_f32.row(%hidden: index, %row_bytes: index, %token: i32, %output_origin: offset, %weight: buffer, %output: buffer)

template.decl @llm.token_embedding_q8_0_f32.row(%hidden: index, %token: i32, %output_origin: offset, %scale: f32, %weight: buffer, %output: buffer)

template.decl @llm.token_embedding_f16_f32.row(%hidden: index, %token: i32, %output_origin: offset, %weight: buffer, %output: buffer)

template.decl @llm.embedding.decode_f32_row(%hidden: index, %tag: index, %token: i32, %output_origin: offset, %weight: buffer, %output: buffer)

template.def<@llm.embedding.decode_f32_row> device @llm_embedding_decode_f32_row(%hidden: index, %tag: index, %token: i32, %output_origin: offset, %weight: buffer, %output: buffer) {
  %f16_tag = index.constant 1 : index
  %f16 = index.cmp eq, %tag, %f16_tag : index
  scf.if %f16 {
    %f16_hidden = index.assume %hidden [range(%hidden, 32, 32768)] : index
    template.apply<@llm.token_embedding_f16_f32.row>(%f16_hidden, %token, %output_origin, %weight, %output) : (index, i32, offset, buffer, buffer)
  } else {
    %q8_tag = index.constant 8 : index
    %q8 = index.cmp eq, %tag, %q8_tag : index
    scf.if %q8 {
      // The command table contract admits this geometry. Epoch kernels forward
      // hidden as a runtime argument, so retain its facts for the device template.
      %q8_hidden = index.assume %hidden [range(%hidden, 32, 32768), multiple_of(%hidden, 32)] : index
      %scale = scalar.constant 1.0 : f32
      template.apply<@llm.token_embedding_q8_0_f32.row>(%q8_hidden, %token, %output_origin, %scale, %weight, %output) : (index, i32, offset, f32, buffer, buffer)
    } else {
      %k_hidden = index.assume %hidden [ge(%hidden, 256), multiple_of(%hidden, 256)] : index
      %q4_tag = index.constant 12 : index
      %q5_tag = index.constant 13 : index
      %q4 = index.cmp eq, %tag, %q4_tag : index
      %q5 = index.cmp eq, %tag, %q5_tag : index
      %q4_bytes = index.constant 144 : index
      %q5_bytes = index.constant 176 : index
      %q6_bytes = index.constant 210 : index
      %other_bytes = scf.select %q5, %q5_bytes, %q6_bytes : index
      %block_bytes = scf.select %q4, %q4_bytes, %other_bytes : index
      %block_values = index.constant 256 : index
      %blocks = index.div %k_hidden, %block_values : index
      %row_bytes = index.mul %blocks, %block_bytes : index
      scf.if %q4 {
        template.apply<@llm.token_embedding_q4k_f32.row>(%k_hidden, %row_bytes, %token, %output_origin, %weight, %output) : (index, index, i32, offset, buffer, buffer)
      } else {
        scf.if %q5 {
          template.apply<@llm.token_embedding_q5k_f32.row>(%k_hidden, %row_bytes, %token, %output_origin, %weight, %output) : (index, index, i32, offset, buffer, buffer)
        } else {
          template.apply<@llm.token_embedding_q6k_f32.row>(%k_hidden, %row_bytes, %token, %output_origin, %weight, %output) : (index, index, i32, offset, buffer, buffer)
        }
      }
    }
  }
  template.return
}

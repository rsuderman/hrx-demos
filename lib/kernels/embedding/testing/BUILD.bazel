load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools:loom_merge.bzl", "loom_merge")
load("//build_tools:loom_testing.bzl", "loom_provider_checks")

loom_test(
    name = "q4k_rows_test",
    srcs = [
        "q4k_checks.loom",
        "//lib/kernels/embedding:q4k_rows.loom",
        "//lib/kernels/embedding:q6k_rows.loom",
        "//lib/kernels/projection:q4k.loom",
        "//lib/kernels/projection:qk_common.loom",
        "//lib/kernels/quantization:q8_1_x4.loom",
        "//lib/kernels/qwen:output/embedding.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
)

loom_test(
    name = "f32_execution_test",
    srcs = [
        "f32_checks.loom",
        "f32_programs.loom",
        "//lib/kernels/embedding:f32.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
)

[loom_merge(
    name = "q8_0_provider_" + format,
    testonly = True,
    srcs = [
        "//lib/kernels/embedding:q8_0_rows.loom",
        "//lib/kernels/projection:block32_sources",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "q8_0_rows_" + format + "_test",
    srcs = [
        "q8_0_checks.loom",
        ":q8_0_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

[loom_merge(
    name = "q5k_provider_" + format,
    testonly = True,
    srcs = [
        "//lib/kernels/decoder:implementation_sources",
        "//lib/kernels/embedding:epoch_f32_sources",
        "//lib/kernels/embedding:ordinary_f32_sources",
    ],
    output_format = format,
) for format in [
    "text",
    "bc",
]]

[loom_test(
    name = "q5k_rows_" + format + "_test",
    srcs = [
        "q5k_checks.loom",
        ":q5k_provider_" + format,
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
) for format in [
    "text",
    "bc",
]]

loom_provider_checks(
    name = "epoch_contract",
    checks = [":epoch_contract_checks"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    provider_name = "epoch_contract_provider",
    provider_srcs = [
        "//lib/kernels/embedding:ordinary_f32_sources",
        "//lib/kernels/embedding:epoch_f32_sources",
        "//lib/platforms/amdgpu/gfx11:targets.loom",
    ],
)

genrule(
    name = "epoch_contract_checks",
    testonly = True,
    srcs = [
        "epoch_contract_fixtures.py",
        "epoch_contract_core.loom.in",
    ],
    outs = ["generated_epoch_contract_checks.loom"],
    cmd = "python3 $(location epoch_contract_fixtures.py) $(location epoch_contract_core.loom.in) $@",
)

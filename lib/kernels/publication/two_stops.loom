func.def public pure inline @llm.publication.map_two_stops(%token: i32, %first_stop: i32, %second_stop: i32, %terminal: i32) -> (i32) {
  %a = scalar.cmpi eq, %token, %first_stop : i32
  %b = scalar.cmpi eq, %token, %second_stop : i32
  %stop = scalar.ori %a, %b : i1
  %mapped = scf.select %stop, %terminal, %token : i32
  func.return %mapped : i32
}

func.def public pure inline @llm.publication.map_one_stop(%token: i32, %source_stop: i32, %terminal: i32) -> (i32) {
  %stop = scalar.cmpi eq, %token, %source_stop : i32
  %mapped = scf.select %stop, %terminal, %token : i32
  func.return %mapped : i32
}

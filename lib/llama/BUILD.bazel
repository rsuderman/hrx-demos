load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
        "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
        "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    })

iree_cc_library(
    name = "ffn_structure",
    srcs = ["detail/ffn_structure.cc"],
    hdrs = ["detail/ffn_structure.h"],
    cxxopts = _CXXOPTS,
    deps = [
        ":structure",
        "//lib/operations:operation_graph",
        "//tools/model:model_types",
    ],
)

iree_cc_library(
    name = "structure",
    srcs = ["structure.cc"],
    hdrs = ["structure.h", "detail/structure_construction.h"],
    cxxopts = _CXXOPTS,
    deps = ["//lib/operations:operation_graph", "//tools/model:model_types"],
)

iree_cc_library(
    name = "embedding_structure",
    srcs = ["detail/embedding_structure.cc"],
    hdrs = ["detail/embedding_structure.h"],
    cxxopts = _CXXOPTS,
    deps = [":structure", "//lib/operations:operation_graph", "//tools/model:model_types"],
)

iree_cc_library(
    name = "attention_structure",
    srcs = ["detail/attention_structure.cc"],
    hdrs = ["detail/attention_structure.h"],
    cxxopts = _CXXOPTS,
    deps = [":structure", "//lib/operations:operation_graph", "//tools/model:model_types"],
)

iree_cc_library(
    name = "model_structure",
    srcs = ["detail/model_structure.cc"],
    cxxopts = _CXXOPTS,
    deps = [":structure", ":embedding_structure", ":attention_structure", ":ffn_structure", "//lib/operations:tensor_operations", "//lib/operations:attention_operations", "//lib/operations:ffn_operations", "//lib/operations:control_operations"],
)
iree_cc_library(
    name = "program",
    srcs = ["program.cc"], hdrs = ["program.h"],
    cxxopts = _CXXOPTS,
    deps = [":model_structure", ":structure", "//lib/dispatch:parameters", "//lib/dispatch:invocation", "//lib/dispatch:registry"],
)

exports_files(glob(["programs/*.loom"]))
filegroup(name = "maintained_program_sources", srcs = glob(["programs/*.loom"]) + ["//lib/programs/ffn:interface.loom", "//lib/programs/ffn:ffn.loom"])

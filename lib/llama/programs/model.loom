config.decl @llama.model.hidden_size : index
config.decl @llama.model.vocabulary_size : index
config.decl @llama.model.layer_count : index
config.decl @llama.model.embedding_weight_bytes : index
config.decl @llama.model.output_weight_bytes : index
command.program.decl @loomify.llama.layer(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %map: buffer, %cache: buffer)
kernel.decl @llama32_head_count() launch(%kind: index, %origin: offset, %packet: buffer, %count: buffer)

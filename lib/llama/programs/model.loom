kernel.decl @llama32_finish_isolated() launch(%kind: index, %raw: buffer, %control: buffer, %history: buffer, %progress: buffer)
template.decl @llm.output.last_greedy(%capacity: index, %begin: index, %origin: offset, %hidden: index, %vocab: index, %weight_bytes: index, %q8_bytes: offset, %logit_bytes: offset, %partial_bytes: offset, %input: buffer, %control: buffer, %gamma: view<[%hidden]xf32>, %weight: view<[%weight_bytes]xi8>, %normalized: buffer, %token: buffer)

command.program.def @loomify.llama.model(%phase: index, %rows: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %map: buffer, %cache: buffer, %history: buffer, %progress: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero_offset = index.constant 0 : offset
  %word = index.constant 4 : offset
  %count_bytes = index.constant 12 : offset
  %count = buffer.alloca<global> align(256) %count_bytes : buffer
  kernel.launch @llama32_head_count[](%phase, %zero_offset, %control, %count) : [](index, offset, buffer, buffer)
  %embedding_bytes = config.get @llama.model.embedding_weight_bytes : index
  %embedding = command.parameter %parameters, "token_embd.weight" : view<[%embedding_bytes]xi8>
  kernel.launch @llama32_token_embedding_active_q6k_f32[%rows](%rows, %zero, %zero_offset, %count, %history, %embedding, %residual) : [index](index, index, offset, buffer, buffer, view<[%embedding_bytes]xi8>, buffer)
  %layers = config.get @llama.model.layer_count : index
  scf.for %layer = [%zero to %layers step %one] unroll {
    command.program.launch @loomify.llama.layer[%layer, %phase, %rows](%parameters, %residual, %control, %map, %cache) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
  }
  %hidden = config.get @llama.model.hidden_size : index
  %vocab = config.get @llama.model.vocabulary_size : index
  %output_bytes = config.get @llama.model.output_weight_bytes : index
  %gamma = command.parameter %parameters, "output_norm.weight" : view<[%hidden]xf32>
  %weight = command.parameter %parameters, "token_embd.weight" : view<[%output_bytes]xi8>
  %normalized_bytes = index.scale %hidden, %word : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %normalized_bytes : buffer
  %token = buffer.alloca<global> align(256) %word : buffer
  %group = index.constant 128 : index
  %packed_group_bytes = index.constant 144 : offset
  %groups = index.div %hidden, %group : index
  %q8_bytes = index.scale %groups, %packed_group_bytes : index, offset -> offset
  %logit_bytes = index.scale %vocab, %word : index, offset -> offset
  %tile = index.constant 4096 : index
  %tile_minus_one = index.constant 4095 : index
  %rounded = index.add %vocab, %tile_minus_one : index
  %parts = index.div %rounded, %tile : index
  %partial_bytes = index.scale %parts, %word : index, offset -> offset
  template.apply<@llm.output.last_greedy>(%rows, %zero, %zero_offset, %hidden, %vocab, %output_bytes, %q8_bytes, %logit_bytes, %partial_bytes, %residual, %count, %gamma, %weight, %normalized, %token) : (index, index, offset, index, index, index, offset, offset, offset, buffer, buffer, view<[%hidden]xf32>, view<[%output_bytes]xi8>, buffer, buffer)
  kernel.launch @llama32_finish_isolated[](%phase, %token, %control, %history, %progress) : [](index, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @generated.llama_prefill() launch(%parameters: buffer, %residual: buffer, %control: buffer, %map: buffer, %cache: buffer, %tokens_history: buffer, %progress: buffer) {
  %phase = index.constant 0 : index
  %rows = config.get @runner.llama32.prefill_token_count : index
  command.program.launch @loomify.llama.model[%phase, %rows](%parameters, %residual, %control, %map, %cache, %tokens_history, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
command.program.def public @generated.llama_decode() launch(%parameters: buffer, %residual: buffer, %control: buffer, %map: buffer, %cache: buffer, %tokens_history: buffer, %progress: buffer) {
  %phase = index.constant 1 : index
  %rows = index.constant 1 : index
  command.program.launch @loomify.llama.model[%phase, %rows](%parameters, %residual, %control, %map, %cache, %tokens_history, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)

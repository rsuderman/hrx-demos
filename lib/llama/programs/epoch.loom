// Native packet adapter. Continuations still enter the configured prefill root.
config.decl @runner.llama32.prefill_token_count : index
command.program.decl @generated.llama_prefill() launch(%parameters: buffer, %residual: buffer, %control: buffer, %map: buffer, %cache: buffer, %history: buffer, %progress: buffer)
kernel.decl @loomify_epoch_unpack(%capacity: index) launch(%capacity: index, %metadata: buffer, %input: buffer, %control: buffer, %history: buffer, %progress: buffer)
kernel.decl @loomify_epoch_scatter() launch(%metadata: buffer, %history: buffer, %output: buffer)
command.program.def public @generated.llama_epoch() launch(%parameters: buffer, %residual: buffer, %metadata: buffer, %map: buffer, %cache: buffer, %input_ids: buffer, %output_ids: buffer) {
  %rows = config.get @runner.llama32.prefill_token_count : index
  %minimum_history = index.constant 129 : index
  %larger = index.cmp ugt, %rows, %minimum_history : index
  %history_capacity = scf.select %larger, %rows, %minimum_history : index
  %word = index.constant 4 : offset
  %history_bytes = index.scale %history_capacity, %word : index, offset -> offset
  %control_bytes = index.constant 12 : offset
  %progress_bytes = index.constant 32 : offset
  %control = buffer.alloca<global> align(256) %control_bytes : buffer
  %history = buffer.alloca<global> align(256) %history_bytes : buffer
  %progress = buffer.alloca<global> align(256) %progress_bytes : buffer
  kernel.launch @loomify_epoch_unpack[%rows](%rows, %metadata, %input_ids, %control, %history, %progress) : [index](index, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @generated.llama_prefill[](%parameters, %residual, %control, %map, %cache, %history, %progress) : [](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @loomify_epoch_scatter[](%metadata, %history, %output_ids) : [](buffer, buffer, buffer)
  command.return
}

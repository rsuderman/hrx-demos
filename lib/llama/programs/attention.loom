// Maintained decoder attention sequence. Numerical providers own arithmetic,
// active-row guards, mapped cache addressing and precision-policy selection.
config.decl @llama.model.hidden_size : index
config.decl @llama.model.kv_size : index
config.decl @llama.attention.cache_base : offset
config.decl @llama.attention.map_origin : offset
func.decl pure @loomify.config.layer_attention(%layer: index) -> (index, index, index, index, index, index, index, index)

kernel.decl @ggml_quantize_q8_1_x4_qk_compat_f32(%rows: index, %input_size: index) launch(%rows: index, %input_size: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count_view: buffer, %input: buffer, %output: buffer)
kernel.decl @ggml_linear_q4k_q8_1_x4_compat(%rows: index, %input_size: index, %output_size: index) launch(%rows: index, %input_size: index, %output_size: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count_view: buffer, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @ggml_linear_q6k_q8_1_x4_compat(%rows: index, %input_size: index, %output_size: index) launch(%rows: index, %input_size: index, %output_size: index, %row_origin: index, %fixed_count: i32, %count_origin: offset, %count_view: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @llama32_rotary_query(%token_capacity0: index) launch(%control_kind: index, %control_origin: offset, %token_begin: index, %control: buffer, %factors: buffer, %projection: buffer, %query: buffer)
kernel.decl @llama32_publish_kv(%token_capacity0: index) launch(%layer0: index, %cache_base: offset, %control_kind: index, %control_origin: offset, %token_begin: index, %map_origin: offset, %control: buffer, %map: buffer, %factors: buffer, %key: buffer, %value: buffer, %cache: buffer)
kernel.decl @llama32_attention_rows(%token_capacity0: index) launch(%layer0: index, %cache_base: offset, %control_kind: index, %control_origin: offset, %token_begin: index, %map_origin: offset, %control: buffer, %map: buffer, %query: buffer, %cache: buffer, %output: buffer)
kernel.decl @llama32_attention_residual(%token_capacity0: index) launch(%control_kind: index, %control_origin: offset, %token_begin: index, %control: buffer, %projected: buffer, %residual: buffer)

// Encoding is selected from admitted GGML metadata, never from payload size.
template.decl @loomify.llama.attention.project(%rows: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %count: buffer, %packed: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer)
template.def<@loomify.llama.attention.project> @loomify_llama_attention_project(%rows: index, %input_width: index, %output_width: index, %tag: index, %weight_bytes: index, %count: buffer, %packed: buffer, %weight: view<[%weight_bytes]xi8>, %output: buffer) {
  %zero = index.constant 0 : index
  %origin = index.constant 0 : offset
  %dynamic = scalar.constant -1 : i32
  %q4 = index.constant 12 : index
  %is_q4 = index.cmp eq, %tag, %q4 : index
  scf.if %is_q4 {
    kernel.launch @ggml_linear_q4k_q8_1_x4_compat[%rows, %input_width, %output_width](%rows, %input_width, %output_width, %zero, %dynamic, %origin, %count, %packed, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
  } else {
    kernel.launch @ggml_linear_q6k_q8_1_x4_compat[%rows, %input_width, %output_width](%rows, %input_width, %output_width, %zero, %dynamic, %origin, %count, %packed, %weight, %output) : [index, index, index](index, index, index, index, i32, offset, buffer, buffer, view<[%weight_bytes]xi8>, buffer)
  }
  template.return
}

command.program.def @loomify.llama.attention(%layer: index, %phase: index, %rows: index) launch(%parameters: buffer, %normalized: buffer, %residual: buffer, %count: buffer, %control: buffer, %map: buffer, %cache: buffer) where [range(%rows, 1, 512), range(%phase, 0, 1)] {
  %hidden = config.get @llama.model.hidden_size : index
  %kv = config.get @llama.model.kv_size : index
  %cache_base = config.get @llama.attention.cache_base : offset
  %map_origin = config.get @llama.attention.map_origin : offset
  %q_tag, %k_tag, %v_tag, %o_tag, %q_bytes, %k_bytes, %v_bytes, %o_bytes = func.call pure @loomify.config.layer_attention(%layer) : (index) -> (index, index, index, index, index, index, index, index)
  %q_weight = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<[%q_bytes]xi8>
  %k_weight = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<[%k_bytes]xi8>
  %v_weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<[%v_bytes]xi8>
  %o_weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<[%o_bytes]xi8>
  %factors = command.parameter %parameters, "rope_freqs.weight" : view<64xf32>
  %zero = index.constant 0 : index
  %origin = index.constant 0 : offset
  %dynamic = scalar.constant -1 : i32
  %four = index.constant 4 : offset
  %block = index.constant 128 : index
  %packed_block = index.constant 144 : offset
  %hidden_elements = index.mul %rows, %hidden : index
  %kv_elements = index.mul %rows, %kv : index
  %hidden_bytes = index.scale %hidden_elements, %four : index, offset -> offset
  %kv_bytes = index.scale %kv_elements, %four : index, offset -> offset
  %packed_blocks = index.div %hidden_elements, %block : index
  %packed_bytes = index.scale %packed_blocks, %packed_block : index, offset -> offset
  %packed = buffer.alloca<global> align(256) %packed_bytes : buffer
  %q = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %k = buffer.alloca<global> align(256) %kv_bytes : buffer
  %v = buffer.alloca<global> align(256) %kv_bytes : buffer
  %query = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %attended = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %attention_packed = buffer.alloca<global> align(256) %packed_bytes : buffer
  %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
  // Projection count is the layer's private snapshot, including during decode.
  kernel.launch @ggml_quantize_q8_1_x4_qk_compat_f32[%rows, %hidden](%rows, %hidden, %zero, %dynamic, %origin, %count, %normalized, %packed) : [index, index](index, index, index, i32, offset, buffer, buffer, buffer)
  template.apply<@loomify.llama.attention.project>(%rows, %hidden, %hidden, %q_tag, %q_bytes, %count, %packed, %q_weight, %q) : (index, index, index, index, index, buffer, buffer, view<[%q_bytes]xi8>, buffer)
  template.apply<@loomify.llama.attention.project>(%rows, %hidden, %kv, %k_tag, %k_bytes, %count, %packed, %k_weight, %k) : (index, index, index, index, index, buffer, buffer, view<[%k_bytes]xi8>, buffer)
  template.apply<@loomify.llama.attention.project>(%rows, %hidden, %kv, %v_tag, %v_bytes, %count, %packed, %v_weight, %v) : (index, index, index, index, index, buffer, buffer, view<[%v_bytes]xi8>, buffer)
  // Position-bearing operations retain the original runtime control packet.
  kernel.launch @llama32_rotary_query[%rows](%phase, %origin, %zero, %control, %factors, %q, %query) : [index](index, offset, index, buffer, view<64xf32>, buffer, buffer)
  kernel.launch @llama32_publish_kv[%rows](%layer, %cache_base, %phase, %origin, %zero, %map_origin, %control, %map, %factors, %k, %v, %cache) : [index](index, offset, index, offset, index, offset, buffer, buffer, view<64xf32>, buffer, buffer, buffer)
  // Publication precedes causal consumption; the provider clears inactive rows.
  kernel.launch @llama32_attention_rows[%rows](%layer, %cache_base, %phase, %origin, %zero, %map_origin, %control, %map, %query, %cache, %attended) : [index](index, offset, index, offset, index, offset, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @ggml_quantize_q8_1_x4_qk_compat_f32[%rows, %hidden](%rows, %hidden, %zero, %dynamic, %origin, %count, %attended, %attention_packed) : [index, index](index, index, index, i32, offset, buffer, buffer, buffer)
  template.apply<@loomify.llama.attention.project>(%rows, %hidden, %hidden, %o_tag, %o_bytes, %count, %attention_packed, %o_weight, %projected) : (index, index, index, index, index, buffer, buffer, view<[%o_bytes]xi8>, buffer)
  kernel.launch @llama32_attention_residual[%rows](%phase, %origin, %zero, %control, %projected, %residual) : [index](index, offset, index, buffer, buffer, buffer)
  command.return
}

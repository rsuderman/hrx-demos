config.decl @runner.llama32.prefill_token_count : index
command.program.decl @loomify.llama.layer(%layer:index,%phase:index,%rows:index) launch(%parameters:buffer,%residual:buffer,%control:buffer,%map:buffer,%cache:buffer)
command.program.def public @validated.layer0.prefill() launch(%parameters:buffer,%residual:buffer,%control:buffer,%map:buffer,%cache:buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.llama32.prefill_token_count : index
  command.program.launch @loomify.llama.layer[%layer,%phase,%rows](%parameters,%residual,%control,%map,%cache) : [index,index,index](buffer,buffer,buffer,buffer,buffer)
  command.return
}
command.program.def public @validated.layer0.decode() launch(%parameters:buffer,%residual:buffer,%control:buffer,%map:buffer,%cache:buffer) {
  %layer = index.constant 0 : index
  %phase = index.constant 1 : index
  %rows = index.constant 1 : index
  command.program.launch @loomify.llama.layer[%layer,%phase,%rows](%parameters,%residual,%control,%map,%cache) : [index,index,index](buffer,buffer,buffer,buffer,buffer)
  command.return
}
command.program.def public @validated.layer1.prefill() launch(%parameters:buffer,%residual:buffer,%control:buffer,%map:buffer,%cache:buffer) {
  %layer = index.constant 1 : index
  %phase = index.constant 0 : index
  %rows = config.get @runner.llama32.prefill_token_count : index
  command.program.launch @loomify.llama.layer[%layer,%phase,%rows](%parameters,%residual,%control,%map,%cache) : [index,index,index](buffer,buffer,buffer,buffer,buffer)
  command.return
}
command.program.def public @validated.layer1.decode() launch(%parameters:buffer,%residual:buffer,%control:buffer,%map:buffer,%cache:buffer) {
  %layer = index.constant 1 : index
  %phase = index.constant 1 : index
  %rows = index.constant 1 : index
  command.program.launch @loomify.llama.layer[%layer,%phase,%rows](%parameters,%residual,%control,%map,%cache) : [index,index,index](buffer,buffer,buffer,buffer,buffer)
  command.return
}

load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

# Deliver exact-pin facade bytes through the existing source-provider interface.
# Flattened names work when HRX is a downstream Bazel dependency.
iree_c_embed_data(
    name = "facade_headers",
    srcs = [
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/buffer.h",
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/cache.h",
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/encoding_type.h",
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/index.h",
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/kernel.h",
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/shape.h",
        "@hrx_system//loom/src/loom/import/cxx:include/loomcxx/view.h",
    ],
    c_file_output = "facade_headers.c",
    flatten = True,
    h_file_output = "facade_headers.h",
    identifier = "facade_headers",
)

cc_binary(
    name = "emit_example",
    srcs = ["emit_example.cc"],
    cxxopts = _CXXOPTS,
    deps = [
        ":facade_headers",
        ":wrapper_source",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/import/cxx",
    ],
)

# This .cc file is input to Loom's existing supported C++ importer, not the host
# compiler. The host tool links the maintained command after importing it.
genrule(
    name = "authored_program",
    testonly = True,
    srcs = ["testdata/affine.cc"],
    outs = ["authored_program.loombc"],
    cmd = "$(location :emit_example) $(location testdata/affine.cc) $@",
    tools = [":emit_example"],
)

iree_c_embed_data(
    name = "authored_program_data",
    testonly = True,
    srcs = [":authored_program"],
    c_file_output = "authored_program_data.c",
    flatten = True,
    h_file_output = "authored_program_data.h",
    identifier = "authored_program_data",
)

cc_test(
    name = "computation_import_test",
    size = "small",
    srcs = ["computation_import_test.cc"],
    copts = _CXXOPTS,
    linkstatic = True,
    deps = [
        ":authored_program_data",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
    ],
)

loom_test(
    name = "authored_execution_test",
    srcs = [
        "testdata/runtime_checks.loom",
        ":authored_program",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
)

iree_c_embed_data(
    name = "wrapper_source",
    srcs = ["affine.loom"],
    c_file_output = "wrapper_source.c",
    flatten = True,
    h_file_output = "wrapper_source.h",
    identifier = "wrapper_source",
)

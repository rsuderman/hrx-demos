load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
package(default_visibility = ["//visibility:public"])
exports_files(["epoch.loom", "prepare.loom.in", "control.loom", "weights.loom"])
filegroup(name = "providers", srcs = ["epoch.loom", "prepare.loom.in", "control.loom", "weights.loom"])
iree_cc_library(
    name = "epoch", srcs = ["epoch.cc"], hdrs = ["epoch.h"], cxxopts = ["-std=c++17"],
    deps = ["//tools/loomify-gguf/authoring/command:command_program_builder", "//tools/loomify-gguf/authoring/commands:command_values"],
)
iree_cc_library(
    name = "package", srcs = ["package.cc"], hdrs = ["package.h", "package_internal.h"], cxxopts = ["-std=c++17"],
    deps = ["//tools/model:model_descriptor", "@hrx_system//loom/binding/c:loomc"],
)
cc_test(
    name = "serving_test", size = "small", srcs = ["serving_test.cc"], copts = ["-std=c++17"], linkstatic = True,
    data = [":providers"],
    deps = [":epoch", ":package", "//tools/loomify-gguf/authoring/command:command_program_builder",
            "@hrx_system//loom/binding/c/target/amdgpu", "@googletest//:gtest", "@googletest//:gtest_main"],
)

load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
cc_binary(
    name = "emit_epoch_fixture", testonly = True, srcs = ["testing/emit_epoch_fixture.cc"], cxxopts = ["-std=c++17"],
    deps = [":epoch", "@hrx_system//loom/binding/c/target/amdgpu"],
)
genrule(
    name = "epoch_fixture", testonly = True,
    srcs = ["epoch.loom", "testing/numerical_fixture.loom"], outs = ["epoch_fixture.loombc", "epoch_fixture_sources.loom"],
    cmd = "cat $(location epoch.loom) $(location testing/numerical_fixture.loom) > $(location epoch_fixture_sources.loom) && $(location :emit_epoch_fixture) $(location epoch_fixture_sources.loom) $(location epoch_fixture.loombc)",
    tools = [":emit_epoch_fixture"],
)
loom_test(
    name = "epoch_execution_test", srcs = ["testing/epoch_checks.loom", ":epoch_fixture.loombc"],
    benchmark_smoke = False, execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)
iree_cc_library(
    name = "model_export", srcs = ["model_export.cc"], hdrs = ["model_export.h"], cxxopts = ["-std=c++17"],
    deps = [":epoch", ":package", "//lib/llama:program", "@hrx_system//loom/binding/c:loomc"],
)
# Immutable external real-model fixture; no download or fallback substitution.
cc_test(
    name = "model_export_test", size = "medium", tags = ["manual"], srcs = ["model_export_test.cc"],
    copts = ["-std=c++17"], linkstatic = True,
    data = [":providers", "//lib/kernels/llama:all_sources"],
    deps = [":model_export", "//tools/model:llama_configuration", "@hrx_system//loom/binding/c/target/amdgpu",
            "@hrx_system//loom/binding/c/target/cmd", "@googletest//:gtest", "@googletest//:gtest_main"],
)
cc_test(name = "cli_test", size = "small", srcs = ["testing/cli_test.cc"], data = ["testing/cli_test.sh", "//tools/loomify-gguf:loomify-gguf"], deps = ["@googletest//:gtest", "@googletest//:gtest_main"])

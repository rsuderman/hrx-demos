// One ordinary request span, using the existing text-serving metadata packet.
// The owner admits 1 <= length <= capacity, row0 and ordinary greedy packets.
kernel.def @loomify_epoch_unpack(%capacity0: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%capacity0: index, %metadata: buffer, %input: buffer, %control: buffer, %history: buffer, %progress: buffer) {
  %capacity = index.assume %capacity0 [range(%capacity0, 1, 512)] : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %eos_origin = index.constant 2060 : offset
  %packet = buffer.view %metadata[%descriptor_origin] : buffer -> view<5xi32>
  %terminal = buffer.view %metadata[%eos_origin] : buffer -> view<1xi32>
  %words = buffer.view %control[%origin] : buffer -> view<3xi32>
  %inputs = buffer.view %input[%origin] : buffer -> view<[%capacity]xi32>
  %tokens = buffer.view %history[%origin] : buffer -> view<[%capacity]xi32>
  %feedback = buffer.view %progress[%origin] : buffer -> view<8xi32>
  %length32 = view.load %packet[0] : view<5xi32> -> i32
  %position = view.load %packet[1] : view<5xi32> -> i32
  %begin32 = view.load %packet[2] : view<5xi32> -> i32
  %eos = view.load %terminal[0] : view<1xi32> -> i32
  view.store %length32, %words[0] : i32, view<3xi32>
  view.store %position, %words[1] : i32, view<3xi32>
  view.store %eos, %words[2] : i32, view<3xi32>
  %length_value = index.cast %length32 : i32 to index
  %limit = index.add %capacity, %one : index
  %length = index.assume %length_value [range(%length_value, 1, 512), lt(%length_value, %limit)] : index
  %begin = index.cast %begin32 : i32 to index
  scf.for %i = [%zero to %length step %one] {
    %row = index.assume %i [range(%i, 0, 511), lt(%i, %capacity)] : index
    %source_value = index.add %begin, %row : index
    %source = index.assume %source_value [range(%source_value, 0, 511), lt(%source_value, %capacity)] : index
    %token = view.load %inputs[%source] : view<[%capacity]xi32> -> i32
    view.store %token, %tokens[%row] : i32, view<[%capacity]xi32>
    scf.yield
  }
  %zero32 = scalar.constant 0 : i32
  %eight = index.constant 8 : index
  scf.for %i = [%zero to %eight step %one] {
    view.store %zero32, %feedback[%i] : i32, view<8xi32>
    scf.yield
  }
  kernel.return
}
kernel.def @loomify_epoch_scatter() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%metadata: buffer, %history: buffer, %outputs: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %packet = buffer.view %metadata[%descriptor_origin] : buffer -> view<5xi32>
  %tokens = buffer.view %history[%origin] : buffer -> view<1xi32>
  %result = buffer.view %outputs[%origin] : buffer -> view<16xi32>
  %slot32 = view.load %packet[4] : view<5xi32> -> i32
  %zero32 = scalar.constant 0 : i32
  %selected = scalar.cmpi sge, %slot32, %zero32 : i32
  scf.if %selected {
    %slot_value = index.cast %slot32 : i32 to index
    %slot = index.assume %slot_value [range(%slot_value, 0, 15)] : index
    %token = view.load %tokens[0] : view<1xi32> -> i32
    view.store %token, %result[%slot] : i32, view<16xi32>
  }
  kernel.return
}

load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
package(default_visibility = ["//visibility:public"])
exports_files(["prepare.loom.in", "control.loom", "weights.loom"])
filegroup(name = "providers", srcs = ["prepare.loom.in", "control.loom", "weights.loom"])
# Keep production function bodies intact; bind only input.require to a valid-
# input test callback instead of the server-owned VM import module.
genrule(
    name = "control_test_source", testonly = True,
    srcs = ["control.loom"], outs = ["control_test.loom"],
    cmd = "sed 's/func.decl import(\"input\") @require/func.decl @require/' $(location control.loom) > $@",
)
loom_test(
    name = "packet_execution_test",
    srcs = [":control_test.loom", "testing/imports.loom", "testing/packet_checks.loom"],
    benchmark_smoke = False,
    execution_profiles = [VM_REFERENCE_PROFILE],
)

load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")
iree_cc_library(
    name = "package", srcs = ["package.cc"], hdrs = ["package.h"], cxxopts = ["-std=c++17"],
    deps = ["//tools/loomify-gguf/serving:package", "//lib/dispatch:registry"],
)
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
cc_test(
    name = "package_test", size = "small", srcs = ["package_test.cc", "testing/fixture.h"], copts = ["-std=c++17"], linkstatic = True,
    data = [":providers"],
    deps = [":package", "@hrx_system//loom/binding/c/target/amdgpu", "@googletest//:gtest", "@googletest//:gtest_main"],
)

load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary")
cc_binary(
    name = "emit_prepare", testonly = True,
    srcs = ["testing/emit_prepare.cc", "testing/fixture.h"], cxxopts = ["-std=c++17"], deps = [":package"],
)
genrule(
    name = "prepare_test_source", testonly = True, srcs = [":providers"],
    outs = ["prepare_test.loom"], tools = [":emit_prepare"],
    cmd = "$(location :emit_prepare) . $@",
)
loom_test(
    name = "prepare_execution_test",
    srcs = [":prepare_test.loom", "testing/prepare_imports.loom", "testing/prepare_checks.loom"],
    benchmark_smoke = False, execution_profiles = [VM_REFERENCE_PROFILE],
)

iree_cc_library(
    name = "model_export", srcs = ["model_export.cc"], hdrs = ["model_export.h"], cxxopts = ["-std=c++17"],
    deps = [":package", "//lib/qwen:program", "@hrx_system//loom/binding/c:loomc"],
)
# Explicit immutable external fixture; failure is not a skipped model gate.
cc_test(
    name = "model_export_test", size = "medium", tags = ["manual"],
    srcs = ["model_export_test.cc"], copts = ["-std=c++17"], linkstatic = True,
    data = [":providers", "//lib/kernels/llama:all_sources", "//lib/kernels/qwen:all_sources", "//lib/kernels/qwen/gdn:all_sources", "//lib/kernels/qwen/attention:all_sources"],
    deps = [":model_export", "//tools/model:qwen_configuration", "@hrx_system//loom/binding/c/target/amdgpu",
            "@hrx_system//loom/binding/c/target/cmd", "@googletest//:gtest", "@googletest//:gtest_main"],
)
cc_test(
    name = "cli_model_test", size = "small", tags = ["manual"],
    srcs = ["testing/cli_model_test.cc"],
    data = ["testing/cli_model_test.sh", "//tools/loomify-gguf:loomify-gguf"],
    deps = ["@googletest//:gtest", "@googletest//:gtest_main"],
)

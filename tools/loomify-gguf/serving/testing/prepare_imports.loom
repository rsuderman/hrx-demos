// Valid-input host callbacks; actual unsupported mode rejection is exercised
// through model/package/Serve admission, not these deterministic callbacks.
func.def @require(%condition: i32, %diagnostic: buffer) { func.return }
func.def @stage(%root: buffer, %tag: i64) -> (i32) {
  %id = scalar.trunci %tag : i64 to i32
  func.return %id : i32
}
func.def @parameter(%stage: i32, %binding: i32, %source: i32, %directory: buffer, %path: buffer, %policy: buffer) { func.return }
func.def @members(%json: buffer) -> (buffer, i32, i64) {
  %zero = index.constant 0 : offset
  %fields = buffer.alloca<private> align(8) %zero : buffer
  %object = scalar.constant 2 : i32
  %count = scalar.constant 0 : i64
  func.return %fields, %object, %count : buffer, i32, i64
}

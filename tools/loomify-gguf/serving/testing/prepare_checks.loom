func.decl @prepare(%prefill: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %draft_depth: i32, %shapes: buffer, %shape_count: i64, %weights: buffer, %options: buffer) -> (i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
func.decl @expected_prepare(%allocations: buffer, %views: buffer, %origins: buffer, %geometry: buffer, %state: buffer, %summary: buffer)
func.def @actual_prepare(%allocations_out: buffer, %views_out: buffer, %origins_out: buffer, %geometry_out: buffer, %state_out: buffer, %summary_out: buffer) {
  %origin = index.constant 0 : offset
  %shape_bytes = index.constant 96 : offset
  %shapes = buffer.alloca<private> align(8) %shape_bytes : buffer
  %shape_view = buffer.view %shapes[%origin] : buffer -> view<6x2xi64>
  %one64 = scalar.constant 1 : i64
  %shape0 = scalar.constant 4 : i64
  view.store %shape0, %shape_view[0, 0] : i64, view<6x2xi64>
  view.store %one64, %shape_view[0, 1] : i64, view<6x2xi64>
  %shape1 = scalar.constant 8 : i64
  view.store %shape1, %shape_view[1, 0] : i64, view<6x2xi64>
  view.store %one64, %shape_view[1, 1] : i64, view<6x2xi64>
  %shape2 = scalar.constant 16 : i64
  view.store %shape2, %shape_view[2, 0] : i64, view<6x2xi64>
  view.store %one64, %shape_view[2, 1] : i64, view<6x2xi64>
  %shape3 = scalar.constant 32 : i64
  view.store %shape3, %shape_view[3, 0] : i64, view<6x2xi64>
  view.store %one64, %shape_view[3, 1] : i64, view<6x2xi64>
  %shape4 = scalar.constant 64 : i64
  view.store %shape4, %shape_view[4, 0] : i64, view<6x2xi64>
  view.store %one64, %shape_view[4, 1] : i64, view<6x2xi64>
  %shape5 = scalar.constant 128 : i64
  view.store %shape5, %shape_view[5, 0] : i64, view<6x2xi64>
  view.store %one64, %shape_view[5, 1] : i64, view<6x2xi64>
  %empty = buffer.alloca<private> align(8) %origin : buffer
  %prefill = scalar.constant 128 : i64
  %context = scalar.constant 512 : i64
  %zero = scalar.constant 0 : i64
  %zero32 = scalar.constant 0 : i32
  %count = scalar.constant 6 : i64
  %effective, %shared, %state, %terminal, %allocations, %views, %origins, %draft, %geometry = func.call @prepare(%prefill, %context, %context, %one64, %zero, %zero32, %shapes, %count, %empty, %empty) : (i64, i64, i64, i64, i64, i32, buffer, i64, buffer, buffer) -> (i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %bytes_allocations = index.constant 264 : offset
  buffer.copy %allocations[%origin], %allocations_out[%origin], %bytes_allocations
  %bytes_views = index.constant 64 : offset
  buffer.copy %views[%origin], %views_out[%origin], %bytes_views
  %bytes_origins = index.constant 512 : offset
  buffer.copy %origins[%origin], %origins_out[%origin], %bytes_origins
  %bytes_geometry = index.constant 104 : offset
  buffer.copy %geometry[%origin], %geometry_out[%origin], %bytes_geometry
  %bytes_state = index.constant 8 : offset
  buffer.copy %state[%origin], %state_out[%origin], %bytes_state
  %summary = buffer.view %summary_out[%origin] : buffer -> view<3xi64>
  %shared64 = scalar.extsi %shared : i32 to i64
  view.store %effective, %summary[0] : i64, view<3xi64>
  view.store %shared64, %summary[1] : i64, view<3xi64>
  %draft_bytes = buffer.length %draft
  %draft_length = index.cast %draft_bytes : offset to i64
  view.store %draft_length, %summary[2] : i64, view<3xi64>
  func.return
}
check.scenario @prepare_geometry {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %allocations = check.generate.fill value(-77) : tensor<33xi64>
    %views = check.generate.fill value(-77) : tensor<8xi64>
    %origins = check.generate.fill value(-77) : tensor<64xi64>
    %geometry = check.generate.fill value(-77) : tensor<13xi64>
    %summary = check.generate.fill value(-77) : tensor<3xi64>
    %state = check.generate.fill value(-77) : tensor<2xi32>
    check.compare<@actual_prepare, @expected_prepare>(%allocations, %views, %origins, %geometry, %state, %summary) : (tensor<33xi64>, tensor<8xi64>, tensor<64xi64>, tensor<13xi64>, tensor<2xi32>, tensor<3xi64>) -> () {
      check.expect.bitwise actual(%allocations) expected(%allocations) : tensor<33xi64>
      check.expect.bitwise actual(%views) expected(%views) : tensor<8xi64>
      check.expect.bitwise actual(%origins) expected(%origins) : tensor<64xi64>
      check.expect.bitwise actual(%geometry) expected(%geometry) : tensor<13xi64>
      check.expect.bitwise actual(%summary) expected(%summary) : tensor<3xi64>
      check.expect.bitwise actual(%state) expected(%state) : tensor<2xi32>
    }
  }
  check.return
}

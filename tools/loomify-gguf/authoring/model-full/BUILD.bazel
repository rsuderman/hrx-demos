load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary", "iree_cc_library")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "llama_step",
    srcs = ["llama_step.cc"],
    hdrs = ["llama_step.h"],
    cxxopts = _CXXOPTS,
    deps = [
        "//tools/model:model_descriptor",
        "//tools/loomify-gguf/authoring/command:command_program_builder",
        "//tools/loomify-gguf/authoring/commands:command_values",
        "@hrx_system//loom/src/loom/ops/template",
    ],
)

cc_binary(
    name = "emit_llama_step",
    srcs = ["emit_llama_step.cc"],
    cxxopts = _CXXOPTS,
    deps = [
        ":llama_step",
        "@hrx_system//loom/binding/c/target/configured:ir",
    ],
)

cc_test(
    name = "llama_step_test",
    srcs = ["llama_step_test.cc"],
    copts = _CXXOPTS,
    size = "small",
    deps = [
        ":llama_step",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "output_alias_test",
    srcs = ["output_alias_test.cc"],
    copts = _CXXOPTS,
    size = "small",
    data = [":emit_llama_step"],
    env = {"LOOMIFY_STEP_EMITTER": "$(rootpath :emit_llama_step)"},
    deps = [
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary", "iree_cc_library")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "command_values",
    srcs = ["command_values.cc"],
    hdrs = ["command_values.h"],
    cxxopts = _CXXOPTS,
    deps = [
        "//tools/loomify-gguf/authoring/command:command_program_builder",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/src/loom/ir",
        "@hrx_system//loom/src/loom/ops/buffer",
        "@hrx_system//loom/src/loom/ops/command",
        "@hrx_system//loom/src/loom/ops/config",
        "@hrx_system//loom/src/loom/ops/index",
        "@hrx_system//loom/src/loom/ops/scalar",
        "@hrx_system//loom/src/loom/ops/scf",
    ],
)

cc_binary(
    name = "emit_body_example",
    srcs = ["emit_body_example.cc"],
    cxxopts = _CXXOPTS,
    deps = [":command_values"],
)

cc_test(
    name = "command_values_test",
    size = "small",
    srcs = ["command_values_test.cc"],
    copts = _CXXOPTS,
    linkstatic = True,
    deps = [
        ":command_values",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:interop",
        "@hrx_system//loom/src/loom/ops/command",
        "@hrx_system//loom/src/loom/ops/index",
        "@hrx_system//loom/src/loom/ops/scf",
    ],
)

genrule(
    name = "body_example",
    testonly = True,
    srcs = ["testdata/numerical.loom"],
    outs = ["body_example.loombc"],
    cmd = "$(location :emit_body_example) $(location testdata/numerical.loom) $@",
    tools = [":emit_body_example"],
)

loom_test(
    name = "command_body_execution_test",
    srcs = ["testdata/checks.loom", ":body_example"],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)

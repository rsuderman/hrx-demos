command.program.decl @example.times_two(%n: index) launch(%input: buffer, %scratch: buffer, %output: buffer)
check.scenario @host_authored_two {
  %n = check.literal value(7) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-9) step(3) : tensor<11xi32>
    %scratch = check.generate.fill value(-701) : tensor<11xi32>
    %output = check.generate.fill value(-903) : tensor<11xi32>
    check.compare<@example.times_two, @expected_two>[%n](%input, %scratch, %output) : [index](tensor<11xi32>, tensor<11xi32>, tensor<11xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<11xi32>
      check.expect.bitwise actual(%scratch) expected(%scratch) : tensor<11xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<11xi32>
    }
  }
  check.return
}

command.program.decl @example.times_three(%n: index) launch(%input: buffer, %scratch: buffer, %output: buffer)
check.scenario @host_authored_three {
  %n = check.literal value(7) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-9) step(3) : tensor<11xi32>
    %scratch = check.generate.fill value(-701) : tensor<11xi32>
    %output = check.generate.fill value(-903) : tensor<11xi32>
    check.compare<@example.times_three, @expected_three>[%n](%input, %scratch, %output) : [index](tensor<11xi32>, tensor<11xi32>, tensor<11xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<11xi32>
      check.expect.bitwise actual(%scratch) expected(%scratch) : tensor<11xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<11xi32>
    }
  }
  check.return
}


func.def @expected_two(%input: buffer, %scratch: buffer, %output: buffer) {
  %n = index.constant 7 : index
  %start = index.constant 0 : index
  %step = index.constant 1 : index
  %guard = index.constant 2 : index
  %base = index.constant 0 : offset
  %src = buffer.view %input[%base] : buffer -> view<11xi32>
  %tmp = buffer.view %scratch[%base] : buffer -> view<11xi32>
  %dst = buffer.view %output[%base] : buffer -> view<11xi32>
  %one = scalar.constant 1 : i32
  %factor = scalar.constant 2 : i32
  scf.for %j = [%start to %n step %step] {
    %i = index.add %j, %guard : index
    %x = view.load %src[%i] : view<11xi32> -> i32
    %first = scalar.addi %x, %one : i32
    %result = scalar.muli %first, %factor : i32
    view.store %first, %tmp[%i] : i32, view<11xi32>
    view.store %result, %dst[%i] : i32, view<11xi32>
    scf.yield
  }
  func.return
}

func.def @expected_three(%input: buffer, %scratch: buffer, %output: buffer) {
  %n = index.constant 7 : index
  %start = index.constant 0 : index
  %step = index.constant 1 : index
  %guard = index.constant 2 : index
  %base = index.constant 0 : offset
  %src = buffer.view %input[%base] : buffer -> view<11xi32>
  %tmp = buffer.view %scratch[%base] : buffer -> view<11xi32>
  %dst = buffer.view %output[%base] : buffer -> view<11xi32>
  %one = scalar.constant 1 : i32
  %factor = scalar.constant 3 : i32
  scf.for %j = [%start to %n step %step] {
    %i = index.add %j, %guard : index
    %x = view.load %src[%i] : view<11xi32> -> i32
    %first = scalar.addi %x, %one : i32
    %result = scalar.muli %first, %factor : i32
    view.store %first, %tmp[%i] : i32, view<11xi32>
    view.store %result, %dst[%i] : i32, view<11xi32>
    scf.yield
  }
  func.return
}

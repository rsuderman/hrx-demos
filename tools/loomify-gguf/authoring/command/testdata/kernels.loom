// Test computations. Command programs are constructed by emit_example.cc.

kernel.def @add_one(%n: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%n, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%n: index, %input: buffer, %output: buffer) {
  %position = kernel.workgroup.id<x> : index
  %two = index.constant 2 : index
  %i = index.add %position, %two : index
  %zero = index.constant 0 : offset
  %src = buffer.view %input[%zero] : buffer -> view<11xi32>
  %dst = buffer.view %output[%zero] : buffer -> view<11xi32>
  %limit = index.constant 7 : index
  %active = index.cmp ult, %position, %limit : index
  scf.if %active {
    %x = view.load %src[%i] : view<11xi32> -> i32
    %constant = scalar.constant 1 : i32
    %y = scalar.addi %x, %constant : i32
    view.store %y, %dst[%i] : i32, view<11xi32>
    scf.yield
  }
  kernel.return
}

kernel.def @times_two(%n: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%n, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%n: index, %input: buffer, %output: buffer) {
  %position = kernel.workgroup.id<x> : index
  %two = index.constant 2 : index
  %i = index.add %position, %two : index
  %zero = index.constant 0 : offset
  %src = buffer.view %input[%zero] : buffer -> view<11xi32>
  %dst = buffer.view %output[%zero] : buffer -> view<11xi32>
  %limit = index.constant 7 : index
  %active = index.cmp ult, %position, %limit : index
  scf.if %active {
    %x = view.load %src[%i] : view<11xi32> -> i32
    %constant = scalar.constant 2 : i32
    %y = scalar.muli %x, %constant : i32
    view.store %y, %dst[%i] : i32, view<11xi32>
    scf.yield
  }
  kernel.return
}

kernel.def @times_three(%n: index) {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%n, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%n: index, %input: buffer, %output: buffer) {
  %position = kernel.workgroup.id<x> : index
  %two = index.constant 2 : index
  %i = index.add %position, %two : index
  %zero = index.constant 0 : offset
  %src = buffer.view %input[%zero] : buffer -> view<11xi32>
  %dst = buffer.view %output[%zero] : buffer -> view<11xi32>
  %limit = index.constant 7 : index
  %active = index.cmp ult, %position, %limit : index
  scf.if %active {
    %x = view.load %src[%i] : view<11xi32> -> i32
    %constant = scalar.constant 3 : i32
    %y = scalar.muli %x, %constant : i32
    view.store %y, %dst[%i] : i32, view<11xi32>
    scf.yield
  }
  kernel.return
}

load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary", "iree_cc_library")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//loom/build_tools/bazel:defs.bzl", "loom_test")
load("@hrx_system//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

cc_binary(
    name = "emit_example",
    srcs = ["emit_example.cc"],
    cxxopts = _CXXOPTS,
    deps = [
        ":command_program_builder",
        "@hrx_system//loom/binding/c:loomc",
    ],
)

iree_cc_library(
    name = "command_program_builder",
    srcs = ["command_program_builder.cc"],
    hdrs = ["command_program_builder.h"],
    cxxopts = _CXXOPTS,
    deps = [
        "@hrx_system//loom/binding/c:interop",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/src/loom/ir",
        "@hrx_system//loom/src/loom/ops/command",
        "@hrx_system//loom/src/loom/ops:function_contract_verify",
        "@hrx_system//loom/src/loom/ops:op_defs",
        "@hrx_system//loom/src/loom/ops/index",
        "@hrx_system//loom/src/loom/ops/kernel",
        "@hrx_system//loom/src/loom/ops/pipeline",
        "@hrx_system//loom/src/loom/ops/scf",
    ],
)

cc_test(
    name = "command_program_builder_test",
    size = "small",
    srcs = ["command_program_builder_test.cc"],
    copts = _CXXOPTS,
    linkstatic = True,
    deps = [
        ":command_program_builder",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:interop",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/src/loom/ops/command",
        "@hrx_system//loom/src/loom/ops/kernel",
    ],
)

# The host C++ example constructs the command bodies; the source fixture supplies
# numerical kernels/oracles only. Execution consumes the generated closed module.
genrule(
    name = "example_programs",
    testonly = True,
    srcs = ["testdata/kernels.loom"],
    outs = ["example_programs.loombc"],
    cmd = "$(location :emit_example) $(location testdata/kernels.loom) $@",
    tools = [":emit_example"],
)

loom_test(
    name = "command_execution_test",
    srcs = [
        "testdata/runtime_checks.loom",
        ":example_programs",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)

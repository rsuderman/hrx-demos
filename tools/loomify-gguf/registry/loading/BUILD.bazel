load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")
load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")

package(default_visibility = ["//tools/loomify-gguf/registry:__subpackages__"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "module_loader",
    srcs = ["module_loader.cc"],
    hdrs = ["module_loader.h"],
    cxxopts = _CXXOPTS,
    deps = ["@hrx_system//loom/binding/c:loomc"],
)

cc_test(
    name = "module_loader_test",
    size = "small",
    srcs = ["module_loader_test.cc"],
    copts = _CXXOPTS,
    linkstatic = True,
    data = [
        "//tools/loomify-gguf/registry/loading/testdata:decode_control_provider",
        "//tools/loomify-gguf/registry/loading/testdata:qk_common_provider",
    ],
    deps = [
        ":module_loader",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
    ],
)

load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary", "iree_cc_library")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "source_builder",
    srcs = ["source_builder.cc"],
    hdrs = ["source_builder.h"],
    cxxopts = _CXXOPTS,
    deps = [
        "//tools/loomify-gguf/authoring/command:command_program_builder",
        "//tools/loomify-gguf/authoring/commands:command_values",
        "//tools/model:model_descriptor",
        "@hrx_system//loom/binding/c:loomc",
    ],
)

# The first-party binary macro applies HRX-repository-relative link policy.
# Its underlying rule retains HRX execution metadata for an external client.
cc_binary(
    name = "loomify-gguf",
    srcs = ["main.cc"],
    data = ["//lib/kernels/llama:all_sources", "//lib/kernels/qwen:all_sources", "//lib/kernels/qwen/gdn:all_sources", "//lib/kernels/qwen/attention:all_sources", "//tools/loomify-gguf/serving:providers", "//tools/loomify-gguf/serving/qwen:providers"],
    cxxopts = _CXXOPTS,
    deps = [
        ":source_builder",
        "//tools/loomify-gguf/serving:model_export",
        "//tools/loomify-gguf/serving/qwen:model_export",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "//tools/model:model_descriptor",
        "@hrx_system//runtime/src/iree/base/tooling:flags",
    ],
)

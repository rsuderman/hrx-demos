load("@hrx_system//build_tools/bazel:cc.bzl", "cc_binary", "iree_cc_library")

load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "embedding",
    srcs = ["embedding.cc"],
    hdrs = ["embedding.h"],
    cxxopts = _CXXOPTS,
    deps = [
        ":embedding_sources",
        "//tools/model:model_descriptor",
        "@hrx_system//loom/binding/c:loomc",
    ],
)

# The first-party binary macro applies HRX-repository-relative link policy.
# Its underlying rule retains HRX execution metadata for an external client.
cc_binary(
    name = "loomify-gguf",
    srcs = ["main.cc"],
    data = ["//lib/serving:export_products"],
    cxxopts = _CXXOPTS,
    deps = [
        ":embedding",
        ":gguf_model_builder",
        "@hrx_system//loom/binding/c/target/amdgpu",
        "//tools/model:model_descriptor",
        "@hrx_system//runtime/src/iree/base/tooling:flags",
    ],
)

iree_cc_library(
    name = "configuration",
    srcs = ["configuration.cc"],
    hdrs = ["configuration.h"],
    cxxopts = _CXXOPTS,
    deps = ["//tools/model:gguf_catalog", "//tools/model:model_descriptor"],
)

iree_cc_library(
    name = "configuration_fixture",
    testonly = True,
    hdrs = ["//tools/loomify-gguf/testing:configuration_fixture.h", "//tools/loomify-gguf/testing:alternating_qwen_fixture.h"],
    cxxopts = _CXXOPTS,
    deps = ["//tools/model:gguf_catalog", "//tools/model:model_descriptor"],
)

cc_test(
    name = "configuration_test",
    srcs = ["//tools/loomify-gguf/testing:configuration_test.cc"],
    copts = ["-std=c++17"],
    deps = [":configuration", ":configuration_fixture", "//tools/model:model_descriptor",
            "@hrx_system//loom/binding/c:loomc", "@googletest//:gtest", "@googletest//:gtest_main"],
)

cc_test(
    name = "configuration_real_assets_test",
    srcs = ["//tools/loomify-gguf/testing:configuration_test.cc"],
    defines = ["LOOMIFY_CONFIGURATION_REAL_ASSETS=1"],
    tags = ["manual"],
    copts = ["-std=c++17"],
    deps = [":configuration", ":configuration_fixture", "//tools/model:model_descriptor",
            "@hrx_system//loom/binding/c:loomc", "@googletest//:gtest", "@googletest//:gtest_main"],
)

iree_c_embed_data(
    name = "embedding_sources",
    srcs = ["embedding.loom", "//lib/kernels/embedding:f32.loom"],
    c_file_output = "embedding_sources.c", h_file_output = "embedding_sources.h",
    identifier = "embedding_sources", flatten = True,
)

iree_cc_library(
    name = "gguf_model_builder",
    srcs = ["package.cc", "gguf_model_builder.cc", "gguf_model_builder_internal.h", "architectures.cc", "architectures.h"],
    hdrs = ["gguf_model_builder.h"],
    cxxopts = _CXXOPTS,
    deps = [":configuration", ":native_linking", ":token_policy", ":chat_policy", "//tools/model:model_descriptor", "//tools/model:text_metadata", "@hrx_system//loom/binding/c:loomc"],
)

# Private operation shared only by the module/package implementation and retained
# native numerical fixtures. gguf_model_builder.h remains the supported API.
iree_cc_library(
    name = "native_linking",
    srcs = ["linking.cc"], hdrs = ["linking.h"],
    cxxopts = _CXXOPTS,
    visibility = [
        "//tools/loomify-gguf:__pkg__",
        "//tools/loomify-gguf/testing:__pkg__",
        "//lib/architectures:__subpackages__",
        "//lib/programs/ffn/testing:__pkg__",
        "//lib/programs/projection/testing:__pkg__",
        "//lib/serving/testing:__pkg__",
    ],
    deps = ["@hrx_system//loom/binding/c:loomc"],
)

# Immutable external checkpoints/tokenizers supplied explicitly by the real gate.
cc_test(
    name = "package_test",
    tags = ["manual"],
    size = "medium",
    linkstatic = True,
    srcs = ["//tools/loomify-gguf/testing:package_test.cc"],
    copts = _CXXOPTS,
    data = [":loomify-gguf", "//lib/serving:export_products"],
    deps = ["//tools/loomify-gguf/testing:package_buffer_vm", ":gguf_model_builder", "@hrx_system//loom/binding/c/target/amdgpu",
            "@googletest//:gtest", "@googletest//:gtest_main"],
)

iree_cc_library(
    name = "token_policy",
    srcs = ["token_policy.cc"],
    hdrs = ["token_policy.h"],
    cxxopts = _CXXOPTS,
    deps = [
        "//tools/model:text_metadata",
        "@hrx_system//runtime/src/iree/base",
        "@hrx_system//runtime/src/iree/tokenizer:tokenizer",
        "@hrx_system//runtime/src/iree/tokenizer/vocab",
        "@hrx_system//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
    ],
)

iree_c_embed_data(
    name = "chat_templates",
    srcs = ["//lib/text/llama:templates/5816fce1.jinja",
            "//lib/text/qwen35:templates/7f0e5290.jinja", "//lib/text/qwen35:templates/c3cf9e34.jinja"],
    c_file_output = "chat_templates.c", h_file_output = "chat_templates.h",
    identifier = "chat_templates", flatten = True,
)
iree_cc_library(
    name = "chat_policy",
    visibility = ["//tools/loomify-gguf:__subpackages__", "//lib/serving/testing:__pkg__"],
    srcs = ["chat_policy.cc"], hdrs = ["chat_policy.h"],
    cxxopts = _CXXOPTS,
    deps = [":chat_templates", "//tools/model:text_metadata"],
)
cc_test(
    name = "chat_policy_test", size = "small", linkstatic = True,
    srcs = ["//tools/loomify-gguf/testing:chat_policy_test.cc"], copts = _CXXOPTS,
    data = ["//lib/text/llama:templates/5816fce1.jinja",
            "//lib/text/qwen35:templates/7f0e5290.jinja", "//lib/text/qwen35:templates/c3cf9e34.jinja"],
    deps = [":chat_policy", "@googletest//:gtest", "@googletest//:gtest_main"],
)

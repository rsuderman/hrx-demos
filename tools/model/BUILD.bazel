load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "gguf_catalog",
    srcs = ["gguf_catalog.cc"],
    hdrs = ["gguf_catalog.h"],
    cxxopts = _CXXOPTS,
    deps = ["@loomify_ggml//:metadata"],
)

iree_cc_library(
    name = "model_descriptor",
    srcs = ["model_descriptor.cc"],
    hdrs = ["model_descriptor.h"],
    cxxopts = _CXXOPTS,
    deps = [":gguf_catalog"],
)

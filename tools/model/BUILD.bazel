load("@hrx_system//build_tools/bazel:cc.bzl", "iree_cc_library")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = select({
    "@hrx_system//build_tools/bazel:cc_compiler_clang_cl": ["/std:c++17"],
    "@hrx_system//build_tools/bazel:cc_compiler_msvc": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

iree_cc_library(
    name = "model_types",
    hdrs = [
        "gguf_catalog.h",
        "model_descriptor.h",
    ],
    cxxopts = _CXXOPTS,
)

iree_cc_library(
    name = "gguf_catalog",
    srcs = ["gguf_catalog.cc"],
    cxxopts = _CXXOPTS,
    deps = [
        ":model_types",
    ],
)

iree_cc_library(
    name = "model_descriptor",
    srcs = [
        "model_descriptor.cc",
        "model_descriptor_internal.h",
        "architectures.cc",
        "architectures.h",
        "architectures/llama.h",
        "architectures/lfm3.h",
        "architectures/lfm3.cc",
        "architectures/qwen2.h",
        "architectures/qwen3.h",
        "architectures/gemma3.h",
        "architectures/qwen35.h",
        "architectures/llama.cc",
        "architectures/qwen3.cc",
        "architectures/gemma3.cc",
        "architectures/qwen35.cc",
        "architectures/qwen2.cc",
    ],
    hdrs = ["tensor_names.h"],
    cxxopts = _CXXOPTS,
    deps = [":gguf_catalog"],
)

iree_cc_library(
    name = "text_metadata",
    srcs = ["text_metadata.cc"],
    hdrs = ["text_metadata.h"],
    cxxopts = _CXXOPTS,
    deps = [":gguf_catalog"],
)

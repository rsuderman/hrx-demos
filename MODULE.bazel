module(
    name = "hrx_solutions",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

# HRX source pin. For local development, pass
# --override_module="hrx=$PWD/../hrx-system" from the shell.
bazel_dep(name = "hrx", version = "0.0.0", repo_name = "hrx_system")
git_override(
    module_name = "hrx",
    remote = "https://github.com/ROCm/hrx-system.git",
    commit = "61417137f334cfa828b38d6e9b0f2d7190503f16",
)

# HRX's test dependencies are not inherited by downstream modules. Keep this
# development-only dependency aligned with the pinned HRX GoogleTest version.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

# Metadata-only GGUF inspection. No llama inference or device backend is built.
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")
git_repository(
    name = "loomify_ggml",
    remote = "https://github.com/amd-ecosystem/llama.cpp.git",
    commit = "dace2471abb49c118f95e6be09b4b8de2c1118b2",
    build_file = "//third_party/ggml:BUILD.ggml.bazel",
    patches = ["//third_party/ggml:metadata_validation.patch"],
    patch_args = ["-p1"],
)

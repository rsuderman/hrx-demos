// Test-only distinguishing provider: public shared-family selection must
// reach decode through the Qwen adapter, prefill, and unchanged Llama callers.
template.decl @llm.rmsnorm.row(%width: index, %divisor: f32, %rows: index, %row: index, %origin: offset, %half: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

template.def<@llm.rmsnorm.row> device priority(100) @pilot.shared_override(%width: index, %divisor: f32, %rows: index, %row: index, %origin: offset, %half: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %step = index.constant 256 : index
  %value = scalar.constant 23.0 : f32
  scf.for %column = [%lane to %width step %step] {
    scf.if %half {
      %view = buffer.view %output[%origin] : buffer -> view<[%width]xf16>
      %short = scalar.fptrunc %value : f32 to f16
      view.store %short, %view[%column] : f16, view<[%width]xf16>
    } else {
      %view = buffer.view %output[%origin] : buffer -> view<[%width]xf32>
      view.store %value, %view[%column] : f32, view<[%width]xf32>
    }
  }
  template.return
}

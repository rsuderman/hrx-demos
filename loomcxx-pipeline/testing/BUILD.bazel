load("@hrx_system//build_tools/bazel:cc_test.bzl", "cc_test")
load("@hrx_system//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(default_visibility = ["//visibility:public"])

iree_c_embed_data(
    name = "consumer_modules",
    testonly = True,
    srcs = [
        "//loomcxx-pipeline/llm:normalization",
        "//loomcxx-pipeline/llm:normalization_providers",
    ],
    c_file_output = "consumer_modules.c",
    flatten = True,
    h_file_output = "consumer_modules.h",
    identifier = "consumer_modules",
)

cc_test(
    name = "loomify_consumer_test",
    size = "small",
    srcs = ["loomify_consumer_test.cc"],
    copts = ["-std=c++17"],
    linkstatic = True,
    deps = [
        ":consumer_modules",
        ":consumer_wrappers",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@hrx_system//loom/binding/c:loomc",
        "@hrx_system//loom/binding/c/target/amdgpu",
    ],
)

cc_test(
    name = "abi_admission_test",
    size = "small",
    srcs = ["abi_admission_test.cc"],
    copts = ["-std=c++17"],
    data = [
        "//loomcxx-pipeline/support:assemble",
        "//loomcxx-pipeline/llm:normalization_import",
        "//loomcxx-pipeline/llm:normalization_abi",
    ],
    deps = ["@googletest//:gtest_main"],
)

iree_c_embed_data(
    name = "consumer_wrappers",
    testonly = True,
    srcs = [
        "consumer_commands.loom",
        "consumer_model_norm.loom",
    ],
    c_file_output = "consumer_wrappers.c",
    flatten = True,
    h_file_output = "consumer_wrappers.h",
    identifier = "consumer_wrappers",
)
